{#
/**
 * @file
 * Steps (pf-steps): a short how-to done in order, on the Quick Start
 * Guide's anatomy (includes/guide-request-paths.html.twig) with numbers
 * for its letters. Letters mark alternatives (pick one); numbers, with no
 * leading zero, a sequence; 01, 02 stay on the section index rules. Two to
 * four steps, each a short name and a one-line note.
 *
 * From md the steps sit across, each headed by a large accent number
 * beside its name on two lines, the note under them. Below md they run
 * down one rail, each number in a diamond. A step may have sub-steps (the
 * Quick Start's stops): a rail of small diamonds under its note, each with
 * a Font Awesome Pro duotone icon, inlined as the Quick Start's are, or
 * its number when it has none.
 *
 * One step alone (pf-steps--single) has no number: its name heads its
 * sub-steps, which carry the sequence, and from md they run across in a
 * row, the line between them, as a Quick Start option does.
 *
 * Ordered lists, so screen readers hear "list, 3 items" and each name;
 * the drawn numbers and icons are decorative.
 *
 * Available variables:
 * - steps: a list of {name, note, stops}: name in two parts ([first,
 *   rest]; one line below md, two from md), note a render array or text
 *   or NULL, stops a list of {label, note, icon} or empty. icon is a
 *   duotone file name (search, calendar-check) or NULL.
 *   _palefire_steps_items() makes them from <li><strong>Name</strong>
 *   note</li>, sub-steps a numbered list inside the item.
 * - labelledby: the id of the heading that names the list, optional.
 */
#}
{% set single = steps|length == 1 %}
<ol class="pf-steps{{ single ? ' pf-steps--single' }}"{% if labelledby|default('') %} aria-labelledby="{{ labelledby }}"{% endif %}>
  {% for step in steps %}
    <li class="pf-steps__step">
      {% if not single %}
        <span class="pf-steps__num" aria-hidden="true">{{ loop.index }}</span>
      {% endif %}
      <span class="pf-steps__name">{{ step.name|first }}{% if step.name|last and step.name|length > 1 %} <span class="pf-steps__name-rest">{{ step.name|last }}</span>{% endif %}</span>
      {% if step.note %}
        <div class="pf-steps__note">{{ step.note }}</div>
      {% endif %}
      {% if step.stops|default([]) %}
        <ol class="pf-steps__stops">
          {% for stop in step.stops %}
            {% set svg = stop.icon ? source('libraries/fontawesome-pro/svgs/duotone/' ~ stop.icon ~ '.svg', ignore_missing = true) : '' %}
            <li class="pf-steps__stop">
              <span class="pf-steps__mark{{ svg ? ' has-icon' }}" aria-hidden="true">{{ svg ? svg|raw : loop.index }}</span>
              <span class="pf-steps__label">{{ stop.label }}</span>
              {% if stop.note %}
                <div class="pf-steps__stop-note">{{ stop.note }}</div>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      {% endif %}
    </li>
  {% endfor %}
</ol>
