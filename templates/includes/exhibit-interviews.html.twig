{#
/**
 * @file
 * An oral history project's full interviews ("[interviews:<set>]" in a
 * guide text block; src/ExhibitInterviews.php), styled by
 * css/exhibit-interviews.css (library palefire/exhibit-interviews, attached
 * here only).
 *
 * A grid of narrators, A to Z by family name: the portrait (or initials),
 * the name, who interviewed them and the accession number, then each tape
 * ruled under it with its length. No players here: the card opens the
 * interview in the exhibition's object view, as a clip opens
 * (js/exhibition.js, data-pf-interview), a tape at a time with its typed
 * transcript lit phrase by phrase (data-pf-timings); a tape's row opens at
 * that tape. Without the script each link is the tape's MP3. The portrait
 * sits beside the name it shows, so it is alt="".
 *
 * The names are h3s (the gallery's <h2> is above), kept out of "On this
 * page" by data-toc-skip so 49 names don't flood it.
 *
 * - narrators: [{id, name, initials, interviewers, accessions, photo
 *   (_palefire_exhibit_image() values or NULL), tapes: [{number,
 *   length, note, audio, timings}]}].
 * - tape_count, hours: the facts line.
 */
#}
{{ attach_library('palefire/exhibit-interviews') }}
<div class="pf-interviews" data-toc-skip>
  <p class="pf-interviews__facts">
    <span>{{ '@count interviews'|t({ '@count': narrators|length }) }}</span>
    <span>{{ '@count recordings'|t({ '@count': tape_count }) }}</span>
    <span>{{ 'About @count hours'|t({ '@count': hours }) }}</span>
  </p>
  <ul class="pf-interviews__grid" role="list">
    {% for narrator in narrators %}
      {% set first = narrator.tapes|filter(t => t.audio)|first %}
      {% set by = narrator.interviewers ? 'Interviewed by @names'|t({ '@names': narrator.interviewers|join(', ', ' and ') }) : '' %}
      <li class="pf-interview" data-pf-interview data-pf-by="{{ by }}" data-pf-accession="{{ narrator.accessions|join(', ') }}">
        {% if first %}<a class="pf-interview__open" href="{{ first.audio }}" aria-describedby="{{ narrator.id }}-meta">{% else %}<div class="pf-interview__open">{% endif %}
          <span class="pf-interview__photo">
            {% if narrator.photo %}
              {% set photo = narrator.photo %}
              <img src="{{ photo.src }}" srcset="{{ photo.srcset }}" sizes="{{ photo.sizes }}"{% if photo.width %} width="{{ photo.width }}" height="{{ photo.height }}"{% endif %} alt="" loading="lazy" decoding="async"{% if photo.focus %} style="object-position: {{ photo.focus }}"{% endif %}>
            {% else %}
              <span class="pf-interview__initials" aria-hidden="true">{{ narrator.initials }}</span>
            {% endif %}
          </span>
          <h3 class="pf-interview__name" id="{{ narrator.id }}">{{ narrator.name }}</h3>
        {% if first %}</a>{% else %}</div>{% endif %}
        <p class="pf-interview__meta" id="{{ narrator.id }}-meta">
          {% if by %}<span>{{ by }}</span>{% endif %}
          {% if narrator.accessions %}
            <span class="pf-interview__accession"><span class="visually-hidden">{{ 'Accession'|t }} </span>{{ narrator.accessions|join(', ') }}</span>
          {% endif %}
        </p>
        <ol class="pf-interview__tapes" aria-label="{{ 'Tapes'|t }}">
          {% for tape in narrator.tapes %}
            <li class="pf-tape">
              {% if tape.audio %}
                <a class="pf-tape__open" href="{{ tape.audio }}" data-pf-tape="{{ tape.number }}" data-pf-length="{{ tape.length }}"{% if tape.timings %} data-pf-timings="{{ tape.timings }}"{% endif %} aria-describedby="{{ narrator.id }}">
                  <svg class="pf-tape__play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"/></svg>
                  <span class="pf-tape__number"><span class="visually-hidden">{{ 'Tape'|t }} </span>{{ tape.number }}</span>
                  {% if tape.length %}<span class="pf-tape__length">{{ tape.length }}</span>{% endif %}
                </a>
              {% else %}
                <span class="pf-tape__open">
                  <span class="pf-tape__number"><span class="visually-hidden">{{ 'Tape'|t }} </span>{{ tape.number }}</span>
                  {% if tape.length %}<span class="pf-tape__length">{{ tape.length }}</span>{% endif %}
                </span>
              {% endif %}
              {% if tape.note %}<span class="pf-tape__note">{{ tape.note }}</span>{% endif %}
            </li>
          {% endfor %}
        </ol>
      </li>
    {% endfor %}
  </ul>
</div>
