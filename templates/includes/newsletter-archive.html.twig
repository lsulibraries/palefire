{#
/**
 * @file
 * Past issues of the newsletter: their front pages in a grid, a row per year.
 *
 * From a guide text paragraph that is only "[newsletter-archive]"; the
 * block's links to Constant Contact previews are the issues, newest first
 * (palefire_preprocess_paragraph__guide_text(), Drupal\palefire\NewsletterReview::archive()).
 *
 * - uid: unique on the page.
 * - years: each with year (2026) and items, each with name (July 2026), line
 *   (The Awards Issue), sent (July 7, 2026) and sent_iso (2026-07-07) or
 *   NULL, number (counting up from the oldest), preview, and front (the
 *   theme's capture of the email's top, 480 by 640) or NULL.
 * - heading: optional, a heading over the grid (a review page's "Past
 *   issues", NewsletterReview::pastIssues()); the years then sit a level
 *   under it.
 * - plain: optional; a flat catalog grid (review pages): no turn, lift,
 *   dimming or reveal, smaller sheets.
 *
 * Each issue is a sheet, drawn as the Written at Hill books are
 * (.pf-tiles--covers, .pf-book: the turn, lift and the others dimming), set
 * in a grid instead of a sideways shelf: newsletter-review.scss,
 * .pf-tiles--sheets. A list of the years above jumps to each. An issue
 * without a capture is a cover set in type. The front page is decorative
 * (aria-hidden, alt=""): the title and number name the link.
 *
 * - reading: the issue ?read=<id> names (id, name, line, html: the email
 *   with its links made plain text, or NULL if it couldn't be fetched), or
 *   NULL (NewsletterReview::reading()).
 *
 * Each sheet is a link to this page with ?read=<id>, which shows that issue
 * above the grid, so it works without the script; js/newsletter-review.js
 * reads the issue from there into a dialog instead. Past issues never offer
 * their own links: they go stale.
 */
#}
{{ attach_library('palefire/newsletter-review') }}
{% set heading = heading|default('') %}
{% set plain = plain|default(false) %}
{% if not plain %}
  {{ attach_library('palefire/tile-reveal') }}
{% endif %}
{% set year_tag = heading ? 'h4' : 'h3' %}
{% if years %}
  <div class="pf-nla pf-tiles pf-tiles--covers pf-tiles--sheets{{ heading ? ' pf-nla--headed' }}{{ plain ? ' pf-nla--plain' }}" data-pf-nla data-toc-skip>
    {% if heading %}
      <h3 class="pf-nla__heading" id="{{ uid }}-heading">{{ heading }}</h3>
    {% endif %}
    {% if reading %}
      <section class="pf-nla__reading" id="{{ uid }}-reading" data-pf-nla-reading aria-labelledby="{{ uid }}-reading-title" tabindex="-1">
        <div class="pf-nla__bar">
          <h3 class="pf-nla__title" id="{{ uid }}-reading-title">{{ reading.name }}{{ reading.line ? ' · ' ~ reading.line }}</h3>
          <a class="pf-nla__own pf-nla__own--close" href="{{ path('<current>') }}#{{ uid }}-heading">{{ 'Close'|t }}</a>
        </div>
        {% if reading.html %}
          <iframe class="pf-nla__frame" title="{{ reading.name }}" srcdoc="{{ reading.html }}" sandbox referrerpolicy="no-referrer" width="640" height="2400"></iframe>
        {% else %}
          <p class="pf-nla__missing">{{ 'This issue couldn’t be loaded just now. Try again in a minute.'|t }}</p>
        {% endif %}
      </section>
    {% endif %}
    {% if years|length > 1 %}
      <nav class="pf-nla__years" aria-label="{{ heading ? 'Past issues by year'|t : 'Issues by year'|t }}">
        <ul role="list">
          {% for group in years %}
            <li><a href="#{{ uid }}-{{ group.year ?: 'undated' }}">{{ group.year ?: 'Undated'|t }}<span class="visually-hidden">, {{ '@count issues'|t({ '@count': group.items|length }) }}</span></a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
    {% for group in years %}
      <section class="pf-nla__year" aria-labelledby="{{ uid }}-{{ group.year ?: 'undated' }}">
        <{{ year_tag }} class="pf-nla__year-label" id="{{ uid }}-{{ group.year ?: 'undated' }}" tabindex="-1">{{ group.year ?: 'Undated'|t }}</{{ year_tag }}>
        <ol class="pf-tiles__list" role="list">
          {% for item in group.items %}
            <li class="pf-tiles__item">
              <a class="pf-book" href="?{{ constant('Drupal\\palefire\\NewsletterReview::READ') }}={{ item.id }}#{{ uid }}-reading" data-pf-nla-open data-name="{{ item.name }}">
                <span class="pf-book__cover{{ item.front ? '' : ' pf-book__cover--set' }}" aria-hidden="true">
                  <span class="pf-book__object">
                    {% if item.front %}
                      <img src="{{ item.front }}" alt="" width="480" height="640" loading="lazy" decoding="async">
                    {% else %}
                      <span class="pf-book__jacket">
                        <span class="pf-book__jacket-title">{{ item.name }}</span>
                        <span class="pf-book__jacket-author">{{ 'No. @n'|t({ '@n': item.number }) }}</span>
                      </span>
                    {% endif %}
                  </span>
                </span>
                <span class="pf-book__text">
                  <span class="pf-book__title">{{ item.line ?: item.name }}</span>
                  <span class="pf-book__imprint"><span class="visually-hidden">, </span>{{ 'No. @n'|t({ '@n': item.number }) }} · {% if item.sent %}<time datetime="{{ item.sent_iso }}">{{ item.sent }}</time>{% else %}{{ item.name }}{% endif %}</span>
                  <span class="pf-book__cta" aria-hidden="true">{{ 'Read the issue'|t }}</span>
                </span>
              </a>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endfor %}
    <dialog class="pf-nla__dialog" id="{{ uid }}-dialog" aria-labelledby="{{ uid }}-dialog-title" data-pf-nla-dialog>
      <div class="pf-nla__bar">
        <p class="pf-nla__title" id="{{ uid }}-dialog-title" data-pf-nla-title></p>
        <button type="button" class="pf-nla__close" data-pf-nla-close aria-label="{{ 'Close'|t }}"><svg class="pf-nl-x" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg></button>
      </div>
      <iframe class="pf-nla__frame" data-pf-nla-frame title="" sandbox referrerpolicy="no-referrer"></iframe>
    </dialog>
  </div>
{% endif %}
