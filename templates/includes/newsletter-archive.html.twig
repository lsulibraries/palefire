{#
/**
 * @file
 * Past issues of the newsletter, as a shelf of front pages.
 *
 * From a guide text paragraph that is only "[newsletter-archive]"; the
 * block's links to Constant Contact previews are the issues, newest first
 * (palefire_preprocess_paragraph__guide_text(), Drupal\palefire\NewsletterReview::archive()).
 *
 * - uid: unique on the page.
 * - items: each with name (July 2026), line (The Awards Issue), sent
 *   (July 7, 2026) and sent_iso (2026-07-07) or NULL, number (counting up
 *   from the oldest), preview, and front (the theme's capture of the
 *   email's top, 480 by 640) or NULL.
 *
 * The Written at Hill shelf (paragraph--tile-showcase.html.twig, covers),
 * its markup, styles and script (palefire/book-shelf), with each issue a
 * thin sheet: newsletter-review.scss, .pf-tiles--sheets. An issue without
 * a capture is a cover set in type. The front page is decorative
 * (aria-hidden, alt=""): the title and number name the link.
 *
 * Each sheet is a link to the issue's preview, so it works without the
 * script; js/newsletter-review.js opens the issue in a dialog on the page
 * instead, framed with no scripts, with a link to open it on its own.
 */
#}
{{ attach_library('palefire/newsletter-review') }}
{{ attach_library('palefire/tile-reveal') }}
{{ attach_library('palefire/book-shelf') }}
{% if items %}
  {% set shelf_id = uid ~ '-shelf' %}
  <div class="pf-nla pf-tiles pf-tiles--covers pf-tiles--sheets" data-pf-nla data-toc-skip>
    <div class="pf-tiles__shelf-nav" role="group" aria-label="{{ 'Scroll the issues'|t }}" hidden>
      {% for dir, label in { prev: 'Previous issues'|t, next: 'Next issues'|t } %}
        <button type="button" class="pf-tiles__shelf-button" data-pf-shelf="{{ dir }}" aria-controls="{{ shelf_id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="{{ dir == 'prev' ? 'M20 12H5M11 6l-6 6 6 6' : 'M4 12h15M13 6l6 6-6 6' }}"/></svg>
          <span class="visually-hidden">{{ label }}</span>
        </button>
      {% endfor %}
    </div>
    <div class="pf-tiles__shelf" data-pf-at="start">
      <ol class="pf-tiles__list" id="{{ shelf_id }}" role="list">
        {% for item in items %}
          <li class="pf-tiles__item">
            <a class="pf-book" href="{{ item.preview }}" target="_blank" rel="noopener" data-pf-nla-open data-name="{{ item.name }}">
              <span class="pf-book__cover{{ item.front ? '' : ' pf-book__cover--set' }}" aria-hidden="true">
                <span class="pf-book__object">
                  {% if item.front %}
                    <img src="{{ item.front }}" alt="" width="480" height="640" loading="lazy" decoding="async">
                  {% else %}
                    <span class="pf-book__jacket">
                      <span class="pf-book__jacket-title">{{ item.name }}</span>
                      <span class="pf-book__jacket-author">{{ 'No. @n'|t({ '@n': item.number }) }}</span>
                    </span>
                  {% endif %}
                </span>
              </span>
              <span class="pf-book__text">
                <span class="pf-book__title">{{ item.line ?: item.name }}</span>
                <span class="pf-book__imprint"><span class="visually-hidden">, </span>{{ 'No. @n'|t({ '@n': item.number }) }} · {% if item.sent %}<time datetime="{{ item.sent_iso }}">{{ item.sent }}</time>{% else %}{{ item.name }}{% endif %}</span>
                <span class="pf-book__cta" aria-hidden="true">{{ 'Read the issue'|t }}</span>
                <span class="visually-hidden" data-pf-nla-tab>, {{ 'opens in a new tab'|t }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ol>
    </div>
    <dialog class="pf-nla__dialog" id="{{ uid }}-dialog" aria-labelledby="{{ uid }}-dialog-title" data-pf-nla-dialog>
      <div class="pf-nla__bar">
        <p class="pf-nla__title" id="{{ uid }}-dialog-title" data-pf-nla-title></p>
        <a class="pf-nla__own" href="#" target="_blank" rel="noopener" data-pf-nla-own>{{ 'Open on its own'|t }}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span></a>
        <button type="button" class="pf-nla__close" data-pf-nla-close aria-label="{{ 'Close'|t }}"><i class="fas fa-times" aria-hidden="true"></i></button>
      </div>
      <iframe class="pf-nla__frame" data-pf-nla-frame title="" sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>
    </dialog>
  </div>
{% endif %}
