{#
/**
 * @file
 * Exhibition title page: the page's <h1> over a full-screen image.
 *
 * Printed inside .pf-modular__head (page.html.twig) on Modular pages in
 * exhibition mode. Variables: head (PalefireHooks::exhibitHead()):
 * - title, subtitle: the <h1> and the line under it.
 * - credit, intro: render arrays or NULL.
 * - prompt: the line that points at the table of contents.
 * - year, physical: optional tiles under the credit: the exhibition's year,
 *   and a note on the physical exhibition, behind FA Pro's light treasure
 *   chest (a word where the server has no FA Pro files). The note is a
 *   tooltip: hover, keyboard focus or a tap shows it, Esc hides it
 *   (js/exhibition.js), and the button is described by it.
 * - cover: image values (_palefire_exhibit_image()) or NULL. Decorative.
 *   Its focal point, when set, is where it stays in view when cropped.
 *
 * The parts come in one after another on load (_exhibition.scss):
 * image, title, subtitle, credit, then the prompt. The galleries follow
 * it as one long page ("Home" in the TOC is this page).
 *
 * "Begin" glides to the first gallery; below lg, "Contents" opens the TOC
 * drawer, which is where the prompt points there.
 */
#}
{{ attach_library('palefire/exhibition') }}
<div class="pf-exhibit-cover{{ head.cover ? ' has-image' }}">
  {% if head.cover %}
    <div class="pf-exhibit-cover__media" aria-hidden="true">
      {# Lazy in the markup so an address for a gallery (#…) doesn't fetch
         it; otherwise a script in <head> preloads it as early as an eager
         image (PalefireHooks::exhibitHead()). #}
      <img class="pf-exhibit-cover__img" src="{{ head.cover.src }}"
           {% if head.cover.srcset %}srcset="{{ head.cover.srcset }}" sizes="{{ head.cover.sizes }}"{% endif %}
           {% if head.cover.width %}width="{{ head.cover.width }}" height="{{ head.cover.height }}"{% endif %}
           {% if head.cover.focus %}style="object-position: {{ head.cover.focus }}"{% endif %}
           alt="" loading="lazy" fetchpriority="high" decoding="async">
    </div>
  {% endif %}
  <div class="pf-exhibit-cover__text">
    <p class="pf-exhibit-cover__kicker pf-exhibit-cover__step" style="--pf-step: 1">{{ 'Exhibition'|t }}</p>
    {# The title's length and longest word set its size (_exhibition.scss). #}
    {% set title_word = 1 %}
    {% for word in head.title|split(' ') %}
      {% set title_word = max(title_word, word|length) %}
    {% endfor %}
    <h1 class="pf-modular__title pf-exhibit-cover__title pf-exhibit-cover__step" style="--pf-step: 2; --pf-title-chars: {{ max(head.title|length, 1) }}; --pf-title-word: {{ title_word }}">
      {{- head.title -}}
      {% if head.subtitle %}
        <span class="visually-hidden">: </span><span class="pf-exhibit-cover__subtitle">{{ head.subtitle }}</span>
      {% endif %}
    </h1>
    {% if head.intro %}
      <div class="pf-exhibit-cover__intro pf-exhibit-cover__step" style="--pf-step: 3">{{ head.intro }}</div>
    {% endif %}
    {% if head.credit %}
      <div class="pf-exhibit-cover__credit pf-exhibit-cover__step" style="--pf-step: 4">{{ head.credit }}</div>
    {% endif %}
    {% if head.year or head.physical %}
      <ul class="pf-exhibit-cover__facts pf-exhibit-cover__step" style="--pf-step: 4.5">
        {% if head.year %}
          <li><span class="pf-exhibit-cover__fact"><span class="visually-hidden">{{ 'Year:'|t }} </span>{{ head.year }}</span></li>
        {% endif %}
        {% if head.physical %}
          {% set chest = source('libraries/fontawesome-pro/svgs/light/treasure-chest.svg', ignore_missing = true) %}
          <li class="pf-exhibit-cover__tip-wrap" data-pf-exhibit-tip>
            <button type="button" class="pf-exhibit-cover__fact pf-exhibit-cover__fact--tip{{ chest ? ' has-icon' }}" aria-describedby="pf-exhibit-physical-note">
              {% if chest %}
                <span class="pf-exhibit-cover__fact-icon" aria-hidden="true">{{ chest|raw }}</span>
                <span class="visually-hidden">{{ 'Physical exhibition'|t }}</span>
              {% else %}
                {{ 'On display'|t }}
              {% endif %}
            </button>
            <span class="pf-exhibit-cover__tip" id="pf-exhibit-physical-note" role="tooltip">{{ head.physical }}</span>
          </li>
        {% endif %}
      </ul>
    {% endif %}
    <div class="pf-exhibit-cover__prompt pf-exhibit-cover__step" style="--pf-step: 5">
      <p class="pf-exhibit-cover__prompt-text">
        <svg class="pf-exhibit-cover__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M13.5 8H2.5M7 3.5 2.5 8 7 12.5"/></svg>
        {{ head.prompt }}
      </p>
      <div class="pf-exhibit-cover__actions" data-pf-exhibit-actions hidden>
        <a class="pf-exhibit-button pf-exhibit-button--primary" href="#" data-pf-exhibit-begin>
          {{ 'Begin'|t }}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/></svg>
        </a>
        <button type="button" class="pf-exhibit-button d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#pf-modular-sidebar" aria-controls="pf-modular-sidebar">
          {{ 'Contents'|t }}
        </button>
      </div>
    </div>
  </div>
  {{ head.cache }}
</div>
