{#
/**
 * @file
 * Building map key: the legend and space list, then the note (the building
 * term's description: who can walk in, what needs an appointment). Used by
 * paragraph--building-map.html.twig, in the map's aside or, on the landing
 * hero, across the top of the Visit strip.
 *
 * Variables:
 * - map: the building map (palefire_preprocess_paragraph__building_map()).
 */
#}
{# The toggle always shows. Open beside the map, collapsed when it moves
   under the map (building-map.js); the reader can open or close it either
   way. data-toc-skip keeps anything in here out of the TOC.
   In the landing hero's Visit panel (map.visit) it is a section of the
   page: the toggle is an index rule (its number map.visit.index, from
   _palefire_hero_rules(): after Visit Hill), it stays open, and the body is an index in three columns,
   the note and legend first, then each group of rooms (_landing-swiss.scss). #}
{% set keyed = map.visit is defined and map.visit %}
<details class="pf-map__key{{ keyed ? ' pf-map__key--indexed' }}" open data-map-key data-toc-skip>
  {% if keyed %}
    <summary class="pf-map__key-toggle pf-index-rule">
      <span class="pf-index-rule__num" aria-hidden="true">{{ map.visit.index }}</span>
      <span class="pf-index-rule__label">{{ 'Rooms and access'|t }}</span>
      <span class="pf-map__key-count">{{ '@count spaces'|t({'@count': map.spaces|length}) }}</span>
    </summary>
  {% else %}
    <summary class="pf-map__key-toggle">
      <span>{{ 'Legend & spaces'|t }}</span>
      <span class="pf-map__key-count">{{ '@count spaces'|t({'@count': map.spaces|length}) }}</span>
      <span class="pf-map__key-icon" aria-hidden="true"></span>
    </summary>
  {% endif %}
  <div class="pf-map__key-body">
    {# Opening fades the rows in one after another, as the guides'
       accordions do (_building-map.scss): each row is .pf-seq with its
       place in --pf-seq, the legend line first, then each heading and its
       rooms. Capped at 5, so the sixth row and the rest come in together.
       Twig keeps no count across loops, so the places are worked out:
       the legend line (0 or 1 rows), then the walk-in group (its heading
       and rooms), then the appointment group. #}
    {% set seq_legend = not keyed and 'elevator' in map.legend ? 1 : 0 %}
    {% set landmarks = map.landmarks|default([]) %}
    {% set seq_walk_in = map.spaces|filter(s => s.access == 'walk_in')|length + landmarks|length %}
    {# The walk-in and appointment hatches are on the group headings below,
       so the legend lists only the drawing's other marks. #}
    {% set legend %}
      {% if 'elevator' in map.legend %}
        <ul class="pf-map__legend pf-seq" style="--pf-seq: 0">
          <li><svg class="pf-map__legend-icon" viewBox="-66 -40 132 80" aria-hidden="true" focusable="false">{% include '@palefire/includes/map-icon-elevator.svg.twig' %}</svg>{{ 'Elevator'|t }}</li>
        </ul>
      {% endif %}
    {% endset %}
    {# Indexed: the note as the first column. The legend (the elevator
       mark) is left out here for now; the drawing keeps the mark. #}
    {% if keyed %}
      <div class="pf-map__key-about">
        {% if map.note %}
          <div class="pf-map__intro pf-map__note">{{ map.note }}</div>
        {% endif %}
      </div>
    {% else %}
      {{ legend }}
    {% endif %}

    {# Same rooms as the drawing's regions: the keyboard / small-screen route
       in. Each group's heading carries its hatch, once, rather than every
       room repeating it. #}
    <div class="pf-map__list">
      {% for group in [
        { access: 'walk_in', title: 'Walk in'|t },
        { access: 'appointment', title: 'By appointment'|t },
      ] %}
        {% set group_spaces = map.spaces|filter(s => s.access == group.access) %}
        {% set seq_start = seq_legend + (group.access == 'appointment' and seq_walk_in ? seq_walk_in + 1 : 0) %}
        {% set group_landmarks = group.access == 'walk_in' ? landmarks : [] %}
        {% if group_spaces or group_landmarks %}
          <div class="pf-map__group">
            <h4 class="pf-map__group-title pf-seq" style="--pf-seq: {{ min(seq_start, 5) }}">
              <span class="pf-map__swatch{{ group.access == 'appointment' ? ' pf-map__swatch--appointment' }}" aria-hidden="true"></span>
              {{ group.title }}
            </h4>
            <ul>
              {# Landmarks (the Lobby) first: not rooms, so plain text with
                 no tooltip, shown on phones only, where building-map.js
                 numbers them with the rooms (the drawing's names are hidden
                 there). #}
              {% for l in group_landmarks %}
                <li class="pf-map__landmark-row pf-seq" style="--pf-seq: {{ min(seq_start + loop.index, 5) }}">
                  <span class="pf-map__landmark" data-map-landmark="{{ l.key }}">
                    <span class="pf-map__item-name">{{ l.title }}</span>
                    <span class="pf-map__item-floor">{{ 'Floor @n'|t({'@n': l.floor}) }}</span>
                  </span>
                </li>
              {% endfor %}
              {% for s in group_spaces %}
                {# Rooms without a link are buttons: they show the tooltip. #}
                {% set tag = s.url ? 'a' : 'button' %}
                <li class="pf-seq" style="--pf-seq: {{ min(seq_start + group_landmarks|length + loop.index, 5) }}">
                  <{{ tag }} class="pf-map__item" data-map-region="{{ s.key }}" aria-describedby="{{ s.tip }}"{% if s.url %} href="{{ s.url }}"{% else %} type="button"{% endif %}{% if s.key == map.here %} aria-current="location"{% endif %}>
                    <span class="pf-map__item-name">{{ s.title }}</span>
                    {% if s.key == map.here %}<span class="pf-map__here-badge">{{ 'Here'|t }}</span>{% endif %}
                    <span class="pf-map__item-floor">{{ 'Floor @n'|t({'@n': s.floor}) }}</span>
                  </{{ tag }}>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</details>
{# Outside the <details>, so it shows while the legend is collapsed (in
   the indexed key it is the first column instead). #}
{% if map.note and not keyed %}
  <div class="pf-map__intro pf-map__note">{{ map.note }}</div>
{% endif %}
