{#
/**
 * @file
 * One part of the LSU research figures, drawn after a guide text whose
 * paragraph is only "[research:<part>]" (palefire_preprocess_paragraph__guide_text(),
 * Drupal\palefire\ResearchFigures). Built from the guide blocks' Figures and
 * Progress chart styles and the guide's own tables, so it adds no CSS.
 *
 * - part: glance, years, access, kinds, journals, publishers, funders,
 *   topics or cited.
 * - data: ResearchFigures::view(part), or NULL before the first nightly pull:
 *   updated (date), from (first year), and figures, rows or works.
 *
 * Bars are decoration: every row says its number in words.
 *
 * dashboard: every part in one grid of panels (library palefire/guide-blocks,
 * scss/components/_research-dashboard.scss): the figures in
 * a row, then works each year as columns, open access as one stacked bar
 * with its legend, open access each year as thin stacked bars, the top
 * publishers each year as a shaded table, the ranked lists (authors among
 * them) as labeled bars, the latest works, and the most cited works as
 * offprints. Each panel is a <section> named by its <h3>. Panels whose data
 * a pull from before 2026-11-13 lacks are left out.
 */
#}
{% if part == 'dashboard' %}
  {{ attach_library('palefire/guide-blocks') }}
  {% set uid = 'pf-rdash-' ~ random() %}
  {% set panels = [
    { key: 'kinds', title: 'Kinds of work'|t },
    { key: 'journals', title: 'Top journals'|t },
    { key: 'publishers', title: 'Top publishers'|t },
    { key: 'funders', title: 'Top funders'|t },
    { key: 'topics', title: 'Top research topics'|t },
    { key: 'authors', title: 'Most published LSU authors'|t },
  ] %}
  <div class="pf-rdash" data-pf-research="dashboard">
    {% if not data %}
      <p class="pf-rdash__note">{{ 'These figures arrive from OpenAlex each night.'|t }}</p>
    {% else %}
      <dl class="pf-rdash__kpis">
        {% for figure in data.glance.figures %}
          <div class="pf-rdash__kpi">
            <dt class="pf-rdash__kpi-label">{{ figure.label }}</dt>
            <dd class="pf-rdash__kpi-value">{{ figure.value }}</dd>
          </div>
        {% endfor %}
      </dl>

      <div class="pf-rdash__grid">
        <section class="pf-rdash__panel pf-rdash__panel--years" aria-labelledby="{{ uid }}-years">
          <h3 class="pf-rdash__title" id="{{ uid }}-years">{{ 'Works each year'|t }}</h3>
          <ol class="pf-rdash__columns">
            {% for row in data.years.rows %}
              <li class="pf-rdash__column{{ row.current ? ' is-current' }}" style="--pf-rdash-share: {{ row.width }}%">
                <span class="pf-rdash__column-value">{{ row.value }}</span>
                <span class="pf-rdash__column-bar" aria-hidden="true"></span>
                <span class="pf-rdash__column-year">{{ row.year }}{% if row.current %}<span class="pf-rdash__column-note">{{ 'so far'|t }}</span>{% endif %}</span>
              </li>
            {% endfor %}
          </ol>
        </section>

        <section class="pf-rdash__panel pf-rdash__panel--access" aria-labelledby="{{ uid }}-access">
          <h3 class="pf-rdash__title" id="{{ uid }}-access">{{ 'Open access'|t }}</h3>
          <div class="pf-rdash__stack" aria-hidden="true">
            {% for row in data.access.rows %}
              <span class="pf-rdash__segment pf-rdash__tone--{{ row.key }}" style="--pf-rdash-share: {{ row.width }}%" data-pf-tip="{{ row.tip }}" tabindex="-1"></span>
            {% endfor %}
          </div>
          <ul class="pf-rdash__legend">
            {% for row in data.access.rows %}
              <li class="pf-rdash__legend-item">
                <span class="pf-rdash__swatch pf-rdash__tone--{{ row.key }}" aria-hidden="true"></span>
                <span class="pf-rdash__legend-name">{{ row.label }}</span>
                <span class="pf-rdash__legend-value">{{ row.value }}</span>
              </li>
            {% endfor %}
          </ul>
        </section>

        {% if data.opentrend %}
          <section class="pf-rdash__panel pf-rdash__panel--opentrend" aria-labelledby="{{ uid }}-opentrend">
            <h3 class="pf-rdash__title" id="{{ uid }}-opentrend">{{ 'Open access each year'|t }}</h3>
            <ol class="pf-rdash__trend">
              {% for row in data.opentrend %}
                <li class="pf-rdash__trend-row{{ row.current ? ' is-current' }}">
                  <span class="pf-rdash__trend-year">{{ row.year }}{% if row.current %}<span class="visually-hidden"> {{ 'so far'|t }}</span>{% endif %}</span>
                  <span class="pf-rdash__stack pf-rdash__stack--thin" aria-hidden="true">
                    {% for segment in row.segments %}
                      <span class="pf-rdash__segment pf-rdash__tone--{{ segment.key }}" style="--pf-rdash-share: {{ segment.width }}%" data-pf-tip="{{ segment.tip }}" tabindex="-1"></span>
                    {% endfor %}
                  </span>
                  <span class="pf-rdash__trend-value">{{ '@share open'|t({ '@share': row.open }) }}</span>
                  <span class="visually-hidden">{% for segment in row.segments %}{{ segment.text }}{{ not loop.last ? ', ' }}{% endfor %}</span>
                </li>
              {% endfor %}
            </ol>
            <p class="pf-rdash__caption">{{ 'Shaded as in Open access, most open on the left. Point to or tap a band for its count.'|t }}</p>
          </section>
        {% endif %}

        {% if data.publishertrend %}
          <section class="pf-rdash__panel pf-rdash__panel--publishertrend" aria-labelledby="{{ uid }}-publishertrend">
            <h3 class="pf-rdash__title" id="{{ uid }}-publishertrend">{{ 'Top publishers each year'|t }}</h3>
            <div class="pf-rdash__scroll" role="region" tabindex="0" aria-labelledby="{{ uid }}-publishertrend">
              <table class="pf-rdash__table">
                <caption class="visually-hidden">{{ 'Works with an LSU author each year, by publisher'|t }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ 'Publisher'|t }}</th>
                    {% for column in data.publishertrend.years %}
                      <th scope="col">{{ column.year }}{% if column.current %}<span class="pf-rdash__column-note">{{ 'so far'|t }}</span>{% endif %}</th>
                    {% endfor %}
                  </tr>
                </thead>
                <tbody>
                  {% for row in data.publishertrend.rows %}
                    <tr>
                      <th scope="row">{{ row.name }}</th>
                      {% for cell in row.cells %}
                        <td style="--pf-rdash-share: {{ cell.share }}">{{ cell.value }}</td>
                      {% endfor %}
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p class="pf-rdash__caption">{{ 'Darker cells mark each publisher’s busiest years. A publisher’s count includes its imprints.'|t }}</p>
          </section>
        {% endif %}

        {% for panel in panels|filter(panel => attribute(data, panel.key).rows) %}
          <section class="pf-rdash__panel pf-rdash__panel--{{ panel.key }}" aria-labelledby="{{ uid }}-{{ panel.key }}">
            <h3 class="pf-rdash__title" id="{{ uid }}-{{ panel.key }}">{{ panel.title }}</h3>
            <ol class="pf-rdash__bars">
              {% for row in attribute(data, panel.key).rows %}
                <li class="pf-rdash__bar" style="--pf-rdash-share: {{ row.width }}%">
                  <span class="pf-rdash__bar-name">{{ row.label }}</span>
                  <span class="pf-rdash__bar-value">{{ row.value }}</span>
                  <span class="pf-rdash__bar-track" aria-hidden="true"><span class="pf-rdash__bar-fill"></span></span>
                </li>
              {% endfor %}
            </ol>
          </section>
        {% endfor %}

        {% if data.recent %}
          <section class="pf-rdash__panel pf-rdash__panel--recent" aria-labelledby="{{ uid }}-recent">
            <h3 class="pf-rdash__title" id="{{ uid }}-recent">{{ 'Latest works'|t }}</h3>
            <ol class="pf-rdash__recent">
              {% for work in data.recent %}
                <li class="pf-rdash__recent-item">
                  <p class="pf-rdash__recent-date">{{ work.when }}</p>
                  <p class="pf-rdash__recent-title"><a href="{{ work.url }}">{{ work.title }}</a></p>
                  <p class="pf-rdash__recent-meta">
                    {%- if work.venue %}{{ work.venue }}{% endif -%}
                    {%- if work.venue and work.access_label %}<span aria-hidden="true"> · </span>{% endif -%}
                    {%- if work.access_label %}<span class="visually-hidden">, </span>{{ work.access_label }}{% endif -%}
                  </p>
                </li>
              {% endfor %}
            </ol>
          </section>
        {% endif %}

        <section class="pf-rdash__panel pf-rdash__panel--cited" aria-labelledby="{{ uid }}-cited">
          <h3 class="pf-rdash__title" id="{{ uid }}-cited">{{ 'Most cited works'|t }}</h3>
          {# Offprints: each work set like a journal's title page, sober
             (the exhibitions' reading list is the playful cousin): the
             journal as masthead over a rule, the title, the byline and
             year, then the citations as the figure, over a rule as long as
             its share of the most cited, and the DOI. The title's link
             covers the card. #}
          <ol class="pf-rdash__offprints">
            {% for work in data.cited.works %}
              <li class="pf-rdash__offprint" style="--pf-rdash-share: {{ work.share }}%">
                <p class="pf-rdash__offprint-masthead">
                  <span class="pf-rdash__offprint-rank" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                  <span class="pf-rdash__offprint-journal">{{ work.venue }}</span>
                </p>
                <h4 class="pf-rdash__offprint-title">
                  <a class="pf-rdash__offprint-link" href="{{ work.url }}">{{ work.title }}</a>
                </h4>
                <p class="pf-rdash__offprint-byline">
                  {%- if work.byline %}{{ work.byline }}, {% endif -%}
                  {{ work.year }}
                </p>
                <p class="pf-rdash__offprint-figure">
                  <span class="pf-rdash__offprint-count">{{ work.count }}</span>
                  <span class="pf-rdash__offprint-unit">{{ 'citations'|t }}</span>
                </p>
                {% if work.doi or work.access_label %}
                  <p class="pf-rdash__offprint-doi">
                    {%- if work.access_label %}<span class="pf-rdash__offprint-access">{{ work.access_label }}</span>{% endif -%}
                    {%- if work.doi %}<span class="visually-hidden">{{ 'DOI'|t }} </span>{{ work.doi }}{% endif -%}
                  </p>
                {% endif %}
              </li>
            {% endfor %}
          </ol>
        </section>
      </div>

      <p class="pf-rdash__note">{{ 'Works with at least one LSU author published since January 1, @from: articles, books, chapters, dissertations, datasets and more. From OpenAlex, updated @updated.'|t({ '@from': data.from, '@updated': data.updated }) }}</p>
    {% endif %}
  </div>
{% else %}
{{ attach_library('palefire/guide-blocks') }}
<div class="pf-analytics pf-research" data-pf-research="{{ part }}">
  {% if not data %}
    <p class="pf-stats__caption">{{ 'These figures arrive from OpenAlex each night.'|t }}</p>
  {% elseif part == 'glance' %}
    <dl class="pf-stats">
      {% for figure in data.figures %}
        <div class="pf-stats__item">
          <dt class="pf-stats__label">{{ figure.label }}</dt>
          <dd class="pf-stats__value">{{ figure.value }}</dd>
        </div>
      {% endfor %}
    </dl>
    <p class="pf-stats__caption">{{ 'Articles, books, chapters, dissertations, datasets and other works with at least one LSU author, published since January 1, @from. From OpenAlex, updated @updated.'|t({ '@from': data.from, '@updated': data.updated }) }}</p>
  {% elseif part == 'cited' %}
    <table>
      <caption class="visually-hidden">{{ 'The most cited works with an LSU author since @from'|t({ '@from': data.from }) }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ 'Work'|t }}</th>
          <th scope="col">{{ 'Citations'|t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for work in data.works %}
          <tr>
            <td>
              <a href="{{ work.url }}">{{ work.title }}</a>
              <br><small>{{ work.year }}{% if work.venue %}<span aria-hidden="true"> · </span>{{ work.venue }}{% endif %}</small>
            </td>
            <td>{{ work.count }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="pf-stats__caption">{{ 'Updated @updated.'|t({ '@updated': data.updated }) }}</p>
  {% else %}
    {% include '@palefire/includes/analytics-bars.html.twig' with { rows: data.rows, unit: '' } only %}
    <p class="pf-stats__caption">{{ 'Since @from. Updated @updated.'|t({ '@from': data.from, '@updated': data.updated }) }}</p>
  {% endif %}
</div>
{% endif %}
