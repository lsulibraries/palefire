{#
/**
 * @file
 * One part of the LSU research figures, drawn after a guide text whose
 * paragraph is only "[research:<part>]" (palefire_preprocess_paragraph__guide_text(),
 * Drupal\palefire\ResearchFigures). Built from the guide blocks' Figures and
 * Progress chart styles and the guide's own tables, so it adds no CSS.
 *
 * - part: glance, years, access, kinds, journals, publishers, funders,
 *   topics or cited.
 * - data: ResearchFigures::view(part), or NULL before the first nightly pull:
 *   updated (date), from (first year), and figures, rows or works.
 *
 * Bars are decoration: every row says its number in words.
 *
 * dashboard: every part in one grid of panels (library palefire/guide-blocks,
 * scss/components/_research-dashboard.scss): the figures in
 * a row, then works each year as columns, open access as one stacked bar
 * with its legend, the ranked lists as labeled bars, and the most cited
 * works. Each panel is a <section> named by its <h3>.
 */
#}
{% if part == 'dashboard' %}
  {{ attach_library('palefire/guide-blocks') }}
  {% set uid = 'pf-rdash-' ~ random() %}
  {% set panels = [
    { key: 'kinds', title: 'Kinds of work'|t },
    { key: 'journals', title: 'Top journals'|t },
    { key: 'publishers', title: 'Top publishers'|t },
    { key: 'funders', title: 'Top funders'|t },
    { key: 'topics', title: 'Top research topics'|t },
  ] %}
  <div class="pf-rdash" data-pf-research="dashboard">
    {% if not data %}
      <p class="pf-rdash__note">{{ 'These figures arrive from OpenAlex each night.'|t }}</p>
    {% else %}
      <dl class="pf-rdash__kpis">
        {% for figure in data.glance.figures %}
          <div class="pf-rdash__kpi">
            <dt class="pf-rdash__kpi-label">{{ figure.label }}</dt>
            <dd class="pf-rdash__kpi-value">{{ figure.value }}</dd>
          </div>
        {% endfor %}
      </dl>

      <div class="pf-rdash__grid">
        <section class="pf-rdash__panel pf-rdash__panel--years" aria-labelledby="{{ uid }}-years">
          <h3 class="pf-rdash__title" id="{{ uid }}-years">{{ 'Works each year'|t }}</h3>
          <ol class="pf-rdash__columns">
            {% for row in data.years.rows %}
              <li class="pf-rdash__column{{ row.current ? ' is-current' }}" style="--pf-rdash-share: {{ row.width }}%">
                <span class="pf-rdash__column-value">{{ row.value }}</span>
                <span class="pf-rdash__column-bar" aria-hidden="true"></span>
                <span class="pf-rdash__column-year">{{ row.year }}{% if row.current %}<span class="pf-rdash__column-note">{{ 'so far'|t }}</span>{% endif %}</span>
              </li>
            {% endfor %}
          </ol>
        </section>

        <section class="pf-rdash__panel pf-rdash__panel--access" aria-labelledby="{{ uid }}-access">
          <h3 class="pf-rdash__title" id="{{ uid }}-access">{{ 'Open access'|t }}</h3>
          <div class="pf-rdash__stack" aria-hidden="true">
            {% for row in data.access.rows %}
              <span class="pf-rdash__segment pf-rdash__tone--{{ row.key }}" style="--pf-rdash-share: {{ row.width }}%"></span>
            {% endfor %}
          </div>
          <ul class="pf-rdash__legend">
            {% for row in data.access.rows %}
              <li class="pf-rdash__legend-item">
                <span class="pf-rdash__swatch pf-rdash__tone--{{ row.key }}" aria-hidden="true"></span>
                <span class="pf-rdash__legend-name">{{ row.label }}</span>
                <span class="pf-rdash__legend-value">{{ row.value }}</span>
              </li>
            {% endfor %}
          </ul>
        </section>

        {% for panel in panels %}
          <section class="pf-rdash__panel pf-rdash__panel--{{ panel.key }}" aria-labelledby="{{ uid }}-{{ panel.key }}">
            <h3 class="pf-rdash__title" id="{{ uid }}-{{ panel.key }}">{{ panel.title }}</h3>
            <ol class="pf-rdash__bars">
              {% for row in attribute(data, panel.key).rows %}
                <li class="pf-rdash__bar" style="--pf-rdash-share: {{ row.width }}%">
                  <span class="pf-rdash__bar-name">{{ row.label }}</span>
                  <span class="pf-rdash__bar-value">{{ row.value }}</span>
                  <span class="pf-rdash__bar-track" aria-hidden="true"><span class="pf-rdash__bar-fill"></span></span>
                </li>
              {% endfor %}
            </ol>
          </section>
        {% endfor %}

        <section class="pf-rdash__panel pf-rdash__panel--cited" aria-labelledby="{{ uid }}-cited">
          <h3 class="pf-rdash__title" id="{{ uid }}-cited">{{ 'Most cited works'|t }}</h3>
          <ol class="pf-rdash__cited">
            {% for work in data.cited.works %}
              <li class="pf-rdash__work">
                <span class="pf-rdash__work-text">
                  <a class="pf-rdash__work-link" href="{{ work.url }}">{{ work.title }}</a>
                  <span class="pf-rdash__work-meta">{{ work.year }}{% if work.venue %}<span aria-hidden="true"> · </span>{{ work.venue }}{% endif %}</span>
                </span>
                <span class="pf-rdash__work-count">{{ '@count citations'|t({ '@count': work.count }) }}</span>
              </li>
            {% endfor %}
          </ol>
        </section>
      </div>

      <p class="pf-rdash__note">{{ 'Works with at least one LSU author published since January 1, @from: articles, books, chapters, dissertations, datasets and more. From OpenAlex, updated @updated.'|t({ '@from': data.from, '@updated': data.updated }) }}</p>
    {% endif %}
  </div>
{% else %}
{{ attach_library('palefire/guide-blocks') }}
<div class="pf-analytics pf-research" data-pf-research="{{ part }}">
  {% if not data %}
    <p class="pf-stats__caption">{{ 'These figures arrive from OpenAlex each night.'|t }}</p>
  {% elseif part == 'glance' %}
    <dl class="pf-stats">
      {% for figure in data.figures %}
        <div class="pf-stats__item">
          <dt class="pf-stats__label">{{ figure.label }}</dt>
          <dd class="pf-stats__value">{{ figure.value }}</dd>
        </div>
      {% endfor %}
    </dl>
    <p class="pf-stats__caption">{{ 'Articles, books, chapters, dissertations, datasets and other works with at least one LSU author, published since January 1, @from. From OpenAlex, updated @updated.'|t({ '@from': data.from, '@updated': data.updated }) }}</p>
  {% elseif part == 'cited' %}
    <table>
      <caption class="visually-hidden">{{ 'The most cited works with an LSU author since @from'|t({ '@from': data.from }) }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ 'Work'|t }}</th>
          <th scope="col">{{ 'Citations'|t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for work in data.works %}
          <tr>
            <td>
              <a href="{{ work.url }}">{{ work.title }}</a>
              <br><small>{{ work.year }}{% if work.venue %}<span aria-hidden="true"> · </span>{{ work.venue }}{% endif %}</small>
            </td>
            <td>{{ work.count }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="pf-stats__caption">{{ 'Updated @updated.'|t({ '@updated': data.updated }) }}</p>
  {% else %}
    {% include '@palefire/includes/analytics-bars.html.twig' with { rows: data.rows, unit: '' } only %}
    <p class="pf-stats__caption">{{ 'Since @from. Updated @updated.'|t({ '@from': data.from, '@updated': data.updated }) }}</p>
  {% endif %}
</div>
{% endif %}
