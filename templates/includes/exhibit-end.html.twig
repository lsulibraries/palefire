{#
/**
 * @file
 * After an exhibition's last gallery: its family's exhibitions and the
 * way back (PalefireHooks::exhibitEnd(), page.html.twig). They are in the
 * exhibitions band of Oral History's Showcase
 * (includes/exhibit-carousel.html.twig), in the family's order and
 * opened on this one, without its index rule: the band's title is the
 * panel's (visually hidden) heading. Then a plain link back to the
 * family's home and, for Special Collections, every exhibition: quieter
 * than the band's Enter, well below it, so it reads as the way out. _exhibition.scss
 * (.pf-exhibit-end), _exhibit-showcase.scss.
 *
 * - end.others: PalefireHooks::exhibitionCard() arrays, in the family's
 *   order. Empty when the family has one.
 * - end.start: this exhibition's place in them, the one shown first.
 * - end.parent: title, url. end.all: url or NULL.
 */
#}
<nav class="pf-exhibit-end" aria-labelledby="pf-exhibit-end-title">
  <h2 class="visually-hidden" id="pf-exhibit-end-title">
    {{- end.others ? 'More from @parent'|t({'@parent': end.parent.title}) : 'Keep exploring'|t -}}
  </h2>
  {% if end.others %}
    <div class="pf-showcase pf-exhibit-end__showcase" data-pf-showcase data-toc-skip>
      {% include '@palefire/includes/exhibit-carousel.html.twig' with {
        items: end.others,
        start: end.start,
        id: 'pf-exhibit-end-band',
        label: 'More from @parent'|t({'@parent': end.parent.title}),
        heading: 'h3',
      } only %}
    </div>
  {% endif %}
  <ul class="pf-exhibit-end__back">
    <li>
      <a class="pf-exhibit-end__home" href="{{ end.parent.url }}">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5"/></svg>
        {{- end.parent.title -}}
      </a>
    </li>
    {% if end.all %}
      <li><a class="pf-exhibit-end__home" href="{{ end.all }}">{{ 'All exhibitions'|t }}</a></li>
    {% endif %}
  </ul>
</nav>
{{ end.cache }}
