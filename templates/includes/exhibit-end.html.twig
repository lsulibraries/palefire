{#
/**
 * @file
 * After an exhibition's last gallery: the next exhibition in its family and
 * the way back (PalefireHooks::exhibitEnd(), page.html.twig). As the
 * galleries' own "Next" placard (.pf-exhibit-next), one size up: a still
 * of the next exhibition beside its title, the whole card one link, then
 * the family's home and, for Special Collections, every exhibition.
 * _exhibition.scss (.pf-exhibit-end).
 *
 * - end.next: title, url, subtitle, position ("04 / 11"), image
 *   (_palefire_exhibit_image()) or NULL; NULL when the family has one.
 * - end.parent: title, url. end.all: url or NULL.
 */
#}
<nav class="pf-exhibit-end" aria-labelledby="pf-exhibit-end-title">
  <h2 class="visually-hidden" id="pf-exhibit-end-title">{{ 'Keep exploring'|t }}</h2>
  {% if end.next %}
    {% set next = end.next %}
    <a class="pf-exhibit-end__next" href="{{ next.url }}">
      <span class="pf-exhibit-end__kicker">
        {{- 'Next exhibition'|t -}}
        <span class="pf-exhibit-end__number">{{ next.position }}</span>
      </span>
      <span class="visually-hidden">: </span>
      {% if next.image %}
        <span class="pf-exhibit-end__frame">
          <img class="pf-exhibit-end__img" src="{{ next.image.src }}"
               {% if next.image.srcset %}srcset="{{ next.image.srcset }}" sizes="{{ next.image.sizes }}"{% endif %}
               {% if next.image.width %}width="{{ next.image.width }}" height="{{ next.image.height }}"{% endif %}
               alt="" loading="lazy" decoding="async">
        </span>
      {% endif %}
      <span class="pf-exhibit-end__text">
        <span class="pf-exhibit-end__title">{{ next.title }}</span>
        {% if next.subtitle %}
          <span class="pf-exhibit-end__subtitle">{{ next.subtitle }}</span>
        {% endif %}
        <span class="pf-exhibit-end__go" aria-hidden="true">
          {{- 'Enter the exhibition'|t -}}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/></svg>
        </span>
      </span>
    </a>
  {% endif %}
  <ul class="pf-exhibit-end__back">
    <li>
      <a class="pf-exhibit-end__home" href="{{ end.parent.url }}">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5"/></svg>
        {{- 'Back to @parent'|t({'@parent': end.parent.title}) -}}
      </a>
    </li>
    {% if end.all %}
      <li><a class="pf-exhibit-end__home" href="{{ end.all }}">{{ 'All exhibitions'|t }}</a></li>
    {% endif %}
  </ul>
</nav>
{{ end.cache }}
