{#
/**
 * @file
 * Ask Special Collections: FAQs beside a question form (Tile showcase,
 * layout "ask"), so visitors ask from the page instead of on AskUs.
 *
 * Included by paragraph--tile-showcase.html.twig. Variables:
 * - faqs: question, answer (render array or plain text), byline (who
 *   answered, or ''), from _palefire_ask_faqs() in palefire.theme.
 * - ask_form: the libanswers module's question form, or NULL without the
 *   module (then the panel points to AskUs).
 *
 * The form is a Drupal form (templates/form/libanswers-ask-form.html.twig):
 * the module sends each question to the Special Collections queue (2616)
 * as a ticket through the LibAnswers API, so staff answer it in LibAnswers
 * as before, and Honeypot keeps bots out. js/ask-form.js checks the fields
 * and posts it in the background; without JavaScript it posts as usual.
 *
 * FAQs are native <details> in the guides' accordion (_guide.scss); the
 * questions are summaries, not headings, so they stay out of "On this
 * page" (data-toc-skip on the wrapper keeps the h3s out too).
 */
#}
{# Each column's parts rise in one after another on scroll (js/ask-reveal.js). #}
{{ attach_library('palefire/ask-reveal') }}
{% set plus = source(directory ~ '/images/bi/plus-lg.svg', ignore_missing = true) %}
{% set arrow %}<svg class="pf-inquiry__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>{% endset %}
<div class="pf-inquiry" data-toc-skip>
  <div class="pf-inquiry__faqs">
    <h3 class="pf-inquiry__heading">{{ 'Common questions'|t }}</h3>
    {% if faqs %}
      <div class="pf-accordion pf-inquiry__accordion">
        {% for faq in faqs %}
          <details class="pf-accordion__item">
            <summary class="pf-accordion__summary">
              <span class="pf-accordion__row">
                <span class="pf-accordion__title">{{ faq.question }}</span>
                {# Theme SVG file, so |raw is safe here. #}
                <span class="pf-accordion__icon" aria-hidden="true">{{ plus|raw }}</span>
              </span>
            </summary>
            <div class="pf-accordion__panel">
              {% if faq.answer %}
                <div class="pf-guide-prose pf-inquiry__answer">{{ faq.answer }}</div>
              {% endif %}
              {% if faq.byline %}
                <p class="pf-inquiry__byline">{{ 'Answered by @name'|t({'@name': faq.byline}) }}</p>
              {% endif %}
            </div>
          </details>
        {% endfor %}
      </div>
    {% endif %}
    {# Further reading: the full guide (the Quick Guide's "Full guide"
       link), then every FAQ on AskUs, as buttons like Send question. #}
    <ul class="pf-inquiry__links" role="list">
      <li><a class="pf-inquiry__button" href="/v2/special/guides/special-collections">{{ 'How to use Special Collections'|t }}{{ arrow }}</a></li>
      <li><a class="pf-inquiry__button" href="https://askus.lib.lsu.edu/search/?t=0&amp;g=4711">{{ 'All Special Collections FAQs'|t }}{{ arrow }}</a></li>
    </ul>
  </div>

  {# The footer's Ask link (includes/footer.html.twig) lands here. #}
  <div class="pf-inquiry__panel" id="ask-question">
    <h3 class="pf-inquiry__heading">{{ 'Send us a question'|t }}</h3>
    {% if ask_form %}
      {{ attach_library('palefire/ask-form') }}
      <p class="pf-inquiry__intro">{{ 'Special Collections staff reply by email.'|t }}</p>
      {{ ask_form }}
    {% else %}
      <p class="pf-inquiry__intro">{{ 'Special Collections staff answer questions on AskUs, by email or chat.'|t }}</p>
      <a class="pf-inquiry__link" href="https://askus.lib.lsu.edu/special">{{ 'Ask Special Collections on AskUs'|t }}{{ arrow }}</a>
    {% endif %}
  </div>
</div>
