{#
/**
 * @file
 * One newspaper family tree in the Family trees list
 * (paragraph--family-trees.html.twig). data-search is what the search box
 * matches: title, city and parish, lowercased.
 */
#}
<li class="pf-trees__row" data-parish="{{ tree.parish }}" data-search="{{ [tree.title, tree.city, tree.parish_name]|join(' ')|lower }}">
  <a class="pf-trees__title" href="{{ tree.url }}">{{ tree.title }}</a>
  <span class="pf-trees__meta">{{ [tree.city, tree.parish_name]|filter(v => v)|join(' · ') }}</span>
</li>
