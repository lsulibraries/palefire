{#
/**
 * @file
 * One newspaper family tree in the Family trees list
 * (paragraph--family-trees.html.twig): its link (family-tree-link.html.twig)
 * with the city and parish under the title. data-search is what the search
 * box matches: title, city and parish, lowercased. icon: the id of the
 * family-tree icon's <symbol>, or nothing.
 */
#}
<li class="pf-trees__row" data-parish="{{ tree.parish }}" data-search="{{ [tree.title, tree.city, tree.parish_name]|join(' ')|lower }}">
  {% include '@palefire/includes/family-tree-link.html.twig' with { tree: tree, icon: icon, meta: [tree.city, tree.parish_name]|filter(v => v)|join(' · ') } only %}
</li>
