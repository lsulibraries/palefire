{#
/**
 * @file
 * An oral history clip with no picture: a reel in its box, drawn in lines.
 *
 * Printed in a wall tile's frame (paragraph--exhibit-page.html.twig) and
 * copied by js/exhibition.js onto the object view's stage. The box is half
 * see-through, so the reel shows faintly behind it; on hover or focus (and
 * on the stage, while the clip plays) the reel rolls out to the right
 * (_exhibition.scss). Decorative: the tile's label names the entry.
 *
 * Variables:
 * - title: the entry's title, set on the box.
 * - year: the clip's year, or NULL (the slot stays empty).
 */
#}
<span class="pf-exhibit-reel" aria-hidden="true">
  <svg class="pf-exhibit-reel__reel" viewBox="0 0 100 100" focusable="false">
    <circle cx="50" cy="50" r="49"/>
    <circle class="pf-exhibit-reel__pack" cx="50" cy="50" r="30"/>
    <circle class="pf-exhibit-reel__pack pf-exhibit-reel__pack--inner" cx="50" cy="50" r="23.5"/>
    <circle cx="50" cy="29.5" r="8.5"/>
    <circle cx="67.75" cy="60.25" r="8.5"/>
    <circle cx="32.25" cy="60.25" r="8.5"/>
    <circle cx="50" cy="50" r="3.75"/>
  </svg>
  <span class="pf-exhibit-reel__box">
    <span class="pf-exhibit-reel__head">
      <span>{{ 'Audio only'|t }}</span>
      <span>{{ year }}</span>
    </span>
    <span class="pf-exhibit-reel__title">{{ title }}</span>
  </span>
</span>
