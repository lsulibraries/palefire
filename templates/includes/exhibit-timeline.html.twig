{#
/**
 * @file
 * An exhibition's timeline (a gallery set to Display "timeline"): every
 * dated entry of the other galleries, from src/ExhibitTimeline.php. Styles:
 * scss/exhibit-timeline.scss (library palefire/exhibit-timeline, attached
 * only with a timeline).
 *
 * A list read top to bottom on a hairline spine, grouped by decade: each
 * event a filled dot (a picture or clip) or a ring (text only), its date,
 * title and gallery, and a small picture when it has one. Each is a link to
 * its entry (js/exhibition.js opens that gallery, or the entry in a wall's
 * object view). From a 48rem container the decade stands in a column at
 * the left and stays in view while its events scroll past.
 *
 * Variables: timeline (see ExhibitTimeline::build()), dom_id.
 */
#}
<div class="pf-tl" data-pf-timeline>
  <p class="pf-tl__key">
    <span class="pf-tl__key-item pf-tl__key-item--media">{{ 'With a picture or clip'|t }}</span>
    <span class="pf-tl__key-item">{{ 'Text'|t }}</span>
  </p>
  <ol class="pf-tl__list" aria-labelledby="{{ dom_id }}-tl">
    {% for decade in timeline.decades %}
      <li class="pf-tl__decade">
        <h3 class="pf-tl__decade-title">{{ decade.label }}</h3>
        <ol class="pf-tl__events">
          {% for e in decade.events %}
            <li class="pf-tl__event{{ e.media ? ' is-media' }}">
              <a class="pf-tl__link" href="#{{ e.anchor }}">
                <span class="pf-tl__dot" aria-hidden="true"></span>
                <span class="pf-tl__meta">
                  <time class="pf-tl__date" datetime="{{ e.iso }}">{{ e.label }}</time>
                  <span class="pf-tl__title">{{ e.title }}</span>
                  <span class="pf-tl__strand">
                    {{- e.strand -}}
                    {% if e.audio %}<span class="pf-tl__clip"><i class="fas fa-volume-up" aria-hidden="true"></i> {{ 'Clip'|t }}</span>{% endif %}
                  </span>
                </span>
                {% if e.thumb %}
                  <img class="pf-tl__thumb" src="{{ e.thumb.src }}"
                       {% if e.thumb.srcset %}srcset="{{ e.thumb.srcset }}" sizes="{{ e.thumb.sizes }}"{% endif %}
                       {% if e.thumb.width %}width="{{ e.thumb.width }}" height="{{ e.thumb.height }}"{% endif %}
                       alt="" loading="lazy" decoding="async">
                {% endif %}
              </a>
            </li>
          {% endfor %}
        </ol>
      </li>
    {% endfor %}
  </ol>
  <p class="visually-hidden" id="{{ dom_id }}-tl">{{ 'Timeline: @count events in date order'|t({'@count': timeline.events|length}) }}</p>
</div>
