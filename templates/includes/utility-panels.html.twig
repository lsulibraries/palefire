{#
/**
 * @file
 * Utility panels: offcanvas drawers opened from the utility menu's icons.
 *
 * Printed once by page.html.twig (outside the header and #swup) when the
 * Utility menu region has content. Each panel is a Bootstrap 5.3 offcanvas
 * that slides in from the left, in the dark TOC sidebar's look (dark
 * glass, monospace tracked labels, gold accent): _utility-panels.scss.
 * Behavior (clock, LibCal hours, "See full hours" link, Ask Us iframes,
 * Settings): utility-panels.js.
 *
 * Panels, in the utility menu's order: Search, Hours, Ask Us, Accounts,
 * Settings (Origami's drawers; Settings is new).
 * - Ask Us: Origami's three LibAnswers widgets as tabs. Each iframe is
 *   loaded the first time its tab is shown (data-src), so the page makes no
 *   request to LibAnswers until the drawer opens.
 * - Accounts: `accounts` below (label, url, icon = a Bootstrap Icon copied
 *   to images/bi/ by build/copy-assets.js).
 * - Settings: reading and display preferences, saved in this browser only
 *   (localStorage "pf-a11y") and applied before the page paints by the
 *   inline script in html.html.twig. Styles: base/_a11y-settings.scss.
 *
 * The trigger is the menu link itself (menu--utility.html.twig): its icon
 * picks the panel, data-bs-target="#pf-panel-{key}". Keys printed here must
 * match the `panels` list in that template.
 *
 * Hours: one row per LibCal location (`lid`, the same IDs the Visit card
 * uses in field_hours_location). Leave `name` empty to use the name LibCal
 * sends back, or fill it in to override it.
 *
 * Accessibility: Bootstrap gives each panel role="dialog" and aria-modal
 * while open, traps focus inside it, closes it on Escape or a backdrop
 * click, and returns focus to the icon. The live clock is not announced
 * (no aria-live), so screen readers aren't interrupted every minute.
 */
#}
{%
  set hours_locations = [
    { lid: '241', name: 'Main Library'|t },
    { lid: '236', name: '' },
  ]
%}
{%
  set ask_tabs = [
    { key: 'chat', label: 'Live Chat'|t, icon: 'chat-dots-fill', title: 'AskUs live chat'|t, src: 'https://askus.lib.lsu.edu/chat/widget/429e7c7707574f86749aadb93dc33dc563a788c78dfd5248c8598e2445ad575d' },
    { key: 'main', label: 'Email Main Library'|t, icon: 'envelope-fill', title: 'Email the Main Library'|t, src: '/askus/widgets/19448' },
    { key: 'special', label: 'Email Special Collections'|t, icon: 'envelope-fill', title: 'Email Special Collections'|t, src: 'https://askus.lib.lsu.edu/widget_standalone.php?la_widget_id=19447' },
  ]
%}
{%
  set accounts = [
    { label: 'Catalog Account'|t, icon: 'book', url: 'https://lsu.ent.sirsi.net/client/en_US/lsu/search/patronlogin/https:%24002f%24002flsu.ent.sirsi.net%24002fclient%24002fen_US%24002flsu%24002fsearch%24002faccount%24003f/' },
    { label: 'Special Collections Account'|t, icon: 'journal-bookmark', url: 'https://specialcollections.lib.lsu.edu/logon' },
    { label: 'Interlibrary Loan Account'|t, icon: 'truck', url: 'https://louis.hosts.atlas-sys.com/remoteauth/luu/illiad.dll' },
    { label: 'Scholarly Repository Account'|t, icon: 'bank', url: 'https://repository.lsu.edu/cgi/login.cgi?return_to=https%3A%2F%2Frepository.lsu.edu%2Fcgi%2Fmyaccount.cgi%3Fcontext%3D&context=https://repository.lsu.edu' },
    { label: 'myLSU Account'|t, icon: 'mortarboard', url: 'https://mylsu.apps.lsu.edu/c/portal/login' },
    { label: 'TigerCASH Account'|t, icon: 'credit-card', url: 'https://tcard.lsu.edu/' },
  ]
%}
{# Reading colors (Settings): page and text color pairs. Keys must match
   $pf-reading-themes (_reading-themes.scss), the THEMES list in
   utility-panels.js and the pattern in html.html.twig. The first is the
   default every page opens in (Twilight, set on <html> by
   html.html.twig); its radio is checked when nothing is saved. Order:
   favorite darks, the other darks, then the lights. Only the first
   three show, then a "Show 9 more colors" link (utility-panels.js); the
   chosen one always stays in view. Each row: the swatch, its name and a
   line on what it looks like (note). 'group' starts a labelled run in the
   opened list. #}
{%
  set reading_themes = [
    { key: 'twilight', label: 'Twilight'|t, note: 'Dark warm gray, gold links'|t },
    { key: 'material', label: 'Material'|t, note: 'Slate blue, brightest text'|t },
    { key: 'cocoa', label: 'Cocoa'|t, note: 'Dark brown, amber links'|t },
    { key: 'forest', label: 'Forest'|t, note: 'Deep green, mint links'|t },
    { key: 'dusk', label: 'Dusk'|t, note: 'Soft gray, lavender links'|t },
    { key: 'night', label: 'Night'|t, note: 'Near black, highest contrast'|t },
    { key: 'midnight', label: 'Midnight'|t, note: 'Navy, pale blue links'|t },
    { key: 'solarized', label: 'Solarized'|t, note: 'Dark teal, low glare'|t },
    { key: 'cream', label: 'Cream'|t, note: 'Warm paper, violet links'|t, group: 'Light'|t },
    { key: 'lavender', label: 'Lavender'|t, note: 'Pale violet paper'|t },
    { key: 'sepia', label: 'Sepia'|t, note: 'Brown ink on tan'|t },
    { key: 'sage', label: 'Sage'|t, note: 'Green ink on pale green'|t },
  ]
%}
{# Settings: group > settings. type 'size' is the radio group; the rest are
   switches whose key becomes html.pf-a11y-{key}. Keep the keys in step with
   html.html.twig and utility-panels.js. #}
{%
  set settings_groups = [
    { key: 'reading', label: 'Reading'|t, items: [
      { key: 'font', label: 'Easy-to-read font'|t, help: 'Atkinson Hyperlegible Next, made for low-vision readers.'|t },
      { key: 'spacing', label: 'More text spacing'|t, help: 'Wider line, letter, word and paragraph spacing.'|t },
      { key: 'underline', label: 'Underline all links'|t, help: 'Includes menus and link buttons.'|t },
      { key: 'reader', label: 'Reader font for guides'|t, help: 'Research guides use a book-style serif, larger and more spaced, like Reader view. Other pages keep their own fonts.'|t },
    ] },
    { key: 'display', label: 'Display'|t, items: [
      { key: 'contrast', label: 'High contrast'|t, help: 'Solid backgrounds, full-strength text, brighter borders, no stripes.'|t },
      { key: 'solid', label: 'Reduce transparency'|t, help: 'No see-through glass on the header, sidebar and drawers.'|t },
      { key: 'focus', label: 'Strong focus outline'|t, help: 'A thick gold-and-black ring around whatever has keyboard focus.'|t },
    ] },
    { key: 'motion', label: 'Motion'|t, items: [
      { key: 'motion', label: 'Reduce motion'|t, help: 'Stops animations, page transitions, map animation and smooth scrolling.'|t },
      { key: 'pausevideo', label: 'Pause background videos'|t, help: 'Background videos start paused.'|t },
    ] },
  ]
%}
{% set close_icon %}
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
{% endset %}
{# "‹ Menu": shown only while a drawer is open over the phone menu, where it
   covers the menu (openOverMenu, js/palefire.js). It goes back to the menu;
   the × closes both. #}
{% set back_button %}
  <button type="button" class="pf-panel__back" aria-label="{{ 'Back to the menu'|t }}" data-pf-panel-back hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ 'Menu'|t }}
  </button>
{% endset %}
{% set ext_icon %}
  <svg class="pf-panel__cta-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9.5 2.5h4v4M13.5 2.5 7 9M11.5 9.5v3a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% endset %}

<div class="pf-panels" data-pf-panels>

  {# Search ------------------------------------------------------------- #}
  <div class="offcanvas offcanvas-start pf-panel pf-panel--search" id="pf-panel-search" tabindex="-1"
       aria-labelledby="pf-panel-search-title" data-pf-panel="search">
    <div class="pf-panel__header">
      {{ back_button }}
      <h2 class="pf-panel__title" id="pf-panel-search-title">{{ 'Search'|t }}</h2>
      <button type="button" class="pf-panel__close" data-bs-dismiss="offcanvas">
        {{ close_icon }}<span class="visually-hidden">{{ 'Close search'|t }}</span>
      </button>
    </div>
    <div class="pf-panel__body">
      {# The Index (/v2/search, the palefire_search module), in the landing
         search's field, with its modes to choose from. #}
      <form class="pf-landing__form pf-panel__search" role="search" method="get" action="/v2/search" aria-labelledby="pf-panel-search-title">
        <label class="visually-hidden" for="pf-panel-search-q">{{ 'Search LSU Libraries'|t }}</label>
        <div class="pf-landing__field">
          <svg class="pf-landing__field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
          <input class="pf-landing__input" type="search" id="pf-panel-search-q" name="q" maxlength="128"
                 placeholder="{{ 'Books, articles, archives'|t }}" autocomplete="off" enterkeyhint="search" data-pf-panel-autofocus>
          <button class="pf-landing__submit" type="submit">
            <span class="pf-landing__submit-text">{{ 'Search'|t }}</span>
            <svg class="pf-landing__submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        {# The Index's modes, each with what it covers (the Index's
           SearchSources::modes()). utility-panels.js starts on the section the
           page is in; All is the default without it. The whole row picks it;
           what it covers is read after its name. #}
        {%
          set panel_modes = [
            { value: 'all', label: 'All'|t, about: 'Everything at once: articles, books, archives and library pages.'|t },
            { value: 'research', label: 'Research'|t, about: 'Articles, books, databases, e-textbooks and research guides.'|t },
            { value: 'special', label: 'Special Collections'|t, about: 'Rare books, manuscripts, finding aids and oral histories.'|t },
            { value: 'website', label: 'Website'|t, about: 'Library pages, services, news, equipment and staff.'|t },
          ]
        %}
        <fieldset class="pf-panel__modes">
          <legend class="pf-panel__modes-label">{{ 'Search in'|t }}</legend>
          {% for mode in panel_modes %}
            <div class="pf-panel__mode">
              <input type="radio" name="mode" id="pf-panel-mode-{{ mode.value }}" value="{{ mode.value }}"{% if loop.first %} checked{% endif %} aria-describedby="pf-panel-mode-{{ mode.value }}-about" data-pf-panel-mode>
              <label class="pf-panel__mode-name" for="pf-panel-mode-{{ mode.value }}">{{ mode.label }}</label>
              <p class="pf-panel__mode-about" id="pf-panel-mode-{{ mode.value }}-about">{{ mode.about }}</p>
            </div>
          {% endfor %}
        </fieldset>
      </form>
    </div>
    {# Straight to the two services people ask for by name, as the Index's own
       "Go to" links (palefire_search's SearchSources more_url). Each opens the
       service's start; utility-panels.js swaps in its search for the field's
       words once there are some (@q). Addresses in one place for the move to
       Alma. #}
    {%
      set panel_elsewhere = [
        { label: 'Go to Discovery'|t, url: 'https://libezp.lib.lsu.edu/login?url=https://search.ebscohost.com/login.aspx?direct=true&site=eds-live&scope=site', search: 'https://libezp.lib.lsu.edu/login?url=https://search.ebscohost.com/login.aspx?direct=true&site=eds-live&scope=site&type=0&mode=and&lang=en&bquery=@q' },
        { label: 'Go to the Catalog'|t, url: 'https://catalog.lib.lsu.edu', search: 'https://lsu.ent.sirsi.net/client/en_US/lsu/search/results?qu=@q&rt=Keyword&qf=ALL' },
      ]
    %}
    <div class="pf-panel__footer pf-panel__elsewhere">
      {% for link in panel_elsewhere %}
        <a class="pf-panel__cta" href="{{ link.url }}" data-pf-panel-elsewhere="{{ link.search }}" data-pf-panel-home="{{ link.url }}">
          <span>{{ link.label }}<span class="visually-hidden"> {{ '(another site)'|t }}</span></span>{{ ext_icon }}
        </a>
      {% endfor %}
    </div>
  </div>

  {# Hours -------------------------------------------------------------- #}
  <div class="offcanvas offcanvas-start pf-panel pf-panel--hours" id="pf-panel-hours" tabindex="-1"
       aria-labelledby="pf-panel-hours-title" data-pf-panel="hours">
    <div class="pf-panel__header">
      {{ back_button }}
      <h2 class="pf-panel__title" id="pf-panel-hours-title">{{ 'Hours'|t }}</h2>
      <button type="button" class="pf-panel__close" data-bs-dismiss="offcanvas">
        {{ close_icon }}<span class="visually-hidden">{{ 'Close hours'|t }}</span>
      </button>
    </div>
    <div class="pf-panel__body pf-hours" data-pf-hours-panel>
      {# Filled in by utility-panels.js (the page may be cached, so the
         server's date would go stale). #}
      <p class="pf-hours__date" data-pf-clock-date></p>
      <p class="pf-hours__clock"><time data-pf-clock></time></p>
      <ul class="pf-hours__list">
        {% for loc in hours_locations %}
          <li class="pf-hours__loc is-loading" data-pf-hours-loc data-lid="{{ loc.lid }}">
            <span class="pf-hours__badge" data-pf-hours-badge></span>
            <span class="pf-hours__text">
              <span class="pf-hours__when" data-pf-hours-when>{{ 'Loading hours…'|t }}</span>
              <span class="pf-hours__name" data-pf-hours-name{% if loc.name %} data-fixed{% endif %}>{{ loc.name }}</span>
            </span>
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="pf-panel__footer">
      {# href: the Hours menu link's URL, copied from the icon on open. #}
      <a class="pf-panel__cta" href="https://lsu.libcal.com/hours" data-pf-panel-href>
        <span>{{ 'See full hours'|t }}</span>{{ ext_icon }}
      </a>
    </div>
  </div>

  {# Ask Us ------------------------------------------------------------- #}
  <div class="offcanvas offcanvas-start pf-panel pf-panel--ask" id="pf-panel-ask" tabindex="-1"
       aria-labelledby="pf-panel-ask-title" data-pf-panel="ask">
    <div class="pf-panel__header">
      {{ back_button }}
      <h2 class="pf-panel__title" id="pf-panel-ask-title">{{ 'Ask Us'|t }}</h2>
      <button type="button" class="pf-panel__close" data-bs-dismiss="offcanvas">
        {{ close_icon }}<span class="visually-hidden">{{ 'Close Ask Us'|t }}</span>
      </button>
    </div>
    <div class="pf-panel__body pf-ask">
      <div class="pf-ask__tabs" role="tablist" aria-label="{{ 'Ways to ask'|t }}">
        {% for tab in ask_tabs %}
          <button type="button" class="pf-ask__tab{{ loop.first ? ' active' }}" role="tab"
                  id="pf-ask-tab-{{ tab.key }}" data-bs-toggle="tab" data-bs-target="#pf-ask-pane-{{ tab.key }}"
                  aria-controls="pf-ask-pane-{{ tab.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"
                  {% if not loop.first %}tabindex="-1"{% endif %}>
            <span class="pf-ask__tab-text">{{ tab.label }}</span>
            <span class="pf-icon" aria-hidden="true">{{ source(directory ~ '/images/bi/' ~ tab.icon ~ '.svg', ignore_missing = true)|raw }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="pf-ask__panes">
        {% for tab in ask_tabs %}
          <div class="pf-ask__pane tab-pane{{ loop.first ? ' active' }}" id="pf-ask-pane-{{ tab.key }}" role="tabpanel"
               aria-labelledby="pf-ask-tab-{{ tab.key }}" tabindex="0">
            {# src is set by utility-panels.js the first time this tab shows. #}
            <iframe class="pf-ask__frame" title="{{ tab.title }}" data-src="{{ tab.src }}" loading="lazy"></iframe>
            <noscript><a href="{{ tab.src }}">{{ tab.title }}</a></noscript>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="pf-panel__footer">
      <a class="pf-panel__cta" href="https://askus.lib.lsu.edu/">
        <span>{{ 'AskUs homepage'|t }}</span>{{ ext_icon }}
      </a>
    </div>
  </div>

  {# Accounts ----------------------------------------------------------- #}
  <div class="offcanvas offcanvas-start pf-panel pf-panel--accounts" id="pf-panel-accounts" tabindex="-1"
       aria-labelledby="pf-panel-accounts-title" data-pf-panel="accounts">
    <div class="pf-panel__header">
      {{ back_button }}
      <h2 class="pf-panel__title" id="pf-panel-accounts-title">{{ 'Accounts'|t }}</h2>
      <button type="button" class="pf-panel__close" data-bs-dismiss="offcanvas">
        {{ close_icon }}<span class="visually-hidden">{{ 'Close accounts'|t }}</span>
      </button>
    </div>
    <div class="pf-panel__body pf-accounts">
      <ul class="pf-accounts__list">
        {% for account in accounts %}
          <li>
            <a class="pf-accounts__link" href="{{ account.url }}">
              <span class="pf-accounts__text">{{ account.label }}</span>
              <span class="pf-icon pf-accounts__icon" aria-hidden="true">{{ source(directory ~ '/images/bi/' ~ account.icon ~ '.svg', ignore_missing = true)|raw }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="pf-panel__footer">
      <a class="pf-panel__cta" href="/accounts">
        <span>{{ 'Account descriptions'|t }}</span>{{ ext_icon }}
      </a>
    </div>
  </div>

  {# Settings ----------------------------------------------------------- #}
  <div class="offcanvas offcanvas-start pf-panel pf-panel--settings" id="pf-panel-settings" tabindex="-1"
       aria-labelledby="pf-panel-settings-title" data-pf-panel="settings">
    <div class="pf-panel__header">
      {{ back_button }}
      <h2 class="pf-panel__title" id="pf-panel-settings-title">{{ 'Settings'|t }}</h2>
      <button type="button" class="pf-panel__close" data-bs-dismiss="offcanvas">
        {{ close_icon }}<span class="visually-hidden">{{ 'Close settings'|t }}</span>
      </button>
    </div>
    <form class="pf-panel__body pf-settings" data-pf-settings aria-labelledby="pf-panel-settings-title">
      {# Text size: a segmented control, its A growing across the four. #}
      <fieldset class="pf-settings__group">
        <legend class="pf-settings__legend">{{ 'Text size'|t }}</legend>
        <div class="pf-settings__sizes">
          {% for size in ['100', '115', '130', '150'] %}
            <input class="pf-settings__size-input visually-hidden" type="radio" name="size" id="pf-set-size-{{ size }}" value="{{ size }}"{{ loop.first ? ' checked' }}>
            <label class="pf-settings__size" for="pf-set-size-{{ size }}" data-size="{{ size }}"><span class="pf-settings__size-a" aria-hidden="true">A</span>{{ size }}%</label>
          {% endfor %}
        </div>
      </fieldset>

      {# Colors: one row each, as the Search drawer's modes. The input is
         named by the row's name and described by its note. #}
      <fieldset class="pf-settings__group">
        <legend class="pf-settings__legend">{{ 'Colors'|t }}</legend>
        <p class="pf-settings__themes-help" id="pf-set-theme-help">{{ 'Page and text colors for the whole site, including the header, menus and these drawers.'|t }}</p>
        <div class="pf-settings__themes" id="pf-set-themes" data-pf-themes>
          {% for theme in reading_themes %}
            {% if theme.group is defined %}
              <p class="pf-settings__theme-group">{{ theme.group }}</p>
            {% endif %}
            <input class="pf-settings__theme-input visually-hidden{{ loop.index > 3 ? ' is-more' }}" type="radio" name="theme" id="pf-set-theme-{{ theme.key }}" value="{{ theme.key }}"{{ loop.first ? ' checked' }} aria-labelledby="pf-set-theme-{{ theme.key }}-name" aria-describedby="pf-set-theme-{{ theme.key }}-note pf-set-theme-help">
            <label class="pf-settings__theme" for="pf-set-theme-{{ theme.key }}" data-theme="{{ theme.key }}">
              <span class="pf-settings__theme-chip" aria-hidden="true">Aa</span>
              <span class="pf-settings__theme-text">
                <span class="pf-settings__theme-name" id="pf-set-theme-{{ theme.key }}-name">{{ theme.label }}</span>
                <span class="pf-settings__theme-note" id="pf-set-theme-{{ theme.key }}-note">{{ theme.note }}</span>
              </span>
              <span class="pf-settings__theme-mark" aria-hidden="true"></span>
            </label>
          {% endfor %}
        </div>
        {# Shown by utility-panels.js; without JS every color shows. #}
        <button type="button" class="pf-settings__more" aria-controls="pf-set-themes" aria-expanded="false" data-pf-themes-more hidden>
          <span data-pf-themes-more-label>{{ 'Show @count more colors'|t({'@count': reading_themes|length - 3}) }}</span>
        </button>
      </fieldset>

      {% for group in settings_groups %}
        <fieldset class="pf-settings__group">
          <legend class="pf-settings__legend">{{ group.label }}</legend>
          {% for item in group.items %}
            <div class="pf-settings__item">
              <input class="pf-settings__switch" type="checkbox" role="switch" name="{{ item.key }}" id="pf-set-{{ item.key }}" aria-describedby="pf-set-{{ item.key }}-help">
              <label class="pf-settings__label" for="pf-set-{{ item.key }}">{{ item.label }}</label>
              <p class="pf-settings__help" id="pf-set-{{ item.key }}-help">{{ item.help }}</p>
            </div>
          {% endfor %}
        </fieldset>
      {% endfor %}
    </form>
    {# Pinned under the form, like the menu's quick links. "Saved on this
       device." takes the note's place for a moment after each change. #}
    <div class="pf-panel__footer pf-settings__foot">
      <div class="pf-settings__saved">
        <p class="pf-settings__status" role="status" data-pf-settings-status></p>
        <p class="pf-settings__note">{{ 'Changes apply right away and are saved in this browser.'|t }}</p>
      </div>
      <button type="button" class="pf-panel__cta pf-settings__reset" data-pf-settings-reset>
        <span>{{ 'Reset to default'|t }}</span>
        <svg class="pf-panel__cta-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 8a5.5 5.5 0 1 0 1.7-3.97M2.5 2.5v2.5H5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

</div>
