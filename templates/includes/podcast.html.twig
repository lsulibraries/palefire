{#
/**
 * @file
 * What Endures, the Oral History podcast: every episode in one numbered
 * table, newest first, under the section's head (the name, its Lede and the
 * cassette mark, field--node--field-scroll-section--modular-page.html.twig).
 * Episodes from Drupal\palefire\PodcastFeed, nightly from SoundCloud's
 * podcast feed. Shown after a guide text whose paragraph is "[podcast]".
 *
 * Every episode the pull kept, three to a page (js/podcast.js PER_PAGE), so the list
 * keeps one height and the head that tells the episode pointed at stays in
 * view beside it. Under the list, two joined arrows page through it, newer
 * and older, with the page's number. Without the script every episode
 * shows and the arrows stay hidden.
 *
 * Each row: its number (counted from the first episode, so the newest has
 * the highest; the feed's own episode numbers repeat and skip), the title (a link to the episode's SoundCloud page,
 * for its comments and sharing; the newest in gold, marked Latest), the
 * date, the length, and a round Play. Each row carries its episode's photo
 * and length (seconds) for js/podcast.js: pointed at, focused or playing,
 * the section's backdrop takes the photo, the cassette's tape the length,
 * the line under the cassette the photo's credit, and the head (in place of
 * the Lede) the episode's number and date, its first paragraph and its
 * credits. The contact and copyright lines every episode repeats are left
 * out (PodcastFeed::parts()).
 * From 44rem of width the date and length are columns of their own;
 * narrower they sit under the title.
 *
 * Under the list, Listen on SoundCloud: the account, as a button.
 *
 * Play opens the episode in the docked listening bar, the exhibitions' own
 * player (js/podcast.js); nothing loads from SoundCloud until then. Without
 * a pull yet: a link to the account only (with episodes, the section's own
 * "All episodes" link in its rule goes there).
 *
 * Available variables:
 * - latest: the newest episode (title, number, kicker, month, time,
 *   duration, mp3, cover, link, summary, body, credits, photo), or absent
 *   before the first pull.
 * - more: the next episodes, the same keys.
 * - profile: the SoundCloud account's address.
 */
#}
{% macro play(episode, label) %}
  <button type="button" class="pf-podcast__play" data-pf-podcast-src="{{ episode.mp3 }}" data-pf-podcast-title="{{ episode.title }}" data-pf-podcast-kicker="{{ episode.kicker }}">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path class="pf-podcast__icon-play" d="M5 3.2v9.6L12.6 8z"/><path class="pf-podcast__icon-pause" d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z"/></svg>
    {%- if label -%}
      <span class="pf-podcast__play-text" aria-hidden="true">{{ 'Play'|t }} · {{ episode.time }}</span>
    {%- endif -%}
    <span class="visually-hidden" data-pf-podcast-state>{{ 'Play @title'|t({ '@title': episode.title }) }}</span>
  </button>
{% endmacro %}
{% import _self as podcast %}
{{ attach_library('palefire/podcast') }}
<div class="pf-podcast" id="podcast">
  {% if latest %}
    {% set episodes = [latest]|merge(more ?: []) %}
    <div class="pf-podcast__episodes" id="pf-podcast-episodes">
    <ol class="pf-podcast__list" reversed aria-label="{{ 'Episodes, newest first'|t }}">
      {% for episode in episodes %}
        {% set num = '%02d'|format(loop.length - loop.index0) %}
        <li class="pf-podcast__row{{ loop.first ? ' pf-podcast__row--latest' }}" data-pf-podcast-photo="{{ episode.cover }}" data-pf-podcast-length="{{ episode.length }}" data-pf-podcast-kicker="{{ num }} · {{ episode.month ?: episode.kicker }}" data-pf-podcast-about="{{ episode.body|first ?: episode.summary }}" data-pf-podcast-credits="{{ episode.credits }}" data-pf-podcast-credit="{{ episode.photo }}">
          <span class="pf-podcast__num" aria-hidden="true">{{ num }}</span>
          <div class="pf-podcast__row-text">
            <a class="pf-podcast__row-title" href="{{ episode.link }}" target="_blank" rel="noopener">
              {%- if loop.first -%}<span class="visually-hidden">{{ 'Latest episode:'|t }} </span>{%- endif -%}
              {{- episode.title -}}
              {%- if loop.first %} <span class="pf-podcast__new" aria-hidden="true">{{ 'Latest'|t }}</span>{% endif -%}
              <span class="visually-hidden"> {{ '(on SoundCloud, opens in a new tab)'|t }}</span>
            </a>
            <span class="pf-podcast__row-meta">
              <span class="pf-podcast__date">{{ episode.month ?: episode.kicker }}</span><span class="pf-podcast__sep" aria-hidden="true"> · </span><time class="pf-podcast__time" datetime="{{ episode.duration }}">{{ episode.time }}</time>
            </span>
          </div>
          {{ podcast.play(episode, false) }}
        </li>
      {% endfor %}
    </ol>
    </div>
    <div class="pf-podcast__foot">
    {% if episodes|length > 3 %}
      <div class="pf-podcast__pager" role="group" aria-label="{{ 'Episode pages'|t }}" data-pf-podcast-pager hidden>
        <button type="button" class="pf-podcast__page" data-pf-podcast-page="-1" aria-controls="pf-podcast-episodes">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M21 12H3.5M10 5.5 3.5 12l6.5 6.5"/></svg>
          <span class="visually-hidden">{{ 'Newer episodes'|t }}</span>
        </button>
        <button type="button" class="pf-podcast__page" data-pf-podcast-page="1" aria-controls="pf-podcast-episodes">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M3 12h17.5M14 5.5l6.5 6.5-6.5 6.5"/></svg>
          <span class="visually-hidden">{{ 'Older episodes'|t }}</span>
        </button>
        <p class="pf-podcast__count" aria-live="polite"><span class="visually-hidden" data-pf-podcast-said></span><span aria-hidden="true"><span data-pf-podcast-n>01</span> / {{ '%02d'|format((episodes|length / 3)|round(0, 'ceil')) }}</span></p>
      </div>
    {% endif %}
    <p class="pf-podcast__listen">
      <a class="pf-button pf-button--secondary pf-button--arrow" href="{{ profile }}" target="_blank" rel="noopener">{{ 'Listen on SoundCloud'|t }}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span></a>
    </p>
    </div>
  {% else %}
    <p class="pf-podcast__all">
      <a href="{{ profile }}" target="_blank" rel="noopener">{{ 'Every episode on SoundCloud'|t }} <span aria-hidden="true">&#8599;</span><span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span></a>
    </p>
  {% endif %}
</div>
