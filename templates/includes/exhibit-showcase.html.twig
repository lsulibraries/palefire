{#
/**
 * @file
 * Exhibitions showcase: every exhibition, on a Modular page whose Type is
 * "showcase" (printed by page.html.twig under the head).
 *
 * Two parts, one list (PalefireHooks::showcase()):
 * - A depth carousel: the covers stand in a row going back into the page,
 *   the nearest one is the exhibition shown, and its summary sits beside
 *   it. Next sends the front cover off and up to the back of the row, so
 *   the row only ever moves one way (js/exhibit-showcase.js). Without
 *   script it is a still: the first exhibition, its summary and link.
 *   Browsing: the square Previous / Next buttons (the events carousel's),
 *   with the next title beside them, the dots, a click on a cover behind.
 * - A table of all of them: year, exhibition, summary, kind.
 *
 * Each part is a band with an index rule (01, 02: the landing's
 * .pf-index-rule) and an id the TOC links to (Browse, All exhibitions:
 * PalefireHooks::preprocessPalefireModularToc()). The second band takes
 * the swatch's surface color, as on the Special Collections landing, and
 * the page's own sections alternate on from there. The breadcrumb is in
 * the landing's glass bar (page.html.twig, .pf-showcase-head).
 *
 * In Palefire's exhibition type: mono labels, the exhibition buttons
 * (.pf-exhibit-button, _exhibition.scss), and each title in its own face
 * (the Exhibition title style field: serif or sans).
 *
 * Online exhibitions and physical ones (their blog posts) share the list.
 * A post reads "Read about it" and shows where and when; an online
 * exhibition with a physical show has its post as a second link.
 *
 * The carousel holds the digital exhibitions only (digital: the
 * exhibition-mode pages); the table lists everything.
 *
 * Featured items (field_exhibit_showcase, or on view today) come first,
 * so the carousel opens on a featured digital one, with a "Featured"
 * label and the reason (field_exhibit_feature_note, or "On view in …
 * through …") in its summary and its table row.
 *
 * Covers are decorative (the titles are in the text). Arrows are drawn
 * inline: Font Awesome's font isn't loaded on these pages. No autoplay.
 *
 * Variables: showcase: items (title, url, cta, digital, subtitle, kicker, year,
 * blurb, when, post (url, when) or NULL, featured, note, unpublished,
 * title_style, cover), featured (count), cache.
 */
#}
{% macro cover(image, sizes, eager) %}
  {% if image %}
    <img src="{{ image.src }}"
         {% if image.srcset %}srcset="{{ image.srcset }}" sizes="{{ sizes }}"{% endif %}
         {% if image.width %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}
         {% if image.focus %}style="object-position: {{ image.focus }}"{% endif %}
         alt="" loading="{{ eager ? 'eager' : 'lazy' }}"{% if eager %} fetchpriority="high"{% endif %} decoding="async">
  {% endif %}
{% endmacro %}
{% macro arrow(direction) %}
  {% if direction == 'left' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M21 12H3.5M10 5.5 3.5 12l6.5 6.5"/></svg>
  {% else %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M3 12h17.5M14 5.5l6.5 6.5-6.5 6.5"/></svg>
  {% endif %}
{% endmacro %}
{% macro feature(ex, class) %}
  {% if ex.featured %}
    <p class="{{ class }}">
      <span class="pf-showcase__badge">{{ 'Featured'|t }}</span>
      {% if ex.note %}<span class="pf-showcase__note">{{ ex.note }}</span>{% endif %}
    </p>
  {% endif %}
{% endmacro %}
{% import _self as pf %}
{% set items = showcase.items %}
{% set count = items|length %}
{# The carousel: the digital exhibitions only (the table lists all). #}
{% set digital = items|filter(ex => ex.digital) %}
{% set shown = digital|length %}
{% if items %}
  {{ attach_library('palefire/exhibit-showcase') }}
  <div class="pf-showcase" data-pf-showcase>
    {% if digital %}
    <section class="pf-showcase__carousel" id="pf-showcase-browse" aria-roledescription="{{ 'carousel'|t }}" aria-label="{{ 'Digital exhibitions'|t }}" data-pf-showcase-carousel>
      <div class="pf-index-rule pf-showcase__rule">
        <span class="pf-index-rule__num" aria-hidden="true">01</span>
        <span class="pf-index-rule__label" aria-hidden="true">{{ 'Digital exhibitions'|t }}</span>
        <a class="pf-index-rule__link" href="#pf-showcase-all">{{ 'All @count'|t({'@count': count}) }}<span class="visually-hidden"> {{ 'exhibitions'|t }}</span></a>
      </div>
      <div class="pf-showcase__stage">
        <div class="pf-showcase__scene" aria-hidden="true" data-pf-showcase-scene>
          {% for ex in digital %}
            <div class="pf-showcase__card{{ loop.first ? ' is-active' }}{{ ex.cover ? '' : ' is-blank' }}" style="--pf-d: {{ loop.index0 }}" data-pf-showcase-card data-url="{{ ex.url }}">
              {{ pf.cover(ex.cover, '(min-width: 62rem) 24rem, 62vw', loop.first) }}
              {% if ex.featured %}<span class="pf-showcase__badge pf-showcase__ribbon">{{ 'Featured'|t }}</span>{% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="pf-showcase__panel">
        {# All in one grid cell, as tall as the longest; only the shown one
           is visible (and read). #}
        <div class="pf-showcase__summaries">
          {% for ex in digital %}
            <div class="pf-showcase__summary{{ loop.first ? ' is-active' }}" data-pf-showcase-summary data-title="{{ ex.title }}">
              {{ pf.feature(ex, 'pf-showcase__feature') }}
              <p class="pf-showcase__kicker">
                {{ ex.kicker }}{% if ex.year %} · {{ ex.year }}{% endif %}{% if ex.unpublished %} · <span class="pf-showcase__draft">{{ 'Unpublished'|t }}</span>{% endif %}
              </p>
              <h2 class="pf-showcase__title pf-showcase__title--{{ ex.title_style }}{{ ex.title|length > 50 ? ' pf-showcase__title--long' }}">{{ ex.title }}</h2>
              {% if ex.subtitle %}<p class="pf-showcase__subtitle">{{ ex.subtitle }}</p>{% endif %}
              {% if ex.when %}<p class="pf-showcase__when">{{ ex.when }}</p>{% endif %}
              {% if ex.blurb %}<p class="pf-showcase__blurb">{{ ex.blurb }}</p>{% endif %}
              <div class="pf-showcase__actions">
                <a class="pf-exhibit-button pf-exhibit-button--primary" href="{{ ex.url }}">
                  {{ ex.cta }}<span class="visually-hidden">: {{ ex.title }}</span>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/></svg>
                </a>
                {% if ex.post %}
                  <a class="pf-exhibit-button" href="{{ ex.post.url }}">
                    {{ 'The physical exhibition'|t }}<span class="visually-hidden">: {{ ex.title }}</span>
                  </a>
                {% endif %}
              </div>
              {% if ex.post and ex.post.when %}<p class="pf-showcase__when">{{ 'In the building: @when'|t({'@when': ex.post.when}) }}</p>{% endif %}
            </div>
          {% endfor %}
        </div>

        {% if shown > 1 %}
          {# Hidden (visibility) until the script is ready, so it holds its
             place and nothing moves when it appears. #}
          <div class="pf-showcase__controls" data-pf-showcase-controls>
            <div class="pf-showcase__browse">
              <button type="button" class="pf-showcase__arrow" data-pf-showcase-prev>
                {{ pf.arrow('left') }}
                <span class="visually-hidden">{{ 'Previous exhibition'|t }}</span>
              </button>
              <button type="button" class="pf-showcase__arrow" data-pf-showcase-next>
                {{ pf.arrow('right') }}
                <span class="visually-hidden">{{ 'Next exhibition'|t }}</span>
              </button>
              <p class="pf-showcase__upnext" aria-hidden="true">
                <span class="pf-showcase__upnext-label">{{ 'Next'|t }}</span>
                <span class="pf-showcase__upnext-title" data-pf-showcase-upnext>{{ digital[1].title }}</span>
              </p>
            </div>
            <div class="pf-showcase__progress">
              <p class="pf-showcase__count" aria-hidden="true"><span data-pf-showcase-n>01</span> / {{ '%02d'|format(shown) }}</p>
              <ol class="pf-showcase__dots">
                {% for ex in digital %}
                  <li><button type="button" class="pf-showcase__dot" data-pf-showcase-go="{{ loop.index0 }}"{% if loop.first %} aria-current="true"{% endif %}>
                    <span class="visually-hidden">{{ 'Show @title'|t({'@title': ex.title}) }}</span>
                  </button></li>
                {% endfor %}
              </ol>
            </div>
          </div>
          <p class="visually-hidden" aria-live="polite" data-pf-showcase-live></p>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <section class="pf-showcase-list" id="pf-showcase-all" aria-labelledby="pf-showcase-all-title">
      <div class="pf-index-rule pf-showcase__rule">
        <span class="pf-index-rule__num" aria-hidden="true">{{ digital ? '02' : '01' }}</span>
        <span class="pf-index-rule__label" aria-hidden="true">{{ 'Index'|t }}</span>
      </div>
      <h2 class="pf-showcase-list__heading" id="pf-showcase-all-title">{{ 'All exhibitions'|t }}</h2>
      <table class="pf-showcase-list__table" aria-labelledby="pf-showcase-all-title">
        <thead>
          <tr>
            <th scope="col" class="pf-showcase-list__year">{{ 'Year'|t }}</th>
            <th scope="col">{{ 'Exhibition'|t }}</th>
            <th scope="col">{{ 'Summary'|t }}</th>
            <th scope="col" class="pf-showcase-list__kind">{{ 'Kind'|t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for ex in items %}
            <tr class="pf-showcase-list__row{{ ex.featured ? ' is-featured' }}">
              <td class="pf-showcase-list__year">{{ ex.year }}</td>
              <th scope="row" class="pf-showcase-list__name">
                <a class="pf-showcase-list__link" href="{{ ex.url }}">{{ ex.title }}</a>
                {% if ex.post %}
                  <p class="pf-showcase-list__post">
                    <a href="{{ ex.post.url }}">{{ 'The physical exhibition'|t }}<span class="visually-hidden">: {{ ex.title }}</span></a>
                    {% if ex.post.when %}<span class="pf-showcase-list__when">{{ ex.post.when }}</span>{% endif %}
                  </p>
                {% endif %}
                {{ pf.feature(ex, 'pf-showcase-list__feature') }}
              </th>
              <td class="pf-showcase-list__summary">
                {% if ex.subtitle %}<p class="pf-showcase-list__subtitle">{{ ex.subtitle }}</p>{% endif %}
                {% if ex.when %}<p class="pf-showcase-list__when">{{ ex.when }}</p>{% endif %}
                {% if ex.blurb %}<p class="pf-showcase-list__blurb">{{ ex.blurb }}</p>{% endif %}
              </td>
              <td class="pf-showcase-list__kind">{{ ex.kicker }}{% if ex.unpublished %}<br>{{ 'Unpublished'|t }}{% endif %}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  </div>
{% endif %}
{{ showcase.cache }}
