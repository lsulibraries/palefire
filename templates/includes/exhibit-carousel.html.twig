{#
/**
 * @file
 * The exhibitions band: digital exhibitions as gallery-wrapped canvases on
 * a rail, the shown one's summary beside them, its picture faded behind
 * the whole band. Shared by the Exhibitions page
 * (includes/exhibit-showcase.html.twig) and a tile showcase of online
 * exhibitions (paragraph--tile-showcase.html.twig: Oral History's
 * Showcase, Off the Walls, Online on Special Collections').
 *
 * - The rail scrolls sideways (swipe and trackpad natively; a mouse grabs
 *   and flings it, js/drag-glide.js) and snaps to each canvas. The canvas
 *   at its start is the one shown. Each canvas has depth: its two edges
 *   carry the picture's own edge, mirrored, as a printer wraps a canvas
 *   round its stretcher, and the rail is seen from one point, so the
 *   canvases to the side show an edge (_exhibit-showcase.scss). Every
 *   canvas is 3:4, its picture cropped about its focus point.
 * - The footnote: under the canvas, the shown cover's object label
 *   (includes/object-label.html.twig, compact), where the exhibition's
 *   Cover label fields have a title.
 * - The plate: the shown exhibition's picture (its 640px version) behind
 *   the band, faded under the band's color, crossfading as it changes.
 * - The summary, as a wall label: a line over the title (Featured and its
 *   note, a kicker that isn't plain "Exhibition", Unpublished), the title,
 *   subtitle, the start of the intro (else the credit line), then the
 *   facts at its foot, a mono label over one value in each of four slots
 *   every exhibition keeps ("—" where it has none, no notes under any):
 *   Year; Clips; Listening (the clips' total:
 *   PalefireHooks::exhibitionClips()), or, for an exhibition without
 *   clips, Images; Est. reading (PalefireHooks::exhibitionReading());
 *   Press ("Read the release", a link to the post about its show in the
 *   building: PalefireHooks::physicalShow()). Then Enter, alone, on the line of the
 *   arrows. Wide, the facts sit on the canvas's foot and Enter on the
 *   arrows' line whichever summary is shown (a subgrid,
 *   _exhibit-showcase.scss), so nothing jumps as it changes.
 * - Browsing: the square Previous / Next (the non-drag way, WCAG 2.5.7),
 *   the next title beside them, the count and a progress line, ← → while
 *   focus is in the band, a click on a canvas (the shown one opens its
 *   exhibition). The changes are announced politely. Nothing moves by
 *   itself.
 *
 * The canvases, plate and progress line are decorative (aria-hidden; the
 * titles are in the text) and the rail is not a tab stop. Without script
 * the rail still scrolls and the first summary shows. Arrows are drawn
 * inline: Font Awesome's font isn't loaded on these pages.
 *
 * Variables:
 * - items: PalefireHooks::exhibitionCard() arrays (showcase() adds post,
 *   featured and note; exhibitEnd() adds top to the exhibition just read,
 *   whose button goes up to its start, an up arrow).
 * - id: the band's id (the TOC's target on the Exhibitions page).
 * - label: the carousel's accessible name.
 * - heading: 'h2' (default) or 'h3' under a section's own heading.
 * - rule: optional index rule: num, label, href, link (its text), more
 *   (said after the link's text to screen readers).
 */
#}
{% macro arrow(direction) %}
  {% if direction == 'left' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M21 12H3.5M10 5.5 3.5 12l6.5 6.5"/></svg>
  {% else %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M3 12h17.5M14 5.5l6.5 6.5-6.5 6.5"/></svg>
  {% endif %}
{% endmacro %}
{# The picture: the front, and the same image again in each edge (same
   srcset and sizes, so one download). #}
{% macro picture(image, eager) %}
  <img src="{{ image.src }}"
       {% if image.srcset %}srcset="{{ image.srcset }}" sizes="(min-width: 62rem) 21rem, 62vw"{% endif %}
       {% if image.width %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}
       {% if image.focus %}style="object-position: {{ image.focus }}"{% endif %}
       alt="" loading="{{ eager ? 'eager' : 'lazy' }}"{% if eager %} fetchpriority="high"{% endif %} decoding="async" draggable="false">
{% endmacro %}
{# An empty fact: a dash, "None" to a screen reader. #}
{% macro none() %}
  <span class="pf-showcase__none" aria-hidden="true">—</span><span class="visually-hidden">{{ 'None'|t }}</span>
{% endmacro %}
{% import _self as pf %}
{% set heading = heading == 'h3' ? 'h3' : 'h2' %}
{% set shown = items|length %}
{% set captioned = items|filter(ex => ex.object)|length > 0 %}
{% if items %}
  {{ attach_library('palefire/exhibit-showcase') }}
  <section class="pf-showcase__carousel{{ captioned ? ' pf-showcase__carousel--captioned' }}" id="{{ id }}" aria-roledescription="{{ 'carousel'|t }}" aria-label="{{ label }}" data-pf-showcase-carousel>
    {# The plate: two layers that crossfade, given their pictures by
       js/exhibit-showcase.js once the band nears the screen (none without
       script: it is decorative). #}
    <div class="pf-showcase__plate" aria-hidden="true">
      <div class="pf-showcase__plate-img" data-pf-showcase-plate></div>
      <div class="pf-showcase__plate-img" data-pf-showcase-plate></div>
    </div>

    {% if rule %}
      <div class="pf-index-rule pf-showcase__rule">
        <span class="pf-index-rule__num" aria-hidden="true">{{ rule.num }}</span>
        <span class="pf-index-rule__label" aria-hidden="true">{{ rule.label }}</span>
        {% if rule.href %}
          <a class="pf-index-rule__link" href="{{ rule.href }}">{{ rule.link }}{% if rule.more %}<span class="visually-hidden"> {{ rule.more }}</span>{% endif %}</a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pf-showcase__stage{{ captioned ? ' pf-showcase__stage--captioned' }}">
      <div class="pf-showcase__rail" aria-hidden="true" tabindex="-1" data-pf-showcase-scene>
        {% for ex in items %}
          <div class="pf-showcase__card{{ loop.first ? ' is-active' }}{{ ex.cover ? '' : ' is-blank' }}" data-pf-showcase-card data-url="{{ ex.url }}"{% if ex.cover %} data-plate="{{ ex.cover.small }}"{% endif %}>
            {% if ex.cover %}
              <span class="pf-showcase__edge pf-showcase__edge--start">{{ pf.picture(ex.cover, false) }}</span>
              <span class="pf-showcase__face">{{ pf.picture(ex.cover, loop.first) }}</span>
              <span class="pf-showcase__edge pf-showcase__edge--end">{{ pf.picture(ex.cover, false) }}</span>
            {% else %}
              <span class="pf-showcase__face"></span>
            {% endif %}
            {% if ex.featured %}<span class="pf-showcase__badge pf-showcase__ribbon">{{ 'Featured'|t }}</span>{% endif %}
          </div>
        {% endfor %}
      </div>
      {# The footnote under the canvas: the shown cover's object label (a
         museum's caption: maker, title, date, its record), all in one
         cell so the band never changes height; only the shown one is
         visible (and read). #}
      {% if captioned %}
        <div class="pf-showcase__captions">
          {% for ex in items %}
            <div class="pf-showcase__caption{{ loop.first ? ' is-active' }}" data-pf-showcase-caption>
              {% if ex.object %}{% include '@palefire/includes/object-label.html.twig' with ex.object|merge({compact: true}) only %}{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pf-showcase__panel">
      {# All in one grid cell, as tall as the longest; only the shown one
         is visible (and read). #}
      <div class="pf-showcase__summaries">
        {% for ex in items %}
          {% set plain_kicker = ex.kicker == 'Exhibition'|t %}
          <div class="pf-showcase__summary{{ loop.first ? ' is-active' }}" data-pf-showcase-summary data-title="{{ ex.title }}">
            <div class="pf-showcase__label">
              {% if ex.featured or not plain_kicker or ex.unpublished %}
                <p class="pf-showcase__feature">
                  {% if ex.featured %}<span class="pf-showcase__badge">{{ 'Featured'|t }}</span>{% endif %}
                  {% if ex.featured and ex.note %}<span class="pf-showcase__note">{{ ex.note }}</span>{% endif %}
                  {% if not plain_kicker %}<span class="pf-showcase__kicker">{{ ex.kicker }}</span>{% endif %}
                  {% if ex.unpublished %}<span class="pf-showcase__draft">{{ 'Unpublished'|t }}</span>{% endif %}
                </p>
              {% endif %}
              <{{ heading }} class="pf-showcase__title pf-showcase__title--{{ ex.title_style }}{{ ex.title|length > 50 ? ' pf-showcase__title--long' }}">{{ ex.title }}</{{ heading }}>
              {% if ex.subtitle %}<p class="pf-showcase__subtitle">{{ ex.subtitle }}</p>{% endif %}
              {# As many whole lines as the label has room for (js). #}
              {% set lede = ex.lede|default(ex.blurb) %}
              {% if lede %}<p class="pf-showcase__blurb" data-pf-showcase-blurb>{{ lede }}</p>{% endif %}
              <dl class="pf-showcase__facts">
                <div class="pf-showcase__fact">
                  <dt>{{ 'Year'|t }}</dt>
                  <dd>{{ ex.year ?: pf.none() }}</dd>
                </div>
                {% if not ex.clips.count %}
                <div class="pf-showcase__fact">
                  <dt>{{ 'Images'|t }}</dt>
                  <dd>{{ ex.reading.images ?: pf.none() }}</dd>
                </div>
                <div class="pf-showcase__fact">
                  <dt><span aria-hidden="true">{{ 'Est. reading'|t }}</span><span class="visually-hidden">{{ 'Estimated reading time'|t }}</span></dt>
                  <dd>
                    {% if ex.reading.total %}
                      <time datetime="{{ ex.reading.total.iso }}">{{ ex.reading.total.text }}</time>
                    {% else %}
                      {{ pf.none() }}
                    {% endif %}
                  </dd>
                </div>
                {% else %}
                <div class="pf-showcase__fact">
                  <dt>{{ 'Clips'|t }}</dt>
                  <dd>{{ ex.clips.count ?: pf.none() }}</dd>
                </div>
                <div class="pf-showcase__fact">
                  <dt>{{ 'Listening'|t }}</dt>
                  <dd>
                    {% if ex.clips.total %}
                      <time datetime="{{ ex.clips.total.iso }}">{{ ex.clips.total.text }}</time>
                    {% else %}
                      {{ pf.none() }}
                    {% endif %}
                  </dd>
                </div>
                {% endif %}
                <div class="pf-showcase__fact pf-showcase__fact--place">
                  <dt>{{ 'Press'|t }}</dt>
                  <dd>
                    {% if ex.show.url %}
                      <span class="pf-showcase__fact-place">
                        <a href="{{ ex.show.url }}">{{ 'Read the release'|t }}<span class="visually-hidden">: {{ ex.title }}</span></a>
                      </span>
                    {% else %}
                      {{ pf.none() }}
                    {% endif %}
                  </dd>
                </div>
              </dl>
            </div>
            <div class="pf-showcase__actions">
              <a class="pf-exhibit-button pf-exhibit-button--primary{{ ex.top ? ' pf-exhibit-button--top' }}" href="{{ ex.url }}">
                {{ ex.cta }}<span class="visually-hidden">: {{ ex.title }}</span>
                {% if ex.top %}
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M8 13.5v-11M3.5 7 8 2.5 12.5 7"/></svg>
                {% else %}
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/></svg>
                {% endif %}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if shown > 1 %}
        {# Hidden (visibility) until the script is ready, so it holds its
           place and nothing moves when it appears. #}
        <div class="pf-showcase__controls" data-pf-showcase-controls>
          <div class="pf-showcase__browse">
            <button type="button" class="pf-showcase__arrow" data-pf-showcase-prev disabled>
              {{ pf.arrow('left') }}
              <span class="visually-hidden">{{ 'Previous exhibition'|t }}</span>
            </button>
            <button type="button" class="pf-showcase__arrow" data-pf-showcase-next>
              {{ pf.arrow('right') }}
              <span class="visually-hidden">{{ 'Next exhibition'|t }}</span>
            </button>
            <p class="pf-showcase__upnext" aria-hidden="true">
              <span class="pf-showcase__upnext-label">{{ 'Next'|t }}</span>
              <span class="pf-showcase__upnext-title" data-pf-showcase-upnext>{{ items[1].title }}</span>
            </p>
          </div>
          <div class="pf-showcase__progress" aria-hidden="true">
            <p class="pf-showcase__count"><span data-pf-showcase-n>01</span> / {{ '%02d'|format(shown) }}</p>
            <span class="pf-showcase__meter"><span class="pf-showcase__meter-fill" style="transform: scaleX({{ 1 / shown }})" data-pf-showcase-meter></span></span>
          </div>
        </div>
        <p class="visually-hidden" aria-live="polite" data-pf-showcase-live></p>
      {% endif %}
    </div>
  </section>
{% endif %}
