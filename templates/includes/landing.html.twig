{#
/**
 * @file
 * Landing section: the markup for both paragraph types that draw it,
 * paragraph--landing-hero.html.twig (hero) and the older Bento search
 * (paragraph--bento-search.html.twig, the bento_search type, retired).
 * A search form that sends the search to the library's Bento results page
 * (its real name, kept below), and an optional Hill Memorial building map
 * under it.
 *
 * The form is a plain GET form: submitting opens landing_action
 * (https://lib.lsu.edu/bento) with the words in landing.identifier
 * (search_api_fulltext_bento), the same query Origami's search box sends.
 * There are no results on this page and no JavaScript; the result tiles
 * that palefire_modular builds (landing.tiles) are not printed.
 *
 * Variables from palefire_modular_preprocess_paragraph__bento_search():
 * - landing.identifier, landing.input_id, landing.placeholder
 * - bg_videos: ordered list of MP4 URLs (optional)
 * - bg_poster: poster image URL (optional)
 * - landing_map: the building_map paragraph from field_bento_map, rendered
 *   by palefire_preprocess_paragraph__bento_search() (optional).
 * - landing_intro, visit: the host Modular page's intro and Visit card
 *   (field_intro, field_hours_location, field_location_*), from
 *   _palefire_landing_visit() (optional).
 *
 * - page_title: the Modular page's title, set by
 *   palefire_preprocess_paragraph__bento_search() only when this landing is
 *   the page's first section. It is printed as the page <h1>, right above
 *   the intro; page.html.twig then prints no <h1> of its own.
 *
 * Layout, top to bottom, one 1280px column: the lead panel (title, intro,
 * search) on frosted glass, the building map, then the Visit strip (hours
 * from LibCal via visit-hours.js, mini map that loads on click with the
 * Google Maps link under it, an Instagram placeholder under the name), as
 * wide as the map's legend and drawing together. With a lead and
 * a map, .pf-landing--lead-screen: from md up the lead fills the first
 * screen and the page snaps between it and the map (landing-snap.js).
 *
 * - map_only: the paragraph's "Hide search panel" box (field_bento_hide_lead)
 *   is checked and there is a map. No lead panel: the map leads the landing.
 *   The page <h1> stays, visually hidden, so the page keeps its heading.
 *
 * - hero: set for the Landing hero paragraph (paragraph--landing-hero),
 *   .pf-landing--hero. The lead holds the title, the intro, a "Search
 *   Special Collections" form (a placeholder: it searches Bento for now),
 *   two exhibition tiles, then Next event (hero-event.js, from the events
 *   carousel's feed) beside the latest blog post. No lead panel when it
 *   would be empty (no page title, no intro): the Next event card then
 *   stands alone.
 * - toc_home_id, toc_map_id: ids for the TOC's "Home" (the lead) and "Map"
 *   (the map) links, when this landing opens the page
 *   (PalefireHooks::heroTocIds()).
 *
 * "Search LSU Libraries" (not on the hero) and the map heading are h3s so
 * the TOC lists them.
 * While the map is in view, building-map.js adds .is-map-in-view here to
 * dim and blur the background video.
 */
#}
{% set landing_action = 'https://lib.lsu.edu/bento' %}
{% set landing_name = landing.identifier|default('search_api_fulltext_bento') %}
{% set input_id = landing.input_id|default('pf-landing-q') %}
{% set show_lead = not map_only and (not hero or page_title or landing_intro) %}
{# Next event (landing hero only), filled in by hero-event.js from the
   events carousel's feed; removed when the page has no carousel or no
   event. In the lead panel, or on its own glass when there is none. #}
{# Lead panel and map: the lead fills the first screen and the page snaps
   between the two (md and up, _landing-swiss.scss, landing-snap.js). #}
{% set lead_screen = show_lead and landing_map %}
{% if lead_screen %}
  {{ attach_library('palefire/landing-snap') }}
{% endif %}
{% if hero %}
  {{ attach_library('palefire/hero-event') }}
  {% set hero_event %}
    <div class="pf-hero-event{{ not show_lead ? ' pf-hero-event--solo' }}" data-pf-hero-event>
      <p class="pf-hero-event__label">{{ 'Next event'|t }}</p>
    </div>
  {% endset %}
{% endif %}
<div{{ attributes.addClass('pf-landing', hero ? 'pf-landing--hero', bg_videos ? 'has-bg-video', not show_lead and landing_map ? 'pf-landing--map-only', lead_screen ? 'pf-landing--lead-screen') }} data-pf-landing>

  {% if bg_videos %}
    {{ attach_library('palefire/landing-video') }}
    <div class="pf-landing__media" data-landing-video data-sources="{{ bg_videos|json_encode }}">
      <video class="pf-landing__bg-video" muted playsinline preload="metadata"
             aria-hidden="true" tabindex="-1"
             {% if bg_poster %}poster="{{ bg_poster }}"{% endif %}></video>
    </div>
    {# Same look as the TOC hide/show button: icon square + a gold bar that
       fills as the current clip plays; the label slides out on
       hover/focus and is always read by screen readers. landing-video.js
       swaps the label and data-state.
       It sits beside .pf-landing__media, not inside it: the media layer is
       position: fixed with negative insets, so a button inside it was
       placed against the viewport and pushed off the right edge by the
       section padding (_landing.scss). #}
    <button type="button" class="pf-landing__bg-toggle" data-landing-video-toggle data-state="playing">
      <span class="pf-landing__bg-toggle-progress" aria-hidden="true"></span>
      <svg class="pf-landing__bg-toggle-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <g class="pf-landing__bg-toggle-pause"><rect x="3.5" y="2.5" width="3.2" height="11" rx="1"/><rect x="9.3" y="2.5" width="3.2" height="11" rx="1"/></g>
        <path class="pf-landing__bg-toggle-play" d="M4.5 3.1v9.8c0 .8.9 1.3 1.6.9l7.6-4.9c.6-.4.6-1.3 0-1.7L6.1 2.2c-.7-.4-1.6.1-1.6.9z"/>
      </svg>
      <span class="pf-landing__bg-toggle-label" data-landing-video-label>{{ 'Pause background video'|t }}</span>
    </button>
  {% endif %}

  {% if not show_lead %}
    {% if page_title %}
      <h1 class="visually-hidden">{{ page_title }}</h1>
    {% endif %}
    {{ hero_event }}
  {% else %}
  {# Title, intro and search on one frosted panel (the Visit card's glass),
     so the text reads over the background video. On the hero
     (_landing-features.scss), top to bottom: title, intro (full width), a
     search form, the two exhibitions, then Next event | Latest blog post.
     The lead's id is the TOC's "Home" target (toc_home_id,
     PalefireHooks::heroTocIds()). #}
  {% if hero %}
    {# PLACEHOLDER: there is no Special Collections search target yet, so
       this sends the words to the libraries' Bento search like the old
       landing form. Change landing_action / landing_name here when there is. #}
    {% set search_label = 'Search Special Collections'|t %}
    {% set search_placeholder = 'Search manuscripts, rare books, photographs and more'|t %}
  {% else %}
    {% set search_label = 'Search LSU Libraries'|t %}
    {% set search_placeholder = landing.placeholder|default('Search books, articles, databases, guides and more'|t) %}
  {% endif %}
  <div class="pf-landing__lead"{% if toc_home_id %} id="{{ toc_home_id }}" tabindex="-1"{% endif %}>
    {% if page_title %}
      <h1 class="pf-modular__title pf-landing__title">{{ page_title }}</h1>
    {% endif %}
    {% if landing_intro %}
      <div class="pf-landing__intro">{{ landing_intro }}</div>
    {% endif %}
    <form class="pf-landing__form" role="search" method="get" action="{{ landing_action }}" aria-labelledby="{{ input_id }}-heading">
      <h3 class="pf-landing__heading" id="{{ input_id }}-heading"{% if not hero %} data-toc{% endif %}>
        <label class="pf-landing__label" for="{{ input_id }}">{{ search_label }}</label>
      </h3>
      <div class="pf-landing__field">
        <svg class="pf-landing__field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        <input class="pf-landing__input" type="search" id="{{ input_id }}" name="{{ landing_name }}"
               placeholder="{{ search_placeholder }}"
               autocomplete="off" enterkeyhint="search">
        <button class="pf-landing__submit" type="submit">
          <span class="pf-landing__submit-text">{{ 'Search'|t }}</span>
          <svg class="pf-landing__submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </form>
    {% if hero %}
      {# Features (_landing-features.scss): two exhibitions side by side,
         then Next event | Latest blog post, each with its label above.
         - hero_post: palefire_preprocess_paragraph__landing_hero(), the
           newest Article in the paragraph's "Blog category"; a placeholder
           until that field exists and is filled in.
         - exhibitions: PLACEHOLDERS until there is a source for them. Same
           shape a real source would give: label, title, start/end (ISO
           dates) and dates (shown), or permanent; images (urls, empty for
           now: hatched frames stand in). More than one image crossfades
           (exhibit-rotate.js), with a pause button. #}
      {% set exhibitions = [
        {
          label: 'Exhibition'|t,
          title: 'Exhibition title'|t,
          start: '2026-09-01',
          end: '2026-12-19',
          dates: 'Sep 1 – Dec 19, 2026',
          images: [],
          frames: 1,
        },
        {
          label: 'Permanent exhibition'|t,
          title: 'LSU History'|t,
          permanent: true,
          images: [],
          frames: 3,
        },
      ] %}
      <div class="pf-landing__features">
        <ul class="pf-exhibits" aria-label="{{ 'Exhibitions'|t }}">
          {% for ex in exhibitions %}
            {% set count = ex.images ? ex.images|length : ex.frames %}
            <li class="pf-exhibit{{ ex.permanent ? ' pf-exhibit--permanent' }}"{% if count > 1 %} data-pf-exhibit-rotate{% endif %}>
              <div class="pf-exhibit__media" aria-hidden="true">
                {% for i in 1..count %}
                  <span class="pf-exhibit__frame{{ loop.first ? ' is-current' }}">
                    {% if ex.images %}
                      <img src="{{ ex.images[loop.index0] }}" alt="" loading="lazy" decoding="async">
                    {% endif %}
                  </span>
                {% endfor %}
              </div>
              <div class="pf-exhibit__text">
                <p class="pf-exhibit__label">{{ ex.label }}</p>
                <p class="pf-exhibit__title">{{ ex.title }}</p>
                <p class="pf-exhibit__when">
                  {% if ex.permanent %}
                    {{ 'On view · Permanent'|t }}
                  {% else %}
                    <time datetime="{{ ex.start }}/{{ ex.end }}">{{ ex.dates }}</time>
                  {% endif %}
                </p>
              </div>
              {% if count > 1 %}
                {# Crossfade pause/play (WCAG 2.2.2), set up by exhibit-rotate.js. #}
                <button type="button" class="pf-exhibit__pause" data-pf-exhibit-pause hidden>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><g class="pf-exhibit__pause-icon"><rect x="4" y="3" width="2.6" height="10" rx=".8"/><rect x="9.4" y="3" width="2.6" height="10" rx=".8"/></g><path class="pf-exhibit__play-icon" d="M5 3.4v9.2c0 .7.8 1.1 1.4.7l6.7-4.6c.5-.4.5-1.1 0-1.5L6.4 2.7c-.6-.4-1.4 0-1.4.7z"/></svg>
                  <span class="visually-hidden" data-pf-exhibit-pause-label>{{ 'Pause slideshow'|t }}</span>
                </button>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
        {% if exhibitions|filter(ex => ex.images|length > 1 or ex.frames > 1) %}
          {{ attach_library('palefire/exhibit-rotate') }}
        {% endif %}

        <div class="pf-landing__pair">
          {{ hero_event }}
          <div class="pf-hero-post">
            <p class="pf-hero-event__label">{{ 'Latest from the blog'|t }}</p>
            {% if hero_post %}
              <a class="pf-hero-event__card" href="{{ hero_post.url }}">
                <span class="pf-hero-event__thumb">{{ hero_post.image }}</span>
                <span class="pf-hero-event__text">
                  <span class="pf-hero-event__when"><time datetime="{{ hero_post.datetime }}">{{ hero_post.date }}</time>{% if hero_post.category %} · {{ hero_post.category }}{% endif %}</span>
                  <span class="pf-hero-event__title">{{ hero_post.title }}</span>
                  {% if hero_post.excerpt %}<span class="pf-hero-event__meta pf-hero-post__excerpt">{{ hero_post.excerpt }}</span>{% endif %}
                </span>
              </a>
            {% else %}
              {# Placeholder until field_landing_blog_category is added and set. #}
              <div class="pf-hero-event__card is-placeholder">
                <span class="pf-hero-event__thumb"></span>
                <span class="pf-hero-event__text">
                  <span class="pf-hero-event__when">{{ 'Date · Category'|t }}</span>
                  <span class="pf-hero-event__title">{{ 'Blog post title'|t }}</span>
                  <span class="pf-hero-event__meta pf-hero-post__excerpt">{{ 'A line or two from the post’s About Text.'|t }}</span>
                </span>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
  {% endif %}

  {% if landing_map %}
    <div class="pf-landing__visit"{% if toc_map_id %} id="{{ toc_map_id }}" tabindex="-1"{% endif %}>{{ landing_map }}</div>
  {% endif %}

  {# Visit strip: under the map, as wide as legend + map. #}
  {% if visit %}
    {% set visit_id = input_id ~ '-visit' %}
    <aside class="pf-visit" aria-labelledby="{{ visit_id }}-heading">
      <h3 class="pf-visit__heading" id="{{ visit_id }}-heading">
        <span class="pf-visit__eyebrow">{{ 'Visit'|t }}</span>
        {% if visit.name %}<span class="pf-visit__name">{{ visit.name }}</span>{% endif %}
      </h3>

      {% if visit.lid %}
        <div class="pf-visit__hours" data-pf-hours data-lid="{{ visit.lid }}">
          <p class="pf-visit__status" aria-live="polite">
            <span class="pf-visit__dot" aria-hidden="true"></span>
            <span class="pf-visit__status-label" data-pf-hours-status>{{ 'Hours'|t }}</span>
            <span class="pf-visit__today" data-pf-hours-today></span>
          </p>
          <details class="pf-visit__week">
            <summary>{{ 'This week'|t }}</summary>
            <ol class="pf-visit__days" data-pf-hours-week></ol>
          </details>
          <a class="pf-visit__link pf-visit__all-hours" href="https://lsu.libcal.com/hours">{{ 'All library hours'|t }}</a>
        </div>
      {% endif %}

      {# Mini map with the Google Maps link under it, one column. #}
      {% if visit.embed_url or visit.maps_url %}
        <div class="pf-visit__place">
          {% if visit.embed_url %}
            <div class="pf-visit__map" data-pf-visit-map data-src="{{ visit.embed_url }}" data-title="{{ 'Map: @place'|t({'@place': visit.name ?: visit.query}) }}">
              <button type="button" class="pf-visit__map-load" data-pf-visit-map-load>
                <svg class="pf-visit__map-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/></svg>
                <span>{{ 'Show map'|t }}</span>
                <small>{{ 'Loads Google Maps'|t }}</small>
              </button>
            </div>
          {% endif %}
          {% if visit.maps_url %}
            <a class="pf-visit__link pf-visit__directions" href="{{ visit.maps_url }}" target="_blank" rel="noopener">
              {{ 'Open in Google Maps'|t }}<svg class="pf-visit__ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h7v7M13 3 4 12"/></svg><span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {# Instagram: a placeholder frame under the name until a post embed
         takes its place. Decorative for now, so screen readers skip it. The
         icon is Font Awesome Pro's, inlined from the site's copy like the
         building map's hint icon (no FA CSS or font). #}
      <div class="pf-visit__social" aria-hidden="true">
        <span class="pf-visit__social-icon">{{ source('libraries/fontawesome-pro/svgs/brands/instagram.svg', ignore_missing = true)|raw }}</span>
        <span class="pf-visit__social-label">{{ 'Instagram'|t }}</span>
      </div>
    </aside>
  {% endif %}
</div>
