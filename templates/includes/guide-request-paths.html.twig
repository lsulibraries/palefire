{#
/**
 * @file
 * Special Collections request paths: three "subway lines", one per way to
 * start (options A, B and C), each a row of stops (a column on narrow
 * blocks). Placed by a "[request-paths]" paragraph in a guide text block
 * (paragraph--guide-text.html.twig) and by the landing hero's Quick Guide.
 *
 * Each line is an ordered list named by its heading, so screen readers hear
 * "Option A: See it in person, list, 4 items"; C's last stop points back to
 * A and B by those letters. A hairline between the lines sets the options
 * apart (decorative). Each stop's disc holds a Font Awesome Pro duotone icon,
 * inlined from the site's copy like the hero account icon, and decorative:
 * the list's own numbering gives the order.
 *
 * A stop with `detail` has a "how" panel: its label is a button that opens a
 * popover with a sentence or two (or a list of paragraphs) and, when it has `shots`, screenshots of
 * the catalog and request system (images/guides/special-collections/). The
 * popover is native (popover / popovertarget), so it needs no script:
 * clicking or tapping the label, Enter or Space opens it; Esc, the close
 * button or a click outside closes it. Screenshots load only when opened.
 *
 * A panel with `cta` ("Find Item") ends its text with a full-width link
 * there (the catalog), in a new tab so the guide stays open behind it;
 * `newtab: false` keeps it in place (an email address).
 *
 * A screenshot with `mark` ({x, y, w, h}, percent of the image) has a gold
 * ring over the control to click, drawn in as the panel opens; its alt text
 * says what is outlined.
 *
 * A stop with `href` (C's "Reach out", A's "Read it at Hill": the Reading
 * Room page) is a link instead, styled as the panel buttons are.
 *
 * Available variables:
 * - uid: makes the heading ids unique on the page.
 * - ask_href: where "Reach out" goes. The Special Collections landing
 *   passes its question form (#ask-question, includes/ask-special.html.twig);
 *   guides, which have none, go to AskUs: Special Collections.
 * - img_base: URL of images/guides/special-collections/ with a trailing
 *   slash. Without it the panels show their text only.
 * - unit: optional; 'oral_history' draws Oral History's three ways instead
 *   (the landing hero's hero_unit); 'oral_history_record' the Williams
 *   Center's services, for the Record tab (.pf-paths--services).
 *
 * A stop's note is optional.
 */
#}
{% set find = {
  icon: 'search', label: 'Find Item'|t, note: 'In the catalog'|t,
  detail: 'Search the catalog, then open the item’s record. It lists the contents, the abstract, a link to the finding aid when there is one, and the format. Scroll down to the Holdings and Available tabs.'|t,
  shots: [
    { file: 'catalog-record.webp', width: 1250, height: 723, alt: 'A catalog record for the William Y. Dixon papers, with Holdings and Available tabs below it.'|t },
  ],
  cta: { href: 'https://catalog.lib.lsu.edu', label: 'Search the library catalog'|t },
} %}
{% set request = {
  icon: 'file-signature', label: 'Click Request Item'|t, note: 'Bottom right area'|t,
  detail: 'On the Available tab, choose Request Item at the end of the row you want. Then sign in: LSU students, faculty and staff use single sign-on, and everyone else signs in or registers as a Guest. You don’t need to be affiliated with LSU.'|t,
  shots: [
    { file: 'available-tab.webp', width: 1001, height: 329, mark: { x: 85, y: 46, w: 11.6, h: 39 }, alt: 'The Available tab: a table of copies, each with a Request Item link in the last column, outlined.'|t },
  ],
} %}
{% set paths = [
  {
    key: 'visit',
    letter: 'A',
    name: ['See it'|t, 'in person'|t],
    stops: [
      find,
      request,
      {
        icon: 'calendar-check', label: 'Book a visit'|t, note: 'Recommended'|t,
        detail: 'The request form fills in the item for you; add the box number from the finding aid. Choose an appointment, or New Appointment, then Submit Request to View In-Person. Appointments aren’t required, but with one your materials are waiting when you arrive.'|t,
        shots: [
          { file: 'book-visit.webp', width: 740, height: 350, alt: 'The end of the request form: Reading Room and Appointment menus, a New Appointment button, and Submit Request to View In-Person.'|t },
        ],
      },
      { icon: 'book-reader', label: 'Read it at Hill'|t, note: 'Staff bring it to you'|t, href: '/v2/special/readingroom' },
    ],
  },
  {
    key: 'copy',
    letter: 'B',
    name: ['Get a'|t, 'digital copy'|t],
    stops: [
      find,
      request,
      {
        icon: 'exchange', label: 'Switch to duplication'|t, note: 'Top right of the form'|t,
        detail: 'Choose Switch to Duplication Order Form at the top right of the request form. Then list what to copy under Selections To Be Reproduced, with box and folder numbers from the finding aid, and pick a format and delivery method.'|t,
        shots: [
          { file: 'duplication-switch.webp', width: 1110, height: 231, mark: { x: 74.2, y: 6, w: 24.6, h: 25 }, alt: 'The request form’s Item Information, with the Switch to Duplication Order Form button at the top right, outlined.'|t },
        ],
      },
      {
        icon: 'paper-plane', label: 'Pay invoice to receive copies'|t, note: 'Invoice in 24–48 hours'|t,
        detail: 'Photocopies and low-resolution PDF scans cost 50 cents an item, and high-resolution JPEG or TIFF scans $1 an item, plus a $10 processing fee per order; one fee covers requests you submit together. Staff email an invoice with payment instructions, usually within 24–48 hours (not counting weekends and holidays). Allow 5–7 business days for the order; your scans are emailed in the format you chose.'|t,
      },
    ],
  },
  {
    key: 'assist',
    letter: 'C',
    name: ['Ask an'|t, 'expert for help'|t],
    stops: [
      { icon: 'comments-alt', label: 'Reach out'|t, note: 'AskUs or email form'|t, href: ask_href|default('https://askus.lib.lsu.edu/special') },
      { icon: 'lightbulb-on', label: 'Receive guidance'|t, note: 'Chef’s choice'|t },
      find,
      { icon: 'repeat', label: 'Start options A or B'|t, note: 'Thank your librarian'|t },
    ],
  },
] %}
{# Oral History's three ways (unit 'oral_history', from the landing hero on
   /v2/oralhistory): A listens online, B orders a copy as Special
   Collections does (B above, renamed), C meets the Williams Center's staff
   in Room 201 at Hill. #}
{% if unit|default('') == 'oral_history' %}
  {% set paths = [
    {
      key: 'listen',
      letter: 'A',
      name: ['Listen'|t, 'online'|t],
      stops: [
        { icon: 'search', label: 'Find an interview'|t, note: 'In Combined Search'|t, href: '/v2/search?mode=special&source%5B%5D=oral_histories' },
        {
          icon: 'file-alt', label: 'Read its abstract'|t, note: 'A PDF summary'|t,
          detail: 'Most interviews have an abstract, a PDF summary of the conversation. Open it from the interview’s row in the results: PDF Abstract.'|t,
        },
        { icon: 'headphones', label: 'Listen in the LDL'|t, note: 'Where it’s digitized'|t, href: 'https://www.louisianadigitallibrary.org/lsu-thwcoh' },
      ],
    },
    paths[1]|merge({ name: ['Order a'|t, 'copy'|t] }),
    {
      key: 'assist',
      letter: 'C',
      name: ['Meet with'|t, 'our staff'|t],
      stops: [
        { icon: 'comments-alt', label: 'Reach out'|t, note: 'AskUs or email'|t, href: ask_href|default('https://askus.lib.lsu.edu/search/?t=0&g=12395') },
        { icon: 'calendar-check', label: 'Book a time'|t, note: 'By appointment'|t },
        { icon: 'headphones-alt', label: 'Listen at Hill'|t, note: 'Room 201'|t },
      ],
    },
  ] %}
{% endif %}
{# The Williams Center's services (unit 'oral_history_record', the Record
   tab on /v2/oralhistory), in the order a newcomer goes: D learns how,
   E starts a project, F gets help. The letters go on from the Research
   tab's A, B and C, so every option on the page has its own. Each service
   opens in place, as the Research tab's steps do, with the words of its
   page on the old site (/oralhistoryworkshops and the rest, where they sat
   in a tile you had to open); the notes are those words, shortened. Reach
   out stays a link to the question form, as on /v2/special. #}
{% if unit|default('') == 'oral_history_record' %}
  {% set paths = [
    {
      key: 'learn',
      letter: 'D',
      name: ['Learn'|t, 'how'|t],
      stops: [
        {
          icon: 'chalkboard-teacher', label: 'Workshops'|t, note: 'Planning to interviewing'|t,
          detail: 'Are you interested in learning about oral history best practices? At our workshops, you will learn about project planning, doing background research, conducting interviews, and what happens to the interview afterward, all based on best practices established by the Oral History Association.'|t,
        },
        {
          icon: 'users-class', label: 'Seminars'|t, note: 'Taught at LSU'|t,
          detail: 'Please stay tuned for announcements on upcoming oral history seminars taught at LSU.'|t,
        },
      ],
    },
    {
      key: 'project',
      letter: 'E',
      name: ['Start a'|t, 'project'|t],
      stops: [
        {
          icon: 'clipboard-list', label: 'Create your own'|t, note: 'Our guide to getting started'|t,
          detail: [
            'If you would like to do your own oral history project but are not sure where to start, take our advice. Start small and manageable and go from there. Think about what you want as a final product and what resources are available to you, and arrange your timeline, your goals, and your action items around that.'|t,
            'We are happy to provide project planning advice via a consultation and/or training. If you would like to take it to another level and think partnering with the Williams Center could work for you, see Collaborate, the next step.'|t,
          ],
        },
        {
          icon: 'handshake', label: 'Collaborate'|t, note: 'A partnership with the Center'|t,
          detail: [
            'Finding like-minded organizations is the first step in creating meaningful partnerships, which is at the heart of the Center’s mission to document Louisiana’s diverse cultural history. We rely on your expertise about your subject, and in return, we provide leadership, expertise, and educational tools for oral history best practices.'|t,
            'When partnering with the Williams Center, there are a variety of potential relationships to explore. The Center offers the following services, which vary case by case depending on the needs of the project and available resources: training, consultations, equipment loans, and collaboration on resource-seeking and presentation. Partners are responsible for providing interviews that meet the Center’s collection development criteria. If they are able to provide transcription or indexing of interviews, this will speed up the Center’s ability to process and provide public access to those interviews.'|t,
            'To that end, Williams Center staff will advise on best practices and will loan digital field recorders that record audio in preservation-quality format (.wav). The Center will preserve the master files and create compressed user copies for access. We are also able to partner with additional repositories to ensure that several copies of the interview collections exist via multiple access points.'|t,
          ],
        },
      ],
    },
    {
      key: 'help',
      letter: 'F',
      name: ['Get'|t, 'help'|t],
      stops: [
        { icon: 'comments-alt', label: 'Reach out'|t, note: 'AskUs or email'|t, href: ask_href|default('https://askus.lib.lsu.edu/search/?t=0&g=12395') },
        {
          icon: 'calendar-check', label: 'Consultations'|t, note: 'By appointment'|t,
          detail: 'Are you incorporating oral history into your research? If you are interested in learning more about using our existing primary sources or creating new oral history interviews for your research or curriculum, contact Williams Center Director Jennifer Abraham Cramer to schedule a consultation.'|t,
          cta: { href: 'mailto:jabrah1@lsu.edu', label: 'Email Jennifer Abraham Cramer'|t, newtab: false },
        },
      ],
    },
  ] %}
{% endif %}
<div class="pf-paths{{ unit|default('') == 'oral_history_record' ? ' pf-paths--services' }}">
  {% for path in paths %}
    {% set heading_id = 'pf-paths-' ~ uid ~ '-' ~ path.key %}
    {% if not loop.first %}
      <div class="pf-paths__or" aria-hidden="true"></div>
    {% endif %}
    <div class="pf-paths__line">
      <p class="pf-paths__name" id="{{ heading_id }}">
        <span class="pf-paths__letter"><span class="visually-hidden">{{ 'Option'|t }} </span>{{ path.letter }}<span class="visually-hidden">: </span></span>
        {# The name in two parts: one line here, two lines (broken between
           them) in the hero's timetable, so A, B and C read alike. #}
        <span class="pf-paths__name-text">{{ path.name|first }} <span class="pf-paths__name-rest">{{ path.name|last }}</span></span>
      </p>
      <ol class="pf-paths__stops" aria-labelledby="{{ heading_id }}">
        {% for stop in path.stops %}
          <li class="pf-paths__stop">
            <span class="pf-paths__icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/' ~ stop.icon ~ '.svg', ignore_missing = true)|raw }}</span>
            {% if stop.detail is defined %}
              {% set pop_id = heading_id ~ '-' ~ loop.index %}
              {% set has_shots = stop.shots is defined and img_base|default('') %}
              <button type="button" class="pf-paths__label pf-paths__peek" popovertarget="{{ pop_id }}">
                {{- stop.label -}}
                <span class="visually-hidden">, {{ has_shots ? 'show screenshots'|t : 'show details'|t }}</span>
              </button>
            {% elseif stop.href is defined %}
              {# A stop with somewhere to go: a link, in the panel buttons'
                 look (the whole stop is the target, underlined on hover). #}
              <a class="pf-paths__label pf-paths__peek" href="{{ stop.href }}">{{ stop.label }}</a>
            {% else %}
              <span class="pf-paths__label">{{ stop.label }}</span>
            {% endif %}
            {% if stop.note|default('') %}<span class="pf-paths__note">{{ stop.note }}</span>{% endif %}
            {% if stop.detail is defined %}
              <div class="pf-paths__pop" id="{{ pop_id }}" popover role="dialog" aria-labelledby="{{ pop_id }}-title">
                <div class="pf-paths__pop-head">
                  <p class="pf-paths__pop-kicker">{{ 'Option @letter, step @step'|t({ '@letter': path.letter, '@step': loop.index }) }}</p>
                  <p class="pf-paths__pop-title" id="{{ pop_id }}-title">{{ stop.label }}</p>
                  <button type="button" class="pf-paths__pop-close" popovertarget="{{ pop_id }}" popovertargetaction="hide">
                    <span class="visually-hidden">{{ 'Close'|t }}</span>
                    <span aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/light/times.svg', ignore_missing = true)|raw }}</span>
                  </button>
                </div>
                {% for text in stop.detail is iterable ? stop.detail : [stop.detail] %}
                  <p class="pf-paths__pop-text">{{ text }}</p>
                {% endfor %}
                {% if stop.cta is defined %}
                  {% set newtab = stop.cta.newtab ?? true %}
                  <a class="pf-paths__cta" href="{{ stop.cta.href }}"{% if newtab %} target="_blank" rel="noopener"{% endif %}>
                    {{- stop.cta.label -}}
                    {% if newtab %}<span class="visually-hidden">{{ ' (opens in a new tab)'|t }}</span>{% endif %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  </a>
                {% endif %}
                {% if has_shots %}
                  {% for shot in stop.shots %}
                    <div class="pf-paths__shot">
                      <img src="{{ img_base ~ shot.file }}" width="{{ shot.width }}" height="{{ shot.height }}" alt="{{ shot.alt }}" loading="lazy" decoding="async">
                      {% if shot.mark is defined %}
                        <span class="pf-paths__mark" style="--x: {{ shot.mark.x }}%; --y: {{ shot.mark.y }}%; --w: {{ shot.mark.w }}%; --h: {{ shot.mark.h }}%;" aria-hidden="true"></span>
                      {% endif %}
                    </div>
                  {% endfor %}
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </div>
  {% endfor %}
</div>
