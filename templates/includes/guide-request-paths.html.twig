{#
/**
 * @file
 * Special Collections request paths: two "subway lines", one per way to use
 * an item, each a row of stops (a column on narrow blocks). Placed by a
 * "[request-paths]" paragraph in a guide text block
 * (paragraph--guide-text.html.twig).
 *
 * Each line is an ordered list named by its heading, so screen readers hear
 * "See it in person, list, 4 items". Icons are Font Awesome Pro duotone,
 * inlined from the site's copy like the hero account icon, and decorative.
 *
 * Available variables:
 * - uid: makes the heading ids unique on the page.
 */
#}
{% set paths = [
  {
    key: 'visit',
    name: 'See it in person'|t,
    icon: 'book-reader',
    stops: [
      { icon: 'search', label: 'Find Item'|t, note: 'in the catalog'|t },
      { icon: 'file-signature', label: 'Click Request Item'|t, note: 'bottom right area'|t },
      { icon: 'calendar-check', label: 'Book a visit'|t, note: 'recommended'|t },
      { icon: 'book-reader', label: 'Read it at Hill'|t, note: 'staff bring it to you'|t },
    ],
  },
  {
    key: 'copy',
    name: 'Get a digital copy'|t,
    icon: 'copy',
    stops: [
      { icon: 'search', label: 'Find Item'|t, note: 'in the catalog'|t },
      { icon: 'file-signature', label: 'Click Request Item'|t, note: 'bottom right area'|t },
      { icon: 'exchange', label: 'Switch to duplication'|t, note: 'top right of the form'|t },
      { icon: 'paper-plane', label: 'Pay invoice to receive copies'|t, note: 'usually emailed in 24–48 hours'|t },
    ],
  },
    {
    key: 'copy',
    name: 'Have an expert help'|t,
    icon: 'copy',
    stops: [
      { icon: 'comments-alt', label: 'Reach out'|t, note: 'AskUs or email form'|t },
      { icon: 'lightbulb-on', label: 'Receive guidance'|t, note: 'recommendations'|t },
      { icon: 'search', label: 'Find Item'|t, note: 'in the catalog'|t },
      { icon: 'hands-helping', label: 'Thank your librarian'|t, note: 'usually emailed in 24–48 hours'|t },
    ],
  },
] %}
<div class="pf-paths">
  {% for path in paths %}
    {% set heading_id = 'pf-paths-' ~ uid ~ '-' ~ path.key %}
    <div class="pf-paths__line">
      <p class="pf-paths__name" id="{{ heading_id }}">
        <span class="pf-paths__name-icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/' ~ path.icon ~ '.svg', ignore_missing = true)|raw }}</span>
        {{ path.name }}
      </p>
      <ol class="pf-paths__stops" aria-labelledby="{{ heading_id }}">
        {% for stop in path.stops %}
          <li class="pf-paths__stop">
            <span class="pf-paths__icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/' ~ stop.icon ~ '.svg', ignore_missing = true)|raw }}</span>
            <span class="pf-paths__label">{{ stop.label }}</span>
            <span class="pf-paths__note">{{ stop.note }}</span>
          </li>
        {% endfor %}
      </ol>
    </div>
  {% endfor %}
</div>
