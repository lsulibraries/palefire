{#
/**
 * @file
 * Special Collections request paths: three "subway lines", one per way to
 * start (options A, B and C), each a row of stops (a column on narrow
 * blocks). Placed by a "[request-paths]" paragraph in a guide text block
 * (paragraph--guide-text.html.twig) and by the landing hero's Quick Guide.
 *
 * Each line is an ordered list named by its heading, so screen readers hear
 * "Option A: See it in person, list, 4 items"; C's last stop points back to
 * A and B by those letters. A hairline between the lines sets the options
 * apart (decorative). Each stop's disc holds a Font Awesome Pro duotone icon,
 * inlined from the site's copy like the hero account icon, and decorative:
 * the list's own numbering gives the order.
 *
 * A stop with `detail` has a "how" panel: its label is a button that opens a
 * popover with a sentence or two and, when it has `shots`, screenshots of
 * the catalog and request system (images/guides/special-collections/). The
 * popover is native (popover / popovertarget), so it needs no script:
 * clicking or tapping the label, Enter or Space opens it; Esc, the close
 * button or a click outside closes it. Screenshots load only when opened.
 *
 * A panel with `cta` ("Find Item") ends its text with a full-width link
 * there (the catalog), in a new tab so the guide stays open behind it.
 *
 * A stop with `href` (C's "Reach out") is a link instead, styled as the
 * panel buttons are.
 *
 * Available variables:
 * - uid: makes the heading ids unique on the page.
 * - ask_href: where "Reach out" goes. The Special Collections landing
 *   passes its question form (#ask-question, includes/ask-special.html.twig);
 *   guides, which have none, go to AskUs: Special Collections.
 * - img_base: URL of images/guides/special-collections/ with a trailing
 *   slash. Without it the panels show their text only.
 */
#}
{% set find = {
  icon: 'search', label: 'Find Item'|t, note: 'In the catalog'|t,
  detail: 'Search the catalog, then open the item’s record. It lists the contents, the abstract, a link to the finding aid when there is one, and the format. Scroll down to the Holdings and Available tabs.'|t,
  shots: [
    { file: 'catalog-record.webp', width: 1250, height: 723, alt: 'A catalog record for the William Y. Dixon papers, with Holdings and Available tabs below it.'|t },
  ],
  cta: { href: 'https://catalog.lib.lsu.edu', label: 'Search the library catalog'|t },
} %}
{% set request = {
  icon: 'file-signature', label: 'Click Request Item'|t, note: 'Bottom right area'|t,
  detail: 'On the Available tab, choose Request Item at the end of the row you want. Then sign in: LSU students, faculty and staff use single sign-on, and everyone else signs in or registers as a Guest. You don’t need to be affiliated with LSU.'|t,
  shots: [
    { file: 'available-tab.webp', width: 1001, height: 329, alt: 'The Available tab: a table of copies, each with a Request Item link in the last column.'|t },
    { file: 'sign-in.webp', width: 760, height: 495, alt: 'The Special Collections Request System sign-in page, with Single Sign-On for LSU Students, Faculty, and Staff on the left and Guest on the right.'|t },
  ],
} %}
{% set paths = [
  {
    key: 'visit',
    letter: 'A',
    name: ['See it'|t, 'in person'|t],
    stops: [
      find,
      request,
      {
        icon: 'calendar-check', label: 'Book a visit'|t, note: 'Recommended'|t,
        detail: 'The request form fills in the item for you; add the box number from the finding aid. Choose an appointment, or New Appointment, then Submit Request to View In-Person. Appointments aren’t required, but with one your materials are waiting when you arrive.'|t,
        shots: [
          { file: 'book-visit.webp', width: 740, height: 350, alt: 'The end of the request form: Reading Room and Appointment menus, a New Appointment button, and Submit Request to View In-Person.'|t },
        ],
      },
      { icon: 'book-reader', label: 'Read it at Hill'|t, note: 'Staff bring it to you'|t },
    ],
  },
  {
    key: 'copy',
    letter: 'B',
    name: ['Get a'|t, 'digital copy'|t],
    stops: [
      find,
      request,
      {
        icon: 'exchange', label: 'Switch to duplication'|t, note: 'Top right of the form'|t,
        detail: 'Choose Switch to Duplication Order Form at the top right of the request form. Then list what to copy under Selections To Be Reproduced, with box and folder numbers from the finding aid, and pick a format and delivery method.'|t,
        shots: [
          { file: 'duplication-switch.webp', width: 1110, height: 231, alt: 'The request form’s Item Information, with the Switch to Duplication Order Form button at the top right.'|t },
          { file: 'duplication-order.webp', width: 1110, height: 438, alt: 'The duplication form’s Order Information: Selections To Be Reproduced, Duplication Format and Preferred Delivery Method.'|t },
        ],
      },
      {
        icon: 'paper-plane', label: 'Pay invoice to receive copies'|t, note: 'Invoice in 24–48 hours'|t,
        detail: 'Scans cost 50 cents a page, plus a $10 processing fee per order; one fee covers requests you submit together. Staff email an invoice with payment instructions, usually within 24–48 hours (not counting weekends and holidays). Allow 5–7 business days for the order; your scans are emailed in the format you chose.'|t,
      },
    ],
  },
  {
    key: 'assist',
    letter: 'C',
    name: ['Ask an'|t, 'expert for help'|t],
    stops: [
      { icon: 'comments-alt', label: 'Reach out'|t, note: 'AskUs or email form'|t, href: ask_href|default('https://askus.lib.lsu.edu/special') },
      { icon: 'lightbulb-on', label: 'Receive guidance'|t, note: 'Chef’s choice'|t },
      find,
      { icon: 'repeat', label: 'Start options A or B'|t, note: 'Thank your librarian'|t },
    ],
  },
] %}
<div class="pf-paths">
  {% for path in paths %}
    {% set heading_id = 'pf-paths-' ~ uid ~ '-' ~ path.key %}
    {% if not loop.first %}
      <div class="pf-paths__or" aria-hidden="true"></div>
    {% endif %}
    <div class="pf-paths__line">
      <p class="pf-paths__name" id="{{ heading_id }}">
        <span class="pf-paths__letter"><span class="visually-hidden">{{ 'Option'|t }} </span>{{ path.letter }}<span class="visually-hidden">: </span></span>
        {# The name in two parts: one line here, two lines (broken between
           them) in the hero's timetable, so A, B and C read alike. #}
        <span class="pf-paths__name-text">{{ path.name|first }} <span class="pf-paths__name-rest">{{ path.name|last }}</span></span>
      </p>
      <ol class="pf-paths__stops" aria-labelledby="{{ heading_id }}">
        {% for stop in path.stops %}
          <li class="pf-paths__stop">
            <span class="pf-paths__icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/' ~ stop.icon ~ '.svg', ignore_missing = true)|raw }}</span>
            {% if stop.detail is defined %}
              {% set pop_id = heading_id ~ '-' ~ loop.index %}
              {% set has_shots = stop.shots is defined and img_base|default('') %}
              <button type="button" class="pf-paths__label pf-paths__peek" popovertarget="{{ pop_id }}">
                {{- stop.label -}}
                <span class="visually-hidden">, {{ has_shots ? 'show screenshots'|t : 'show details'|t }}</span>
              </button>
            {% elseif stop.href is defined %}
              {# A stop with somewhere to go: a link, in the panel buttons'
                 look (the whole stop is the target, underlined on hover). #}
              <a class="pf-paths__label pf-paths__peek" href="{{ stop.href }}">{{ stop.label }}</a>
            {% else %}
              <span class="pf-paths__label">{{ stop.label }}</span>
            {% endif %}
            <span class="pf-paths__note">{{ stop.note }}</span>
            {% if stop.detail is defined %}
              <div class="pf-paths__pop" id="{{ pop_id }}" popover role="dialog" aria-labelledby="{{ pop_id }}-title">
                <div class="pf-paths__pop-head">
                  <p class="pf-paths__pop-kicker">{{ 'Option @letter, step @step'|t({ '@letter': path.letter, '@step': loop.index }) }}</p>
                  <p class="pf-paths__pop-title" id="{{ pop_id }}-title">{{ stop.label }}</p>
                  <button type="button" class="pf-paths__pop-close" popovertarget="{{ pop_id }}" popovertargetaction="hide">
                    <span class="visually-hidden">{{ 'Close'|t }}</span>
                    <span aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/light/times.svg', ignore_missing = true)|raw }}</span>
                  </button>
                </div>
                <p class="pf-paths__pop-text">{{ stop.detail }}</p>
                {% if stop.cta is defined %}
                  <a class="pf-paths__cta" href="{{ stop.cta.href }}" target="_blank" rel="noopener">
                    {{- stop.cta.label -}}
                    <span class="visually-hidden">{{ ' (opens in a new tab)'|t }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  </a>
                {% endif %}
                {% if has_shots %}
                  {% for shot in stop.shots %}
                    <img class="pf-paths__shot" src="{{ img_base ~ shot.file }}" width="{{ shot.width }}" height="{{ shot.height }}" alt="{{ shot.alt }}" loading="lazy" decoding="async">
                  {% endfor %}
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </div>
  {% endfor %}
</div>
