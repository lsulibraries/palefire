{#
/**
 * @file
 * The question form's Send button (palefire_form_libanswers_ask_form_alter()):
 * a <button>, so it can hold the arrow, in the Quick Start Guide's style
 * (_ask.scss). Its name and value still go with the form, as an input's do.
 *
 * Available variables:
 * - attributes: type, name, value, id and classes.
 * - children: anything after the button.
 */
#}
<button{{ attributes }}>
  {{- attributes.value -}}
  <svg class="pf-inquiry__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
</button>{{ children }}
