{#
/**
 * @file
 * The libanswers module's question form in the Ask section's markup
 * (included by includes/ask-special.html.twig; styled in _ask.scss, checked
 * and sent by js/ask-form.js).
 *
 * palefire_form_libanswers_ask_form_alter() strips each control's
 * form-element wrapper, so this writes its label, the required mark and
 * its error line (id "<control id>-error", the script's and the server's).
 * After a post without JavaScript, Form API's errors (#errors) show there.
 * Everything else (form_build_id, form_id, Honeypot's hidden field) comes
 * last, untouched.
 *
 * Available variables:
 * - form: the form render array.
 */
#}
{% macro field(control, wide) %}
  {% set id = control['#id'] %}
  <div class="pf-inquiry__field{{ wide ? ' pf-inquiry__field--wide' }}">
    <label class="pf-inquiry__label" for="{{ id }}">
      {{- control['#title'] -}}
      {%- if control['#required'] %}<span class="pf-inquiry__req" aria-hidden="true"> *</span>{% endif -%}
    </label>
    {{ control }}
    {% if control['#required'] %}
      <span class="pf-inquiry__error" id="{{ id }}-error"{{ control['#errors'] ? '' : ' hidden' }}>{{ control['#errors'] }}</span>
    {% endif %}
  </div>
{% endmacro %}
{% for name in ['val1', 'val2', 'pname', 'pemail'] %}
  {% if form[name] %}
    {{ _self.field(form[name], false) }}
  {% endif %}
{% endfor %}
{{ _self.field(form.pquestion, true) }}
{{ _self.field(form.pdetails, true) }}
<p class="pf-inquiry__required">
  <span><span aria-hidden="true">* </span>{{ 'Required'|t }}</span>
  <span>{{ 'Special Collections staff reply by email.'|t }}</span>
</p>
{# The status is a card that rises from behind the Send bar (_ask.scss):
   after the button, as the answer to pressing it. The script writes the
   words into its text; the icon shows by data-kind (done or error). #}
{% set done_icon = source('libraries/fontawesome-pro/svgs/light/check-circle.svg', ignore_missing = true) %}
{% set error_icon = source('libraries/fontawesome-pro/svgs/light/exclamation-circle.svg', ignore_missing = true) %}
<div class="pf-inquiry__actions">
  {{ form.actions }}
  <div class="pf-inquiry__status" role="status" tabindex="-1">
    {%- if done_icon %}<span class="pf-inquiry__status-icon" data-for="done" aria-hidden="true">{{ done_icon|raw }}</span>{% endif -%}
    {%- if error_icon %}<span class="pf-inquiry__status-icon" data-for="error" aria-hidden="true">{{ error_icon|raw }}</span>{% endif -%}
    <span class="pf-inquiry__status-text"></span>
  </div>
</div>
{{ form|without('val1', 'val2', 'pname', 'pemail', 'pquestion', 'pdetails', 'actions') }}
