{#
/**
 * @file
 * Scroll sections for modular_page.
 *
 * Each item arrives with section attributes (id, pf-section--snap, etc.)
 * and item.section data from palefire_modular_preprocess_field().
 *
 * item.section.bg is the rendered field_section_bg (a responsive <img>).
 * It is decorative, so it is hidden from assistive tech and made inert.
 *
 * Dark sections also get Bootstrap's dark colour mode (data-bs-theme), so
 * anything inside that reads --bs-* variables (tiles, form controls, the
 * events carousel) switches with the section, as _sections.scss does for
 * the older field_sections.
 *
 * item.section.index (palefire_preprocess_field(), a section with an
 * Eyebrow): the hero's index rule (includes/landing.html.twig) above the
 * heading, numbered by position, with its link at the rule's right end,
 * and the Lede under the heading.
 */
#}
{% import '@palefire/includes/landing.html.twig' as pf %}
<div{{ attributes.addClass('pf-sections') }}>
  {% for item in items %}
    {% if item.section %}
      {% if item.attributes.hasClass('pf-section--theme-dark') %}
        {% set item_attributes = item.attributes.setAttribute('data-bs-theme', 'dark') %}
      {% endif %}
      {% set index = item.section.index %}
      {% if index %}
        {% set item_attributes = item.attributes.addClass('pf-section--indexed') %}
      {% endif %}
      <section{{ item.attributes }}>
        {% if item.section.bg %}
          <div class="pf-section__bg" aria-hidden="true" inert>{{ item.section.bg }}</div>
        {% endif %}
        <div class="pf-section__inner">
          {% if index %}
            {{ pf.index_rule(index.num, index.label, index.link ?: {}) }}
          {% endif %}
          {% if item.section.label %}
            <h2 id="{{ item.section.title_id }}"
                class="pf-section__title{{ item.section.title_hidden ? ' visually-hidden' }}"
                tabindex="-1">{{ item.section.label }}</h2>
          {% endif %}
          {% if index.lede %}
            <p class="pf-section__lede">{{ index.lede }}</p>
          {% endif %}
          {{ item.content }}
        </div>
      </section>
    {% else %}
      {{ item.content }}
    {% endif %}
  {% endfor %}
  {# Section headings, the Events carousel and the request paths animate
     in on scroll, once per page load (js/section-reveal.js). #}
  {{ attach_library('palefire/section-reveal') }}
</div>
