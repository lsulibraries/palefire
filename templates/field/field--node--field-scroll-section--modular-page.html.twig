{#
/**
 * @file
 * Scroll sections for modular_page.
 *
 * Each item arrives with section attributes (id, pf-section--snap, etc.)
 * and item.section data from palefire_modular_preprocess_field().
 *
 * item.section.bg is the rendered field_section_bg (a responsive <img>).
 * It is decorative, so it is hidden from assistive tech and made inert.
 */
#}
<div{{ attributes.addClass('pf-sections') }}>
  {% for item in items %}
    {% if item.section %}
      <section{{ item.attributes }}>
        {% if item.section.bg %}
          <div class="pf-section__bg" aria-hidden="true" inert>{{ item.section.bg }}</div>
        {% endif %}
        <div class="pf-section__inner">
          {% if item.section.label %}
            <h2 id="{{ item.section.title_id }}"
                class="pf-section__title{{ item.section.title_hidden ? ' visually-hidden' }}"
                tabindex="-1">{{ item.section.label }}</h2>
          {% endif %}
          {{ item.content }}
        </div>
      </section>
    {% else %}
      {{ item.content }}
    {% endif %}
  {% endfor %}
</div>
