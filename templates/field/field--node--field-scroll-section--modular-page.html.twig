{#
/**
 * @file
 * Scroll sections for modular_page.
 *
 * Each item arrives with section attributes (id, pf-section--snap, etc.)
 * and item.section data from palefire_modular_preprocess_field().
 *
 * item.section.bg is the rendered field_section_bg (a responsive <img>).
 * It is decorative, so it is hidden from assistive tech and made inert.
 *
 * Dark sections also get Bootstrap's dark color mode (data-bs-theme), so
 * anything inside that reads --bs-* variables (tiles, form controls, the
 * events carousel) switches with the section, as _sections.scss does for
 * the older field_sections.
 *
 * item.section.index (palefire_preprocess_field(), a section with an
 * Eyebrow): the hero's index rule (includes/landing.html.twig) above the
 * heading, numbered by position, with its link at the rule's right end,
 * and the Lede under the heading. With index.aside (a location page's
 * parts), the heading and Lede share a head (.pf-section__head) that sits
 * beside the content from lg, sticky while it scrolls (_location.scss).
 */
#}
{% import '@palefire/includes/landing.html.twig' as pf %}
<div{{ attributes.addClass('pf-sections') }}>
  {% for item in items %}
    {% if item.section %}
      {% if item.attributes.hasClass('pf-section--theme-dark') %}
        {% set item_attributes = item.attributes.setAttribute('data-bs-theme', 'dark') %}
      {% endif %}
      {% set index = item.section.index %}
      {% if index %}
        {% set item_attributes = item.attributes.addClass('pf-section--indexed') %}
      {% endif %}
      {% if index.aside %}
        {% set item_attributes = item.attributes.addClass('pf-section--aside') %}
      {% endif %}
      {# A tile showcase drawn as the exhibitions band: it holds the band's
         faded plate (palefire_modular_preprocess_field()). #}
      {% if item.section.exhibitions %}
        {% set item_attributes = item.attributes.addClass('pf-section--exhibitions') %}
      {% endif %}
      {# The podcast's head (index.mark): the name (an h2 like every
         section's), its Lede, and the cassette mark tilted behind them at
         the right, running off the section's edge; centered under them in
         one column (podcast.scss). The drawing is decorative; the name is
         the h2's own text. The section's backdrop takes the photo of the
         episode pointed at or playing (js/podcast.js); the pictures are
         set only then. #}
      {% set mark = index.mark == 'cassette' and item.section.label and not item.section.title_hidden %}
      <section{{ item.attributes }}>
        {% if item.section.bg %}
          <div class="pf-section__bg" aria-hidden="true" inert>{{ item.section.bg }}</div>
        {% endif %}
        {% if mark %}
          <div class="pf-podcast-backdrop" aria-hidden="true"><img alt="" decoding="async"><img alt="" decoding="async"></div>
        {% endif %}
        <div class="pf-section__inner">
          {# A walk-in room's parts have no number: the rule only when it
             carries its link (Directions). #}
          {% if index.num or index.link.url %}
            {{ pf.index_rule(index.num, index.label, index.link ?: {}) }}
          {% endif %}
          {% if index.aside %}
            <div class="pf-section__head">
          {% endif %}
          {% if mark %}
            <div class="pf-podcast-head">
              <h2 id="{{ item.section.title_id }}" class="pf-section__title pf-podcast-head__title" tabindex="-1">{{ item.section.label }}</h2>
              {# The Lede, or the episode pointed at (js/podcast.js). #}
              <div class="pf-podcast-head__about">
                {% if index.lede %}
                  <p class="pf-section__lede pf-podcast-head__lede">{{ index.lede }}</p>
                {% endif %}
                <div class="pf-podcast-head__episode" aria-live="polite" hidden>
                  <p class="pf-podcast-head__kicker"></p>
                  <p class="pf-podcast-head__summary"></p>
                  <p class="pf-podcast-head__credits"></p>
                </div>
              </div>
              <p class="pf-podcast-head__read" aria-hidden="true"></p>
              <p class="pf-podcast-head__credit" aria-hidden="true"></p>
              <div class="pf-podcast-head__tape">
                {%- include '@palefire/includes/cassette-mark.html.twig' -%}
              </div>
            </div>
          {% elseif item.section.label %}
            <h2 id="{{ item.section.title_id }}"
                class="pf-section__title{{ item.section.title_hidden ? ' visually-hidden' }}"
                tabindex="-1">
              {{- item.section.label -}}
            </h2>
          {% endif %}
          {% if index.lede and not mark %}
            <p class="pf-section__lede">{{ index.lede }}</p>
          {% endif %}
          {% if index.aside %}
            </div>
          {% endif %}
          {{ item.content }}
        </div>
      </section>
    {% else %}
      {{ item.content }}
    {% endif %}
  {% endfor %}
  {# Section headings, the Events carousel and the request paths animate
     in on scroll, once per page load (js/section-reveal.js). #}
  {{ attach_library('palefire/section-reveal') }}
</div>
