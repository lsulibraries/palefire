{#
/**
 * @file
 * Palefire override of palefire_modular's TOC. Same markup as the module
 * default, plus the scroll-tracking library and Origami's "Back to top"
 * arrow (inline SVG, so it doesn't need Font Awesome).
 *
 * Title: "Table of contents" on every page, in the label style that lines
 * up with the breadcrumb beside it (.pf-toc__heading--page). It used to be
 * the page title, which the page's <h1> already says. A plain paragraph,
 * not a heading, because the sidebar comes before the <h1> in the page;
 * it names the nav (aria-labelledby), so screen readers hear "Table of
 * contents, navigation". The mobile button says the same.
 */
#}
{{ attach_library('palefire/modular-toc') }}
<nav class="pf-toc" aria-labelledby="pf-toc-title" data-pf-toc data-depth="{{ depth }}" data-mode="{{ mode }}">
  <p id="pf-toc-title" class="pf-toc__heading pf-toc__heading--page">{{ 'Table of contents'|t }}</p>
  <div class="pf-toc__rail">
    <span class="pf-toc__indicator" aria-hidden="true"></span>
    <ol class="pf-toc__list">
      {% for item in items %}
        <li class="pf-toc__item">
          <a class="pf-toc__link" href="#{{ item.id }}">{{ item.label }}</a>
        </li>
      {% endfor %}
    </ol>
  </div>
  <a class="pf-toc__top" href="#top">
    <svg class="pf-toc__top-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M8 14V2.5M3.5 7 8 2.5 12.5 7"/></svg>
    {{ 'Back to top'|t }}
  </a>
</nav>
