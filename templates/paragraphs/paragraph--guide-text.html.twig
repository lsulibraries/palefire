{#
/**
 * @file
 * Guide: Text (paragraph type guide_text).
 *
 * - field_block_title: optional <h3> (a sub-link in "On this page").
 * - field_text_style: "callout" puts the block in a highlighted box.
 * - transcription: the text opens with a Heading 4 "Transcription"
 *   (palefire_preprocess_paragraph__guide_text()): set as a primary source.
 *
 * Inside a block that has a heading, use Heading 4 in the editor: every h3
 * in a guide section becomes a TOC sub-link.
 *
 * - ask_href: where the paths' "Reach out" goes (empty: AskUs).
 * - request_paths: the text had a "[request-paths]" paragraph
 *   (palefire_preprocess_paragraph__guide_text()); the Special Collections
 *   request diagram follows the text.
 * - faqs: the text had a "[special-collections-faqs]" paragraph; every
 *   Special Collections FAQ follows it, most asked first.
 * - plates: the text had "[styleguide:<plate>]" paragraphs; each style
 *   guide plate follows it (includes/styleguide-plate.html.twig).
 * - analytics: the text had an "[analytics:report]" or "[analytics:feedback]"
 *   paragraph; the staff analytics report or the Combined Search feedback
 *   follows it (includes/analytics-report.html.twig,
 *   analytics-feedback.html.twig).
 * - research: the text had a "[research:<part>]" paragraph; that part of the
 *   LSU research figures follows it (includes/research-figures.html.twig).
 * - newsletter: the text had a "[newsletter-review:<account>/<activity id>]"
 *   paragraph; that Constant Contact draft follows it, for review, with its
 *   feedback form (includes/newsletter-review.html.twig).
 * - newsletter_compare, newsletter_archive: the text had a
 *   "[newsletter-compare]" or "[newsletter-archive]" paragraph; its links to
 *   Constant Contact previews become a before/after slider or a gallery of
 *   past issues (includes/newsletter-compare.html.twig,
 *   newsletter-archive.html.twig).
 */
#}
{% set title = paragraph.field_block_title.value|default('')|trim %}
{% set callout = paragraph.field_text_style.value == 'callout' %}
{%
  set classes = [
    'pf-guide-block',
    'pf-guide-block--text',
    callout ? 'pf-guide-callout',
    transcription ? 'pf-transcription',
    not paragraph.isPublished() ? 'paragraph--unpublished',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {% if title %}
    <h3 class="pf-guide-block__title">{{ title }}</h3>
  {% endif %}
  <div class="pf-guide-prose">
    {{ content.field_block_body }}
  </div>
  {% if request_paths %}
    {% include '@palefire/includes/guide-request-paths.html.twig' with { uid: paragraph.id(), img_base: file_url(directory) ~ '/images/guides/special-collections/', ask_href: ask_href } only %}
  {% endif %}
  {% if faqs %}
    {% include '@palefire/includes/guide-faqs.html.twig' with { faqs: faqs, directory: directory } only %}
  {% endif %}
  {% if analytics %}
    {% include analytics.part == 'feedback' ? '@palefire/includes/analytics-feedback.html.twig' : '@palefire/includes/analytics-report.html.twig' with analytics only %}
  {% endif %}
  {% if research %}
    {% include '@palefire/includes/research-figures.html.twig' with research only %}
  {% endif %}
  {% if newsletter %}
    {% include '@palefire/includes/newsletter-review.html.twig' with newsletter|merge({ uid: 'nlr-' ~ paragraph.id() }) only %}
  {% endif %}
  {% if newsletter_compare %}
    {% include '@palefire/includes/newsletter-compare.html.twig' with newsletter_compare|merge({ uid: 'nlc-' ~ paragraph.id() }) only %}
  {% endif %}
  {% if newsletter_archive %}
    {% include '@palefire/includes/newsletter-archive.html.twig' with newsletter_archive|merge({ uid: 'nla-' ~ paragraph.id() }) only %}
  {% endif %}
  {% for plate in plates %}
    {% include '@palefire/includes/styleguide-plate.html.twig' with plate|merge({ uid: 'sg-' ~ paragraph.id() ~ '-' ~ loop.index }) only %}
  {% endfor %}
</div>
