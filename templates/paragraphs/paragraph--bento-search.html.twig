{#
/**
 * @file
 * Bento search section: a search form that sends the search to the
 * library's Bento results page, and an optional Hill Memorial building map
 * under it.
 *
 * The form is a plain GET form: submitting opens bento_action
 * (https://lib.lsu.edu/bento) with the words in bento.identifier
 * (search_api_fulltext_bento), the same query Origami's search box sends.
 * There are no results on this page and no JavaScript; the result tiles
 * that palefire_modular builds (bento.tiles) are not printed.
 *
 * Variables from palefire_modular_preprocess_paragraph__bento_search():
 * - bento.identifier, bento.input_id, bento.placeholder
 * - bg_videos: ordered list of MP4 URLs (optional)
 * - bg_poster: poster image URL (optional)
 * - bento_map: the building_map paragraph from field_bento_map, rendered
 *   by palefire_preprocess_paragraph__bento_search() (optional).
 *
 * "Search LSU Libraries" and the map heading are h3s so the TOC lists them.
 * While the map is in view, building-map.js adds .is-map-in-view here to
 * dim and blur the background video.
 */
#}
{% set bento_action = 'https://lib.lsu.edu/bento' %}
{% set bento_name = bento.identifier|default('search_api_fulltext_bento') %}
{% set input_id = bento.input_id|default('pf-bento-q') %}
<div{{ attributes.addClass('pf-bento', bg_videos ? 'has-bg-video') }} data-pf-bento>

  {% if bg_videos %}
    {{ attach_library('palefire/bento-video') }}
    <div class="pf-bento__media" data-bento-video data-sources="{{ bg_videos|json_encode }}">
      <video class="pf-bento__bg-video" muted playsinline preload="metadata"
             aria-hidden="true" tabindex="-1"
             {% if bg_poster %}poster="{{ bg_poster }}"{% endif %}></video>
      {# Same look as the TOC hide/show button: icon square + a gold bar that
         fills as the current clip plays; the label slides out on
         hover/focus and is always read by screen readers. bento-video.js
         swaps the label and data-state. #}
      <button type="button" class="pf-bento__bg-toggle" data-bento-video-toggle data-state="playing">
        <span class="pf-bento__bg-toggle-progress" aria-hidden="true"></span>
        <svg class="pf-bento__bg-toggle-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <g class="pf-bento__bg-toggle-pause"><rect x="3.5" y="2.5" width="3.2" height="11" rx="1"/><rect x="9.3" y="2.5" width="3.2" height="11" rx="1"/></g>
          <path class="pf-bento__bg-toggle-play" d="M4.5 3.1v9.8c0 .8.9 1.3 1.6.9l7.6-4.9c.6-.4.6-1.3 0-1.7L6.1 2.2c-.7-.4-1.6.1-1.6.9z"/>
        </svg>
        <span class="pf-bento__bg-toggle-label" data-bento-video-label>{{ 'Pause background video'|t }}</span>
      </button>
    </div>
  {% endif %}

  <form class="pf-bento__form" role="search" method="get" action="{{ bento_action }}" aria-labelledby="{{ input_id }}-heading">
    <h3 class="pf-bento__heading" id="{{ input_id }}-heading" data-toc>
      <label class="pf-bento__label" for="{{ input_id }}">{{ 'Search LSU Libraries'|t }}</label>
    </h3>
    <div class="pf-bento__field">
      <svg class="pf-bento__field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
      <input class="pf-bento__input" type="search" id="{{ input_id }}" name="{{ bento_name }}"
             placeholder="{{ bento.placeholder|default('Search books, articles, databases, guides and more'|t) }}"
             autocomplete="off" enterkeyhint="search">
      <button class="pf-bento__submit" type="submit">
        <span class="pf-bento__submit-text">{{ 'Search'|t }}</span>
        <svg class="pf-bento__submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
      </button>
    </div>
  </form>

  {% if bento_map %}
    <div class="pf-bento__visit">{{ bento_map }}</div>
  {% endif %}
</div>
