{#
/**
 * @file
 * Exhibition reading (paragraph type exhibit_reading): a book or article in
 * a reading list, typeset as a cover. Added to an Image group, it sits in
 * the group's grid like a linked image (paragraph--exhibit-figure.html.twig).
 *
 * - kind: 'book' (a colored cover) or 'article' (a journal offprint).
 * - byline: the author as typed, for the cover; author: the same ending in
 *   a full stop, for the citation.
 * - title, subtitle: a book's title and subtitle (split at the first
 *   colon); an article's whole title, subtitle ''.
 * - source, details: publisher or journal, and year or volume.
 * - size: '' or 'longer', a smaller title on the cover.
 * - link: ['url', 'external'], or NULL.
 * - tone: 1–8, a book cover's color.
 *
 * The cover is set like a real one: a book's author at the head, its title
 * and, smaller, its subtitle under a rule; an article's journal as a
 * masthead, its title and its author. It is decoration (aria-hidden): the
 * caption under it is the full citation (author, title and subtitle,
 * imprint), which a long subtitle may need, as the cover stops it after a
 * few lines. With a link, the whole figure is the link, named by the
 * caption, and an arrow shows in the corner; another site opens in a new
 * tab, like the exhibition's other outside links.
 */
#}
{%
  set classes = [
    'pf-exhibit-figure',
    'pf-exhibit-reading',
    'pf-exhibit-reading--' ~ kind,
    link ? 'pf-exhibit-figure--out',
    not paragraph.isPublished() ? 'paragraph--unpublished',
  ]
%}
{% set id = 'pf-reading-' ~ paragraph.id() %}
{% set cover %}
  <span class="pf-exhibit-figure__frame">
    <span class="pf-exhibit-reading__cover" aria-hidden="true"{% if kind == 'book' %} style="--pf-reading-tone: var(--pf-reading-tone-{{ tone }}); --pf-reading-ink: var(--pf-reading-ink-{{ tone }})"{% endif %}>
      {% if byline %}
        <span class="pf-exhibit-reading__byline">{{ byline }}</span>
      {% endif %}
      {% if kind == 'article' %}
        <span class="pf-exhibit-reading__name{{ size ? ' pf-exhibit-reading__name--' ~ size }}">“{{ title }}”</span>
        {% if source %}
          <span class="pf-exhibit-reading__masthead">{{ source }}</span>
        {% endif %}
      {% else %}
        <span class="pf-exhibit-reading__titles">
          <span class="pf-exhibit-reading__name{{ size ? ' pf-exhibit-reading__name--' ~ size }}">{{ title }}</span>
          {% if subtitle %}
            <span class="pf-exhibit-reading__sub">{{ subtitle }}</span>
          {% endif %}
        </span>
      {% endif %}
    </span>
    {% if link %}
      <svg class="pf-exhibit-figure__zoom" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M5 11 11 5M6 5h5v5"/></svg>
    {% endif %}
  </span>
{% endset %}
{% set imprint = [source, details]|filter(v => v) %}
<figure{{ attributes.addClass(classes) }}>
  {% if link %}
    <a class="pf-exhibit-figure__out" href="{{ link.url }}"
       {% if link.external %}target="_blank" rel="noopener"{% endif %}
       aria-labelledby="{{ id }}-caption{{ link.external ? ' ' ~ id ~ '-note' }}">
      {{ cover }}
      {% if link.external %}
        <span class="visually-hidden" id="{{ id }}-note">{{ '(opens in a new tab)'|t }}</span>
      {% endif %}
    </a>
  {% else %}
    {{ cover }}
  {% endif %}
  <figcaption class="pf-exhibit-figure__caption pf-exhibit-reading__caption" id="{{ id }}-caption">
    {% if author %}
      <span class="pf-exhibit-reading__author">{{ author }}</span>
    {% endif %}
    {% if kind == 'article' %}
      <span class="pf-exhibit-reading__title">“{{ title }}.”</span>
      {% if imprint %}
        <span class="pf-exhibit-reading__imprint">{% if source %}<em>{{ source }}</em>{% endif %}{{ source and details ? ' ' }}{{ details }}.</span>
      {% endif %}
    {% else %}
      <span class="pf-exhibit-reading__title"><em>{{ title }}{{ subtitle ? ': ' ~ subtitle }}</em>.</span>
      {% if imprint %}
        <span class="pf-exhibit-reading__imprint">{{ imprint|join(', ') }}.</span>
      {% endif %}
    {% endif %}
  </figcaption>
</figure>
