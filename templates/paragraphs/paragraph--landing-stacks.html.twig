{#
/**
 * @file
 * From the stacks: a large picture beside three lists, the next events, a
 * featured item and the newest blog posts (the Special Collections
 * homepage's last section).
 *
 * The picture is a stage (js/stacks-stage.js): at rest it shows the
 * Instagram frame, and whichever item the pointer is over, or that has
 * keyboard focus, in any list takes its place (an event's LibCal picture,
 * a post's Image, the feature's cover); an item without a picture brings
 * back Instagram. Decorative: each list item names itself.
 *
 * Instagram: a placeholder in the hatch (the picture, then bars for the
 * title, description and link) until a post embed replaces it. That embed
 * will need to sit outside the stage's aria-hidden, or carry its link in
 * the lists, so screen readers reach it.
 *
 * Variables from palefire_preprocess_paragraph__landing_stacks():
 * - feature: title, url, label (Category terms), note (intro as plain
 *   text), image (portrait cover, or NULL: a hatched frame), or NULL.
 * - events: calendar, campus, endpoint, calendar_url, or NULL. The list is
 *   filled by js/upcoming.js from the events carousel's feed: the next
 *   three events at that campus, or "No upcoming events". Its height is
 *   held while it loads.
 * - posts: title, url, date, datetime, category, image (or NULL).
 *
 * The section <h2> comes from the scroll-section field template, so the
 * lists' headings are <h3>s. data-toc-skip keeps them out of the TOC,
 * which lists the section itself.
 */
#}
{% if feature or events or posts %}
  {% set uid = 'pf-stacks-' ~ paragraph.id() %}
  {{ attach_library('palefire/stacks-stage') }}
  <div{{ attributes.addClass('pf-stacks') }} data-toc-skip>
    <div class="pf-stacks__stage" aria-hidden="true">
      {# The icon is Font Awesome Pro's, inlined from the site's copy as the
         Visit strip's was (no FA CSS or font). #}
      <span class="pf-stacks__frame pf-stacks__frame--instagram is-shown is-home" data-pf-frame="instagram">
        <span class="pf-stacks__ig-media">
          <span class="pf-stacks__ig-icon">{{ source('libraries/fontawesome-pro/svgs/brands/instagram.svg', ignore_missing = true)|raw }}</span>
          <span class="pf-stacks__ig-label">{{ 'Instagram'|t }}</span>
        </span>
        <span class="pf-stacks__ig-caption">
          <span class="pf-stacks__ig-bar pf-stacks__ig-bar--title"></span>
          <span class="pf-stacks__ig-bar"></span>
          <span class="pf-stacks__ig-bar pf-stacks__ig-bar--short"></span>
          <span class="pf-stacks__ig-bar pf-stacks__ig-bar--link"></span>
        </span>
      </span>
      {% if feature.image ?? false %}
        <span class="pf-stacks__frame" data-pf-frame="feature">{{ feature.image }}</span>
      {% endif %}
      {% for post in posts %}
        {% if post.image %}
          <span class="pf-stacks__frame" data-pf-frame="post-{{ loop.index }}">{{ post.image }}</span>
        {% endif %}
      {% endfor %}
    </div>

    <div class="pf-stacks__lists">
      {% if events %}
        <section class="pf-stacks__block" aria-labelledby="{{ uid }}-events">
          <h3 class="pf-stacks__heading" id="{{ uid }}-events">{{ 'Upcoming'|t }}</h3>
          <ol class="pf-upcoming" role="list" aria-busy="true"
              data-pf-upcoming
              data-calendar="{{ events.calendar }}"
              {% if events.campus %}data-campus="{{ events.campus }}"{% endif %}
              data-endpoint="{{ events.endpoint }}"
              data-count="3"
              data-empty="{{ 'No upcoming events at Hill right now.'|t }}"></ol>
          <a class="pf-stacks__more" href="{{ events.calendar_url }}">{{ 'All events'|t }}<span class="visually-hidden"> {{ '(LibCal calendar)'|t }}</span></a>
        </section>
      {% endif %}

      {% if feature %}
        <section class="pf-stacks__block" aria-labelledby="{{ uid }}-feature">
          <h3 class="pf-stacks__heading" id="{{ uid }}-feature">{{ 'Featured'|t }}</h3>
          <ul class="pf-stacks__posts" role="list">
            <li>
              <a class="pf-stacks__post" href="{{ feature.url }}" data-pf-stage="feature">
                {% if feature.label %}
                  <span class="pf-stacks__post-date">{{ feature.label }}</span>
                {% endif %}
                <span class="pf-stacks__post-title">{{ feature.title }}</span>
                {% if feature.note %}
                  <span class="pf-stacks__post-note">{{ feature.note }}</span>
                {% endif %}
              </a>
            </li>
          </ul>
        </section>
      {% endif %}

      {% if posts %}
        <section class="pf-stacks__block" aria-labelledby="{{ uid }}-posts">
          <h3 class="pf-stacks__heading" id="{{ uid }}-posts">{{ 'From the blog'|t }}</h3>
          <ul class="pf-stacks__posts" role="list">
            {% for post in posts %}
              <li>
                <a class="pf-stacks__post" href="{{ post.url }}"{% if post.image %} data-pf-stage="post-{{ loop.index }}"{% endif %}>
                  <span class="pf-stacks__post-date"><time datetime="{{ post.datetime }}">{{ post.date }}</time>{% if post.category %} · {{ post.category }}{% endif %}</span>
                  <span class="pf-stacks__post-title">{{ post.title }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>
  </div>
{% endif %}
