{#
/**
 * @file
 * Exhibition gallery (paragraph type exhibit_page) on a Modular page.
 *
 * Like guide_section, palefire_modular already wraps it in the <section>
 * and its <h2> (field--node--field-scroll-section--modular-page.html.twig),
 * so this prints only what follows the heading; it must not extend
 * paragraph.html.twig. CSS places these parts around the <h2>
 * (_exhibition.scss, .pf-gallery is display: contents).
 *
 * Opening (field_exhibit_opener):
 * - cover (default with a lead; stored as "full"): the lead full screen and
 *   fixed, as on a wall (wall_lead), with the heading, the "In this
 *   gallery" links and the gallery's opening text (moved there by
 *   js/exhibition.js, folded with "Read more") over its lower left.
 * - full (stored as "pan"; the default without a lead): the lead fills the
 *   first screen under the running head
 *   (.pf-exhibit-hero), with the gallery number and <h2> over it and "In
 *   this gallery" links to its entries. Scrolling on, the image stays
 *   pinned while those fade, then pans through the whole image before the
 *   text (and its caption) arrives. Without a lead: the number, heading and
 *   links on the page colour.
 * - compact: the lead as a band above the heading, panning as the page
 *   scrolls, or with lead_whole uncropped and centred (.pf-exhibit-lead).
 *
 * - lead: image values (_palefire_exhibit_image()), or NULL.
 * - lead_caption: rendered caption, or NULL. With one, the image is a
 *   figure: its alt text is announced, it opens in the lightbox like the
 *   other images, and the caption sits under it (in the full opening it
 *   shows only in the lightbox, and labels the figure for screen readers).
 *   Without one it is decorative (alt="", aria-hidden).
 * - focus: object-position keyword for a cropped image. lead_x: the
 *   compact band's pan position.
 * - entries, entries_more: links for the full opening; dom_id: id base.
 * - wall: Display "wall" (_palefire_exhibit_wall()), or NULL. The wall is
 *   printed [hidden] after the blocks: js/exhibition.js shows it and folds
 *   the entries away, and each tile opens its entry in the object view.
 *   Without the script the gallery reads as a story.
 *
 * js/exhibition.js shows one gallery at a time and adds the previous /
 * next links at the foot.
 */
#}
{% set full = opener == 'full' %}
{%
  set classes = [
    'pf-gallery',
    lead ? 'pf-gallery--has-lead',
    full ? 'pf-gallery--opener',
    opener == 'cover' ? 'pf-gallery--cover',
    wall ? 'pf-gallery--wall',
  ]
%}
{% set entry_nav %}
  {% if entries %}
    <nav class="pf-exhibit-opener__nav{{ opener == 'cover' ? ' pf-exhibit-cover__nav' }}" aria-labelledby="{{ dom_id }}-in">
      <p class="pf-exhibit-opener__label" id="{{ dom_id }}-in">{{ 'In this gallery'|t }}</p>
      <ol class="pf-exhibit-opener__links">
        {% for entry in entries %}
          <li><a href="#{{ entry.anchor }}">{{ entry.title }}</a></li>
        {% endfor %}
      </ol>
      {% if entries_more %}
        <details class="pf-exhibit-opener__more">
          <summary>{{ '+ @count more'|t({'@count': entries_more|length}) }}</summary>
          <ol class="pf-exhibit-opener__links" start="{{ entries|length + 1 }}">
            {% for entry in entries_more %}
              <li><a href="#{{ entry.anchor }}">{{ entry.title }}</a></li>
            {% endfor %}
          </ol>
        </details>
      {% endif %}
    </nav>
  {% endif %}
{% endset %}
{% set lightbox_svg %}<svg class="pf-exhibit-figure__zoom" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9"/></svg>{% endset %}
<div{{ attributes.addClass(classes) }} data-pf-exhibit-page>
  {% if full %}
    {% if lead %}
      {# The image stays pinned while the heading and links fade, then pans
         through the whole image (js/exhibition.js sizes the pan from
         data-ratio). With a caption it is announced as a figure and opens
         in the lightbox, which shows the caption (visually hidden here). #}
      <div class="pf-exhibit-hero{{ lead_caption ? ' has-caption' }}" data-pf-hero
           {% if lead.width %}data-ratio="{{ (lead.height / lead.width)|round(4) }}"{% endif %}
           {% if lead_caption %}role="figure" aria-labelledby="{{ dom_id }}-caption"{% else %}aria-hidden="true"{% endif %}>
        <div class="pf-exhibit-hero__stage">
          {% set hero_img %}
            <span class="pf-exhibit-hero__frame">
              <img class="pf-exhibit-hero__img" src="{{ lead.src }}"
                   {% if lead.srcset %}srcset="{{ lead.srcset }}" sizes="{{ lead.sizes }}"{% endif %}
                   {% if lead.width %}width="{{ lead.width }}" height="{{ lead.height }}"{% endif %}
                   style="object-position: {{ focus }}" alt="{{ lead_caption ? lead.alt }}" loading="lazy" decoding="async">
            </span>
          {% endset %}
          {% if lead_caption %}
            <a class="pf-exhibit-hero__link" href="{{ lead.full }}" data-pf-lightbox data-pf-caption="{{ dom_id }}-caption"
               {% if lead.width %}data-width="{{ lead.width }}" data-height="{{ lead.height }}"{% endif %}>
              {{ hero_img }}
              <span class="visually-hidden">{{ '(opens a larger view)'|t }}</span>
              {{ lightbox_svg }}
            </a>
          {% else %}
            {{ hero_img }}
          {% endif %}
        </div>
      </div>
    {% endif %}
    <div class="pf-exhibit-opener">
      {{ entry_nav }}
      <p class="pf-exhibit-opener__actions">
        {% if lead %}
          {# Shown only while the pan is on (_exhibition.scss). #}
          <span class="pf-exhibit-opener__cue" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" focusable="false"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9"/></svg>
            {{ 'Scroll to explore the image'|t }}
          </span>
        {% endif %}
        <a class="pf-exhibit-opener__skip" href="#{{ dom_id }}-text">{{ 'Skip to the text'|t }}</a>
      </p>
    </div>
    {% if lead and lead_caption %}
      <div class="pf-exhibit-hero__caption pf-exhibit-lead__caption pf-guide-prose" id="{{ dom_id }}-caption">{{ lead_caption }}</div>
    {% endif %}
  {% elseif lead %}
    {% set lead_classes = 'pf-exhibit-lead' ~ (lead_whole ? ' pf-exhibit-lead--whole') %}
    {% set lead_img %}
      <img class="pf-exhibit-lead__img" src="{{ lead.src }}"
           {% if lead.srcset %}srcset="{{ lead.srcset }}" sizes="{{ lead.sizes }}"{% endif %}
           {% if lead.width %}width="{{ lead.width }}" height="{{ lead.height }}"{% endif %}
           style="object-position: {{ focus }}; --pf-lead-x: {{ lead_x }}" alt="{{ lead_caption ? lead.alt }}" loading="lazy" decoding="async">
    {% endset %}
    {% if lead_caption %}
      <figure class="{{ lead_classes }} has-caption">
        <a class="pf-exhibit-lead__link" href="{{ lead.full }}" data-pf-lightbox
           {% if lead.width %}data-width="{{ lead.width }}" data-height="{{ lead.height }}"{% endif %}>
          <span class="pf-exhibit-lead__frame">{{ lead_img }}</span>
          <span class="visually-hidden">{{ '(opens a larger view)'|t }}</span>
          {{ lightbox_svg }}
        </a>
        <figcaption class="pf-exhibit-lead__caption pf-guide-prose">{{ lead_caption }}</figcaption>
      </figure>
    {% else %}
      <div class="{{ lead_classes }}" aria-hidden="true">
        <div class="pf-exhibit-lead__frame">{{ lead_img }}</div>
      </div>
    {% endif %}
  {% endif %}
  {% if wall_lead %}
    {# A wall's lead: full screen, with the title, the facts and the intro
       over its lower left on a wash (_exhibition.scss). With a caption it
       is a figure that opens in the lightbox. #}
    {# The frame stays on screen (with its wash) while the text over it
       scrolls, however long the intro once opened. #}
    {% set wall_img %}
      <span class="pf-exhibit-wall-hero__frame">
        <img class="pf-exhibit-wall-hero__img" src="{{ wall_lead.src }}"
             {% if wall_lead.srcset %}srcset="{{ wall_lead.srcset }}" sizes="{{ wall_lead.sizes }}"{% endif %}
             {% if wall_lead.width %}width="{{ wall_lead.width }}" height="{{ wall_lead.height }}"{% endif %}
             style="object-position: {{ focus }}" alt="{{ wall_lead_caption ? wall_lead.alt }}" loading="lazy" decoding="async">
      </span>
    {% endset %}
    <div class="pf-exhibit-wall-hero" data-pf-wall-hero
         {% if wall_lead_caption %}role="figure" aria-labelledby="{{ dom_id }}-caption"{% else %}aria-hidden="true"{% endif %}>
      {% if wall_lead_caption %}
        <a class="pf-exhibit-wall-hero__link" href="{{ wall_lead.full }}" data-pf-lightbox data-pf-caption="{{ dom_id }}-caption"
           {% if wall_lead.width %}data-width="{{ wall_lead.width }}" data-height="{{ wall_lead.height }}"{% endif %}>
          {{ wall_img }}
          <span class="visually-hidden">{{ '(opens a larger view)'|t }}</span>
        </a>
        <div class="visually-hidden" id="{{ dom_id }}-caption">{{ wall_lead_caption }}</div>
      {% else %}
        {{ wall_img }}
      {% endif %}
    </div>
  {% endif %}
  {% if wall and wall.stats %}
    {# A wall's facts under its title, in place of a story's entry links. #}
    <ul class="pf-exhibit-wall__stats">
      {% for stat in wall.stats %}
        <li>{{ stat }}</li>
      {% endfor %}
    </ul>
  {% elseif opener == 'cover' %}
    {# A cover's entry links under its title, on the image. #}
    {{ entry_nav }}
  {% endif %}
  <div class="pf-gallery__body pf-guide" id="{{ dom_id }}-text" tabindex="-1">
    {# The full opening's heading has faded with the image by the time the
       text arrives: the gallery's title again, to open the text. A visual
       repeat only; the <h2> above is the heading for screen readers. #}
    {% if full and lead %}
      <p class="pf-exhibit-body-title" aria-hidden="true">{{ paragraph.field_section_title.value }}</p>
    {% endif %}
    {{ content.field_guide_blocks }}
    {% if wall %}
      <div class="pf-exhibit-wall" data-pf-wall hidden
           {% if wall.sheets %}data-pf-sheets="{{ wall.sheets|json_encode }}"{% endif %}>
        {% if wall.sortable %}
          <div class="pf-exhibit-wall__tools">
            <p class="pf-exhibit-wall__hint">{{ 'Select an entry to view it full screen'|t }}</p>
            <div class="pf-exhibit-wall__sort" role="group" aria-label="{{ 'Order'|t }}">
              <span class="pf-exhibit-wall__sort-label" aria-hidden="true">{{ 'Order'|t }}</span>
              <button type="button" data-pf-sort="plate" aria-pressed="true">{{ 'Plate'|t }}</button>
              <button type="button" data-pf-sort="title" aria-pressed="false">{{ 'A–Z'|t }}</button>
            </div>
          </div>
        {% endif %}
        <ul class="pf-exhibit-wall__list">
          {% for tile in wall.tiles %}
            {% set image = tile.images|first %}
            <li class="pf-exhibit-wall__tile" style="--pf-r: {{ tile.ratio }}" data-pf-tile="{{ tile.anchor }}"
                {% if tile.plate %}data-plate="{{ tile.plate }}"{% endif %}>
              <a class="pf-exhibit-wall__link" href="#{{ tile.anchor }}">
                <span class="pf-exhibit-wall__frame">
                  <img class="pf-exhibit-wall__img" src="{{ image.src }}"
                       {% if image.srcset %}srcset="{{ image.srcset }}" sizes="{{ image.sizes }}"{% endif %}
                       {% if image.width %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}
                       alt="{{ image.alt }}" loading="lazy" decoding="async">
                  {% if tile.images|length > 1 %}
                    {% set second = tile.images|last %}
                    {# The proof crossfades in on hover; the entry is described by the first. #}
                    <img class="pf-exhibit-wall__img pf-exhibit-wall__img--second" src="{{ second.src }}"
                         {% if second.srcset %}srcset="{{ second.srcset }}" sizes="{{ second.sizes }}"{% endif %}
                         alt="" loading="lazy" decoding="async" aria-hidden="true">
                  {% endif %}
                </span>
                <span class="pf-exhibit-wall__label">
                  <span class="pf-exhibit-wall__name">{{ tile.title }}</span>
                  {% if tile.tag %}
                    <span class="pf-exhibit-wall__tag">{{ tile.tag }}</span>
                  {% elseif tile.plate %}
                    <span class="pf-exhibit-wall__tag"><abbr title="{{ 'Plate'|t }}">{{ 'Pl.'|t }}</abbr> {{ tile.plate }}</span>
                  {% endif %}
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</div>
