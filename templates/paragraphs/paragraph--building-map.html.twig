{#
/**
 * @file
 * Building map (paragraph type building_map), rendered inside the landing
 * section under the search form (bento_search.field_bento_map).
 *
 * The editor picks a building; everything else comes from `map`, built by
 * palefire_preprocess_paragraph__building_map() in palefire.theme:
 *   map.uid       id prefix (pf-map-{paragraph id})
 *   map.heading   h3 above the map; data-toc lists it in the TOC in any mode
 *   map.summary   this paragraph's Intro (field_map_intro), under the heading
 *   map.note      the building term's description, above the legend
 *   map.template  the building's drawing (maps/buildings.yml)
 *   map.spaces    key => { key, title, access, access_label, hatch, floor, url, cta, tip, body },
 *                 one per published room term, Floor 1 first
 *   map.here      key of the room this page is about (field_map_here), or ''.
 *                 Its list entry gets aria-current="location" and a "Here"
 *                 badge; building-map.js adds the arrow on the drawing.
 *   map.legend    extra legend entries for icons the drawing uses
 *                 (buildings.yml `legend`, e.g. [elevator])
 *   map.no_key    TRUE on a room's page (paragraph--location-space): the
 *                 drawing alone, without the legend, space list or the
 *                 phone hint; the room is lit and marked with the arrow
 *   map.cache     cache metadata (room terms, overrides); print it
 *
 * Layout (_building-map.scss): heading, intro and legend in a column on
 * the left, the drawing on the right starting level with the heading. While
 * they are side by side the drawing is sticky, so it stays in view while the
 * legend and page scroll (building-map.js turns that off when the drawing is
 * taller than the window). When the map would drop under ~36rem, the
 * drawing moves under the heading, the legend under the drawing, and the
 * legend starts collapsed.
 */
#}
{% if map %}
{{ attach_library('palefire/building-map') }}
{{ map.cache }}
<div{{ attributes.addClass('pf-map', 'pf-map--' ~ map.key|clean_class).setAttribute('aria-labelledby', map.uid ~ '-heading').setAttribute('role', 'region') }} data-pf-map data-pf-track="map"{% if map.here %} data-map-here="{{ map.here }}"{% endif %}>
  {# Inside the grid, so the drawing starts level with the heading. #}
  {# h2 on the landing hero, where the map is a section of the page under
     its h1 (map.heading_tag); h3 elsewhere. data-toc keeps it in the TOC
     either way. #}
  <{{ map.heading_tag }} class="pf-map__heading" id="{{ map.uid }}-heading" data-toc>{{ map.heading }}</{{ map.heading_tag }}>
  {# Summary (this paragraph's Intro) under the heading. On the landing
     hero, Hill Memorial only and wide enough, it sits in the drawing's
     empty top-left corner instead (_landing-hero.scss, "Typography in the
     drawing"). #}
  {# On the hero the drawing's legend follows it: each hatch once (booked
     rooms and rentals share one), then the drawing's other marks. #}
  {% set legend_hatches = map.key_indexed ? {
    walk_in: map.spaces|filter(s => s.access == 'walk_in')|length > 0,
    book: map.spaces|filter(s => s.access == 'appointment')|length > 0,
    rent: map.spaces|filter(s => s.access == 'rental')|length > 0,
  } : {} %}
  {% if map.summary or map.key_indexed %}
    <div class="pf-map__type">
      {% if map.summary %}
        <div class="pf-map__summary">{{ map.summary }}</div>
      {% endif %}
      {% if map.key_indexed %}
        <ul class="pf-map__legend pf-map__legend--hero" aria-label="{{ 'Map legend'|t }}">
          {% if legend_hatches.walk_in %}
            <li><span class="pf-map__swatch" aria-hidden="true"></span>{{ 'Walk in'|t }}</li>
          {% endif %}
          {% if legend_hatches.book or legend_hatches.rent %}
            <li><span class="pf-map__swatch pf-map__swatch--appointment" aria-hidden="true"></span>
              {%- if legend_hatches.book and legend_hatches.rent %}{{ 'Book online or event rental'|t }}
              {%- elseif legend_hatches.book %}{{ 'Book online'|t }}
              {%- else %}{{ 'Event rental'|t }}{% endif -%}
            </li>
          {% endif %}
          {% if 'elevator' in map.legend %}
            <li><svg class="pf-map__legend-icon" viewBox="-66 -40 132 80" aria-hidden="true" focusable="false">{% include '@palefire/includes/map-icon-elevator.svg.twig' %}</svg>{{ 'Elevator'|t }}</li>
          {% endif %}
        </ul>
      {% endif %}
    </div>
  {% endif %}
  {# Aside: the legend and space list, then the note (includes/
     map-key.html.twig). #}
  {% if not map.no_key %}
  <div class="pf-map__aside">
    {% include '@palefire/includes/map-key.html.twig' %}
  </div>
  {% endif %}

  <figure class="pf-map__stage">
    <div class="pf-map__scroller">
      {% include map.template with { uid: map.uid, spaces: map.spaces } only %}
    </div>
    {# Phones only (_building-map.scss): the room names are hidden there and
       building-map.js numbers the rooms and the list to match. In the
       markup from the start, so nothing moves when the script runs. #}
    {% if not map.no_key %}
    <figcaption class="pf-map__hint">
      {# Font Awesome Pro bullseye-pointer (duotone, its rings at the 40%
         .fa-secondary layer, as the Quick Start's icons), inlined from the
         site's /libraries copy like menu--utility.html.twig, so |raw is safe. #}
      <span class="pf-map__hint-icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/bullseye-pointer.svg', ignore_missing = true)|raw }}</span>
      {{ 'Tap a numbered room, or choose a space from the list.'|t }}
    </figcaption>
    {% endif %}
  </figure>

  {# Hidden tooltip sources, one per room (also the regions' aria-describedby).
     building-map.js copies the active one into the visible tooltip. Set as a
     museum wall label: the floor in its own column, then the access, the
     room and its text. The floor column reads "Floor 1" to screen readers,
     so the access line doesn't repeat it. A room's photo is not in its label:
     on the landing it fills the map's background while the room is lit
     (data-map-photo, a URL building-map.js fetches only then). #}
  {% for s in map.spaces %}
    <div class="pf-map__tip-src" id="{{ s.tip }}" data-map-tip="{{ s.key }}"{% if s.photo %} data-map-photo="{{ s.photo }}"{% endif %} hidden>
      <p class="pf-map__tip-floor">
        <span class="pf-map__tip-floor-label">{{ 'Floor'|t }}</span>
        <span class="pf-map__tip-floor-num">{{ s.floor }}</span>
      </p>
      <div class="pf-map__tip-body">
        <div class="pf-map__tip-head">
          <span class="pf-map__swatch{{ s.hatch == 'appointment' ? ' pf-map__swatch--appointment' }}" aria-hidden="true"></span>
          <p class="pf-map__tip-eyebrow">{{ s.access_label }}{% if s.note %} &middot; {{ s.note }}{% endif %}</p>
          {% if s.key == map.here %}<span class="pf-map__here-badge">{{ 'Here'|t }}</span>{% endif %}
        </div>
        <strong class="pf-map__tip-title">{{ s.title }}</strong>
        {% if s.body %}
          <div class="pf-map__tip-text">{{ s.body }}</div>
        {% endif %}
        {% if s.cta %}
          <p class="pf-map__tip-cta">{{ s.cta }}</p>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
{% endif %}
