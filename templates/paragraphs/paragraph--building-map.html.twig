{#
/**
 * @file
 * Building map (paragraph type building_map), rendered inside the landing
 * section under the search form (bento_search.field_bento_map).
 *
 * The editor picks a building; everything else comes from `map`, built by
 * palefire_preprocess_paragraph__building_map() in palefire.theme:
 *   map.uid       id prefix (pf-map-{paragraph id})
 *   map.heading   h3 above the map; data-toc lists it in the TOC in any mode
 *   map.intro     this paragraph's intro, else the building term's description
 *   map.template  the building's drawing (maps/buildings.yml)
 *   map.spaces    key => { key, title, access, floor, url, cta, tip, body },
 *                 one per published room term, Floor 1 first
 *   map.here      key of the room this page is about (field_map_here), or ''.
 *                 Its list entry gets aria-current="location" and a "Here"
 *                 badge; building-map.js adds the arrow on the drawing.
 *   map.legend    extra legend entries for icons the drawing uses
 *                 (buildings.yml `legend`, e.g. [elevator])
 *   map.cache     cache metadata (room terms, overrides); print it
 *
 * Layout (_building-map.scss): heading, intro and legend in a column on
 * the left, the drawing on the right starting level with the heading. While
 * they are side by side the drawing is sticky, so it stays in view while the
 * legend and page scroll (building-map.js turns that off when the drawing is
 * taller than the window). When the map would drop under ~36rem, the
 * drawing moves under the heading, the legend under the drawing, and the
 * legend starts collapsed.
 */
#}
{% if map %}
{{ attach_library('palefire/building-map') }}
{{ map.cache }}
<div{{ attributes.addClass('pf-map', 'pf-map--' ~ map.key|clean_class).setAttribute('aria-labelledby', map.uid ~ '-heading').setAttribute('role', 'region') }} data-pf-map{% if map.here %} data-map-here="{{ map.here }}"{% endif %}>
  {# Inside the grid, so the drawing starts level with the heading. #}
  <h3 class="pf-map__heading" id="{{ map.uid }}-heading" data-toc>{{ map.heading }}</h3>
  <div class="pf-map__aside">
    {% if map.intro %}
      <div class="pf-map__intro">{{ map.intro }}</div>
    {% endif %}

    {# The toggle always shows. Open beside the map, collapsed when it moves
       under the map (building-map.js); the reader can open or close it either
       way. data-toc-skip keeps anything in here out of the TOC. #}
    <details class="pf-map__key" open data-map-key data-toc-skip>
      <summary class="pf-map__key-toggle">
        <span>{{ 'Legend & spaces'|t }}</span>
        <span class="pf-map__key-count">{{ '@count spaces'|t({'@count': map.spaces|length}) }}</span>
        <span class="pf-map__key-icon" aria-hidden="true"></span>
      </summary>
      <div class="pf-map__key-body">
        <ul class="pf-map__legend">
          <li><span class="pf-map__swatch" aria-hidden="true"></span>{{ 'Public walk-in'|t }}</li>
          <li><span class="pf-map__swatch pf-map__swatch--appointment" aria-hidden="true"></span>{{ 'Request an appointment'|t }}</li>
          {% if 'elevator' in map.legend %}
            <li><svg class="pf-map__legend-icon" viewBox="-66 -40 132 80" aria-hidden="true" focusable="false">{% include '@palefire/includes/map-icon-elevator.svg.twig' %}</svg>{{ 'Elevator'|t }}</li>
          {% endif %}
        </ul>

        {# Same rooms as the drawing's regions: the keyboard / small-screen route in. #}
        <div class="pf-map__list">
          {% for group in [
            { access: 'walk_in', title: 'Walk in'|t },
            { access: 'appointment', title: 'By appointment'|t },
          ] %}
            {% set group_spaces = map.spaces|filter(s => s.access == group.access) %}
            {% if group_spaces %}
              <div class="pf-map__group">
                <h4 class="pf-map__group-title">{{ group.title }}</h4>
                <ul>
                  {% for s in group_spaces %}
                    {# Rooms without a link are buttons: they show the tooltip. #}
                    {% set tag = s.url ? 'a' : 'button' %}
                    <li>
                      <{{ tag }} class="pf-map__item" data-map-region="{{ s.key }}" aria-describedby="{{ s.tip }}"{% if s.url %} href="{{ s.url }}"{% else %} type="button"{% endif %}{% if s.key == map.here %} aria-current="location"{% endif %}>
                        <span class="pf-map__swatch{{ s.access == 'appointment' ? ' pf-map__swatch--appointment' }}" aria-hidden="true"></span>
                        <span class="pf-map__item-name">{{ s.title }}</span>
                        {% if s.key == map.here %}<span class="pf-map__here-badge">{{ 'Here'|t }}</span>{% endif %}
                        <span class="pf-map__item-floor">{{ 'Floor @n'|t({'@n': s.floor}) }}</span>
                      </{{ tag }}>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </details>
  </div>

  <figure class="pf-map__stage">
    <div class="pf-map__scroller">
      {% include map.template with { uid: map.uid, spaces: map.spaces } only %}
    </div>
    {# Phones only (_building-map.scss): the room names are hidden there and
       building-map.js numbers the rooms and the list to match. In the
       markup from the start, so nothing moves when the script runs. #}
    <figcaption class="pf-map__hint">
      <span class="pf-map__hint-dot" aria-hidden="true">1</span>
      {{ 'Tap a numbered room, or choose a space from the list.'|t }}
    </figcaption>
  </figure>

  {# Hidden tooltip sources, one per room (also the regions' aria-describedby).
     building-map.js copies the active one into the visible tooltip. #}
  {% for s in map.spaces %}
    <div class="pf-map__tip-src" id="{{ s.tip }}" data-map-tip="{{ s.key }}" hidden>
      <div class="pf-map__tip-head">
        <span class="pf-map__swatch{{ s.access == 'appointment' ? ' pf-map__swatch--appointment' }}" aria-hidden="true"></span>
        <p class="pf-map__tip-eyebrow">
          {{ 'Floor @n'|t({'@n': s.floor}) }} &middot; {{ s.access == 'appointment' ? 'By appointment'|t : 'Public walk-in'|t }}
        </p>
      </div>
      <strong class="pf-map__tip-title">{{ s.title }}</strong>
      {% if s.key == map.here %}<span class="pf-map__here-badge">{{ 'Here'|t }}</span>{% endif %}
      {% if s.body %}
        <div class="pf-map__tip-text">{{ s.body }}</div>
      {% endif %}
      {% if s.cta %}
        <p class="pf-map__tip-cta">{{ s.cta }}</p>
      {% endif %}
    </div>
  {% endfor %}
</div>
{% endif %}
