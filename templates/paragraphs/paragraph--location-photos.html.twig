{#
/**
 * @file
 * Location: photos (paragraph type location_photos), "The room" on a
 * room's page.
 *
 * Variables from palefire_preprocess_paragraph__location_photos():
 * - photos: the section's Photos (field_location_photos), each with src,
 *   width, height, alt, caption (its media name, "Lecture") and note (the
 *   room's detail of that name, "Lecture: xx seats", or '').
 *
 * The section <h2>, its index rule and lede come from the scroll-section
 * field template (_palefire_location_index()). Three across at 4:5 from
 * md; below it the first leads at 4:3 and the rest pair up. Each is
 * captioned in the label voice (_location.scss). The first is also the
 * photo behind the page's top when the room term has none of its own.
 *
 * Each photo opens in the full-screen viewer, as an exhibition's or a
 * guide's pictures do (js/guide-gallery.js, data-pf-gallery: the arrows
 * step through the room's photos, the caption beside). Without the script
 * the link opens the original.
 *
 * With no photos yet, three empty frames in their place, captioned "Photo
 * coming soon", so the section keeps its shape until they are added.
 */
#}
{% if photos %}
  {{ attach_library('palefire/guide-gallery') }}
  <ul{{ attributes.addClass('pf-location__photos').setAttribute('data-pf-gallery', '') }}>
    {% for photo in photos %}
      <li>
        <figure class="pf-location__photo">
          <a class="pf-location__photo-link" href="{{ photo.full }}" data-pf-lightbox
             {%- if photo.full_width %} data-width="{{ photo.full_width }}" data-height="{{ photo.full_height }}"{% endif %}>
            <img src="{{ photo.src }}" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ photo.alt }}" loading="lazy" decoding="async">
            <span class="visually-hidden">{{ '(opens a larger view)'|t }}</span>
            <svg class="pf-location__photo-zoom" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9"/></svg>
          </a>
          {% if photo.caption %}
            <figcaption>
              {{- photo.caption -}}
              {%- if photo.note %}<span class="visually-hidden">, </span><span class="pf-location__photo-note">{{ photo.note }}</span>{% endif -%}
            </figcaption>
          {% endif %}
        </figure>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <ul{{ attributes.addClass('pf-location__photos') }}>
    {# One caption read aloud, not three. #}
    {% for i in 1..3 %}
      <li{% if not loop.first %} aria-hidden="true"{% endif %}>
        <figure class="pf-location__photo">
          <span class="pf-location__frame">{% include '@palefire/includes/space-icon.html.twig' with { icon: 'camera' } only %}</span>
          <figcaption>{{ 'Photo coming soon'|t }}</figcaption>
        </figure>
      </li>
    {% endfor %}
  </ul>
{% endif %}
