{#
/**
 * @file
 * Tile showcase section: Tile nodes and Modular pages as image cards, or as
 * a numbered list.
 *
 * Variables from palefire_preprocess_paragraph__tile_showcase():
 * - layout: 'stagger' (tall cards, offset rhythm), 'grid' (3 / 2 / 1
 *   columns), 'index' (numbered rows, no pictures) or 'masonry' (tall
 *   cards, with a Grid / Masonry / List switch).
 * - tiles: title, url, label (Category terms, "Dept + Medium"; the index's
 *   rows), labels (the same terms, a label apiece on the cards), note (the
 *   intro as plain text; index only), image.
 *
 * The section <h2> comes from the scroll-section field template, so each
 * card is an <h3>. The title comes first in the source so the link's name
 * starts with it ("Oral History, Dept + Medium"); CSS shows the label above.
 * role="list" keeps list semantics in Safari, which drops them when
 * list-style is none.
 *
 * Masonry: the cards in the hero banners' voice (mixed case), with a
 * switch for the visitor: Grid (even cards, the label under the picture;
 * the default), Masonry (columns of mixed heights, the pill above the
 * title) or List (a thumbnail, title, note and label per row). One list
 * for all three; js/tile-views.js sets data-pf-view on the wrapper and
 * shows the switch, which stays hidden without it (the grid is the page
 * as written). aria-pressed buttons
 * in a labelled group, as the exhibition's view controls.
 *
 * Index: the same list, each row a link with its number (decorative: the
 * list is ordered, which screen readers already announce), title, note and
 * label, and an arrow that slides on hover. An <ol>, as the numbers say.
 *
 * Outline: a card with no image draws the page it links to instead, as a
 * desktop shows it, photographed on a desk at an angle and blurred: the
 * "On this page" rail on the left, then the title, intro and first
 * sections (tile.outline), cut off by the card's right edge, in the
 * reading swatch's colours. Most guides have no cover. Decorative, so
 * aria-hidden like the pictures; the link is still named by its <h3>.
 *
 * "On this page": each card is a sub-link under its section, as in the
 * concept. The <li> is the target (data-toc), not the <h3>: modular-toc.js
 * gives its target tabindex="-1", and a focusable heading inside the link
 * would be nested-interactive. data-toc-skip on the wrapper keeps the h3s
 * from being listed a second time on modes that list every h3.
 */
#}
{# The card's Category terms as one square label, as the hero banners
   show them ("Digital Exhibition", "Dept + Medium": _palefire_card_label()),
   read as ", Digital Exhibition" after the title. #}
{% macro labels(tile) %}
  {% if tile.label %}
    <span class="pf-tile__labels">
      <span class="pf-tile__label"><span class="visually-hidden">, </span>{{ tile.label }}</span>
    </span>
  {% endif %}
{% endmacro %}
{% macro outline(tile) %}
  <span class="pf-tile__outline" aria-hidden="true">
    {% if tile.outline %}
      <span class="pf-tile__outline-toc">
        <span class="pf-tile__outline-toc-label">{{ 'On this page'|t }}</span>
        {% for section in tile.outline %}
          <span class="pf-tile__outline-toc-item">{{ section.heading }}</span>
        {% endfor %}
      </span>
    {% endif %}
    <span class="pf-tile__outline-page">
      <span class="pf-tile__outline-title">{{ tile.title }}</span>
      {% if tile.note %}
        <span class="pf-tile__outline-intro">{{ tile.note }}</span>
      {% endif %}
      {% for section in tile.outline %}
        <span class="pf-tile__outline-heading">{{ section.heading }}</span>
        {% for line in section.lines %}
          <span class="pf-tile__outline-{{ line.kind }}">{{ line.text }}</span>
        {% endfor %}
      {% endfor %}
    </span>
  </span>
{% endmacro %}
{% if tiles %}
  {# Scroll-in animation, as on the concept page, once per page load
     (skipped for reduced motion). #}
  {{ attach_library('palefire/tile-reveal') }}
  <div{{ attributes.addClass('pf-tiles', 'pf-tiles--' ~ layout) }} data-toc-skip{% if layout == 'masonry' %} data-pf-view="grid"{% endif %}>
    {% if layout == 'index' %}
      <ol class="pf-tiles__list" role="list">
        {% for tile in tiles %}
          <li class="pf-tiles__item" data-toc data-toc-label="{{ tile.title }}">
            <a class="pf-tile-row" href="{{ tile.url }}">
              <span class="pf-tile-row__number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
              <span class="pf-tile-row__text">
                <h3 class="pf-tile-row__title">{{ tile.title }}</h3>
                {% if tile.note %}
                  <span class="pf-tile-row__note"><span class="visually-hidden">, </span>{{ tile.note }}</span>
                {% endif %}
              </span>
              {% if tile.label %}
                <span class="pf-tile-row__label"><span class="visually-hidden">, </span>{{ tile.label }}</span>
              {% endif %}
              <svg class="pf-tile-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
            </a>
          </li>
        {% endfor %}
      </ol>
    {% elseif layout == 'masonry' %}
      {{ attach_library('palefire/tile-views') }}
      {% set views = {
        grid: { label: 'Grid'|t, icon: '<rect x="3" y="3" width="7.5" height="7.5"/><rect x="13.5" y="3" width="7.5" height="7.5"/><rect x="3" y="13.5" width="7.5" height="7.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5"/>' },
        masonry: { label: 'Masonry'|t, icon: '<rect x="3" y="3" width="5" height="11"/><rect x="3" y="17" width="5" height="4"/><rect x="10" y="3" width="5" height="6"/><rect x="10" y="12" width="5" height="9"/><rect x="17" y="3" width="4" height="13"/>' },
        list: { label: 'List'|t, icon: '<path d="M3 5h18M3 12h18M3 19h18"/>' },
      } %}
      <div class="pf-tiles__views" role="group" aria-label="{{ 'Show as'|t }}" hidden>
        {% for key, view in views %}
          <button type="button" class="pf-tiles__view" data-pf-view="{{ key }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ view.icon|raw }}</svg>
            <span>{{ view.label }}</span>
          </button>
        {% endfor %}
      </div>
      <ul class="pf-tiles__list" role="list">
        {% for tile in tiles %}
          <li class="pf-tiles__item" data-toc data-toc-label="{{ tile.title }}">
            <a class="pf-tile pf-tile--banner{{ tile.image ? '' : ' pf-tile--no-image' }}" href="{{ tile.url }}">
              <span class="pf-tile__media">{{ tile.image ?: _self.outline(tile) }}</span>
              <span class="pf-tile__body">
                <h3 class="pf-tile__title">{{ tile.title }}</h3>
                {% if tile.note %}
                  <span class="pf-tile__note"><span class="visually-hidden">, </span>{{ tile.note }}</span>
                {% endif %}
                {{ _self.labels(tile) }}
              </span>
              <svg class="pf-tile__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <ul class="pf-tiles__list" role="list">
        {% for tile in tiles %}
          <li class="pf-tiles__item" data-toc data-toc-label="{{ tile.title }}">
            <a class="pf-tile{{ tile.image ? '' : ' pf-tile--no-image' }}" href="{{ tile.url }}">
              <span class="pf-tile__media">{{ tile.image ?: _self.outline(tile) }}</span>
              <span class="pf-tile__body">
                <h3 class="pf-tile__title">{{ tile.title }}</h3>
                {{ _self.labels(tile) }}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endif %}
