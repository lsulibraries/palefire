{#
/**
 * @file
 * Location: hours and directions (paragraph type location_visit).
 *
 * Variables from palefire_preprocess_paragraph__location_visit():
 * - visit: the page's hours and directions (field_hours_location and the
 *   rest, _palefire_landing_visit()), or NULL.
 * - uid: the page's Location id, so the hours line under the title jumps
 *   here (uid-visit-hours).
 *
 * The section <h2>, its index rule (with Directions) and lede come from
 * the scroll-section field template (_palefire_location_index()). The
 * Visit strip's hours without its frame or its Google map (the building
 * map at the top shows the way in, Open in Google Maps the way there):
 * today's status, the week, then the links on one line.
 */
#}
{% if visit and (visit.lid or visit.maps_url or visit.parking_url) %}
  <div{{ attributes.addClass('pf-location__visit') }}>
    {% if visit.lid %}
      {# visit-hours.js fills the status and the week. #}
      <div class="pf-visit__hours" data-pf-hours data-lid="{{ visit.lid }}">
        <p class="pf-visit__status" id="{{ uid }}-visit-hours" tabindex="-1" aria-live="polite">
          <span class="pf-visit__dot" aria-hidden="true"></span>
          <span class="pf-visit__status-label" data-pf-hours-status>{{ 'Hours'|t }}</span>
          <span class="pf-visit__today" data-pf-hours-today></span>
        </p>
        <div class="pf-visit__week">
          <h3 class="pf-visit__week-title" data-pf-hours-week-label>{{ 'This week'|t }}</h3>
          <ol class="pf-visit__days" data-pf-hours-week>
            {% for i in 1..7 %}<li class="pf-visit__day" aria-hidden="true">&nbsp;</li>{% endfor %}
          </ol>
        </div>
      </div>
    {% endif %}
    <p class="pf-location__visit-links">
      {% if visit.lid %}
        <a class="pf-visit__link" href="https://lsu.libcal.com/hours">
          {{- 'All library hours'|t -}}
          <svg class="pf-visit__ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h7v7M13 3 4 12"/></svg>
        </a>
      {% endif %}
      {% if visit.maps_url %}
        <a class="pf-visit__link" href="{{ visit.maps_url }}" target="_blank" rel="noopener">
          {{- 'Open in Google Maps'|t -}}
          <svg class="pf-visit__ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h7v7M13 3 4 12"/></svg><span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span>
        </a>
      {% endif %}
      {% if visit.parking_url %}
        <a class="pf-visit__link" href="{{ visit.parking_url }}">
          {{- 'Parking & travel'|t -}}
          {%- if visit.name %}<span class="visually-hidden"> {{ 'to @place'|t({'@place': visit.name}) }}</span>{% endif -%}
          <svg class="pf-visit__ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      {% endif %}
    </p>
  </div>
{% endif %}
