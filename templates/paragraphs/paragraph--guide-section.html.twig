{#
/**
 * @file
 * Guide section (paragraph type guide_section) on a Modular page.
 *
 * palefire_modular already wraps each field_scroll_section item in the
 * <section>, its <h2> and its optional background
 * (field--node--field-scroll-section--modular-page.html.twig), so this
 * template prints only the section's blocks. It must not extend
 * paragraph.html.twig: that template would add a second <section> and <h2>,
 * because PalefireHooks::preprocessParagraph() treats any paragraph with
 * field_section_title as an older field_sections section.
 *
 * Blocks: guide_text, resource_list, guide_accordion, librarian_card,
 * guide_video, exhibit_gallery (an image group, with its own lightbox in a
 * guide). Each prints its heading as an <h3>, which modular-toc.js lists
 * under the section in guide mode.
 *
 * Wide section (field_section_wide, palefire_guide_wide_setup.php): adds
 * .pf-guide--wide and its stylesheet, palefire/guide-wide, only when ticked.
 */
#}
{% set wide = paragraph.hasField('field_section_wide') and paragraph.field_section_wide.value %}
{% if wide %}
  {{ attach_library('palefire/guide-wide') }}
{% endif %}
<div{{ attributes.addClass('pf-guide', wide ? 'pf-guide--wide') }}>
  {{ content.field_guide_blocks }}
</div>
