{#
/**
 * @file
 * Palefire page template.
 *
 * Landmarks: banner (header) > navigation (menus) | main | complementary
 * (sidebar) | contentinfo (footer). Every region is optional.
 *
 * Top bar, left to right: Header (logo) | Primary menu | Utility menu (icons).
 * Below the Bootstrap "lg" breakpoint (992px) the primary menu collapses
 * behind a toggle button and drops beneath the top bar. Utility icons that
 * have a panel (search, hours, ask us, accounts, settings) open it as an
 * offcanvas drawer from the left
 * (templates/includes/utility-panels.html.twig).
 *
 * Extra variables (PalefireHooks::preprocessPage()):
 * - is_modular_page: TRUE on "modular_page" nodes.
 * - modular_title_in_bento: TRUE when the first section is a bento search,
 *   which then prints the page <h1> itself.
 *
 * Modular pages: the "On this page" TOC is palefire_modular's block, placed
 * in the modular_sidebar region. The region is rendered once into a variable
 * so an empty TOC (Form mode, or no titled sections) leaves no empty column.
 * Below lg the TOC column is a Bootstrap offcanvas opened by the "On this
 * page" button; from lg up it is a sticky left column. The TOC comes before
 * <main> so keyboard and screen-reader users reach it first.
 *
 * Modular pages are full bleed: no container, no row gutters. The body is a
 * CSS grid (.pf-modular in _modular.scss): sidebar width + the rest from lg
 * up, or a single full-width column when there is no sidebar. Other pages
 * keep the container-xxl + Bootstrap row layout.
 *
 * Full-page backgrounds: on modular pages, section background images and
 * bento background videos run past their section, left under the frosted
 * TOC sidebar (pf-modular--has-toc, lg and up) and, for the first section,
 * up under the frosted top bar. Only the decorative layer grows; the
 * sections and their content keep their place in the main column.
 *
 * Swup page transitions (js/palefire-swup.js, anonymous visitors only) swap
 * #swup (breadcrumb + body) and #pf-primary-menu (active trail) on each
 * visit. The header shell and footer persist between pages.
 *
 * @see html.html.twig
 */
#}
{% set modular_toc = is_modular_page ? page.modular_sidebar|render : '' %}
{% set has_toc = is_modular_page and modular_toc|striptags|trim is not empty %}
{% set has_sidebar = page.sidebar or has_toc %}
{% set toc_first = has_sidebar and is_modular_page %}

{% if is_modular_page %}
  {% set body_classes = 'pf-body pf-body--modular flex-grow-1' %}
  {% set row_classes = 'pf-modular' ~ (has_sidebar ? ' pf-modular--has-sidebar') ~ (has_toc ? ' pf-modular--has-toc') %}
  {% set main_classes = 'pf-main' %}
{% else %}
  {% set body_classes = 'pf-body container-xxl flex-grow-1' %}
  {% set row_classes = 'row g-4 g-lg-5' %}
  {% set main_classes = 'pf-main ' ~ (has_sidebar ? 'col-lg-9' : 'col-12') %}
{% endif %}

{% if not logged_in %}
  {{ attach_library('palefire/swup') }}
{% endif %}

<div class="pf-page position-relative d-flex flex-column min-vh-100">
  {# Scroll marker: when it leaves the viewport, the header turns compact
     (js/palefire.js, palefireHeaderCompact). #}
  <div class="pf-header-sentinel" aria-hidden="true"></div>

  <header class="pf-header sticky-top">
    <div class="navbar navbar-expand-lg">
      {# Full-width top bar: container-fluid instead of container-xxl.
         Side padding grows with the viewport ($pf-header-gutters). #}
      <div class="container-fluid pf-header__inner">
        {# Logo. A block placed in the Header region (Site branding) wins;
           with the region empty, the theme prints the inline LSU Libraries
           wordmark itself, so the logo needs no block layout config. #}
        <div class="pf-header__brand">
          {% if page.header %}
            {{ page.header }}
          {% else %}
            <a href="{{ path('<front>') }}" rel="home" class="navbar-brand pf-brand d-inline-flex align-items-center me-0">
              {% include '@palefire/includes/logo-lsu-libraries.svg.twig' %}
              <span class="visually-hidden">{{ 'LSU Libraries home'|t }}</span>
            </a>
          {% endif %}
        </div>

        {% if page.primary_menu %}
          {# DOM order = desktop visual order; mobile reorders with order-*.
             Below lg: a labelled Menu button opens the menu as a drawer from
             the left, like the utility drawers (Bootstrap offcanvas; from lg
             up .navbar-expand-lg shows the same element inline in the bar).
             Inside: quick links to the other drawers (filled from the
             utility menu by palefireMenuActions, js/palefire.js), then the
             menu, each section a toggle over its pages. Styles: the "Phones
             and tablets" part of _header.scss. #}
          <button class="navbar-toggler pf-menu-toggle order-2 order-lg-0" type="button"
                  data-bs-toggle="offcanvas" data-bs-target="#pf-primary-menu"
                  aria-controls="pf-primary-menu">
            <span class="pf-menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
            <span class="pf-menu-toggle__text">{{ 'Menu'|t }}</span>
          </button>
          <div class="offcanvas offcanvas-start pf-menu-drawer order-3 order-lg-0" id="pf-primary-menu" tabindex="-1"
               aria-labelledby="pf-primary-menu-title">
            <div class="pf-panel__header offcanvas-header">
              <h2 class="pf-panel__title" id="pf-primary-menu-title">{{ 'Menu'|t }}</h2>
              <button type="button" class="pf-panel__close" data-bs-dismiss="offcanvas">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span class="visually-hidden">{{ 'Close menu'|t }}</span>
              </button>
            </div>
            <div class="offcanvas-body pf-menu-sheet">
              {% if page.utility_menu %}
                <nav class="pf-menu-actions" aria-label="{{ 'Quick links'|t }}" data-pf-menu-actions hidden>
                  <ul class="pf-menu-actions__list"></ul>
                </nav>
              {% endif %}
              {{ page.primary_menu }}
              {# Reading colours, so they can be changed from the menu on a
                 phone: copies of the Settings drawer's swatches, built and
                 kept in step by initMenuThemes (js/utility-panels.js). Below
                 lg only. #}
              {% if page.utility_menu %}
                <fieldset class="pf-menu-themes" data-pf-menu-themes hidden>
                  <legend class="pf-menu-themes__legend">{{ 'Reading colours'|t }}</legend>
                  <div class="pf-settings__themes" id="pf-menu-themes-grid" data-pf-menu-themes-grid></div>
                  <button type="button" class="pf-settings__more" aria-controls="pf-menu-themes-grid" aria-expanded="false" data-pf-themes-more hidden>
                    <span data-pf-themes-more-label>{{ 'More colours'|t }}</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                </fieldset>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if page.utility_menu %}
          <div class="pf-header__utility order-1 order-lg-0 ms-auto">
            {{ page.utility_menu }}
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {# Utility panels: Bootstrap offcanvas drawers (from the left) opened by
     the utility menu's icons (menu--utility.html.twig). Printed outside
     the header on purpose: the header's backdrop-filter would make it the
     containing block of the fixed drawers and clip them to the bar. They
     also sit outside #swup, so Swup visits keep them (and their clock). #}
  {% if page.utility_menu %}
    {{ attach_library('palefire/utility-panels') }}
    {% include '@palefire/includes/utility-panels.html.twig' %}
  {% endif %}

  <div id="swup" class="pf-swup transition-fade d-flex flex-column flex-grow-1">
    {# Modular pages print the breadcrumb inside <main>, above the first
       section (see below), so it lines up with the content column, not
       across the TOC sidebar. #}
    {% if page.breadcrumb and not is_modular_page %}
      <div class="pf-breadcrumb container-xxl">
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    <div class="{{ body_classes }}">
      <div class="{{ row_classes }}">
        {# Modular pages: TOC (and any sidebar blocks) before <main>. #}
        {% if toc_first %}
          <aside id="pf-modular-sidebar"
                 class="pf-sidebar pf-sidebar--toc{{ has_toc ? ' pf-modular__sidebar offcanvas-lg offcanvas-start' }}"
                 {% if has_toc %}tabindex="-1"{% endif %}
                 aria-label="{{ 'Page navigation'|t }}">
            {% if has_toc %}
              {# lg and up the TOC is always shown: it is the page's main
                 navigation, so there is no hide/show button. Below lg it is
                 an offcanvas opened by the list-icon button. #}
              <div class="offcanvas-header">
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#pf-modular-sidebar"
                        aria-label="{{ 'Close'|t }}"></button>
              </div>
              <div class="offcanvas-body" id="pf-modular-sidebar-body">
                {{ modular_toc }}
                {{ page.sidebar }}
              </div>
            {% else %}
              {{ page.sidebar }}
            {% endif %}
          </aside>
        {% endif %}

        <main id="main-content" tabindex="-1" class="{{ main_classes }}">
          {# Modular page head: breadcrumb, then the page's <h1>, at the top
             of the content column and over the first section's bleed.
             - Breadcrumb: the same "breadcrumb" region and System Breadcrumb
               block as other pages, on the line of the TOC's title.
             - <h1>: the node title, printed here so every Modular page has
               one, unless the first section is a bento search: then the
               bento prints it right above its intro. The Page title block is suppressed on these pages
               (PalefireHooks::preprocessBlock()), so placing it can't add a
               second <h1>.
             It has no snap point of its own: the first section's snap point
             is moved up to the top of the page (_modular.scss), so the head
             and the first section snap as one screen.
             Styles: .pf-modular__head (_layout.scss). #}
          {% if is_modular_page %}
            <header class="pf-modular__head">
              {% if page.breadcrumb %}
                <div class="pf-breadcrumb pf-breadcrumb--modular">
                  {{ page.breadcrumb }}
                </div>
              {% endif %}
              {# When the first section is a bento search, the bento prints
                 the <h1> above its intro (paragraph--bento-search.html.twig)
                 and this one is left out (modular_title_in_bento,
                 PalefireHooks::preprocessPage()). #}
              {% if node.label and not modular_title_in_bento %}
                <h1 class="pf-modular__title">{{ node.label }}</h1>
              {% endif %}
              {# Guide mode: intro, owner, updated date, subjects
                 (includes/guide-head.html.twig). #}
              {% if guide_head %}
                {% include '@palefire/includes/guide-head.html.twig' with { head: guide_head } only %}
              {% endif %}
            </header>
          {% endif %}
          {% if has_toc %}
            {# Below lg: a square list icon that opens the TOC offcanvas (lg
               and up the TOC is always shown); the name stays for screen
               readers and shows as a tooltip. #}
            <button class="pf-modular__toc-toggle btn btn-outline-secondary d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#pf-modular-sidebar" aria-controls="pf-modular-sidebar"
                    title="{{ 'Table of contents'|t }}">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m-3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/></svg>
              <span class="visually-hidden">{{ 'Table of contents'|t }}</span>
            </button>
          {% endif %}
          {{ page.highlighted }}
          {{ page.content }}
        </main>

        {% if has_sidebar and not toc_first %}
          <aside class="pf-sidebar col-lg-3">
            {{ page.sidebar }}
          </aside>
        {% endif %}
      </div>
    </div>
  </div>{# /#swup #}

  {% if page.footer %}
    <footer class="pf-footer mt-auto" data-bs-theme="dark">
      <div class="container-xxl py-5">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}
</div>
