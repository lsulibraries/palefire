{#
/**
 * @file
 * Palefire page template.
 *
 * Landmarks: banner (header) > navigation (menus) | main | complementary
 * (sidebar) | contentinfo (footer). Every region is optional.
 *
 * Top bar, left to right: Header (logo) | Primary menu | Utility menu (icons).
 * Below the Bootstrap "lg" breakpoint (992px) the primary menu collapses
 * behind a toggle button and drops beneath the top bar.
 *
 * Extra variables (PalefireHooks::preprocessPage()):
 * - is_modular_page: TRUE on "modular_page" nodes.
 *
 * Modular pages: the "On this page" TOC is palefire_modular's block, placed
 * in the modular_sidebar region. The region is rendered once into a variable
 * so an empty TOC (Form mode, or no titled sections) leaves no empty column.
 * Below lg the TOC column is a Bootstrap offcanvas opened by the "On this
 * page" button; from lg up it is a sticky left column. The TOC comes before
 * <main> so keyboard and screen-reader users reach it first.
 *
 * Modular pages are full bleed: no container, no row gutters. The body is a
 * CSS grid (.pf-modular in _modular.scss): sidebar width + the rest from lg
 * up, or a single full-width column when there is no sidebar. Other pages
 * keep the container-xxl + Bootstrap row layout.
 *
 * Full-page backgrounds: on modular pages, section background images and
 * bento background videos run past their section, left under the frosted
 * TOC sidebar (pf-modular--has-toc, lg and up) and, for the first section,
 * up under the frosted top bar. Only the decorative layer grows; the
 * sections and their content keep their place in the main column.
 *
 * Swup page transitions (js/palefire-swup.js, anonymous visitors only) swap
 * #swup (breadcrumb + body) and #pf-primary-menu (active trail) on each
 * visit. The header shell and footer persist between pages.
 *
 * @see html.html.twig
 */
#}
{% set modular_toc = is_modular_page ? page.modular_sidebar|render : '' %}
{% set has_toc = is_modular_page and modular_toc|striptags|trim is not empty %}
{% set has_sidebar = page.sidebar or has_toc %}
{% set toc_first = has_sidebar and is_modular_page %}

{% if is_modular_page %}
  {% set body_classes = 'pf-body pf-body--modular flex-grow-1' %}
  {% set row_classes = 'pf-modular' ~ (has_sidebar ? ' pf-modular--has-sidebar') ~ (has_toc ? ' pf-modular--has-toc') %}
  {% set main_classes = 'pf-main' %}
{% else %}
  {% set body_classes = 'pf-body container-xxl flex-grow-1' %}
  {% set row_classes = 'row g-4 g-lg-5' %}
  {% set main_classes = 'pf-main ' ~ (has_sidebar ? 'col-lg-9' : 'col-12') %}
{% endif %}

{% if not logged_in %}
  {{ attach_library('palefire/swup') }}
{% endif %}

<div class="pf-page position-relative d-flex flex-column min-vh-100">
  {# Scroll marker: when it leaves the viewport, the header turns compact
     (js/palefire.js, palefireHeaderCompact). #}
  <div class="pf-header-sentinel" aria-hidden="true"></div>

  <header class="pf-header sticky-top">
    <div class="navbar navbar-expand-lg">
      {# Full-width top bar: container-fluid instead of container-xxl.
         Side padding grows with the viewport ($pf-header-gutters). #}
      <div class="container-fluid pf-header__inner">
        {% if page.header %}
          <div class="pf-header__brand me-lg-4">
            {{ page.header }}
          </div>
        {% endif %}

        {% if page.primary_menu %}
          {# DOM order = desktop visual order; mobile reorders with order-*. #}
          <button class="navbar-toggler order-2 order-lg-0 ms-2" type="button"
                  data-bs-toggle="collapse" data-bs-target="#pf-primary-menu"
                  aria-controls="pf-primary-menu" aria-expanded="false">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
            <span class="visually-hidden">{{ 'Main menu'|t }}</span>
          </button>
          <div class="collapse navbar-collapse order-3 order-lg-0" id="pf-primary-menu">
            {{ page.primary_menu }}
          </div>
        {% endif %}

        {% if page.utility_menu %}
          <div class="pf-header__utility order-1 order-lg-0 ms-auto">
            {{ page.utility_menu }}
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  <div id="swup" class="pf-swup transition-fade d-flex flex-column flex-grow-1">
    {# Modular pages print the breadcrumb inside <main>, above the first
       section (see below), so it lines up with the content column, not
       across the TOC sidebar. #}
    {% if page.breadcrumb and not is_modular_page %}
      <div class="pf-breadcrumb container-xxl">
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    <div class="{{ body_classes }}">
      <div class="{{ row_classes }}">
        {# Modular pages: TOC (and any sidebar blocks) before <main>. #}
        {% if toc_first %}
          <aside id="pf-modular-sidebar"
                 class="pf-sidebar pf-sidebar--toc{{ has_toc ? ' pf-modular__sidebar offcanvas-lg offcanvas-start' }}"
                 {% if has_toc %}tabindex="-1"{% endif %}
                 aria-label="{{ 'Page navigation'|t }}">
            {% if has_toc %}
              {# Hide / show the sidebar, lg and up (js/modular-toc-collapse.js).
                 Below lg the "On this page" offcanvas button is used instead. #}
              {{ attach_library('palefire/modular-toc-collapse') }}
              <button type="button" class="pf-modular__toc-collapse d-none d-lg-inline-flex"
                      data-pf-toc-collapse aria-controls="pf-modular-sidebar-body" aria-expanded="true">
                {# Open: chevron (hide). Closed: list (show the TOC). CSS picks one. #}
                <svg class="pf-modular__toc-collapse-icon pf-modular__toc-collapse-icon--hide" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
                <svg class="pf-modular__toc-collapse-icon pf-modular__toc-collapse-icon--show" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m-3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/></svg>
                <span class="visually-hidden">{{ 'On this page sidebar'|t }}</span>
              </button>
              <div class="offcanvas-header">
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#pf-modular-sidebar"
                        aria-label="{{ 'Close'|t }}"></button>
              </div>
              <div class="offcanvas-body" id="pf-modular-sidebar-body">
                {{ modular_toc }}
                {{ page.sidebar }}
              </div>
            {% else %}
              {{ page.sidebar }}
            {% endif %}
          </aside>
        {% endif %}

        <main id="main-content" tabindex="-1" class="{{ main_classes }}">
          {# Modular page head: breadcrumb, then the page's <h1>, at the top
             of the content column and over the first section's bleed.
             - Breadcrumb: the same "breadcrumb" region and System Breadcrumb
               block as other pages, on the line of the TOC's title.
             - <h1>: the node title, printed here so every Modular page has
               one. The Page title block is suppressed on these pages
               (PalefireHooks::preprocessBlock()), so placing it can't add a
               second <h1>.
             It has no snap point of its own: the first section's snap point
             is moved up to the top of the page (_modular.scss), so the head
             and the first section snap as one screen.
             Styles: .pf-modular__head (_layout.scss). #}
          {% if is_modular_page %}
            <header class="pf-modular__head">
              {% if page.breadcrumb %}
                <div class="pf-breadcrumb pf-breadcrumb--modular">
                  {{ page.breadcrumb }}
                </div>
              {% endif %}
              {% if node.label %}
                <h1 class="pf-modular__title">{{ node.label }}</h1>
              {% endif %}
            </header>
          {% endif %}
          {% if has_toc %}
            <button class="pf-modular__toc-toggle btn btn-outline-secondary d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#pf-modular-sidebar" aria-controls="pf-modular-sidebar">
              {{ 'On this page'|t }}
            </button>
          {% endif %}
          {{ page.highlighted }}
          {{ page.content }}
        </main>

        {% if has_sidebar and not toc_first %}
          <aside class="pf-sidebar col-lg-3">
            {{ page.sidebar }}
          </aside>
        {% endif %}
      </div>
    </div>
  </div>{# /#swup #}

  {% if page.footer %}
    <footer class="pf-footer mt-auto" data-bs-theme="dark">
      <div class="container-xxl py-5">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}
</div>
