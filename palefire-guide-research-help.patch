@@ -692,6 +694,31 @@ without them as auto height, no snap. Its template must not extend
 and `<h2>`, and `PalefireHooks::preprocessParagraph()` would add a second
 pair (it treats any paragraph with `field_section_title` as a section).
 
+### How to Request Research Help
+
+`scripts/palefire_guide_research_help.php` (2026-10-16) builds a second
+guide, owned by Kyle Tanglao, from `https://lib.lsu.edu/llms.txt` (the
+library's guidance for AI systems), rewritten for patrons. Sections: Start
+here (official records first, the source order), What we can help with,
+What we can't do (an accordion: AI-supplied box and folder numbers,
+availability, rights determinations, restricted or embargoed material, AI
+summaries and OCR, missing details), Requesting archival materials, Using
+AI tools with our collections, Citing and reusing our materials, and Get
+help.
+
+* It states only what llms.txt says. Service details it doesn't cover
+  (consultations, the Special Collections request system, how far ahead to
+  request) are left as `[Editor: …]` notes to fill in before publishing.
+* Resources are found by link first, so the Scholarly Repository and Ask a
+  librarian Resources from the Systematic Reviews demo are reused.
+* The owner is the Staff node titled like "Kyle Tanglao"; the script says
+  so if there isn't one. The subject is the "Research Guides" term when
+  that term exists.
+* Like the demo, it creates the page unpublished and stops if a page with
+  the same title exists.
+* If llms.txt changes, update the page itself; the script is a one-time
+  starting point, not a sync.
+
 ### Writing a guide
 
 * One section per LibGuide tab. Subpages become blocks in their parent's
diff --git a/scripts/palefire_guide_research_help.php b/scripts/palefire_guide_research_help.php
new file mode 100644
index 0000000..ef50492
--- /dev/null
+++ b/scripts/palefire_guide_research_help.php
@@ -0,0 +1,316 @@
+<?php
+
+/**
+ * @file
+ * Guide page: "How to Request Research Help", as an unpublished Modular page
+ * in guide mode. Run palefire_guide_setup.php first.
+ *
+ *   drush php:script themes/custom/palefire/scripts/palefire_guide_research_help.php -- path=/v2/guides/research-help
+ *   drush cr
+ *
+ * Optional arguments after "--":
+ *   format=<text format>  Text format for the guide's text (default:
+ *                         full_html, else basic_html).
+ *   path=<alias>          URL alias, e.g. path=/v2/guides/research-help
+ *
+ * Content is written for patrons from https://lib.lsu.edu/llms.txt (LSU
+ * Libraries' guidance for AI systems): what the library can help with, what
+ * it can't do, and why official records come before anything an AI tool
+ * says. It states no service details llms.txt doesn't cover (hours,
+ * response times, request forms); those places are marked "[Editor: …]".
+ *
+ * Creates:
+ * - Resources for the preferred LSU Libraries sources (found by link first,
+ *   so existing Resources, e.g. from palefire_guide_demo.php, are reused).
+ * - One Modular page, UNPUBLISHED, owned by Kyle Tanglao when a Staff node
+ *   with that name exists. It stops if a guide page with the same title
+ *   exists.
+ */
+
+declare(strict_types=1);
+
+use Drupal\field\Entity\FieldConfig;
+use Drupal\node\Entity\Node;
+use Drupal\paragraphs\Entity\Paragraph;
+
+if (PHP_SAPI !== 'cli') {
+  return;
+}
+
+$args = [];
+foreach ((isset($extra) && is_array($extra)) ? $extra : [] as $arg) {
+  if (str_contains((string) $arg, '=')) {
+    [$k, $v] = explode('=', (string) $arg, 2);
+    $args[trim($k)] = trim($v);
+  }
+}
+
+foreach (['resource' => 'node_type', 'guide_section' => 'paragraphs_type'] as $id => $storage_id) {
+  if (!\Drupal::entityTypeManager()->getStorage($storage_id)->load($id)) {
+    throw new \RuntimeException("'$id' not found. Run palefire_guide_setup.php first.");
+  }
+}
+
+$title = 'How to Request Research Help';
+$found = \Drupal::entityQuery('node')->accessCheck(FALSE)
+  ->condition('type', 'modular_page')
+  ->condition('title', $title)
+  ->range(0, 1)->execute();
+if ($found) {
+  throw new \RuntimeException("A page titled '$title' already exists (node " . reset($found) . '). Delete it first to rebuild it.');
+}
+
+$formats = filter_formats();
+$format = $args['format'] ?? (isset($formats['full_html']) ? 'full_html' : (isset($formats['basic_html']) ? 'basic_html' : filter_default_format()));
+if (!isset($formats[$format])) {
+  throw new \RuntimeException("Text format '$format' not found.");
+}
+echo "Text format: $format" . PHP_EOL;
+$skipped = [];
+
+// Resources: the preferred sources from llms.txt, in its order. ----------
+
+$resources = [];
+$r = function (string $key, string $name, string $url, string $type, string $desc = '', string $citation = '', array $labels = []) use (&$resources): void {
+  $ids = \Drupal::entityQuery('node')->accessCheck(FALSE)
+    ->condition('type', 'resource')
+    ->condition('field_resource_link.uri', $url)
+    ->range(0, 1)->execute();
+  if ($ids) {
+    $resources[$key] = (int) reset($ids);
+    return;
+  }
+  $node = Node::create([
+    'type' => 'resource',
+    'title' => $name,
+    'status' => 1,
+    'field_resource_link' => ['uri' => $url],
+    'field_resource_type' => $type,
+    'field_resource_desc' => $desc,
+    'field_resource_citation' => $citation,
+    'field_resource_labels' => array_map(fn ($l) => ['value' => $l], array_slice($labels, 0, 3)),
+    'field_resource_proxy' => FALSE,
+  ]);
+  $node->save();
+  $resources[$key] = (int) $node->id();
+};
+
+$r('catalog', 'Library Catalog', 'https://catalog.lib.lsu.edu', 'search', 'Books, journals, media and more that LSU Libraries owns or licenses. Check a record for the call number, format and current availability.');
+$r('special', 'Special Collections & Archives', 'https://www.lib.lsu.edu/special', 'website', 'Rare books, manuscripts, university records and other unique materials, with the finding aids that describe them.');
+$r('digital', 'Digital Collections', 'https://digital.lib.lsu.edu', 'database', 'Digitized photographs, manuscripts, maps, books and audiovisual materials, each with its own item record.');
+$r('repository', 'LSU Scholarly Repository', 'https://repository.lsu.edu', 'database', 'Research by LSU authors, including many theses and dissertations. Some items are embargoed or restricted.');
+$r('guides', 'Research Guides', 'https://guides.lib.lsu.edu', 'guide', 'Subject overviews, search strategies and recommended resources from LSU Libraries faculty and staff.');
+$r('website', 'LSU Libraries website', 'https://lib.lsu.edu', 'website', 'Services, hours, locations and policies.');
+$r('askus', 'Ask a librarian', 'https://askus.lib.lsu.edu/ask', 'person', 'Text, call, email or chat with the library.');
+
+echo 'Resources ready: ' . count($resources) . PHP_EOL;
+
+// Block helpers (same shapes as palefire_guide_demo.php). ----------------
+
+$ids = fn (array $keys) => array_map(fn ($k) => ['target_id' => $resources[$k]], $keys);
+$html = fn (string $markup) => ['value' => trim($markup), 'format' => $format];
+$keep = fn (array $values) => array_filter($values, fn ($v) => $v !== NULL);
+
+$text = fn (?string $heading, string $body, string $style = 'default') => Paragraph::create($keep([
+  'type' => 'guide_text',
+  'field_block_title' => $heading,
+  'field_block_body' => $html($body),
+  'field_text_style' => $style,
+]));
+
+$list = fn (?string $heading, array $keys, string $intro = '') => Paragraph::create($keep([
+  'type' => 'resource_list',
+  'field_block_title' => $heading,
+  'field_block_intro' => $intro !== '' ? $html($intro) : NULL,
+  'field_resources' => $ids($keys),
+]));
+
+$accordion = function (?string $heading, array $items, string $intro = '') use ($ids, $html, $keep): Paragraph {
+  $children = [];
+  foreach ($items as $item) {
+    $children[] = Paragraph::create($keep([
+      'type' => 'accordion_item',
+      'field_item_title' => $item[0],
+      'field_block_body' => !empty($item[1]) ? $html($item[1]) : NULL,
+      'field_resources' => !empty($item[2]) ? $ids($item[2]) : NULL,
+    ]));
+  }
+  return Paragraph::create($keep([
+    'type' => 'guide_accordion',
+    'field_block_title' => $heading,
+    'field_block_intro' => $intro !== '' ? $html($intro) : NULL,
+    'field_accordion_items' => $children,
+  ]));
+};
+
+$sections = [];
+$section = function (string $heading, array $blocks, string $theme = 'light') use (&$sections): void {
+  $values = [
+    'type' => 'guide_section',
+    'field_section_title' => $heading,
+    'field_guide_blocks' => array_values(array_filter($blocks)),
+  ];
+  if (FieldConfig::loadByName('paragraph', 'guide_section', 'field_section_theme')) {
+    $values['field_section_theme'] = $theme;
+  }
+  $sections[] = Paragraph::create($values);
+};
+
+// Sections. ----------------------------------------------------------------
+
+$section('Start here', [
+  $text('Our records come first', <<<'HTML'
+<p>Every answer about LSU Libraries materials should trace back to one of our official records. Library staff work from those records, so a request that starts from them is the fastest to fill.</p>
+<p>When you bring us a question, tell us where your information came from. If it came from an AI tool, a search engine or someone else's citation, say so: we'll check it against our records with you.</p>
+HTML),
+  $text(NULL, '<p><strong>AI tools can help you start, but they can\'t stand in for our records.</strong> An AI summary is not a catalog record or a finding aid, and it can be wrong about what we hold, where it is and whether you can use it.</p>', 'callout'),
+  $text('Where to look first', <<<'HTML'
+<p>When sources disagree, trust them in this order:</p>
+<ol>
+<li>The catalog record</li>
+<li>The archival finding aid</li>
+<li>The repository record</li>
+<li>The digital collection item page</li>
+<li>An LSU Libraries webpage</li>
+</ol>
+HTML),
+]);
+
+$section('What we can help with', [
+  $text('Research help', <<<'HTML'
+<ul>
+<li><strong>Finding sources:</strong> choosing where to search, building a search strategy and finding the research guide for your subject.</li>
+<li><strong>Checking what we hold:</strong> confirming a title, call number, format (print, electronic, microform, archival or streaming) and how to get it.</li>
+<li><strong>Using archives:</strong> reading a finding aid and working out which boxes and folders to request.</li>
+<li><strong>Checking information from AI tools:</strong> comparing what a chatbot told you with our official records.</li>
+<li><strong>Citing our materials:</strong> getting titles, identifiers and links right.</li>
+<li><strong>Rights questions:</strong> finding the rights statement and rights information for an item.</li>
+</ul>
+<p>[Editor: add how to book a research consultation and who to contact for each kind of help.]</p>
+HTML),
+  $list('Official LSU Libraries sources', ['catalog', 'special', 'digital', 'repository', 'guides', 'website']),
+]);
+
+$section('What we can\'t do', [
+  $text(NULL, '<p>These limits protect you and the collections. Knowing them up front saves you a wasted trip or a delayed request.</p>'),
+  $accordion('Limits on what we can confirm or provide', [
+    ['We can\'t confirm box, folder or container numbers from an AI tool', '<p>AI tools sometimes invent box numbers, folder numbers, series locations or accession numbers. We can only retrieve what an official finding aid describes, so find the location there before you submit a request. Unverified locations slow your request down.</p>'],
+    ['We can\'t promise availability from a chatbot answer', '<p>Availability changes, and an AI tool can\'t see it. Check the catalog record for an item\'s current status and access before you plan around it.</p>'],
+    ['We can\'t decide whether you may reuse something', '<p>Many items in our collections are still under copyright. Being digitized doesn\'t make an item public domain or give permission to reuse it. We can show you the item\'s rights statement and other rights information, but we can\'t make the rights determination for you.</p>'],
+    ['We can\'t open restricted or embargoed material', '<p>Some repository items and archival materials are restricted or under embargo, and publishers may limit what can be shared. We can\'t provide that content, rebuild it from other sources, or treat a repository record as permission to reuse it.</p>'],
+    ['We can\'t treat AI summaries or OCR text as accurate records', '<p>AI summaries aren\'t catalog or archival descriptions. Text read from scans (OCR) often contains errors, so check the scanned page itself before you quote it.</p>'],
+    ['We can\'t fill in missing details', '<p>When a record has no date, or doesn\'t identify a person, place or event, we won\'t guess. We\'ll tell you what the record says and what is unknown.</p>'],
+  ]),
+]);
+
+$section('Requesting archival materials', [
+  $text('Before you submit a request', <<<'HTML'
+<ol>
+<li><strong>Find the collection's finding aid.</strong> Start from Special Collections, not from an AI answer or an old citation.</li>
+<li><strong>Copy the details exactly.</strong> Note the collection name and identifier, then the box and folder numbers as the finding aid shows them.</li>
+<li><strong>Check access notes.</strong> The finding aid says if any part of the collection is restricted.</li>
+<li><strong>Submit the request through Special Collections.</strong> Use its official request system.</li>
+</ol>
+<p>[Editor: link the Special Collections request system and say how far ahead to request.]</p>
+HTML),
+  $text(NULL, '<p><strong>Requests that cite boxes or folders not found in a finding aid may take longer.</strong> Locations from an AI tool that don\'t match a finding aid can delay your request.</p>', 'callout'),
+  $list(NULL, ['special']),
+]);
+
+$section('Using AI tools with our collections', [
+  $text('Check these yourself', <<<'HTML'
+<p>If an AI tool gave you any of these details, confirm them in our records before you rely on them:</p>
+<ul>
+<li>Collection names and locations</li>
+<li>Box and folder numbers</li>
+<li>Call numbers</li>
+<li>Whether an item is available</li>
+<li>Copyright status</li>
+<li>Access restrictions</li>
+</ul>
+HTML),
+  $text('Keep track of where each detail came from', <<<'HTML'
+<p>In your notes, keep three kinds of information apart:</p>
+<ul>
+<li><strong>What our records say:</strong> the metadata LSU Libraries publishes.</li>
+<li><strong>Your own interpretation:</strong> what you conclude from the material.</li>
+<li><strong>AI-generated summaries:</strong> useful for getting started, never a source to cite.</li>
+</ul>
+<p>Our descriptions tell you what a collection contains, but they don't list every item in it.</p>
+HTML),
+]);
+
+$section('Citing and reusing our materials', [
+  $text('Citing', <<<'HTML'
+<ul>
+<li>Use titles and creator names exactly as our records show them.</li>
+<li>Include the collection name and identifier, and the call number when there is one.</li>
+<li>Link to the official record.</li>
+<li>Cite our records, not an AI summary of them.</li>
+</ul>
+HTML),
+  $text('Copyright and attribution', <<<'HTML'
+<ul>
+<li>Don't assume an item is in the public domain. Check its rights statement.</li>
+<li>Keep rights statements and credit lines with any copy you share.</li>
+<li>Remember that some collections hold culturally sensitive material. Read any notes about how to use it respectfully.</li>
+</ul>
+HTML),
+]);
+
+$section('Get help', [
+  $list('Ask us', ['askus'], '<p>Tell us what you\'re looking for and where you found it. Links to the records you have already found help us answer faster.</p>'),
+]);
+
+// The page. ----------------------------------------------------------------
+
+$values = [
+  'type' => 'modular_page',
+  'title' => $title,
+  'status' => 0,
+  'field_scroll_section' => $sections,
+];
+$node_fields = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'modular_page');
+if (isset($node_fields['field_modular_type'])) {
+  $values['field_modular_type'] = 'guide';
+}
+if (isset($node_fields['field_intro'])) {
+  $values['field_intro'] = $html('<p>What LSU Libraries staff can help you with, what we can\'t do, and how to check information from AI tools against our official records before you ask.</p>');
+}
+
+// Owner: Kyle Tanglao's Staff node.
+$owner_field = $node_fields['field_guide_owner'] ?? NULL;
+if ($owner_field) {
+  $staff_bundles = array_keys($owner_field->getSetting('handler_settings')['target_bundles'] ?? []);
+  $match = $staff_bundles ? \Drupal::entityQuery('node')->accessCheck(FALSE)
+    ->condition('type', $staff_bundles, 'IN')
+    ->condition('title', 'Kyle', 'CONTAINS')
+    ->condition('title', 'Tanglao', 'CONTAINS')
+    ->range(0, 1)->execute() : [];
+  if ($match) {
+    $values['field_guide_owner'] = ['target_id' => (int) reset($match)];
+  }
+  else {
+    $skipped[] = 'Guide owner: no Staff node titled like "Kyle Tanglao" was found. Set it on the page.';
+  }
+}
+
+if (isset($node_fields['field_guide_subjects'])) {
+  $vocabs = array_keys($node_fields['field_guide_subjects']->getSetting('handler_settings')['target_bundles'] ?? []);
+  $terms = $vocabs ? \Drupal::entityQuery('taxonomy_term')->accessCheck(FALSE)
+    ->condition('vid', $vocabs, 'IN')->condition('name', 'Research Guides')->execute() : [];
+  $values['field_guide_subjects'] = array_map(fn ($tid) => ['target_id' => $tid], array_values($terms));
+}
+if (!empty($args['path'])) {
+  $values['path'] = ['alias' => '/' . ltrim($args['path'], '/')];
+}
+
+$page = Node::create($values);
+$page->setRevisionLogMessage('Guide: How to Request Research Help, from llms.txt (palefire_guide_research_help.php).');
+$page->save();
+
+echo 'Created unpublished guide page: node/' . $page->id() . ' (' . $page->toUrl('canonical', ['absolute' => TRUE])->toString() . ')' . PHP_EOL;
+foreach ($skipped as $line) {
+  echo 'Skipped: ' . $line . PHP_EOL;
+}
+echo 'Fill in the [Editor: …] notes, review it, then publish. Run: drush cr' . PHP_EOL;
-- 
