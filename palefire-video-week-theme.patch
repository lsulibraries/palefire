+        const first = wrap.querySelector('video');
         const btn = wrap.querySelector('[data-bento-video-toggle]');
         const label = btn.querySelector('[data-bento-video-label]') || btn;
         const sources = JSON.parse(wrap.dataset.sources || '[]');
