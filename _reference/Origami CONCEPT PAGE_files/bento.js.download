/**
 * @see origami.theme origami_preprocess_html
 * Runs only for /testbento
 */
; (function ($, Drupal, drupalSettings) {
	console.log('origami/bento')

	Drupal.behaviors.bento_liveTime = {
		attach: function (context, settings) {
			once('live-time', 'body', context).forEach(function (el) {
				function updateTime() {
					const now = new Date()
					const hours = now.getHours() % 12 || 12
					const minutes = now.getMinutes().toString().padStart(2, '0')
					const ampm = now.getHours() >= 12 ? 'PM' : 'AM'
					const xxtime = `${hours}:${minutes} ${ampm}`
					const days = [
						'Sunday',
						'Monday',
						'Tuesday',
						'Wednesday',
						'Thursday',
						'Friday',
						'Saturday',
					]
					const months = [
						'January',
						'February',
						'March',
						'April',
						'May',
						'June',
						'July',
						'August',
						'September',
						'October',
						'November',
						'December',
					]
					const dayName = days[now.getDay()]
					const monthName = months[now.getMonth()]
					const dayNum = now.getDate().toString().padStart(2, '0')
					const xxday = `${dayName}`
					const xxdate = `${monthName} ${dayNum}`
					$('#live-day').text(xxday)
					$('#live-date').text(xxdate)
					$('#live-time').text(xxtime)
				}

				updateTime() // Initial call
				setInterval(updateTime, 60000)
			})
		},
	}

	$(document).on('ajaxSend', function (event, xhr, settings) {
		if (!settings || !settings.extraData || !settings.extraData.view_name) {
			return
		}

		const viewName = settings.extraData.view_name
		const viewDisplay = settings.extraData.view_display_id

		const selector = `.view-id-${viewName}.view-display-id-${viewDisplay}`
		const $view = $(selector)

		if ($view.length) {
			$view.find('.bento-view-spinner').show()
		}
	})

	$(document).on('ajaxComplete', function (event, xhr, settings) {
		if (!settings || !settings.extraData || !settings.extraData.view_name) {
			return
		}

		const viewName = settings.extraData.view_name
		const viewDisplay = settings.extraData.view_display_id

		const selector = `.view-id-${viewName}.view-display-id-${viewDisplay}`
		const $view = $(selector)

		if ($view.length) {
			$view.find('.bento-view-spinner').hide()
		}
	})

	// This event is triggered by the one-search-summary.js script
	$(document).on('one-search-summary-ready', function (event, data) {
		const searchTerm = data.searchTerm
		const totalResults = data.totalResults

		$('#bento-empty').prop('hidden', totalResults !== 0)
	})

	//scrollReveal for offCanvas
	const sr = ScrollReveal({
		distance: '40px',
		duration: 50,
		easing: 'ease-out',
		origin: 'bottom',
	})

	// Animate on open
	$('.auxOffcanvas').on('shown.bs.offcanvas', function () {
		const $offcanvas = $(this)

		// Delay long enough for the slide-in transform to finish
		setTimeout(() => {
			const targets =
				'.timeNow, .dateNow, .hoursContainer, a.accountContainer, .linkOut'

			// CLEAN all reveal targets inside this offcanvas
			sr.clean($offcanvas.find(targets).toArray())

			// REVEAL fresh
			sr.reveal($offcanvas.find('.timeNow').toArray(), {
				origin: 'bottom',
				container: '.auxOffcanvas  .dashboardBody',
				duration: 100,
			})

			sr.reveal($offcanvas.find('.dateNow').toArray(), {
				origin: 'top',
				container: '.auxOffcanvas  .dashboardBody',
				duration: 300,
				distance: '20px',
				delay: 50,
			})

			sr.reveal($offcanvas.find('.hoursContainer').toArray(), {
				origin: 'left',
				container: '.auxOffcanvas  .dashboardBody',
				interval: 50,
				duration: 300,
			})

			sr.reveal($offcanvas.find('a.accountContainer').toArray(), {
				origin: 'left',
				container: '.auxOffcanvas .accountsList',
				interval: 50,
				duration: 200,
				distance: '20px',
			})

			sr.reveal($offcanvas.find('.linkOut').toArray(), {
				origin: 'left',
				container: '.auxOffcanvas  .dashboardBody',
				duration: 150,
				delay: 200,
			})
		}, 0) // 60–120ms is the sweet spot for side-slide
	})

	$('.auxOffcanvas').on('hidden.bs.offcanvas', function () {
		const $offcanvas = $(this)
		const $targets = $offcanvas.find(
			'.timeNow, .dateNow, .hoursContainer, a.accountContainer, .linkOut',
		)

		// Add exit animation class
		$targets.addClass('offcanvas-exit')

		// Wait for exit animation to finish
		setTimeout(() => {
			// Reset ScrollReveal state
			$targets.removeAttr('style').removeAttr('data-sr-id')

			// Remove exit class so next open starts clean
			$targets.removeClass('offcanvas-exit')
		}, 200) // match your CSS transition duration
	})

	console.log('origami/bento sr fix targets')

	const srLoad = ScrollReveal({
		distance: '40px',
		duration: 50,
		easing: 'ease-out',
		origin: 'bottom',
		reset: false,
	})

	//modular page styles only

	//TOC
	$(function () {
		/* -----------------------------------------------------------
		 * 0. Helpers for body classes
		 * ---------------------------------------------------------*/

		function getPageTitleSlug() {
			const pathname = window.location.pathname || ''
			const parts = pathname.split('/').filter(Boolean)
			const last = parts[parts.length - 1] || ''
			// remove spaces and non-word chars
			return last.toLowerCase().replace(/[^\w]+/g, '')
		}
		const PAGE_TITLE_SLUG = getPageTitleSlug()

		function updateBodyClassesForSection($currentSection, index) {
			const $bodyEl = $('body')
			const currentClasses = $bodyEl.attr('class') || ''

			// Remove any previous slide classes and dark-mode flag we added
			const cleaned = currentClasses
				.split(/\s+/)
				.filter(function (cls) {
					if (!cls) return false
					const regex = new RegExp('^' + PAGE_TITLE_SLUG + '\\d+$')
					// keep class if it does NOT match our slide pattern and is not dark-mode
					return !regex.test(cls) && cls !== 'dark-mode'
				})
				.join(' ')

			$bodyEl.attr('class', cleaned)

			// Add new slide class: [title][#]
			const slideClass = PAGE_TITLE_SLUG + index
			$bodyEl.addClass(slideClass)

			// Add .firstSlide when on the first slide (index === 1, or 0 if you're 0-based)
			if (index === 1) {
				$bodyEl.addClass('firstSlide')
			} else {
				$bodyEl.removeClass('firstSlide')
			}

			// Add dark-mode if section has it
			if ($currentSection && $currentSection.hasClass('dark-mode')) {
				$bodyEl.addClass('dark-mode')
			}
		}

		/* -----------------------------------------------------------
		 * 1. Build TOC structure from headings inside .modularBody
		 * ---------------------------------------------------------*/
		const $body = $('.modularBody')
		const $sidebar = $('.modularSidebar .sidebarBody')
		const $barFooter = $('.modularSidebar .sidebarFooter')
		const $toc = $(
			'<nav class="toc"><div class="sidebarIndicator"></div><ul></ul></nav>',
		)
		const $list = $toc.find('ul')
		const $headings = $body.find('h2, h3, h4')

		let lastH2, lastH3

		$headings.each(function () {
			const $h = $(this)
			const tag = this.tagName.toLowerCase()

			if (tag === 'h2') {
				const $section = $h.closest('.modularSection')

				let id = $section.attr('id')
				if (!id) {
					id = $h
						.text()
						.trim()
						.toLowerCase()
						.replace(/[^\w]+/g, '-')
						.replace(/^-+|-+$/g, '')
					$section.attr('id', id)
				}

				lastH2 = $('<li><a href="#' + id + '">' + $h.text() + '</a></li>')
				$list.append(lastH2)
				lastH3 = null
				return
			}

			if (tag === 'h3') {
				if (!lastH2) lastH2 = $('<li></li>').appendTo($list)
				let sub = lastH2.children('ul')
				if (!sub.length)
					sub = $('<ul class="subHeader collapse"></ul>').appendTo(lastH2)

				lastH3 = $('<li><span>' + $h.text() + '</span></li>')
				sub.append(lastH3)
				return
			}

			if (tag === 'h4') {
				if (!lastH3) {
					if (!lastH2) lastH2 = $('<li></li>').appendTo($list)
					let sub = lastH2.children('ul')
					if (!sub.length) sub = $('<ul></ul>').appendTo(lastH2)
					lastH3 = $('<li></li>').appendTo(sub)
				}
				let sub = lastH3.children('ul')
				if (!sub.length) sub = $('<ul></ul>').appendTo(lastH3)

				sub.append('<li><span>' + $h.text() + '</span></li>')
			}
		})

		if ($sidebar.length) {
			$sidebar.prepend($toc)
		}

		/* -----------------------------------------------------------
		 * 2. Smooth scrolling
		 * ---------------------------------------------------------*/

		const scroller = window

		$(document).on('click', '.toc a', function (e) {
			const target = $(this).attr('href')
			const $target = $(target)

			if ($target.length) {
				e.preventDefault()

				$target[0].scrollIntoView({
					behavior: 'smooth',
					block: 'start',
				})
			}
		})

		/* -----------------------------------------------------------
		 * 3. Active section highlighting + body classes + BG crossfade
		 * ---------------------------------------------------------*/

		const sections = document.querySelectorAll('.modularSection[id]')
		const $tocLinks = $('.toc a')
		let lastActiveId = null

		// Elements and state for background lazy-load + crossfade
		const mainEl = document.getElementById('main')
		const loadedBackgrounds = new Set()
		const FADE_DURATION = 200

		// Preload all data-bg URLs once
		const bgUrls = Array.from(
			document.querySelectorAll('.modularSection[data-bg]'),
		)
			.map((s) => s.getAttribute('data-bg'))
			.filter(Boolean)

		bgUrls.forEach((url) => {
			if (loadedBackgrounds.has(url)) return
			loadedBackgrounds.add(url)
			const img = new Image()
			img.src = url
		})

		// Helper: get next .modularSection[data-bg] in the DOM
		function getNextModularSectionBg(currentSectionEl) {
			if (!currentSectionEl || !sections.length) return null

			const sectionArray = Array.from(sections)
			const currentIndex = sectionArray.indexOf(currentSectionEl)
			if (currentIndex === -1) return null

			for (let i = currentIndex + 1; i < sectionArray.length; i++) {
				const bg = sectionArray[i].getAttribute('data-bg')
				if (bg) return bg
			}

			return null
		}

		// Crossfade only handles "next" background layer
		function crossfadeToBackground(nextBgUrl, isDarkModeNext = false) {
			if (!mainEl || !nextBgUrl) return

			if (isDarkModeNext) {
				mainEl.classList.add('dip-to-black')
			}

			mainEl.style.setProperty('--next-bg', 'url("' + nextBgUrl + '")')
			mainEl.classList.remove('bg-fade-in')
			// Force reflow
			// eslint-disable-next-line no-unused-expressions
			mainEl.offsetHeight
			mainEl.classList.add('bg-fade-in')

			setTimeout(() => {
				mainEl.classList.remove('bg-fade-in')
				if (isDarkModeNext) {
					mainEl.classList.remove('dip-to-black')
				}
			}, FADE_DURATION)
		}

		/**
		 * Get the ul.subHeader that belongs to the current .toc a.active
		 */
		function getActiveSubHeaderForActiveLink() {
			const activeLink = document.querySelector('.toc a.active')
			if (!activeLink) return null

			const next = activeLink.nextElementSibling
			if (next && next.matches('ul.subHeader')) {
				return next
			}

			return null
		}

		/**
		 * Keep ONLY the subHeader belonging to the active TOC link open.
		 * This is strictly tied to .toc a.active.
		 */
		function updateSubHeadersForActiveLink() {
			const activeSubHeader = getActiveSubHeaderForActiveLink()

			document.querySelectorAll('ul.subHeader').forEach((el) => {
				const collapse = bootstrap.Collapse.getOrCreateInstance(el, {
					toggle: false,
				})

				if (el === activeSubHeader) {
					// This is the only one we want open; Bootstrap ignores show() if already transitioning.
					collapse.show()
				} else {
					// Everything else must be closed.
					collapse.hide()
				}
			})
		}

		/**
		 * Central handler whenever a section becomes the active one.
		 * Called by IntersectionObserver, scroll fallback, and init-on-load.
		 */
		function handleActiveSection(sectionEl) {
			if (!sectionEl || !sectionEl.id) return
			const id = sectionEl.id
			if (id === lastActiveId) return
			lastActiveId = id

			// 1. Update .active on TOC links
			$tocLinks.removeClass('active')
			$('.toc a[href="#' + id + '"]').addClass('active')

			// 2. Normalize subHeaders based on .toc a.active
			updateSubHeadersForActiveLink()

			// 3. Highlight parent modular section/accordion
			$('.modularAccordion, .modularSection').removeClass('active')
			const $currentSection = $(sectionEl)
				.closest('.modularAccordion, .modularSection')
				.addClass('active')

			// 4. Update <body> classes based on active section
			const index = $('.modularSection[id]').index($currentSection) + 1
			updateBodyClassesForSection($currentSection, index)

			// 5. Backgrounds: current + next
			const currentBgUrl = sectionEl.getAttribute('data-bg')
			const nextBgUrl = getNextModularSectionBg(sectionEl)

			if (currentBgUrl) {
				mainEl.style.setProperty(
					'--current-bg',
					'url("' + currentBgUrl + '")',
				)
			}

			if (nextBgUrl) {
				let isDarkModeNext = false
				const nextEl = sectionEl.nextElementSibling
				if (
					nextEl &&
					nextEl.classList &&
					nextEl.classList.contains('modularSection') &&
					nextEl.classList.contains('dark-mode')
				) {
					isDarkModeNext = true
				}
				crossfadeToBackground(nextBgUrl, isDarkModeNext)
			}
		}

		/* ------------------------------
		 * IntersectionObserver version
		 * ---------------------------- */
		if ('IntersectionObserver' in window && sections.length) {
			const observerOptions = {
				root: null,
				threshold: 0.6,
			}

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return
					handleActiveSection(entry.target)
				})
			}, observerOptions)

			sections.forEach((section) => observer.observe(section))
		} else {
			// Fallback scroll handler if IntersectionObserver is unavailable
			const OFFSET = 250

			$(window).on('scroll', function () {
				let scrollPos = $(window).scrollTop()
				let activeSectionEl = null

				$('.modularSection[id]').each(function () {
					const $section = $(this)
					const offset = $section.offset().top - OFFSET

					if (scrollPos >= offset) {
						activeSectionEl = this
					}
				})

				if (activeSectionEl) {
					handleActiveSection(activeSectionEl)
				}
			})
		}

		/* ------------------------------
		 * Init on page load
		 * ---------------------------- */
		function initSubHeadersOnLoad() {
			const centerY = window.innerHeight / 2
			let activeSection = null

			sections.forEach((section) => {
				const rect = section.getBoundingClientRect()
				if (rect.top <= centerY && rect.bottom >= centerY) {
					activeSection = section
				}
			})

			// Fallback: first visible section from top
			if (!activeSection) {
				for (let i = 0; i < sections.length; i++) {
					const rect = sections[i].getBoundingClientRect()
					if (rect.top < window.innerHeight && rect.bottom > 0) {
						activeSection = sections[i]
						break
					}
				}
			}

			if (!activeSection) return

			handleActiveSection(activeSection)
		}

		// Call on DOM ready
		document.addEventListener('DOMContentLoaded', initSubHeadersOnLoad)

		/* ------------------------------
		 * Anchor click + hashchange hooks
		 * Ensure TOC jumps also normalize the open subHeader
		 * ---------------------------- */

		let scrollSyncTimeout = null

		window.addEventListener(
			'scroll',
			() => {
				clearTimeout(scrollSyncTimeout)
				scrollSyncTimeout = setTimeout(() => {
					// By now snap should have finished and IO has marked the right .active
					updateSubHeadersForActiveLink()
				}, 0)
			},
			{ passive: true },
		)

		// As an extra safety net for manual hash changes
		window.addEventListener('hashchange', function () {
			setTimeout(() => {
				updateSubHeadersForActiveLink()
			}, 800)
		})
		/* -----------------------------------------------------------
		 * 4. Back to top link
		 * ---------------------------------------------------------*/
		$barFooter.append(
			'<span class="back-to-top"><a href="#"><i class="far fa-arrow-alt-up"></i>Back to top</a></span>',
		)

		$(document).on('click', '.back-to-top a', function (e) {
			e.preventDefault()

			if (scroller === window) {
				$('html, body').animate({ scrollTop: 0 }, 300)
			} else {
				if (scroller.scrollTo) {
					scroller.scrollTo({ top: 0, behavior: 'smooth' })
				} else {
					scroller.scrollTop = 0
				}
			}
		})
	})

	//animate on page load
	$(document).ready(function () {
		//concept header
		//stage 1
		srLoad.reveal('#header', { origin: 'top', duration: 150, delay: 0 })
		srLoad.reveal('.conceptHeader', {
			origin: 'left',
			distance: '80px',
			duration: 300,
			delay: 0,
		})
		srLoad.reveal(
			'.bentoResult, .mainTitle .hoursContainer, .mainTitle .timeNow, .mainTitle .hoursNow',
			{ origin: 'left', duration: 150, delay: 200 },
		)
		srLoad.reveal('.views-element-container, .outerSearch', {
			origin: 'left',
			interval: 50,
			duration: 200,
			delay: 0,
			viewFactor: 0,
		})
		//stage2
		srLoad.reveal('.breadcrumb', {
			origin: 'left',
			interval: 100,
			duration: 100,
			delay: 0,
		})
		srLoad.reveal('.conceptHero', {
			origin: 'left',
			distance: '200px',
			duration: 800,
			delay: 0,
		})
		srLoad.reveal('.conceptHero h1', {
			origin: 'left',
			duration: 400,
			delay: 200,
		})
		srLoad.reveal('.conceptHero h4', {
			origin: 'left',
			duration: 600,
			delay: 400,
		})
		//stage3
		srLoad.reveal('.resQuery, .resNumber, .themeSelect', {
			origin: 'bottom',
			interval: 50,
			duration: 200,
			delay: 100,
		})
		srLoad.reveal('.breadcrumb > *', {
			origin: 'left',
			distance: '80px',
			interval: 50,
			duration: 600,
			delay: 0,
		})
		srLoad.reveal('.conceptTitle', {
			origin: 'left',
			duration: 100,
			delay: 400,
		})
		srLoad.reveal('.masterBento', {
			origin: 'left',
			distance: '20px',
			duration: 800,
			delay: 800,
		})

		// Only run on modular_page content type
		if ($('body').hasClass('node--type-modular-page')) {
			var $toc = $('.toc')
			var $indicator = $('.sidebarIndicator')

			// Stop if TOC doesn't exist
			if (!$toc.length || !$indicator.length) {
				return
			}

			function updateIndicator() {
				var $activeLink = $('.toc a.active')
				var $indicator = $('.sidebarIndicator')

				if ($activeLink.length) {
					var $li = $activeLink.closest('li')
					var top = $li.position().top
					var height = $li.outerHeight()

					$indicator.css({
						top: top + 'px',
						height: height + 'px',
					})
				}
			}

			// Run on load
			updateIndicator()

			// Run on resize and scroll
			$(window).on('scroll resize', updateIndicator)

			// Watch for .active changes (scrollspy, clicks, etc.)
			var tocNode = $toc.get(0)

			if (tocNode) {
				var observer = new MutationObserver(updateIndicator)

				observer.observe(tocNode, {
					subtree: true,
					attributes: true,
					attributeFilter: ['class'],
				})
			}
		}
	})

	//JSON parse for hours
	// =======================================
	// jQuery logic for open/closed + hours
	// =======================================

	// =======================================
	// Inject LibCal JSON-LD scripts
	// =======================================
	window.lsuHoursLocations = window.lsuHoursLocations || {}

	window.jsonldcb241 = function (data) {
		window.lsuHoursLocations['241'] = data
	}

	window.jsonldcb236 = function (data) {
		window.lsuHoursLocations['236'] = data
	}
		; (function () {
			const urls = [
				{ lid: '241', cb: 'jsonldcb241' },
				{ lid: '236', cb: 'jsonldcb236' },
			]

			urls.forEach((loc) => {
				const s = document.createElement('script')
				s.src = `https://lsu.libcal.com/widget/hours/grid?format=jsonld&lid=${loc.lid}&org=2&callback=${loc.cb}`
				document.body.appendChild(s)
			})
		})()

	// =======================================
	// jQuery logic for open/closed + hours
	// =======================================
	$(function () {
		// Wait until ALL requested locations have loaded
		function waitForAllLocations(callback) {
			const needed = ['241', '236']

			if (!window.lsuHoursLocations) {
				return setTimeout(() => waitForAllLocations(callback), 50)
			}

			const loaded = needed.every((id) => window.lsuHoursLocations[id])

			if (loaded) {
				callback(window.lsuHoursLocations)
			} else {
				setTimeout(() => waitForAllLocations(callback), 50)
			}
		}

		waitForAllLocations(function (locations) {
			// Utility functions
			function formatTime(date) {
				let h = date.getHours()
				const m = date.getMinutes()
				const ampm = h >= 12 ? 'PM' : 'AM'
				h = h % 12
				if (h === 0) h = 12
				if (m === 0) return `${h}${ampm}`
				const mm = String(m).padStart(2, '0')
				return `${h}:${mm} ${ampm}`
			}

			function ymdLocal(d) {
				const year = d.getFullYear()
				const month = String(d.getMonth() + 1).padStart(2, '0')
				const day = String(d.getDate()).padStart(2, '0')
				return `${year}-${month}-${day}`
			}

			function getTodaySpec(specs, now) {
				const today = ymdLocal(now)

				return (
					specs.find((spec) => {
						const from = spec.validFrom
						const thru = spec.validThrough
						if (from === thru) return today === from
						return today >= from && today < thru
					}) || null
				)
			}

			// Normalize date to midnight for clean comparisons
			function normalize(d) {
				return new Date(d.getFullYear(), d.getMonth(), d.getDate())
			}

			// Find the next open day (could be tomorrow or later)
			function getNextOpenDay(specs, startDate) {
				for (let i = 1; i <= 14; i++) {
					const d = new Date(startDate)
					d.setDate(d.getDate() + i)

					const spec = getTodaySpec(specs, d)
					if (!spec || !spec.opens || !spec.closes) continue

					const [openH, openM] = spec.opens.split(':').map(Number)
					const [closeH, closeM] = spec.closes.split(':').map(Number)

					const closedAllDay =
						openH === 0 && openM === 0 && closeH === 0 && closeM === 0

					if (!closedAllDay) {
						const openDate = new Date(d)
						openDate.setHours(openH, openM, 0, 0)

						return {
							date: d,
							openTime: formatTime(openDate),
						}
					}
				}
				return null
			}

			// Status + hours logic
			function getStatusAndHours(spec, now) {
				// Guard: missing or malformed spec → treat as closed all day
				if (!spec || !spec.opens || !spec.closes) {
					return {
						isOpen: false,
						closedAllDay: true,
						opensLater: false,
						openingSoon: false,
						closesSoon: false,
						closedUntilTomorrow: false,
						hoursText: null,
					}
				}

				const [openH, openM] = spec.opens.split(':').map(Number)
				const [closeH, closeM] = spec.closes.split(':').map(Number)

				const closedAllDay =
					openH === 0 && openM === 0 && closeH === 0 && closeM === 0

				if (closedAllDay) {
					return {
						isOpen: false,
						closedAllDay: true,
						opensLater: false,
						openingSoon: false,
						closesSoon: false,
						closedUntilTomorrow: false,
						hoursText: null,
					}
				}

				const openTime = new Date(now)
				openTime.setHours(openH, openM, 0, 0)

				const closeTime = new Date(now)
				if (closeH === 0 && closeM === 0) {
					closeTime.setDate(closeTime.getDate() + 1)
					closeTime.setHours(0, 0, 0, 0)
				} else {
					closeTime.setHours(closeH, closeM, 0, 0)
				}

				const isOpen = now >= openTime && now < closeTime

				const opensLater = now < openTime
				const openingSoon = opensLater && openTime - now <= 30 * 60 * 1000 // within 30 minutes
				const closesSoon = isOpen && closeTime - now <= 30 * 60 * 1000
				const closedUntilTomorrow = !isOpen && !opensLater

				return {
					isOpen,
					closedAllDay,
					opensLater,
					openingSoon,
					closesSoon,
					closedUntilTomorrow,
					hoursText: `${formatTime(openTime)} – ${formatTime(closeTime)}`,
				}
			}

			// Add/remove .phrase class
			function updatePhraseClass($el, text) {
				$el.removeClass('phrase')
				if (text && !text.includes('–')) {
					$el.addClass('phrase')
				}
			}

			// Helper: set the Closed status labels for all .status elements
			function setClosedLabels($statusAll) {
				$statusAll.each(function () {
					const $status = $(this)
					const isSmall = $status.hasClass('smallStatus')
					$status.text(isSmall ? 'Closed now' : 'Closed')
				})
			}

			// Helper: build the "next open" phrase from a nextOpen object
			function buildNextOpenPhrase(nextOpen, now, prefix) {
				const tomorrow = new Date(now)
				tomorrow.setDate(tomorrow.getDate() + 1)

				const isTomorrow =
					normalize(nextOpen.date).getTime() ===
					normalize(tomorrow).getTime()

				const nextLabel = isTomorrow
					? 'tomorrow'
					: nextOpen.date.toLocaleDateString('en-US', {
						weekday: 'long',
					})

				return `${prefix}<b>${nextLabel} ${nextOpen.openTime}</b>`
			}

			// Process each location
			Object.entries(locations).forEach(([lid, data]) => {
				const now = new Date()
				const specs = (data && data.openingHoursSpecification) || []
				const todaySpec = getTodaySpec(specs, now)

				const $container = $(`.lsu-lib-status-${lid}`)
				const $statusAll = $container.find('.status')
				const $hours = $container.find('.hours')

				// clear base classes
				$statusAll.removeClass('open closed')
				$container.removeClass('open closed')

				// NO SPEC FOR TODAY → treat as closed today, show next open day
				if (!todaySpec) {
					setClosedLabels($statusAll)
					$container.addClass('closed')

					const nextOpen = getNextOpenDay(specs, now)
					let phrase = 'Closed today'

					if (nextOpen) {
						phrase = buildNextOpenPhrase(nextOpen, now, 'until ')
					}

					$hours.html(phrase)
					updatePhraseClass($hours, phrase)
					return
				}

				const {
					isOpen,
					closedAllDay,
					opensLater,
					openingSoon,
					closesSoon,
					closedUntilTomorrow,
					hoursText,
				} = getStatusAndHours(todaySpec, now)

				const nextOpen = getNextOpenDay(specs, now)

				// CLOSED ALL DAY
				if (closedAllDay) {
					setClosedLabels($statusAll)
					$container.addClass('closed')

					let phrase = 'Closed today'

					if (nextOpen) {
						phrase = buildNextOpenPhrase(nextOpen, now, 'until ')
					}

					$hours.html(phrase)
					updatePhraseClass($hours, phrase)
					return
				}

				// OPENING SOON
				if (openingSoon) {
					setClosedLabels($statusAll)
					$container.addClass('closed')

					const phrase = `Opens soon at <b>${hoursText.split('–')[0].trim()}</b>`
					$hours.html(phrase)
					updatePhraseClass($hours, phrase)
					return
				}

				// OPENS LATER
				if (opensLater) {
					setClosedLabels($statusAll)
					$container.addClass('closed')

					const phrase = `Opens at <b>${hoursText.split('–')[0].trim()}</b>`
					$hours.html(phrase)
					updatePhraseClass($hours, phrase)
					return
				}

				// CLOSES SOON
				if (closesSoon) {
					$statusAll.each(function () {
						const $status = $(this)
						const isSmall = $status.hasClass('smallStatus')
						const openLabel = isSmall ? 'Open now' : 'Open'
						$status.text(openLabel)
					})
					$container.addClass('open')

					const phrase = `Closes soon at <b>${hoursText.split('–')[1].trim()}</b>`
					$hours.html(phrase)
					updatePhraseClass($hours, phrase)
					return
				}

				// CLOSED UNTIL TOMORROW / NEXT OPEN DAY
				if (closedUntilTomorrow) {
					setClosedLabels($statusAll)
					$container.addClass('closed')

					let phrase = 'Closed until tomorrow'

					if (nextOpen) {
						phrase = buildNextOpenPhrase(nextOpen, now, 'Opens ')
					}

					$hours.html(phrase)
					updatePhraseClass($hours, phrase)
					return
				}

				// NORMAL OPEN/CLOSED
				$statusAll.each(function () {
					const $status = $(this)
					const isSmall = $status.hasClass('smallStatus')
					const statusText = isOpen
						? isSmall
							? 'Open now'
							: 'Open'
						: isSmall
							? 'Closed now'
							: 'Closed'
					$status.text(statusText)
				})

				$container.addClass(isOpen ? 'open' : 'closed')
				$hours.text(hoursText)
				updatePhraseClass($hours, hoursText)
			})
		})
	})

	//horizontal scroll

	$(window).on('load', function () {
		const $section = $('.conceptHeader')
		const $slider = $('.event-feed-slider')
		const slider = $slider[0]

		if (!slider) return

		// Compute true max scroll
		function computeMaxScroll() {
			slider.dataset.maxScroll = slider.scrollWidth - slider.clientWidth
		}

		computeMaxScroll()
		setTimeout(computeMaxScroll, 100)

		// Wheel logic
		$section.on('wheel', function (e) {
			// Only allow horizontal scroll at top of page
			if (window.scrollY > 0) {
				// Not at top → let vertical scroll happen normally
				return
			}

			const delta = e.originalEvent.deltaY * 3 // speed multiplier
			const maxScroll = parseFloat(slider.dataset.maxScroll) || 0

			const atStart = slider.scrollLeft <= 0
			const atEnd = slider.scrollLeft >= maxScroll - 1

			// CASE 1: Horizontal scroll is possible → hijack
			if ((delta > 0 && !atEnd) || (delta < 0 && !atStart)) {
				e.preventDefault()
				slider.scrollLeft += delta
				return
			}

			// CASE 2: At edges → forward wheel to window for vertical scroll
			const forwarded = new WheelEvent(e.originalEvent.type, e.originalEvent)
			window.dispatchEvent(forwarded)
		})
	})

	//start horizontal scroll

	$(function () {
		const $row = $('.eventRow')
		if (!$row.length) return

		const SCROLL_MULTIPLIER = 3 // increase/decrease to taste
		const SCROLL_DURATION = 250 // ms

		$row.on('wheel', function (event) {
			const e = event.originalEvent
			const $this = $(this)

			const scrollLeft = $this.scrollLeft()
			const maxScrollLeft = this.scrollWidth - this.clientWidth

			const canScrollMoreLeft = scrollLeft > 0
			const canScrollMoreRight = scrollLeft < maxScrollLeft

			if (e.deltaY !== 0 && (canScrollMoreLeft || canScrollMoreRight)) {
				event.preventDefault()

				const delta = e.deltaY * SCROLL_MULTIPLIER
				const target = scrollLeft + delta

				$this
					.stop(true, false)
					.animate(
						{ scrollLeft: target },
						{ duration: SCROLL_DURATION, queue: false },
					)
			}
		})
	})
})(jQuery, Drupal, drupalSettings)
