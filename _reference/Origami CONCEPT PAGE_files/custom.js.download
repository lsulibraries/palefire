							.text('')
							.attr('aria-label', originalText)
							.addClass('searchSubmit')
					})
			})

			once(
				'move-tile-homepage-block-exposed-form',
				'#block-exposedformtile-homepage-searchblock-1',
				context,
			).forEach(function (el) {
				$(el).appendTo('.siteForm .formSection')
				$(el)
					.find('button')
					.each(function () {
						const $btn = $(this)
						const originalText = $btn.text().trim()
						$btn
							.text('')
							.attr('aria-label', originalText)
							.addClass('searchSubmit')
					})
			})

			once(
				'move-ebooks-block-exposed-form',
				'#block-exposedforme-books-top-search-page-1',
				context,
			).forEach(function (el) {
				console.log(el)
