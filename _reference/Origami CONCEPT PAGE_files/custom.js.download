	// Owl carousel
	Drupal.behaviors.owl = {
		attach: function (context, settings) {

			const initCarousel = ($el, options) => {
				once('owl-init', $el, context).forEach((el) => {
					try {
						$(el).owlCarousel(options)
					} catch (error) {
						console.log("Error initializing owl carousel")
						console.error(error)
					}
				})
			}

			const fixOwlAccessibility = () => {
				once('owl-a11y', 'body', context).forEach(() => {
					$('.owl-prev')
						.attr('aria-label', 'Previous slide')
						.attr('role', 'button')
					$('.owl-next')
						.attr('aria-label', 'Next slide')
						.attr('role', 'button')

					$('.owl-carousel').each(function () {
						$(this)
							.find('.owl-dot')
							.each(function (index) {
								$(this).attr('aria-label', `Go to slide ${index + 1}`)
							})
					})
				})
			}

			const replaceUlWithDiv = () => {
				once('owl-ul-to-div', 'ul.owl-carousel', context).forEach((ul) => {
					const $ul = $(ul)
					const $div = $('<div>', { class: ul.className })

					$ul.children().each(function () {
						if (this.tagName.toLowerCase() === 'li') {
							$('<div>', $(this).prop('attributes'))
								.append($(this).contents())
								.appendTo($div)
						} else {
							$div.append(this)
						}
					})

					$ul.replaceWith($div)
				})
			}

			$(
				'#api_upc_cid8030_iid1486 li br, #api_upc_cid16219_iid1486 li br',
				context,
			).remove()

			$(
				'.largeBanner #api_upc_cid8030_iid1486 ul, .largeBanner #api_upc_cid16219_iid1486 ul',
				context,
			)
				.add('#api_upc_cid8030_iid1486 ul')
				.addClass('owl-carousel owl-theme')

			replaceUlWithDiv()

			initCarousel($('.showcaseGrid', context), {
				margin: 10,
				nav: true,
				center: true,
				rewind: true,
				startPosition: pagenum,
				responsive: {
					0: { items: 1 },
					600: { items: 3 },
					1000: { items: 5 },
				},
			})

			initCarousel($('.node--type-section .dynamicTable', context), {
				margin: 1,
				dots: true,
				rewind: true,
				responsive: {
					0: { items: 1 },
					768: { items: 3 },
					1000: { items: 6 },
					1200: { items: 7 },
				},
			})

			initCarousel($('.loantileTable', context), {
				margin: 1,
				dots: true,
				rewind: true,
				responsive: {
					0: { items: 1 },
					768: { items: 3 },
					1000: { items: 3 },
				},
			})

			initCarousel($('.singleColumn', context), {
				items: 1,
				nav: true,
			})

			initCarousel($('#api_upc_cid8030_iid1486 > div', context), {
				items: 1,
				dots: false,
				autoHeight: true,
				autoplay: true,
				autoplayTimeout: 8000,
				autoplayHoverPause: true,
				loop: true,
				smartSpeed: 1200,
			})

			initCarousel(
				$('.largeBanner #api_upc_cid16219_iid1486 > div', context),
				{
					items: 1,
					dots: false,
					autoHeight: true,
					autoplay: true,
					autoplayTimeout: 8000,
					autoplayHoverPause: true,
					loop: true,
					smartSpeed: 1200,
				},
			)

			initCarousel($('#search-tabs', context), {
				dots: false,
				loop: false,
				mouseDrag: false,
				responsive: {
					0: {
						items: 1,
						nav: true,
					},
					600: {
						items: 3,
						nav: true,
					},
					1000: {
						items: 6,
						nav: true,
					},
				},
				onInitialized: function (e) {
					$(e.target).find('.owl-stage .owl-item').attr('role', 'tablist')
					$(e.target)
						.find('.owl-stage .owl-item .itemTab')
						.attr('role', 'tab')
				},
			})

			const items = $('#api_upc_cid16219_iid1486 div div')
			// Is there a better way to do this than comparing strings?
			if ($(items[0]).text() == 'No events are scheduled.') {
				$(items[0]).text('No displays are scheduled.')
			}

			once(
				'search-tab-carousel-event-handler',
				'#search-tabs',
				context,
			).forEach((element) => {
				const tabs = $(element).find('.itemTab')
				$(element).on('changed.owl.carousel', function (event) {
					if (event.page.size === 1) {
						tabs[event.item.index].click()
					}
				})
			})

			once('owl-text-fix', '#api_upc_cid16219_iid1486', context).forEach(
				(el) => {
					const $item = $(el).find('div div').first()
					if ($item.text().trim() === 'No events are scheduled.') {
						$item.text('No displays are scheduled.')
					}
				},
			)

			fixOwlAccessibility()
		},
	}

	// Load saved search tab
	Drupal.behaviors.search = {
		attach: function (context, settings) {
			once('bind-search-tab-events', 'div.itemSearch', context).forEach(
				(element) => {
					// Load last saved tab or explicitly saved default search

					const DEFAULT_TAB_KEY = 'saved-tab'
					const PREVIOUS_SESSION_TAB_KEY = 'previous-session-tab'
					const FALLBACK_DEFAULT_TAB_TEXT = 'Discovery'

					const defaultSearchForm = $('#defaultSearchForm')
					const shortcutBar = $('.sbContainer')
					let defaultSearch = localStorage.getItem(DEFAULT_TAB_KEY)

					// Discovery is the default search unless the visitor has
					// explicitly saved a different default (via #saveDefaultSearch,
					// stored under DEFAULT_TAB_KEY). The previously-viewed tab
					// (PREVIOUS_SESSION_TAB_KEY) is still recorded below, but it no
					// longer overrides Discovery on load.
					let target = defaultSearch

					if (!target) {
						const $discoveryTab = $(
							'.itemSearch div[data-bs-toggle="pill"]',
						).filter(function () {
							return (
								$(this).text().trim().toLowerCase() ===
								FALLBACK_DEFAULT_TAB_TEXT.toLowerCase()
							)
						})

						if ($discoveryTab.length) {
							target = $discoveryTab.first().data('bs-target')
							defaultSearch = target
						}
					}

					function hideForm() {
						shortcutBar.removeClass('mt-5 mt-lg-4')
						defaultSearchForm.css({
							display: 'none',
						})
					}

					function showForm() {
						shortcutBar.addClass('mt-5 mt-lg-4')
						defaultSearchForm.css({
							display: 'block',
						})
					}

					$('#saveDefaultSearch').click(() => {
						const pill = $('.itemTabs  div[data-bs-toggle="pill"].active')
						localStorage.setItem(
							DEFAULT_TAB_KEY,
							$(pill[0]).data('bs-target'),
						)
						defaultSearch = $(pill[0]).data('bs-target')
						$('#defaultSearch').text($(pill[0]).text().trim())
						hideForm()
					})

					$('.itemSearch div[data-bs-toggle="pill"]').each((_, pill) => {
						pill.addEventListener('shown.bs.tab', function (event) {
							localStorage.setItem(
								PREVIOUS_SESSION_TAB_KEY,
								$(event.target).data('bs-target'),
							)
							$('#selectedSearchTab').text($(event.target).text().trim())

							if ($(event.target).data('bs-target') == defaultSearch)
								hideForm()
							else showForm()
						})
					})

					if (target) {
						$(`.itemSearch div[data-bs-target="${target}"]`).each(
							(_, markup) => {
								$('#defaultSearch').text($(markup).text().trim())
								if (!$('body').hasClass('page-node-136')) {
									$('.itemTabs .itemTab')
										.removeClass('active')
										.attr('aria-selected', 'false')

									const tab = bootstrap.Tab.getOrCreateInstance(
										$(markup),
									)
									const carousel = $('div#search-tabs')
									const tabs = carousel.find('.itemTab')
									const index = tabs.index($(markup))
									carousel.trigger('to.owl.carousel', [index, 20])
									tab.show()
								}
							},
						)
					} else {
						// No defaultSearch or tab stored
						$('#defaultSearchSpan').remove()
						showForm()
					}
				},
			)
		},
	}

	// Ask Us Modal
	// Switch to correct tab
	// Set default values for inputs
	Drupal.behaviors.askUs = {
		attach: function (context, settings) {
			/**
			 * @see origmai.theme origami_preprocess_html L103-L105
			 */
			const defaultTab = settings.origami['default-ask-us-tab']
			once('ask-us-modal-init', '#tile2958', context).forEach((element) => {
				$(element).on('shown.bs.modal', function (e) {
					const intent = $(e.relatedTarget).data('intent')
					switch (intent) {
						case 'feedback':
							$(element).find('#general-tab').click()
							const widget = $(element).find('#askus-general-widget')
							const content = $(widget).contents()
							const dropdown = content.find('#val7_19448')
							dropdown.val('17')
							break

						default:
							$(element).find(`#${defaultTab}`).click()
							break
					}
				})
			})
		},
	}

	// Update url on modal events
	Drupal.behaviors.UpdateURLModalEvent = {
		attach: function (context, settings) {
			once('update-url-modal-event', '.tileModal', context).forEach(
				(element) => {
					if ($(element).hasClass('staffModal')) return

					$(element).on('shown.bs.modal', function (e) {
						const url = $(element).find('div.copyPath').text().split('/')
						const path = url[url.length - 1]
						window.history.pushState({}, '', path)
					})
					$(element).on('hidden.bs.modal', function (e) {
						window.history.back()
					})
				},
			)
		},
	}

	/**
	 * For accessibility
	 * Toggle modal inert on modal events.
	 * This is to prevent content inside modal from receiving focus when hidden
	 */
	Drupal.behaviors.ToggleModalInert = {
		attach: function (context, settings) {
			once('toggle-modal-inert', '.modal', context).forEach((element) => {
				// Add inert attribute to modal by default
				$(element).attr('inert', '')

				$(element).on('shown.bs.modal', function (e) {
					$(element).removeAttr('inert')
				})
				$(element).on('hidden.bs.modal', function (e) {
					$(element).attr('inert', '')
				})
			})
		},
	}

	// Update view count on FAQs
	Drupal.behaviors.UpdateFAQViewCount = {
		attach: function (context, settings) {
			once('update-faq-view-count', '.tileModal.faqTile', context).forEach(
				(element) => {
					$(element).on('shown.bs.modal', function (e) {
						const id = $(element)
							.find('a.faq-btn')
							.attr('href')
							.split('/')
							.pop()
						const uri = `https://askus.lib.lsu.edu/faq/${id}/view`

						const formData = new FormData()
						formData.append('type', '1')
						const options = {
							method: 'POST',
							body: formData,
							mode: 'no-cors',
						}

						fetch(uri, options)
					})
				},
			)
		},
	}

	//parallax banners
	Drupal.behaviors.parallax = {
		attach: function (context, settings) {
			once('parallax', 'img.bannerImage', context).forEach((element) => {
				$('.bannerBackground').appendTo('#main-wrapper')
				new simpleParallax(element, { scale: 1.2, orientation: 'down' })
				$('.bannerBackground').find('.placeholder').fadeOut(100)
				$('.bannerContainer').find('.placeholder').fadeOut(100)
				$('.linkMain').find('.placeholder').fadeOut(100)
			})
		},
	}

	Drupal.behaviors.tooltips = {
		attach: function (context, settings) {
			once('tooltip-init', '[data-bs-toggle="tooltip"]', context).forEach(
				() => {
					// Delete any stuck tooltip
					setTimeout(() => {
						$('.tooltip.show').remove()
					}, 500)

					// Define a mapping of selectors to their custom classes
					const tooltipConfigurations = [
						{
							selector: '.tabText',
							config: { customClass: 'searchTooltip' },
						},
						{
							selector: '.mobileIcon',
							config: { customClass: 'defaultTooltip' },
						},
						{
							selector: '.featureLink',
							config: { customClass: 'linkTooltip' },
						},
						{
							selector: '.copyLink',
							config: { customClass: 'copyTooltip' },
						},
						{
							selector: '.bentoLink',
							config: {
								customClass: 'bentoLink',
								placement: 'left',
								delay: { show: 500, hide: 100 },
							},
						},
					]

					// Track initialized tooltips to avoid duplicates
					const initializedElements = new Set()

					// Initialize tooltips with defined selectors and custom classes
					tooltipConfigurations.forEach(({ selector, config }) => {
						const tooltipTriggerList = document.querySelectorAll(selector)
							;[...tooltipTriggerList].forEach((tooltipTriggerEl) => {
								if (!initializedElements.has(tooltipTriggerEl)) {
									const c = { ...config }
									if ('container' in c && c.container === 'self')
										c.container = tooltipTriggerEl
									new bootstrap.Tooltip(tooltipTriggerEl, c)
									initializedElements.add(tooltipTriggerEl) // Mark as initialized
								}
							})
					})

					// Initialize all other tooltips with [data-toggle='tooltip'] that aren't already handled
					const fallbackTooltips = document.querySelectorAll(
						'[data-bs-toggle="tooltip"]',
					);
					[...fallbackTooltips].forEach((tooltipTriggerEl) => {
						if (!initializedElements.has(tooltipTriggerEl)) {
							new bootstrap.Tooltip(tooltipTriggerEl) // Default initialization without custom config
						}
					})
				},
			)

			// Ask-Us tooltip init
			// Disable Ask-Us popover on bento and concept pages
			if (
				window.location.pathname.includes('bento') ||
				window.location.pathname.includes('concept')
			) {
				return
			}

			once('askus-popover-init', '#askus-button', context).forEach(
				async (element) => {
					const response = await fetch(
						'https://chat-us.libanswers.com/widget_status?iid=955&rules=[{"u":0,"d":[7071],"c":"","fallbackSeconds":0},{"u":0,"d":[8344],"c":"","fallbackSeconds":0}]',
					)
					const data = await response.json()

					const chatAvailable =
						data && data.hasOwnProperty('d') && data.d.includes(7071)

					const popover = new bootstrap.Popover(element, {
						html: true,
						trigger: 'manual',
						placement: 'bottom',
						customClass: 'askus-popover',
						sanitize: false,
						template: `<div class="popover" role="tooltip">
                      <div class="popover-arrow"></div>
                      <h2 class="popover-header"></h2>
                      <div class="popover-body"></div>
                    </div>`,
					})

					element.addEventListener('shown.bs.popover', function () {
						$('.askus-popover')
							.find('.actions #btn-confirm')
							.on('click', function (e) {
								e.preventDefault()
								$('a[data-bs-target="#tile2958"]')[0].click()
								popover.hide()
							})
						$('.askus-popover')
							.find('.actions #btn-cancel')
							.on('click', function (e) {
								e.preventDefault()
								sessionStorage.setItem('askus-tip-dismissed', 'true')
								popover.hide()
							})
					})

					setTimeout(() => {
						const dismissed = sessionStorage.getItem(
							'askus-tip-dismissed',
						)
						if (Boolean(!dismissed) && Boolean(chatAvailable)) {
							popover.show()
						}
					}, 2000)
				},
			)
		},
	}

	Drupal.behaviors.tiles = {
		attach: function (context, settings) {
			once('placeholder-fade', 'div.placeholder', context).forEach(
				(element) => {
					$(element).fadeOut(500)
				},
			)
			$('div.copyLink').on('click', async function () {
				const $copyAlert = $(this)
					.parent()
					.parent()
					.parent()
					.find('.copyAlert')
				await navigator.clipboard.writeText(
					$('.copyPath', this).text().trim(),
				)
				$copyAlert.addClass('show')
				setTimeout(() => {
					$copyAlert.removeClass('show')
				}, 1300)
			})
			$('.copyAlert .btn-close').on('click', function () {
				$(this).parent().removeClass('show')
			})
		},
	}

	Drupal.behaviors.sticky = {
		attach: function (context, settings) {
			once('sticky', '.bannerNavigation', context).forEach(() => {
				$(
					'.field--name-field-section-header .field__item:not(.staffHeader)',
				).each(function () {
					var title = $(this).text()
					var value = title.replace(/ /g, '')
					$(this).append('<div class="anchorDiv" id="' + value + '"</div>')
					$('.sectionItems ol').append(
						'<li class="nav-item"><a class="nav-link" href="#' +
						value +
						'" aria-label="Anchor link to ' +
						title +
						'section"><span>' +
						title +
						'</span></a></li>',
					)
				})

				if ($('.sectionItems ol li').length === 0) {
					// Removing if no items were appended. For accessibility
					$('.sectionItems').remove()
				}

				$(
					'.field--name-field-section-header .field__item:first:not(.staffHeader)',
				).each(function () {
					var title = $(this).text()
					console.log(title)
					var value = title.replace(/ /g, '')
					// $(this).append('<div class="anchorDiv" id="'+ value + '"</div>');
					$('.sectionNavbar ul').append(
						'<li class="nav-item"><a class="nav-link firstLink" href="#main-content" alt="Anchor link to ' +
						title +
						'">' +
						title +
						'</a></li>',
					)
				})

				$(
					'.field--name-field-section-header .field__item:not(:first):not(.staffHeader)',
				).each(function () {
					var title = $(this).text()
					var value = title.replace(/ /g, '')
					//
					// $(this).append('<div class="anchorDiv" id="'+ value + '"</div>');
					console.log(title)
					$('.sectionNavbar ul').append(
						'<li class="nav-item"><a class="nav-link" href="#' +
						value +
						'" alt="Anchor link to ' +
						title +
						'">' +
						title +
						'</a></li>',
					)
				})

				if ($('.sectionNavbar ul li').length === 0) {
					// Removing if no items were appended. For accessibility
					$('.sectionNavbar').remove()
				}

				createSticky($('#sectionNav'))
				$('.firstLink').addClass('active')
				// $('.field--name-field-section-header:first:not(.staffhr)').hide();
				//staff work
				$('.js-form-item-search-api-staff').appendTo('.menuDesc')
				$(
					'.js-form-item-field-department, .js-form-item-field-subject-area',
				).appendTo('.menuContact .menuItem')
				$('.js-form-item-field-staff-type').appendTo('.categoryItems')
				$('.sectionMenu, .linksMenu, .featureMenu').prependTo(
					'#views-exposed-form-allstaff-staffblock',
				)
				$('#views-exposed-form-allstaff-staffblock').addClass(
					'bannerMenus nodeSection',
				)
				$(
					'#views-exposed-form-allstaff-staffblock .js-form-wrapper',
				).appendTo('#views-exposed-form-allstaff-staffblock')
				$('.removeThis, .bannerMenus > .d-flex').remove()
				$('#edit-field-staff-type').removeClass('form-select')
				$(
					"<a href='#' class='orgLink' data-bs-toggle='modal' data-bs-target='#organizationalcharts'>Org Charts</a>",
				).prependTo('.menuFilters .menuItem')
				$('.views-view-responsive-grid--horizontal').addClass('tileGrid')
			})
		},
	}
	function createSticky(sticky) {
		if (sticky) {
			var pos = sticky.offset()?.top + 20,
				win = $(window)
			win.on('scroll', function () {
				win.scrollTop() >= pos
					? sticky.addClass('fixed')
					: sticky.removeClass('fixed')
			})
		}
	}

	Drupal.behaviors.itemTabsBehavior = {
		attach: function (context) {
			let isMoving = false

			// Mousedown: track movement
			once('itemTabs-mousedown', '.itemTabs .itemTab', context).forEach(
				function (el) {
					$(el).on('mousedown', function () {
						isMoving = false

						const onMouseMove = () => (isMoving = true)
						$(window).on('mousemove.itemTabs', onMouseMove)

						$(window).one('mouseup.itemTabs', function () {
							$(window).off('mousemove.itemTabs', onMouseMove)
						})
					})
				},
			)

			// Click: handle tab activation
			once('itemTabs-click', '.itemTabs .itemTab', context).forEach(
				function (el) {
					$(el).on('click', function (e) {
						if (isMoving) {
							e.stopImmediatePropagation()
							e.preventDefault()
							return
						}
					})

					$(el).on('show.bs.tab', function () {
						$('.itemTabs .itemTab', context)
							.removeClass('active')
							.attr('aria-selected', 'false')
					})

					$(el).on('shown.bs.tab', function (e) {
						$(e.target).addClass('active').attr('aria-selected', 'true')
					})
				},
			)
		},
	}

	/**
	 * Search bar database tab
	 * Redirect to A-Z database on select
	 */
	Drupal.behaviors.dataAZRedirect = {
		attach: function (context, settings) {
			once('dataAZRedirect', '#dataAZ', context).forEach(function (el) {
				$(el).on('change', function () {
					if ($(this).val() !== '') {
						window.location.href = $(this).val()
					}
				})
			})
		},
	}

	/**
	 * Open modal if modal ID in URL
	 */
	Drupal.behaviors.modalFromHash = {
		attach: function (context, settings) {
			once('modalFromHash', '.modal', context).forEach(function (el) {
				const modalId = `#${$(el).attr('id')}`

				// Retry if modal is not ready
				function tryShowModal() {
					if (typeof $(modalId).modal === 'function')
						$(modalId).modal('show')
					else
						setTimeout(() => {
							tryShowModal()
						}, 200)
				}

				if (window.location.href.indexOf(modalId) !== -1) {
					tryShowModal()
				}
			})
		},
	}

	/**
	 * Remove scrolled class on search bar focused
	 */
	Drupal.behaviors.searchContainerClick = {
		attach: function (context, settings) {
			once('searchContainerClick', '.searchContainer', context).forEach(
				function (el) {
					$(el).on('click', function () {
						$('body', context).removeClass('scrolled')
					})
				},
			)
		},
	}

	/**
	 * @deprecated
	 * Section nav is no longer visible
	 */
	Drupal.behaviors.sectionNavScroll = {
		attach: function (context, settings) {
			// Ensure we only attach the scroll event once.
			once('section-nav-scroll', 'body', context).forEach(function (el) {
				const scrollSpy = new bootstrap.ScrollSpy(el, {
					target: '#sectionNav',
					offset: 100,
				})

				$(window).on('scroll', function () {
					const hasActive = $(
						'#sectionNav .nav-link:not(:first)',
					).hasClass('active')

					if (!hasActive) {
						$('.firstLink').addClass('active')
					} else {
						$('.firstLink').removeClass('active') // probably 'active', not 'newClass'?
					}
				})
			})
		},
	}

	//start seaerch header
	const $wrapper = $('.header-search')
	if (!$wrapper.length) return

	const $toggle = $wrapper.find('.search-toggle')
	const $form = $wrapper.find('.search-form')
	const $input = $form.find('input')

	$toggle.on('click', function () {
		const isOpen = $wrapper.toggleClass('active').hasClass('active')
		$toggle.attr('aria-expanded', isOpen)

		if (isOpen) {
			setTimeout(() => $input.trigger('focus'), 150)
		}
	})

	// Collapse when clicking outside
	$(document).on('click', function (e) {
		if (!$wrapper.is(e.target) && $wrapper.has(e.target).length === 0) {
			$wrapper.removeClass('active')
			$toggle.attr('aria-expanded', 'false')
		}
	})
	//end search header

	//event slider
	// const scrollRoot = document.querySelector('.conceptHeader');
