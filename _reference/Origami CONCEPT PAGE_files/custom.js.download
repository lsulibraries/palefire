; (function ($, Drupal) {
	'use strict'

	$('.serviceSearch').attr({
		'data-bs-toggle': 'modal',
		'data-bs-target': '#search',
		role: 'button',
		'aria-expanded': 'false',
		'aria-controls': 'search',
		title: 'Opens search interface',
	})

	$('.serviceSearch').click(function () {
		$('#search li:nth-child(5) a').tab('show')
		$('#inputSite').focus()
	})

	$('.catalogSearch').click(function () {
		$('#header .itemSearch .cataTab').click()
	})

	///catalog Search for Govdocs
	$('.page-node-54 .catalogSearch').click(function () {
		$('#header .itemSearch .cataTab').click()
		$('#library-static').val(
			'LIBRARY	Library	21:DOCS_MICRO	Government Documents ',
		)
		$('#library-static').addClass('selected')
		var selectedScheme = 'Default'

		$('#library-static').change(function () {
			$(this).removeClass(selectedScheme).addClass($(this).val())
			selectedScheme = $(this).val()
		})
	})

	///catalog Search for Music
	$('.page-node-70 .node--type-call-to-action').addClass('catalogSearch')

	$('.page-node-70 .catalogSearch').click(function () {
		$('#header .itemSearch .cataTab').click()
		$('#library-static').val(
			'LIBRARY	Library	21:MUSIC	Carter Music Resource Center',
		)
		$('#library-static').addClass('selected')
		var selectedScheme = 'Default'

		$('#library-static').change(function () {
			$(this).removeClass(selectedScheme).addClass($(this).val())
			selectedScheme = $(this).val()
		})
	})

	///catalog Search for SC
	$('.page-node-22 .node--type-call-to-action').addClass('catalogSearch')

	$('.page-node-22 .catalogSearch').click(function () {
		$('#header .itemSearch .cataTab').click()
		$('#library-static').val('LIBRARY	Library	21:SPEC_COLL	Special Collections')
		$('#library-static').addClass('selected')
		var selectedScheme = 'Default'

		$('#library-static').change(function () {
			$(this).removeClass(selectedScheme).addClass($(this).val())
			selectedScheme = $(this).val()
		})
	})

	$('.mainSearch').click(function () {
		$('#search li:nth-child(1) a').tab('show')
	})

	//
	// $(".path-frontpage .tileItem:gt(5)").addClass("inactive");
	// temporary moves block for blog
	$('#block-views-block-article-test-block-1').appendTo('.tileGrid')

	// start showcase page number query
	var pagenum = $('.scInteger > div').text() - 1
	$('.showcaseLink').eq(pagenum).addClass('active')
	var pagelong = $('.showcaseLink.active .showcaseLong').text()
	$('.showcaseCurrent > div').text(pagelong)

	$('.scToggle.showcaseDetails').click(function () {
		$('.showcaseDetails').toggleClass('open')
	})

	//start hover carousel for long titles
	$('.showcaseLink').hover(
		function () {
			var $this = $(this) // caching $(this)
			var $title = $('.showcasePlaceholder')
			var $long = $this.find('.showcaseLong').text()
			$title.data('defaultText', $this.text())
			$title.text($long)
		},
		function () {
			var $title = $('.showcasePlaceholder')
			$title.text('Page Navigation')
		},
	)

	// sitemap
	$('.clickable').each((index, element) => {
		$(element).click(() => {
			const icon = $(element).find('i')[0]
			$(icon).toggleClass('inverted')
			const parentTag = $(element).parent()[0]
			const collapsed = $(parentTag).find('.transition')[0]
			if (collapsed !== undefined) {
				$(collapsed).toggleClass('collapsed')
			}
		})
	})
	//section menu for bootstrap nav

	/**
	 * We should move page specific code to a separate library and load via
	 * hook_page_attachment_alter depending on the route and attach libraries
	 * @see origami.theme hook_page_attachment_alter
	 */
	switch (
	true //detect page type or content type
	) {
		/**
		 * @deprecated Moved to a separate library
		 * @see showcase.js
		 */
		case $('body').hasClass('node--type-showcase'): {
			break

			$('body').addClass('alwaysScrolled')
			$(window).on('load', function () {
				var elementHeight = $('.showcaseCover').height()
				var heightLabel = $('.showcaseIntro').height()
				var actualHeight = elementHeight - heightLabel - 100
				var windowHeight = window.innerHeight
				if (actualHeight < windowHeight) {
					$('.showcaseCover').css('top', '0px')
				} else {
					$('.showcaseCover').css(
						'top',
						'calc( -' + actualHeight + 'px + 60vh)',
					)
				}
			})

			//add styles for lowres cover image
			const imgbg = $('.showcaseBackground img')
			const testNat = imgbg[0].attributes[2].value
			if (testNat < 600) {
				$('body').addClass('lowresCover')
			}

			console.log(testNat)

			//add active class for menu
			$('#showcaseMenu a.scmLink').each(function () {
				// Get the full current URL
				var currentUrl = window.location.href

				// Get the href attribute of the current link
				var linkHref = $(this).attr('href')

				// Check if the current URL matches the link's href
				// You might need to adjust this comparison based on your URL structure
				// For example, if you only want to match the path without query parameters or hash
				if (currentUrl.includes(linkHref)) {
					$(this).addClass('active') // Add the 'active' class
				}
			})
			break
		}

		/**
		 * @deprecated Search results page no longer exists. Moved to separate library for safe keeping
		 * @see search-results.js
		 */
		case $('body').hasClass('path-searchresults'): {
			break

			$('#block-exposedformwebsite-searchpage-1').appendTo(
				'.siteForm .formSection',
			)
			$('#block-exposedformwebsite-searchpage-1 button')
				.text('')
				.addClass('searchSubmit')

			$('#block-exposedforme-books-top-search-page-1').appendTo(
				'.textbooksForm .formSection',
			)
			$('#block-exposedforme-books-top-search-page-1 button')
				.text('')
				.addClass('searchSubmit')
			break
		}

		case $('body').hasClass('page-node-108149'): {
			//function to gray out the X

			$(window).on('load', function () {
				$('.card').click(function () {
					if ($(this).find('input[type="checkbox"]:checked').length > 0) {
						// The card contains at least one checked checkbox
						$(this).addClass('answeredQuestion')
					} else {
						// No checked checkboxes found within the card
						$(this).removeClass('answeredQuestion')
					}
				})

				//function to prevent collapse if there is a checked checkbox
				$('.collapse').on('hide.bs.collapse', function (event) {
					console.log('collapse attempted')
					// Find if there's any checked checkbox within this panel
					if ($(this).find('input[type="checkbox"]:checked').length > 0) {
						// If a checked checkbox is found, prevent the collapse
						event.preventDefault()
						event.stopPropagation() // Stop event from bubbling up
					}
				})
			})
			break
		}

		/**
		 * @deprecated This seems to be unused. Moved to separate library for safe keeping.
		 * @see ebooks.js
		 */
		case $('body').hasClass('path-e-books'): {
			break
			$('.textTab').click()

			$('#block-exposedforme-books-top-search-page-1').appendTo(
				'.textbooksForm .formSection',
			)
			$('#block-exposedforme-books-top-search-page-1 button')
				.text('')
				.addClass('searchSubmit')

			$('#block-exposedformwebsite-searchpage-1').appendTo(
				'.siteForm .formSection',
			)
			$('#block-exposedformwebsite-searchpage-1 button')
				.text('')
				.addClass('searchSubmit')
			break
