				},
			)

			once(
				'move-ebooks-exposed-form',
				'#views-exposed-form-e-books-block-1',
				context,
			).forEach((el) => {
				$(el).appendTo('.textbooksForm .formSection')
				$(el)
					.find('button')
					.each(function () {
						const $btn = $(this)
						const originalText = $btn.text().trim()
