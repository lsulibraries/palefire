	Drupal.behaviors.searchAJAX = {
		attach: function (context, settings) {
			once('searchAJAX', '#searchResult', context).forEach((element) => {
				const query = $(
					'#views-exposed-form-tile-homepage-search-block-1 input',
				).val()
				if (query) {
					const hook = $('#searchResult')[0]
					setTimeout(() => {
						hook?.scrollIntoView()
					}, 100)
				}
			})
		},
	}

	Drupal.behaviors.themeToggles = {
		attach: function (context, settings) {
			const modes = [
				{ key: 'darkMode', class: 'dark-mode' },
				{ key: 'hidesidebarMode', class: 'hidesidebar-mode' },
				{ key: 'largeMode', class: 'large-mode' },
				{ key: 'columnMode', class: 'column-mode' },
				{ key: 'highlightMode', class: 'highlight-mode' },
			]

			modes.forEach(({ key, class: className }) => {
				const $toggle = $('#' + key)

				if (localStorage.getItem(key) === 'enabled') {
					$('body').addClass(className)
					$toggle.prop('checked', true)
				}

				once('theme-toggle', $toggle, context).forEach((el) => {
					$(el).on('change', function () {
						const enabled = $(this).is(':checked')

						$('body').toggleClass(className, enabled)
						localStorage.setItem(key, enabled ? 'enabled' : 'disabled')
					})
				})
			})
		},
	}

	Drupal.behaviors.GDPR = {
		attach: function (context, settings) {
			if (localStorage.getItem('gdpr-accept') !== 'ok') {
				$('#block-origami-cookiebanner').css('display', 'block')
			}

			// If accept, hide banner and remember choice
			once('gdpr-accept', '#consent-button', context).forEach((el) => {
				$(el).on('click', function () {
					$('#block-origami-cookiebanner').css('display', 'none')
					localStorage.setItem('gdpr-accept', 'ok')
				})
			})
		},
	}

	Drupal.behaviors.scrollReveal = {
		attach: function (context, settings) {
			if (!window.sr) {
				window.sr = ScrollReveal()
			}

			once('scroll-reveal-init', 'body', context).forEach(() => {
