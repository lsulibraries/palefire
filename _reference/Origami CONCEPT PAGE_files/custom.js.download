		/**
		 * @deprecated Moved to separate library
		 * @see ebooks.js
		 */
		case $('body').hasClass('page-node-136'): {
			break
			$('.textTab').click()

			$('#views-exposed-form-e-books-block-1').appendTo(
				'.textbooksForm .formSection',
			)
			$('#views-exposed-form-e-books-block-1 button')
				.text('')
				.addClass('searchSubmit')

			$('#block-exposedformwebsite-searchpage-1').appendTo(
				'.siteForm .formSection',
			)
			$('#block-exposedformwebsite-searchpage-1 button')
				.text('')
				.addClass('searchSubmit')
			break
		}

		case $('body').hasClass('page-node-114597'): {
			/**
			 * @deprecated
			 * @description This can be done server side. Requires adjusting the styles because it targets the view itself and not the block
			 * @see origami.theme @function style_bento_block for implementation
			 * @see bentosearch.css line 99, 235, 325, 384, 567, 618, 639, 878, 947
			 */

			Drupal.behaviors.selectValue = {
				attach: function (context, settings) {
					once(
						'bento-items-per-page',
						'select[name="items_per_page"]',
						context,
					).forEach((element) => {
						const value = $(element).val()
						const view = $(element).closest('.views-element-container')
						if (value.toLowerCase() == 'all' || parseInt(value) > 12)
							view.addClass('allBento')
						else view.removeClass('allBento lgBento')
						$('body').addClass('alwaysScrolled')
					})
				},
			}

			/**
			 * @deprecated
			 * This can be done server side. Requires adjusting the styles because it targets the view itself and not the block
			 * @see origami.theme @function style_bento_block for implementation
			 * @see bentosearch.css line 99, 235, 325, 384, 567, 618, 639, 878, 947
			 */
			Drupal.behaviors.resultCount = {
				attach: function (context, settings) {
					once('bento-result-count', '.view-summary', context).forEach(
						(element) => {
							const value = $(element).data('total')
							const view = $(element).closest('.views-element-container')
							if (value == 0 || value == null)
								view.addClass('emptyBento')
							else {
								//remove class and add order value
								view.removeClass('emptyBento')
								view.css({
									order: '-' + value,
								}) //need to add conditional to this so that users can toggle the bento sort (results, default, etc)
							}
						},
					)
				},
			}
			// We should do this in drupal via twig templates because it will be done server side
			// This will take care of the initial load where the styles don't get applied
			// This will require separating the header from the page template

			$(window).on('load', function () {
				return

				/**
				 * @deprecated begin wrap
				 * @description This can be done server side
				 * @see {@link /node/119736}
				 * */
				const views = $('.views-element-container[class*="blockbento"]') //select all bento views
				views.wrapAll("<div class='bentoContainer' />") //wrap all bento views
				$('.bentoContainer').wrap(
					"<div class='nodeSection bentoSection' />",
				) //wraps into nodeSection

				$('.bentoSection').prependTo('section.section') //moves to top section, this is needed for sticky behavior
				$('.bentoShortcut').insertAfter('.bentoContainer')

				// This must be done in JS on the client side because the query params only exist on the client
				// end wrap

				//begin input changes

				$('.inputSection').prependTo('section > .nodeSection') //moves input to proper section
				const stickyElement = document.querySelector('.inputSection')
				const scrollWatcher = document.createElement('div')
				scrollWatcher.setAttribute('data-scroll-watcher', '') // Optional: for identification
				stickyElement.before(scrollWatcher) // Inserts it before the sticky element
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							// Toggle a class on the sticky element based on intersection
							stickyElement.classList.toggle(
								'is-sticky',
								!entry.isIntersecting,
							)
							$('body').toggleClass('scrolledBento')
						})
					},
					{
						rootMargin: '120px 0px 0px 0px', // This option defines the margin around the root (viewport). Setting a negative top margin, like -1px, ensures the callback triggers slightly before the sticky element fully adheres to the top, providing a more precise detection of the sticky state. Adjust this value if you want the class to be applied at a different point in the scroll. Adjust this as needed
					},
				)
				observer.observe(scrollWatcher)
				// end inputchanges
				$('.bentoResult').insertBefore('.bentoContainer')
				$('#block-origami-content').remove() //removes unneeded empty block

				// Search term
				const queryString = window.location.search
				const params = new URLSearchParams(queryString)
				// There might be a way to configure so we don't have to specify the param as string here
				const searchTerm = params.get('search_api_fulltext_bento')

				// Doing this in the twig template will be easier because the data will already be there in the render array
				// Total search results
				// A span with the class 'view-summary' and data attribute 'total' needs to be added to view header
				const summaries = views.find('.view-summary')
				const totalResults = summaries.toArray().reduce((acc, curr) => {
					return acc + (parseInt($(curr).data('total')) || 0)
				}, 0)

				//Adds searched term to input form
				$('#edit-search-api-fulltext-bento').val(searchTerm)
				if (!searchTerm) {
					$('body').addClass('emptySearch')
				} else {
					$('body').addClass('usedSearch')
				}

				// We might need to move this to a Drupal behavior because this will only run on the initial page load and not on subsequent AJAX requests
				//Temporary adds message
				$('.bentoTotal').text(totalResults)
				$('.bntGroup').text(searchTerm)
				// $('#masterBento').on('submit', function (e) {
				//   $('body').addClass('bentoSent');
				// }); this is used for loading screen if its needed for longer load times

				$('.bentoColumn').each(function () {
					//allows to hide page numbers when single page

					const $summary = $(this).find('span.view-summary')
					const text = $summary.text().trim()
					const lastChar = text.slice(-1)
					const pageTotal = parseInt(lastChar, 10) || 0

					if (pageTotal < 2) {
						$(this).addClass('single-page')
					} else {
						$(this).addClass('multi-page')
					}
				})
					; (function () {
						function updateTime() {
							const now = new Date()
							const hours = now.getHours() % 12 || 12
							const minutes = now.getMinutes().toString().padStart(2, '0')
							const ampm = now.getHours() >= 12 ? 'PM' : 'AM'
							const xxtime = `${hours}:${minutes} ${ampm}`
							const days = [
								'Sunday',
								'Monday',
								'Tuesday',
								'Wednesday',
								'Thursday',
								'Friday',
								'Saturday',
							]
							const months = [
								'January',
								'February',
								'March',
								'April',
								'May',
								'June',
								'July',
								'August',
								'September',
								'October',
								'November',
								'December',
							]
							const dayName = days[now.getDay()]
							const monthName = months[now.getMonth()]
							const dayNum = now.getDate().toString().padStart(2, '0')
							const xxday = `${dayName}`
							const xxdate = `${monthName} ${dayNum}`
							$('#live-day').text(xxday)
							$('#live-date').text(xxdate)
							$('#live-time').text(xxtime)
						}

						updateTime() // Initial call
						setInterval(updateTime, 60000) // Update every minute
					})()
			})
			break
		}

		/**
		 * @deprecated Moved to separate library
		 * @see maps.js
		 */
		case $('body').hasClass('page-node-25689'): {
			break

			if (window.location.hash) {
				var hash = window.location.hash
				console.log('map index is ' + hash)
				$('.floor > *.active').removeClass('active')
				$('.floor span[class^="' + hash.split('#')[1] + '"]').addClass(
					'active',
				)
				$('.floor a[class^="' + hash.split('#')[1] + '"]').addClass(
					'active',
				)
				if ($('a.active').parents('.isomapHill').length) {
					$('html, body').animate(
						{
							scrollTop: $('#hillmap').offset().top - 400,
						},
						500,
					)
				} else {
					$('html, body').animate({ scrollTop: '150px' }, 500)
				}
			}
			break
		}

		/**
		 * @deprecated Move to a separate library
		 * @see frontpage.js
		 */
		case $('body').hasClass('path-frontpage'): {
			break

			// $(".field--name-field-welcome-text .field__item").html("Welcome to <br> LSU Libraries");
			$('#block-exposedformtile-homepage-searchblock-1').appendTo(
				'.siteForm .formSection',
			)
			$('#block-exposedformtile-homepage-searchblock-1 button')
				.text('')
				.addClass('searchSubmit')
			$('#block-exposedforme-books-top-search-page-1').appendTo(
				'.textbooksForm .formSection',
			)
			$('#block-exposedforme-books-top-search-page-1 button')
				.text('')
				.addClass('searchSubmit')
			break
		}

		/**
		 * @deprecated Moved to separate library
		 * @see special-collections.js
		 */
		case window.location.href.indexOf('special') > -1: {
			break

			$('#scask-tab').click()
			break
		}

		/**
		 * @deprecated Moved to separate library
		 * @see louisiana-newspapers.js
		 */
		case window.location.href.indexOf('louisiananewspapers') > -1: {
			break

			$('#scask-tab').click()
			break
		}
	}

	Drupal.behaviors.origamiEventHandlers = {
		attach: function (context, settings) {
			once('window-scroll', 'body', context).forEach(function (el) {
				$(window).on('scroll', function () {
					$('.navbar').removeClass('expanded')
					$('.itemCat').removeClass('active')
				})
			})

			once(
				'close-on-scrolled-click',
				'body.scrolled #main-wrapper, body.scrolled .highlighted',
				context,
			).forEach(function (el) {
				$(el).on('click', function () {
					$('.navbar').removeClass('expanded')
					$('.itemCat').removeClass('active')
					$('.searchTooltip .formDetail').hide()
				})
			})

			once('highlighted-click', '.highlighted', context).forEach(
				function (el) {
					$(el).on('click', function () {
						$('.searchTooltip .formDetail').hide()
					})
				},
			)

			once('header-click', '#header', context).forEach(function (el) {
				$(el).on('click', function () {
					$('.searchTooltip .formDetail').show()
				})
			})
		},
	}

	// $("#block-exposedformtile-homepage-searchblock-1").appendTo(".siteForm .formSection");
	// $("#views-exposed-form-tile-homepage-search-block-1 button").text("").addClass("searchSubmit");
	// $(".hidden").attr("placeholder", "Type here to search");
	// $("#block-exposedformwebsite-searchblock-1").appendTo(".siteCat");

	Drupal.behaviors.origamiContentFixes = {
