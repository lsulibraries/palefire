# Editors: LF line endings, UTF-8 and a final newline, two-space indents
# (Drupal coding standards). Line endings are enforced by .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
