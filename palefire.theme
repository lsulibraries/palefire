  'calcasieu' => 'Calcasieu',
  'caldwell' => 'Caldwell',
  'cameron' => 'Cameron',
  'catahoula' => 'Catahoula',
  'claiborne' => 'Claiborne',
  'concordia' => 'Concordia',
  'de_soto' => 'De Soto',
  'east_baton_rouge' => 'East Baton Rouge',
  'east_carroll' => 'East Carroll',
  'east_feliciana' => 'East Feliciana',
  'evangeline' => 'Evangeline',
  'franklin' => 'Franklin',
  'grant' => 'Grant',
  'iberia' => 'Iberia',
  'iberville' => 'Iberville',
  'jackson' => 'Jackson',
  'jefferson' => 'Jefferson',
  'jefferson_davis' => 'Jefferson Davis',
  'lafayette' => 'Lafayette',
  'lafourche' => 'Lafourche',
  'la_salle' => 'La Salle',
  'lincoln' => 'Lincoln',
