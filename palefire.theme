<?php

/**
 * @file
 * Functions to support theming in the Palefire theme.
 */

use Drupal\Component\Serialization\Yaml;
use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Render\Markup;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Adds the current page title so the breadcrumb template can show it
 * as the final, non-linked item.
 */
function palefire_preprocess_breadcrumb(array &$variables) {
  $route_match = \Drupal::routeMatch();
  $title = NULL;

  // Node pages: use the node's title.
  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface) {
    $title = $node->label();
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $node->getCacheTags()
    );
  }
  // Other pages (Views, taxonomy terms, etc.): use the route's title.
  elseif ($route = $route_match->getRouteObject()) {
    $resolved = \Drupal::service('title_resolver')
      ->getTitle(\Drupal::request(), $route);

    if (is_array($resolved)) {
      $resolved = \Drupal::service('renderer')->renderPlain($resolved);
    }
    if ($resolved) {
      $title = strip_tags((string) $resolved);
    }
  }

  if ($title) {
    $variables['current_page_title'] = $title;
  }

  // Cache the breadcrumb separately for each page.
  $variables['#cache']['contexts'][] = 'url.path';
}
/**
 * Implements hook_page_attachments_alter().
 *
 * Adds noindex to every page under /concept.
 */
function palefire_page_attachments_alter(array &$attachments) {
  $path = \Drupal::request()->getPathInfo();

  if (!preg_match('#^/concept(/|$)#i', $path)) {
    return;
  }

  $found = FALSE;

  // Overwrite Metatag's robots tag if it already added one.
  if (!empty($attachments['#attached']['html_head'])) {
    foreach ($attachments['#attached']['html_head'] as &$item) {
      if (($item[1] ?? '') === 'robots') {
        $item[0]['#attributes']['content'] = 'noindex, nofollow';
        $found = TRUE;
      }
    }
    unset($item);
  }

  // Otherwise, add one.
  if (!$found) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex, nofollow'],
      ],
      'robots',
    ];
  }
}

/**
 * Building floor maps from maps/buildings.yml, keyed by building.
 *
 * Each entry: label, heading, template (Twig include of the drawing), intro,
 * legend (icons to explain, e.g. [elevator]) and spaces (space key => label,
 * floor, access, tooltip). See that file.
 */
function palefire_buildings(): array {
  $buildings = &drupal_static(__FUNCTION__);
  if (!isset($buildings)) {
    $file = DRUPAL_ROOT . '/' . \Drupal::service('extension.list.theme')->getPath('palefire') . '/maps/buildings.yml';
    $buildings = is_readable($file) ? (Yaml::decode(file_get_contents($file)) ?: []) : [];
  }
  return $buildings;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--bento-search.
 *
 * Renders the bento's building map (field_bento_map) as bento_map. Built here
 * from the referenced paragraph, so it doesn't depend on the bento's view
 * display listing the field.
 */
function palefire_preprocess_paragraph__bento_search(array &$variables): void {
  $variables['bento_map'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface || !$paragraph->hasField('field_bento_map')) {
    return;
  }
  $map = $paragraph->get('field_bento_map')->entity;
  if ($map instanceof ParagraphInterface && $map->isPublished()) {
    $map = \Drupal::service('entity.repository')->getTranslationFromContext($map);
    $variables['bento_map'] = \Drupal::entityTypeManager()->getViewBuilder('paragraph')->view($map, 'default');
  }
  _palefire_bento_visit($variables, $paragraph);
}

/**
 * Adds the host Modular page's intro and Visit card to a bento search.
 *
 * Reads the optional node fields added by scripts/palefire_modular_setup.php
 * (field_intro, field_hours_location, field_location_name,
 * field_location_query, field_location_display). Sets:
 * - bento_intro: render array of field_intro, or NULL.
 * - visit: NULL, or ['name', 'lid', 'maps_url', 'embed_url', 'query'] for
 *   the Visit card (hours via js/visit-hours.js, the map loads on click).
 * A page with none of these fields filled in keeps today's bento.
 */
function _palefire_bento_visit(array &$variables, ParagraphInterface $paragraph): void {
  $variables['bento_intro'] = NULL;
  $variables['visit'] = NULL;

  // The bento may sit inside a section paragraph: walk up to the node.
  $host = $paragraph;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  if (!$host instanceof NodeInterface) {
    return;
  }
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $host->getCacheTags());

  $value = static function (string $name) use ($host): string {
    return ($host->hasField($name) && !$host->get($name)->isEmpty())
      ? trim((string) $host->get($name)->value)
      : '';
  };

  if ($host->hasField('field_intro') && !$host->get('field_intro')->isEmpty()) {
    $variables['bento_intro'] = $host->get('field_intro')->view(['label' => 'hidden']);
  }

  $lid = $value('field_hours_location');
  $name = $value('field_location_name');
  $query = $value('field_location_query');
  if ($lid === '' && $name === '' && $query === '') {
    return;
  }
  $embed = $value('field_location_display') === 'embed';
  $variables['visit'] = [
    'name' => $name,
    'lid' => preg_match('/^\d+$/', $lid) ? $lid : '',
    'query' => $query,
    'maps_url' => $query !== '' ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($query) : '',
    'embed_url' => ($embed && $query !== '') ? 'https://www.google.com/maps?q=' . rawurlencode($query) . '&output=embed' : '',
  ];
  $variables['#attached']['library'][] = 'palefire/visit';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--building-map.
 *
 * Builds `map` for the template: the building's drawing, and one entry per
 * published "Building spaces" room term (title, access, floor, link, tooltip).
 * A published Room override on this paragraph replaces that room's tooltip
 * text, access or link (only the fields it fills in).
 */
function palefire_preprocess_paragraph__building_map(array &$variables): void {
  $variables['map'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  $buildings = palefire_buildings();
  if (!$paragraph instanceof ParagraphInterface || !$buildings) {
    return;
  }
  $value = static fn (string $field) => $paragraph->hasField($field) ? $paragraph->get($field)->value : NULL;
  $key = $value('field_map_building') ?: array_key_first($buildings);
  $building = $buildings[$key] ?? NULL;
  if (!$building) {
    return;
  }

  // Any change to a Building spaces term re-renders the map.
  $cache = (new CacheableMetadata())->addCacheTags(['taxonomy_term_list:building_space']);
  $repository = \Drupal::service('entity.repository');
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $terms->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'building_space')
    ->condition('status', 1)
    ->condition('field_map_key', $key, 'STARTS_WITH')
    ->execute();
  $building_term = NULL;
  $rooms = [];
  foreach ($terms->loadMultiple($ids) as $term) {
    $term = $repository->getTranslationFromContext($term);
    $map_key = (string) $term->get('field_map_key')->value;
    if ($map_key === $key) {
      $building_term = $term;
    }
    elseif (str_starts_with($map_key, $key . '.')) {
      $rooms[substr($map_key, strlen($key) + 1)] = $term;
    }
  }

  $overrides = [];
  if ($paragraph->hasField('field_map_overrides')) {
    foreach ($paragraph->get('field_map_overrides') as $item) {
      $override = $item->entity;
      $room_key = $override instanceof ParagraphInterface && $override->isPublished() ? (string) $override->get('field_room_key')->value : '';
      if (str_starts_with($room_key, $key . '.')) {
        $overrides[substr($room_key, strlen($key) + 1)] = $override;
        $cache->addCacheableDependency($override);
      }
    }
  }

  // The override's field when it is filled in, otherwise the term's.
  $pick = static function (string $field, $term, ?ParagraphInterface $override, ?string $term_field = NULL): ?FieldItemListInterface {
    if ($override && $override->hasField($field) && !$override->get($field)->isEmpty()) {
      return $override->get($field);
    }
    $term_field = $term_field ?? $field;
    return $term->hasField($term_field) && !$term->get($term_field)->isEmpty() ? $term->get($term_field) : NULL;
  };
  $text = static fn (?FieldItemListInterface $items) => $items ? [
    '#type' => 'processed_text',
    '#text' => $items->value,
    '#format' => $items->format,
  ] : NULL;

  $uid = 'pf-map-' . $paragraph->id();
  $spaces = [];
  foreach ($building['spaces'] ?? [] as $space_key => $def) {
    $term = $rooms[$space_key] ?? NULL;
    if (!$term) {
      // Unpublished or missing: drawn as plain floor.
      continue;
    }
    $cache->addCacheableDependency($term);
    $override = $overrides[$space_key] ?? NULL;
    $access = $pick('field_space_access', $term, $override)?->value ?: ($def['access'] ?? 'walk_in');
    $link = $pick('field_space_link', $term, $override)?->first();
    $spaces[$space_key] = [
      'key' => $space_key,
      'title' => $term->label(),
      'access' => $access,
      'floor' => (int) ($def['floor'] ?? 1),
      'url' => $link ? $link->getUrl()->toString() : '',
      'cta' => $link ? ($link->title ?: ($access === 'appointment' ? t('Request an appointment') : t('Plan your visit'))) : '',
      'tip' => $uid . '-' . Html::cleanCssIdentifier($space_key) . '-tip',
      'body' => $text($pick('field_space_body', $term, $override, 'description')),
    ];
  }
  // Floor 1 before Floor 2; within a floor, the buildings.yml order.
  uasort($spaces, static fn (array $a, array $b): int => $a['floor'] <=> $b['floor']);

  if ($building_term) {
    $cache->addCacheableDependency($building_term);
  }
  $intro = $paragraph->hasField('field_map_intro') && !$paragraph->get('field_map_intro')->isEmpty()
    ? $paragraph->get('field_map_intro')
    : ($building_term && !$building_term->get('description')->isEmpty() ? $building_term->get('description') : NULL);

  // "You are here": only a drawn (published) room in this building.
  $here = (string) $value('field_map_here');
  $here = str_starts_with($here, $key . '.') ? substr($here, strlen($key) + 1) : '';
  if (!isset($spaces[$here])) {
    $here = '';
  }

  $cache_render = [];
  $cache->applyTo($cache_render);
  $variables['map'] = [
    'uid' => $uid,
    'key' => $key,
    'label' => $building['label'] ?? $key,
    'heading' => $value('field_map_heading') ?: ($building['heading'] ?? t('Visit @building', ['@building' => $building['label'] ?? $key])),
    'intro' => $text($intro),
    'template' => $building['template'],
    'spaces' => $spaces,
    'here' => $here,
    'legend' => array_values((array) ($building['legend'] ?? [])),
    'cache' => $cache_render,
  ];
}
