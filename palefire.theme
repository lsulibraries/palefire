<?php

/**
 * @file
 * Functions to support theming in the Palefire theme.
 */

use Drupal\Component\Serialization\Yaml;
use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Render\Markup;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\palefire\Hook\PalefireHooks;

/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Adds the current page title so the breadcrumb template can show it
 * as the final, non-linked item.
 */
function palefire_preprocess_breadcrumb(array &$variables) {
  $route_match = \Drupal::routeMatch();
  $title = NULL;

  // Node pages: use the node's title.
  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface) {
    $title = $node->label();
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $node->getCacheTags()
    );
  }
  // Other pages (Views, taxonomy terms, etc.): use the route's title.
  elseif ($route = $route_match->getRouteObject()) {
    $resolved = \Drupal::service('title_resolver')
      ->getTitle(\Drupal::request(), $route);

    if (is_array($resolved)) {
      $resolved = \Drupal::service('renderer')->renderPlain($resolved);
    }
    if ($resolved) {
      $title = strip_tags((string) $resolved);
    }
  }

  if ($title) {
    $variables['current_page_title'] = $title;
  }

  // Cache the breadcrumb separately for each page.
  $variables['#cache']['contexts'][] = 'url.path';
}
/**
 * Implements hook_page_attachments_alter().
 *
 * Adds noindex to every page under /concept, and to Resource nodes' own
 * pages: a Resource exists to be listed on guides, and its node page would
 * be a thin duplicate in search results.
 */
function palefire_page_attachments_alter(array &$attachments) {
  $path = \Drupal::request()->getPathInfo();
  $node = \Drupal::routeMatch()->getParameter('node');
  $is_resource = $node instanceof NodeInterface && $node->bundle() === 'resource';

  if (!$is_resource && !preg_match('#^/concept(/|$)#i', $path)) {
    return;
  }

  $found = FALSE;

  // Overwrite Metatag's robots tag if it already added one.
  if (!empty($attachments['#attached']['html_head'])) {
    foreach ($attachments['#attached']['html_head'] as &$item) {
      if (($item[1] ?? '') === 'robots') {
        $item[0]['#attributes']['content'] = 'noindex, nofollow';
        $found = TRUE;
      }
    }
    unset($item);
  }

  // Otherwise, add one.
  if (!$found) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex, nofollow'],
      ],
      'robots',
    ];
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Cache busting. Drupal adds a library's version to its CSS and JS URLs
 * (?v=1.0.0) and to the names of its aggregates, so with fixed versions in
 * palefire.libraries.yml a changed file kept its old URL and browsers or a
 * CDN served the old copy. Each library's version is now a short hash of
 * the contents of its files: change a file and its library gets a new URL;
 * the others keep theirs, so their caches stay warm.
 *
 * Library info is cached, so files are only hashed when caches are rebuilt
 * (drush cr, part of every deploy). External files are skipped.
 *
 * Drupal calls this with the definitions as written in the .libraries.yml
 * (files keyed by path, CSS grouped by category such as "theme"), and
 * copies the library version onto each file afterwards. The first version
 * of this hook expected the processed form (a "data" key per file), found
 * nothing and changed nothing; palefire_library_files() reads both forms.
 */
function palefire_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'palefire') {
    return;
  }
  $theme_path = \Drupal::service('extension.list.theme')->getPath('palefire');
  foreach ($libraries as &$library) {
    $files = [];
    foreach (['css', 'js'] as $type) {
      if (!empty($library[$type]) && is_array($library[$type])) {
        palefire_library_files($library[$type], $theme_path, $files);
      }
    }
    $hashes = [];
    foreach (array_unique($files) as $file) {
      if (is_file($file)) {
        $hashes[] = hash_file('xxh3', $file);
      }
    }
    if (!$hashes) {
      continue;
    }
    $version = substr(hash('xxh3', implode('.', $hashes)), 0, 10);
    $library['version'] = $version;
    // Processed form: each file carries its own copy of the version.
    foreach (['css', 'js'] as $type) {
      if (!empty($library[$type]) && is_array($library[$type]) && array_is_list($library[$type])) {
        foreach ($library[$type] as &$asset) {
          if (is_array($asset) && isset($asset['data'])) {
            $asset['version'] = $version;
          }
        }
        unset($asset);
      }
    }
  }
  unset($library);
}

/**
 * Collects the local file paths of a library's CSS or JS definitions.
 *
 * @param array $assets
 *   The library's "css" or "js" array, as written in the .libraries.yml
 *   (path => options, CSS nested under categories) or processed (a list of
 *   arrays with a "data" path).
 * @param string $theme_path
 *   The theme's path, which relative file paths are relative to.
 * @param string[] $files
 *   Absolute file paths, added to.
 */
function palefire_library_files(array $assets, string $theme_path, array &$files): void {
  foreach ($assets as $key => $value) {
    // Processed: ['data' => 'themes/custom/palefire/css/style.css', ...].
    if (is_array($value) && isset($value['data']) && is_string($value['data'])) {
      if (($value['type'] ?? 'file') === 'file') {
        $files[] = DRUPAL_ROOT . '/' . ltrim($value['data'], '/');
      }
      continue;
    }
    if (!is_string($key) || !is_array($value)) {
      continue;
    }
    // As written: 'css/style.css' => [options], or '/libraries/…' from the
    // Drupal root.
    if (preg_match('/\.(css|js)$/i', $key)) {
      if (($value['type'] ?? 'file') === 'external' || preg_match('#^(//|[a-z][a-z0-9+.-]*:)#i', $key)) {
        continue;
      }
      $files[] = str_starts_with($key, '/') ? DRUPAL_ROOT . $key : DRUPAL_ROOT . '/' . $theme_path . '/' . $key;
    }
    // A CSS category (theme, component, base, layout, state).
    else {
      palefire_library_files($value, $theme_path, $files);
    }
  }
}

/**
 * Building floor maps from maps/buildings.yml, keyed by building.
 *
 * Each entry: label, heading, template (Twig include of the drawing), intro,
 * legend (icons to explain, e.g. [elevator]) and spaces (space key => label,
 * floor, access, tooltip). See that file.
 */
function palefire_buildings(): array {
  $buildings = &drupal_static(__FUNCTION__);
  if (!isset($buildings)) {
    $file = DRUPAL_ROOT . '/' . \Drupal::service('extension.list.theme')->getPath('palefire') . '/maps/buildings.yml';
    $buildings = is_readable($file) ? (Yaml::decode(file_get_contents($file)) ?: []) : [];
  }
  return $buildings;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--bento-search.
 *
 * Renders the landing's building map (field_bento_map) as landing_map. Built
 * here from the referenced paragraph, so it doesn't depend on the landing's
 * view display listing the field.
 *
 * map_only: TRUE when the optional field_bento_hide_lead (Boolean, added in
 * the UI) is checked and there is a map to show. The template then leaves
 * out the lead panel (title, intro, search) and the map leads the landing. A
 * landing without a map ignores it, so it can never render empty.
 *
 * landing: the search settings (identifier, input_id, placeholder). The
 * palefire_modular module still hands them over as bento, so they are
 * copied across; anything already in landing wins.
 */
function palefire_preprocess_paragraph__bento_search(array &$variables): void {
  $variables['landing'] = ($variables['landing'] ?? []) + ($variables['bento'] ?? []);
  $variables['landing_map'] = NULL;
  $variables['page_title'] = NULL;
  $variables['toc_home_id'] = NULL;
  $variables['toc_map_id'] = NULL;
  $variables['lead_breadcrumb'] = NULL;
  $variables['map_only'] = FALSE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  // A landing without the map field still gets its intro, Visit card and
  // page title (this used to return early and skip them).
  $map = $paragraph->hasField('field_bento_map') ? $paragraph->get('field_bento_map')->entity : NULL;
  if ($map instanceof ParagraphInterface && $map->isPublished()) {
    $map = \Drupal::service('entity.repository')->getTranslationFromContext($map);
    $variables['landing_map'] = \Drupal::entityTypeManager()->getViewBuilder('paragraph')->view($map, 'default');
  }
  $variables['map_only'] = $variables['landing_map'] !== NULL
    && $paragraph->hasField('field_bento_hide_lead')
    && (bool) $paragraph->get('field_bento_hide_lead')->value;
  _palefire_landing_visit($variables, $paragraph);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-hero.
 *
 * Landing hero (scripts/palefire_landing_hero_setup.php) is the landing
 * section without the search form, and it shares the bento_search fields:
 * the same variables, plus hero, which includes/landing.html.twig reads.
 * input_id only keeps the Visit card's ids unique on the page.
 *
 * With both a map and a Visit card, the map shows the card itself: under
 * the drawing, with the legend and space list across its top, one panel
 * (paragraph--building-map.html.twig reads #pf_visit as map.visit), and
 * visit_in_map tells the landing not to print it again. Hero only: the
 * stacked hero map gives the aside the map's full width; beside the drawing
 * (other landings) it is a narrow column.
 */
function palefire_preprocess_paragraph__landing_hero(array &$variables): void {
  palefire_preprocess_paragraph__bento_search($variables);
  $variables['hero'] = TRUE;
  $variables['visit_in_map'] = FALSE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if ($paragraph instanceof ParagraphInterface) {
    $variables['landing']['input_id'] = 'pf-hero-' . $paragraph->id();
    $variables['hero_post'] = _palefire_hero_post($paragraph, $variables);
    if (!empty($variables['landing_map']) && !empty($variables['visit'])) {
      $variables['landing_map']['#pf_visit'] = $variables['visit'] + ['id' => $variables['landing']['input_id'] . '-visit'];
      // The map's render cache: its own entry with the card, cleared when
      // the page's location fields change (the host node's tags).
      $variables['landing_map']['#cache']['keys'][] = 'pf_visit';
      $variables['landing_map']['#cache']['tags'] = Cache::mergeTags($variables['landing_map']['#cache']['tags'] ?? [], $variables['#cache']['tags'] ?? []);
      $variables['visit_in_map'] = TRUE;
    }
  }
}

/**
 * The newest published Article in the hero's blog category, or NULL.
 *
 * The category is the Landing hero's optional "Blog category" field
 * (field_landing_blog_category, a taxonomy reference to Article Category,
 * added by hand in the UI). Without the field, or with it empty, this is
 * NULL and the lead shows a placeholder row. Newest by Article Date, then by
 * creation. The list's cache tag (node_list:article) refreshes the row when
 * an article is published or changed.
 *
 * Returns ['title', 'url', 'date', 'datetime', 'category', 'excerpt',
 * 'image'], image a render array (decorative, lazy) or NULL.
 */
function _palefire_hero_post(ParagraphInterface $paragraph, array &$variables): ?array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $cache->addCacheTags(['node_list:article']);
  $post = NULL;

  if ($paragraph->hasField('field_landing_blog_category') && !$paragraph->get('field_landing_blog_category')->isEmpty()) {
    $term = $paragraph->get('field_landing_blog_category')->entity;
    // Both fields are on Article (Manage fields); without them the query
    // would fail, so the row just stays a placeholder.
    $storages = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
    if ($term && isset($storages['field_article_category'], $storages['field_article_date'])) {
      $cache->addCacheableDependency($term);
      $ids = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'article')
        ->condition('status', 1)
        ->condition('field_article_category', $term->id())
        ->sort('field_article_date', 'DESC')
        ->sort('created', 'DESC')
        ->range(0, 1)
        ->execute();
      $node = $ids ? \Drupal::entityTypeManager()->getStorage('node')->load(reset($ids)) : NULL;
      if ($node instanceof NodeInterface) {
        $node = \Drupal::service('entity.repository')->getTranslationFromContext($node);
        $cache->addCacheableDependency($node);
        $url = $node->toUrl()->toString(TRUE);
        $cache->addCacheableDependency($url);

        // In the site's time zone (the field stores UTC).
        $timestamp = (int) $node->getCreatedTime();
        if ($node->hasField('field_article_date') && $node->get('field_article_date')->date) {
          $timestamp = $node->get('field_article_date')->date->getTimestamp();
        }
        $formatter = \Drupal::service('date.formatter');

        // Excerpt: About Text, else the body's summary or text, as plain text.
        $excerpt = '';
        foreach ([['field_about_text', 'value'], ['body', 'summary'], ['body', 'value']] as [$field, $property]) {
          if ($excerpt === '' && $node->hasField($field) && !$node->get($field)->isEmpty()) {
            $excerpt = trim(Html::decodeEntities(strip_tags((string) $node->get($field)->first()->{$property})));
          }
        }
        $excerpt = preg_replace('/\s+/u', ' ', $excerpt);
        if (mb_strlen($excerpt) > 180) {
          $excerpt = rtrim(mb_substr($excerpt, 0, 180)) . '…';
        }

        $post = [
          'title' => $node->label(),
          'url' => $url->getGeneratedUrl(),
          'date' => $formatter->format($timestamp, 'custom', 'M j, Y'),
          'datetime' => $formatter->format($timestamp, 'custom', 'Y-m-d'),
          'category' => \Drupal::service('entity.repository')->getTranslationFromContext($term)->label(),
          'excerpt' => $excerpt,
          'image' => _palefire_field_image($node, 'field_image', ['medium', 'thumbnail'], $cache),
        ];
      }
    }
  }
  $cache->applyTo($variables);
  return $post;
}

/**
 * An image field's first image as a decorative (alt="") lazy image.
 *
 * In the first of $styles that exists, else the original file. Article
 * images are often 2000-3000px originals, so a small style matters.
 */
function _palefire_field_image(NodeInterface $node, string $field, array $styles, CacheableMetadata $cache): ?array {
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
    return NULL;
  }
  $image = $node->get($field)->first();
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $build = [
    '#uri' => $file->getFileUri(),
    '#width' => $image->width,
    '#height' => $image->height,
    '#alt' => '',
    '#attributes' => ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  foreach ($styles as $name) {
    if ($style = $storage->load($name)) {
      $cache->addCacheableDependency($style);
      return $build + ['#theme' => 'image_style', '#style_name' => $name];
    }
  }
  return $build + ['#theme' => 'image'];
}

/**
 * Adds the host Modular page's title, intro and Visit card to a landing search.
 *
 * Reads the optional node fields added by scripts/palefire_modular_setup.php
 * (field_intro, field_hours_location, field_location_name,
 * field_location_query, field_location_display). Sets:
 * - page_title: the node title when this landing is the first section (it
 *   then prints the page <h1>), or NULL.
 * - landing_intro: render array of field_intro, or NULL.
 * - visit: NULL, or ['name', 'lid', 'maps_url', 'embed_url', 'query'] for
 *   the Visit card (hours via js/visit-hours.js, the map loads on click).
 * A page with none of these fields filled in keeps today's landing.
 */
function _palefire_landing_visit(array &$variables, ParagraphInterface $paragraph): void {
  $variables['landing_intro'] = NULL;
  $variables['visit'] = NULL;

  // The landing may sit inside a section paragraph: walk up to the node.
  $host = $paragraph;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  if (!$host instanceof NodeInterface) {
    return;
  }
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $host->getCacheTags());

  // The page <h1>: printed by the landing (above the intro) only when it is
  // the Modular page's first section. Paragraph templates don't get a
  // `node` variable, which is why {{ node.label }} printed nothing.
  // PalefireHooks::preprocessPage() uses the same check, so page.html.twig
  // prints the <h1> itself on every other Modular page.
  if ($host->bundle() === PalefireHooks::MODULAR_BUNDLE && PalefireHooks::titleLandingUuid($host) === $paragraph->uuid()) {
    $variables['page_title'] = $host->label();
    // The TOC's "Home" and "Map" targets (PalefireHooks::heroTocIds()).
    $ids = PalefireHooks::heroTocIds($host);
    $variables['toc_home_id'] = $ids['home'] ?? NULL;
    $variables['toc_map_id'] = $ids['map'] ?? NULL;
    // The breadcrumb at the top of the lead panel (PalefireHooks::
    // crumbInLanding(); page.html.twig then leaves the head's out). Built by
    // the same service as the System Breadcrumb block, so the trail and its
    // template are the same.
    if (PalefireHooks::crumbInLanding($host)) {
      $variables['lead_breadcrumb'] = \Drupal::service('breadcrumb')->build(\Drupal::routeMatch())->toRenderable();
    }
  }

  $value = static function (string $name) use ($host): string {
    return ($host->hasField($name) && !$host->get($name)->isEmpty())
      ? trim((string) $host->get($name)->value)
      : '';
  };

  if ($host->hasField('field_intro') && !$host->get('field_intro')->isEmpty()) {
    $variables['landing_intro'] = $host->get('field_intro')->view(['label' => 'hidden']);
  }

  $lid = $value('field_hours_location');
  $name = $value('field_location_name');
  $query = $value('field_location_query');
  if ($lid === '' && $name === '' && $query === '') {
    return;
  }
  $embed = $value('field_location_display') === 'embed';
  $variables['visit'] = [
    'name' => $name,
    'lid' => preg_match('/^\d+$/', $lid) ? $lid : '',
    'query' => $query,
    'maps_url' => $query !== '' ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($query) : '',
    'embed_url' => ($embed && $query !== '') ? 'https://www.google.com/maps?q=' . rawurlencode($query) . '&output=embed' : '',
  ];
  $variables['#attached']['library'][] = 'palefire/visit';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--building-map.
 *
 * Builds `map` for the template: the building's drawing, and one entry per
 * published "Building spaces" room term (title, access, floor, link, tooltip).
 * A published Room override on this paragraph replaces that room's tooltip
 * text, access or link (only the fields it fills in).
 */
function palefire_preprocess_paragraph__building_map(array &$variables): void {
  $variables['map'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  $buildings = palefire_buildings();
  if (!$paragraph instanceof ParagraphInterface || !$buildings) {
    return;
  }
  $value = static fn (string $field) => $paragraph->hasField($field) ? $paragraph->get($field)->value : NULL;
  $key = $value('field_map_building') ?: array_key_first($buildings);
  $building = $buildings[$key] ?? NULL;
  if (!$building) {
    return;
  }

  // Any change to a Building spaces term re-renders the map.
  $cache = (new CacheableMetadata())->addCacheTags(['taxonomy_term_list:building_space']);
  $repository = \Drupal::service('entity.repository');
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $terms->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'building_space')
    ->condition('status', 1)
    ->condition('field_map_key', $key, 'STARTS_WITH')
    ->execute();
  $building_term = NULL;
  $rooms = [];
  foreach ($terms->loadMultiple($ids) as $term) {
    $term = $repository->getTranslationFromContext($term);
    $map_key = (string) $term->get('field_map_key')->value;
    if ($map_key === $key) {
      $building_term = $term;
    }
    elseif (str_starts_with($map_key, $key . '.')) {
      $rooms[substr($map_key, strlen($key) + 1)] = $term;
    }
  }

  $overrides = [];
  if ($paragraph->hasField('field_map_overrides')) {
    foreach ($paragraph->get('field_map_overrides') as $item) {
      $override = $item->entity;
      $room_key = $override instanceof ParagraphInterface && $override->isPublished() ? (string) $override->get('field_room_key')->value : '';
      if (str_starts_with($room_key, $key . '.')) {
        $overrides[substr($room_key, strlen($key) + 1)] = $override;
        $cache->addCacheableDependency($override);
      }
    }
  }

  // The override's field when it is filled in, otherwise the term's.
  $pick = static function (string $field, $term, ?ParagraphInterface $override, ?string $term_field = NULL): ?FieldItemListInterface {
    if ($override && $override->hasField($field) && !$override->get($field)->isEmpty()) {
      return $override->get($field);
    }
    $term_field = $term_field ?? $field;
    return $term->hasField($term_field) && !$term->get($term_field)->isEmpty() ? $term->get($term_field) : NULL;
  };
  $text = static fn (?FieldItemListInterface $items) => $items ? [
    '#type' => 'processed_text',
    '#text' => $items->value,
    '#format' => $items->format,
  ] : NULL;

  $uid = 'pf-map-' . $paragraph->id();
  $spaces = [];
  foreach ($building['spaces'] ?? [] as $space_key => $def) {
    $term = $rooms[$space_key] ?? NULL;
    if (!$term) {
      // Unpublished or missing: drawn as plain floor.
      continue;
    }
    $cache->addCacheableDependency($term);
    $override = $overrides[$space_key] ?? NULL;
    $access = $pick('field_space_access', $term, $override)?->value ?: ($def['access'] ?? 'walk_in');
    $link = $pick('field_space_link', $term, $override)?->first();
    $spaces[$space_key] = [
      'key' => $space_key,
      'title' => $term->label(),
      'access' => $access,
      'floor' => (int) ($def['floor'] ?? 1),
      'url' => $link ? $link->getUrl()->toString() : '',
      'cta' => $link ? ($link->title ?: ($access === 'appointment' ? t('Request an appointment') : t('Plan your visit'))) : '',
      'tip' => $uid . '-' . Html::cleanCssIdentifier($space_key) . '-tip',
      'body' => $text($pick('field_space_body', $term, $override, 'description')),
    ];
  }
  // Floor 1 before Floor 2; within a floor, the buildings.yml order.
  uasort($spaces, static fn (array $a, array $b): int => $a['floor'] <=> $b['floor']);

  if ($building_term) {
    $cache->addCacheableDependency($building_term);
  }
  // Summary: this paragraph's Intro (field_map_intro), under the heading or,
  // on the Hill hero, set into the drawing. Note: the building's own
  // description (its Building spaces term), at the top of the legend, for
  // who can walk in and what needs an appointment. Each is optional.
  $summary = $paragraph->hasField('field_map_intro') && !$paragraph->get('field_map_intro')->isEmpty()
    ? $paragraph->get('field_map_intro')
    : NULL;
  $note = $building_term && !$building_term->get('description')->isEmpty() ? $building_term->get('description') : NULL;

  // "You are here": only a drawn (published) room in this building.
  $here = (string) $value('field_map_here');
  $here = str_starts_with($here, $key . '.') ? substr($here, strlen($key) + 1) : '';
  if (!isset($spaces[$here])) {
    $here = '';
  }

  $cache_render = [];
  $cache->applyTo($cache_render);
  $variables['map'] = [
    'uid' => $uid,
    'key' => $key,
    'label' => $building['label'] ?? $key,
    'heading' => $value('field_map_heading') ?: ($building['heading'] ?? t('Visit @building', ['@building' => $building['label'] ?? $key])),
    'summary' => $text($summary),
    'note' => $text($note),
    'template' => $building['template'],
    'spaces' => $spaces,
    'here' => $here,
    'legend' => array_values((array) ($building['legend'] ?? [])),
    'cache' => $cache_render,
    // The landing hero's Visit card, shown in the aside with the key
    // (palefire_preprocess_paragraph__landing_hero()), or NULL.
    'visit' => $variables['elements']['#pf_visit'] ?? NULL,
  ];
}

/* ---------------------------------------------------------------------------
 * Guide pages (scripts/palefire_guide_setup.php)
 * ------------------------------------------------------------------------- */

/**
 * Proxy prefix for Resources with "Requires LSU login" ticked.
 */
const PALEFIRE_PROXY_PREFIX = 'https://libezp.lib.lsu.edu/login?url=';

/**
 * Resource type (field_resource_type) => Bootstrap Icons file in images/bi.
 */
const PALEFIRE_RESOURCE_ICONS = [
  'article' => 'file-earmark-text',
  'book' => 'book',
  'database' => 'database',
  'guide' => 'journal-bookmark',
  'standard' => 'card-checklist',
  'tool' => 'tools',
  'course' => 'easel',
  'video' => 'play-fill',
  'pdf' => 'file-earmark-pdf',
  'word' => 'file-earmark-word',
  'download' => 'download',
  'search' => 'search',
  'person' => 'person',
  'website' => 'globe2',
];

/**
 * Renders the Resources in $field that the visitor can see (guide_item).
 *
 * Unpublished or otherwise inaccessible Resources are left out; their cache
 * tags are kept, so publishing one shows it on every guide that lists it.
 */
function _palefire_guide_resources(ParagraphInterface $paragraph, string $field, array &$variables): array {
  $items = [];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  if ($paragraph->hasField($field)) {
    $builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    $repository = \Drupal::service('entity.repository');
    foreach ($paragraph->get($field) as $item) {
      $resource = $item->entity;
      if (!$resource instanceof NodeInterface) {
        continue;
      }
      $cache->addCacheableDependency($resource);
      $access = $resource->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access);
      if ($access->isAllowed()) {
        $items[] = $builder->view($repository->getTranslationFromContext($resource), 'guide_item');
      }
    }
  }
  $cache->applyTo($variables);
  return $items;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--resource-list.
 */
function palefire_preprocess_paragraph__resource_list(array &$variables): void {
  $variables['resources'] = _palefire_guide_resources($variables['paragraph'], 'field_resources', $variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--accordion-item.
 */
function palefire_preprocess_paragraph__accordion_item(array &$variables): void {
  $variables['resources'] = _palefire_guide_resources($variables['paragraph'], 'field_resources', $variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--librarian-card.
 *
 * card: the referenced staff node in the guide_card view mode, or NULL when
 * it is missing or the visitor can't see it (the card is then left out).
 */
function palefire_preprocess_paragraph__librarian_card(array &$variables): void {
  $variables['card'] = NULL;
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_librarian')) {
    return;
  }
  $person = $paragraph->get('field_librarian')->entity;
  if (!$person instanceof NodeInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($person);
  $access = $person->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->applyTo($variables);
  if ($access->isAllowed()) {
    $person = \Drupal::service('entity.repository')->getTranslationFromContext($person);
    $variables['card'] = \Drupal::entityTypeManager()->getViewBuilder('node')->view($person, 'guide_card');
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--tile-showcase.
 *
 * Tile showcase (scripts/palefire_tile_showcase_setup.php) lists Tile nodes
 * as image cards in one of two layouts (field_tile_layout):
 * - stagger: tall portrait cards in a row with an offset rhythm (the
 *   concept's How-to guides and Specializations). A swipeable row when the
 *   section is narrow.
 * - grid: landscape cards in three columns (the concept's Collections),
 *   stepping down to two and one.
 *
 * layout: 'stagger' or 'grid'.
 * tiles: one entry per Tile the visitor can see, in field order:
 * - title: the Tile's title.
 * - url: the Tile node's own URL.
 * - label: its Category terms joined with " + " ("Dept + Medium"), or ''.
 * - image: field_tile_cover in the layout's responsive image style, or NULL.
 *   Its alt is empty: the card's title already names the link, so the
 *   image would only repeat it (WCAG 1.1.1 decorative-in-context).
 */
function palefire_preprocess_paragraph__tile_showcase(array &$variables): void {
  $variables['layout'] = 'stagger';
  $variables['tiles'] = [];
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  if ($paragraph->hasField('field_tile_layout') && $paragraph->get('field_tile_layout')->value === 'grid') {
    $variables['layout'] = 'grid';
  }
  if (!$paragraph->hasField('field_tiles')) {
    return;
  }

  $cache = CacheableMetadata::createFromRenderArray($variables);
  $repository = \Drupal::service('entity.repository');
  $style = $variables['layout'] === 'grid' ? 'tile_showcase_landscape' : 'tile_showcase_portrait';

  foreach ($paragraph->get('field_tiles') as $item) {
    $tile = $item->entity;
    if (!$tile instanceof NodeInterface) {
      continue;
    }
    $cache->addCacheableDependency($tile);
    $access = $tile->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $tile = $repository->getTranslationFromContext($tile);

    $url = $tile->toUrl()->toString(TRUE);
    $cache->addCacheableDependency($url);

    $labels = [];
    if ($tile->hasField('field_category')) {
      foreach ($tile->get('field_category') as $term_item) {
        $term = $term_item->entity;
        if (!$term) {
          continue;
        }
        $cache->addCacheableDependency($term);
        $term_access = $term->access('view', NULL, TRUE);
        $cache->addCacheableDependency($term_access);
        if ($term_access->isAllowed()) {
          $labels[] = $repository->getTranslationFromContext($term)->label();
        }
      }
    }

    $variables['tiles'][] = [
      'title' => $tile->label(),
      'url' => $url->getGeneratedUrl(),
      'label' => implode(' + ', $labels),
      'image' => _palefire_tile_cover($tile, $style, $cache),
    ];
  }
  $cache->applyTo($variables);
}

/**
 * The Tile's cover image as a decorative (alt="") lazy image.
 *
 * Uses the responsive image style when it exists, then its middle image
 * style ("<style>_md") on its own, then the original file, so the card never
 * breaks if the setup script hasn't run yet or Responsive Image is off.
 */
function _palefire_tile_cover(NodeInterface $tile, string $style, CacheableMetadata $cache): ?array {
  if (!$tile->hasField('field_tile_cover') || $tile->get('field_tile_cover')->isEmpty()) {
    return NULL;
  }
  $image = $tile->get('field_tile_cover')->first();
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $attributes = ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'];
  $build = [
    '#uri' => $file->getFileUri(),
    '#width' => $image->width,
    '#height' => $image->height,
    '#attributes' => $attributes,
  ];

  $types = \Drupal::entityTypeManager();
  if (\Drupal::moduleHandler()->moduleExists('responsive_image')
    && ($responsive = $types->getStorage('responsive_image_style')->load($style))) {
    $cache->addCacheableDependency($responsive);
    return $build + ['#theme' => 'responsive_image', '#responsive_image_style_id' => $style];
  }
  if ($image_style = $types->getStorage('image_style')->load($style . '_md')) {
    $cache->addCacheableDependency($image_style);
    return $build + ['#theme' => 'image_style', '#style_name' => $image_style->id(), '#alt' => ''];
  }
  return $build + ['#theme' => 'image', '#alt' => ''];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--guide-video.
 *
 * video: url (the video's page), embed (privacy-enhanced YouTube or Vimeo
 * player URL, '' for other providers), title, and the media item's local
 * thumbnail (thumb, thumb_width, thumb_height) when it has one.
 */
function palefire_preprocess_paragraph__guide_video(array &$variables): void {
  $variables['video'] = NULL;
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_video')) {
    return;
  }
  $media = $paragraph->get('field_video')->entity;
  if (!$media instanceof MediaInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($media);
  $access = $media->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->applyTo($variables);
  if (!$access->isAllowed()) {
    return;
  }

  $url = trim((string) $media->getSource()->getSourceFieldValue($media));
  if (!preg_match('#^https?://#i', $url)) {
    return;
  }
  $embed = '';
  if (preg_match('#(?:youtube\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/|live/)|youtu\.be/)([\w-]{11})#i', $url, $m)) {
    $embed = 'https://www.youtube-nocookie.com/embed/' . $m[1] . '?autoplay=1&rel=0';
  }
  elseif (preg_match('#vimeo\.com/(?:video/)?(\d+)#i', $url, $m)) {
    $embed = 'https://player.vimeo.com/video/' . $m[1] . '?autoplay=1&dnt=1';
  }

  $thumb = '';
  $width = $height = NULL;
  $file = $media->get('thumbnail')->entity ?? NULL;
  if ($file) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('large');
    $uri = $file->getFileUri();
    $thumb = $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri);
    $item = $media->get('thumbnail')->first();
    if ($item && $item->width && $item->height) {
      $width = (int) $item->width;
      $height = (int) $item->height;
      if ($style) {
        $dimensions = ['width' => $width, 'height' => $height];
        $style->transformDimensions($dimensions, $uri);
        [$width, $height] = [$dimensions['width'], $dimensions['height']];
      }
    }
  }

  $variables['video'] = [
    'url' => $url,
    'embed' => $embed,
    'title' => $media->label(),
    'thumb' => $thumb,
    'thumb_width' => $width,
    'thumb_height' => $height,
  ];
}

/**
 * Implements hook_preprocess_node().
 *
 * Resources in the guide_item view mode get `resource`: title, url, icon,
 * labels, citation, desc (node--resource--guide-item.html.twig).
 */
function palefire_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'resource' || ($variables['view_mode'] ?? '') !== 'guide_item') {
    return;
  }
  $value = fn (string $field): string => $node->hasField($field) && !$node->get($field)->isEmpty() ? trim((string) $node->get($field)->value) : '';

  $url = '';
  if ($node->hasField('field_resource_link') && !$node->get('field_resource_link')->isEmpty()) {
    $url = $node->get('field_resource_link')->first()->getUrl()->toString();
  }
  $labels = [];
  if ($node->hasField('field_resource_labels')) {
    foreach ($node->get('field_resource_labels') as $item) {
      if (trim((string) $item->value) !== '') {
        $labels[] = trim((string) $item->value);
      }
    }
  }
  $proxy = $node->hasField('field_resource_proxy') && (bool) $node->get('field_resource_proxy')->value;
  if ($proxy && $url !== '') {
    if (!str_starts_with($url, PALEFIRE_PROXY_PREFIX) && !str_contains((string) parse_url($url, PHP_URL_HOST), 'libezp.')) {
      $url = PALEFIRE_PROXY_PREFIX . $url;
    }
    array_unshift($labels, (string) t('LSU login'));
  }

  $type = $value('field_resource_type');
  $variables['resource'] = [
    'title' => $node->label(),
    'url' => $url ?: $node->toUrl()->toString(),
    'icon' => PALEFIRE_RESOURCE_ICONS[$type] ?? 'globe2',
    'labels' => array_slice(array_unique($labels), 0, 4),
    'citation' => $value('field_resource_citation'),
    'desc' => $value('field_resource_desc'),
  ];
}
