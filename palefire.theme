/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Adds the current page title so the breadcrumb template can show it
 * as the final, non-linked item.
 */
function palefire_preprocess_breadcrumb(array &$variables) {
  $route_match = \Drupal::routeMatch();
  $title = NULL;

  // Node pages: use the node's title.
  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface) {
    $title = $node->label();
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $node->getCacheTags()
    );
  }
  // Staff profiles (a View page): the person's name, not the View's title.
  elseif (StaffDirectory::isRoute('profile')) {
    $cache = CacheableMetadata::createFromRenderArray($variables);
    $title = StaffDirectory::current($cache)?->label();
    $cache->applyTo($variables);
  }
  // Other pages (Views, taxonomy terms, etc.): use the route's title.
  elseif ($route = $route_match->getRouteObject()) {
    $resolved = \Drupal::service('title_resolver')
      ->getTitle(\Drupal::request(), $route);

    if (is_array($resolved)) {
      $resolved = \Drupal::service('renderer')->renderPlain($resolved);
    }
    if ($resolved) {
      $title = strip_tags((string) $resolved);
    }
  }

  if ($title) {
    $variables['current_page_title'] = $title;
  }

  // Cache the breadcrumb separately for each page.
  $variables['#cache']['contexts'][] = 'url.path';
}
/**
 * Implements hook_page_attachments_alter().
 *
 * Adds noindex to every page under /concept, and to Resource nodes' own
 * pages: a Resource exists to be listed on guides, and its node page would
 * be a thin duplicate in search results.
 */
function palefire_page_attachments_alter(array &$attachments) {
  $path = \Drupal::request()->getPathInfo();
  $node = \Drupal::routeMatch()->getParameter('node');
  $is_resource = $node instanceof NodeInterface && $node->bundle() === 'resource';

  if (!$is_resource && !preg_match('#^/concept(/|$)#i', $path)) {
    return;
  }

  $found = FALSE;

  // Overwrite Metatag's robots tag if it already added one.
  if (!empty($attachments['#attached']['html_head'])) {
    foreach ($attachments['#attached']['html_head'] as &$item) {
      if (($item[1] ?? '') === 'robots') {
        $item[0]['#attributes']['content'] = 'noindex, nofollow';
        $found = TRUE;
      }
    }
    unset($item);
  }

  // Otherwise, add one.
  if (!$found) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex, nofollow'],
      ],
      'robots',
    ];
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Cache busting. Drupal adds a library's version to its CSS and JS URLs
 * (?v=1.0.0) and to the names of its aggregates, so with fixed versions in
 * palefire.libraries.yml a changed file kept its old URL and browsers or a
 * CDN served the old copy. Each library's version is now a short hash of
 * the contents of its files: change a file and its library gets a new URL;
 * the others keep theirs, so their caches stay warm.
 *
 * Library info is cached, so files are only hashed when caches are rebuilt
 * (drush cr, part of every deploy). External files are skipped.
 *
 * Drupal calls this with the definitions as written in the .libraries.yml
 * (files keyed by path, CSS grouped by category such as "theme"), and
 * copies the library version onto each file afterwards. The first version
 * of this hook expected the processed form (a "data" key per file), found
 * nothing and changed nothing; palefire_library_files() reads both forms.
 */
function palefire_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'palefire') {
    return;
  }
  $theme_path = \Drupal::service('extension.list.theme')->getPath('palefire');
  foreach ($libraries as &$library) {
    $files = [];
    foreach (['css', 'js'] as $type) {
      if (!empty($library[$type]) && is_array($library[$type])) {
        palefire_library_files($library[$type], $theme_path, $files);
      }
    }
    $hashes = [];
    foreach (array_unique($files) as $file) {
      if (is_file($file)) {
        $hashes[] = hash_file('xxh3', $file);
      }
    }
    if (!$hashes) {
      continue;
    }
    $version = substr(hash('xxh3', implode('.', $hashes)), 0, 10);
    $library['version'] = $version;
    // Processed form: each file carries its own copy of the version.
    foreach (['css', 'js'] as $type) {
      if (!empty($library[$type]) && is_array($library[$type]) && array_is_list($library[$type])) {
        foreach ($library[$type] as &$asset) {
          if (is_array($asset) && isset($asset['data'])) {
            $asset['version'] = $version;
          }
        }
        unset($asset);
      }
    }
  }
  unset($library);
}

/**
 * Collects the local file paths of a library's CSS or JS definitions.
 *
 * @param array $assets
 *   The library's "css" or "js" array, as written in the .libraries.yml
 *   (path => options, CSS nested under categories) or processed (a list of
 *   arrays with a "data" path).
 * @param string $theme_path
 *   The theme's path, which relative file paths are relative to.
 * @param string[] $files
 *   Absolute file paths, added to.
 */
function palefire_library_files(array $assets, string $theme_path, array &$files): void {
  foreach ($assets as $key => $value) {
    // Processed: ['data' => 'themes/custom/palefire/css/style.css', ...].
    if (is_array($value) && isset($value['data']) && is_string($value['data'])) {
      if (($value['type'] ?? 'file') === 'file') {
        $files[] = DRUPAL_ROOT . '/' . ltrim($value['data'], '/');
      }
      continue;
    }
    if (!is_string($key) || !is_array($value)) {
      continue;
    }
    // As written: 'css/style.css' => [options], or '/libraries/…' from the
    // Drupal root.
    if (preg_match('/\.(css|js)$/i', $key)) {
      if (($value['type'] ?? 'file') === 'external' || preg_match('#^(//|[a-z][a-z0-9+.-]*:)#i', $key)) {
        continue;
      }
      $files[] = str_starts_with($key, '/') ? DRUPAL_ROOT . $key : DRUPAL_ROOT . '/' . $theme_path . '/' . $key;
    }
    // A CSS category (theme, component, base, layout, state).
    else {
      palefire_library_files($value, $theme_path, $files);
    }
  }
}

/**
 * Building floor maps from maps/buildings.yml, keyed by building.
 *
 * Each entry: label, heading, template (Twig include of the drawing), intro,
 * legend (icons to explain, e.g. [elevator]) and spaces (space key => label,
 * floor, access, tooltip). See that file.
 */
function palefire_buildings(): array {
  $buildings = &drupal_static(__FUNCTION__);
  if (!isset($buildings)) {
    $file = DRUPAL_ROOT . '/' . \Drupal::service('extension.list.theme')->getPath('palefire') . '/maps/buildings.yml';
    $buildings = is_readable($file) ? (Yaml::decode(file_get_contents($file)) ?: []) : [];
  }
  return $buildings;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--bento-search.
 *
 * Renders the landing's building map (field_bento_map) as landing_map. Built
 * here from the referenced paragraph, so it doesn't depend on the landing's
 * view display listing the field.
 *
 * map_only: TRUE when the optional field_bento_hide_lead (Boolean, added in
 * the UI) is checked and there is a map to show. The template then leaves
 * out the lead panel (title, intro, search) and the map leads the landing. A
 * landing without a map ignores it, so it can never render empty.
 *
 * landing: the search settings (identifier, input_id, placeholder). The
 * palefire_modular module still hands them over as bento, so they are
 * copied across; anything already in landing wins.
 */
function palefire_preprocess_paragraph__bento_search(array &$variables): void {
  $variables['landing'] = ($variables['landing'] ?? []) + ($variables['bento'] ?? []);
  $variables['landing_map'] = NULL;
  $variables['page_title'] = NULL;
  $variables['toc_home_id'] = NULL;
  $variables['toc_map_id'] = NULL;
  $variables['lead_breadcrumb'] = NULL;
  $variables['map_only'] = FALSE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  // A landing without the map field still gets its intro, Visit card and
  // page title (this used to return early and skip them).
  $map = $paragraph->hasField('field_bento_map') ? $paragraph->get('field_bento_map')->entity : NULL;
  if ($map instanceof ParagraphInterface && $map->isPublished()) {
    $map = \Drupal::service('entity.repository')->getTranslationFromContext($map);
    $variables['landing_map'] = \Drupal::entityTypeManager()->getViewBuilder('paragraph')->view($map, 'default');
  }
  $variables['map_only'] = $variables['landing_map'] !== NULL
    && $paragraph->hasField('field_bento_hide_lead')
    && (bool) $paragraph->get('field_bento_hide_lead')->value;
  _palefire_landing_visit($variables, $paragraph);
}

/**
 * The landing hero's index rules, in the order it shows them: guide (Start
 * your research, the Quick Start in the lead panel), visit (Visit Hill, over
 * the map) and rooms (Rooms and access: the map's key, when the map carries
 * the Visit card, map-key.html.twig). Read from the same facts the
 * templates use: the lead shows unless the map leads alone, and only with
 * the page title or an intro (show_lead, includes/landing.html.twig); the
 * map when it is published; the Visit card when the host page has a
 * location (_palefire_landing_visit()). The hero numbers its rules from
 * this, and palefire_preprocess_field() counts on from its length, so no
 * number is typed by hand and they always agree.
 *
 * @return string[]
 *   Rule keys: 'guide', 'visit', 'rooms', those the hero shows.
 */
function _palefire_hero_rules(ParagraphInterface $paragraph): array {
  $map = $paragraph->hasField('field_bento_map') ? $paragraph->get('field_bento_map')->entity : NULL;
  $has_map = $map instanceof ParagraphInterface && $map->isPublished();
  $map_only = $has_map && $paragraph->hasField('field_bento_hide_lead') && (bool) $paragraph->get('field_bento_hide_lead')->value;

  $host = $paragraph;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  $filled = static fn (string $name): bool => $host instanceof NodeInterface
    && $host->hasField($name) && trim((string) ($host->get($name)->value ?? '')) !== '';
  $title = $host instanceof NodeInterface
    && $host->bundle() === PalefireHooks::MODULAR_BUNDLE
    && PalefireHooks::titleLandingUuid($host) === $paragraph->uuid();
  $intro = $host instanceof NodeInterface && $host->hasField('field_intro') && !$host->get('field_intro')->isEmpty();
  $visit = $filled('field_hours_location') || $filled('field_location_name') || $filled('field_location_query');

  $rules = [];
  if (!$map_only && ($title || $intro)) {
    $rules[] = 'guide';
  }
  if ($has_map) {
    $rules[] = 'visit';
    if ($visit) {
      $rules[] = 'rooms';
    }
  }
  return $rules;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-hero.
 *
 * Landing hero (scripts/palefire_landing_hero_setup.php) is the landing
 * section without the search form, and it shares the bento_search fields:
 * the same variables, plus hero, which includes/landing.html.twig reads.
 * input_id only keeps the Visit card's ids unique on the page.
 *
 * With both a map and a Visit card, the map shows the card itself: under
 * the drawing, with the legend and space list across its top, one panel
 * (paragraph--building-map.html.twig reads #pf_visit as map.visit), and
 * visit_in_map tells the landing not to print it again. Hero only: the
 * stacked hero map gives the aside the map's full width; beside the drawing
 * (other landings) it is a narrow column.
 */
function palefire_preprocess_paragraph__landing_hero(array &$variables): void {
  palefire_preprocess_paragraph__bento_search($variables);
  $variables['hero'] = TRUE;
  $variables['visit_in_map'] = FALSE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if ($paragraph instanceof ParagraphInterface) {
    $variables['landing']['input_id'] = 'pf-hero-' . $paragraph->id();
    // The index rules' numbers (_palefire_hero_rules()): 01, 02, … in the
    // order the hero shows them.
    $variables['hero_index'] = [];
    foreach (_palefire_hero_rules($paragraph) as $i => $rule) {
      $variables['hero_index'][$rule] = sprintf('%02d', $i + 1);
    }
    $variables['hero_tiles'] = _palefire_hero_tiles($paragraph, $variables);
    $variables['quick_guide'] = _palefire_quick_guide($paragraph, $variables);
    $variables['hero_banners'] = _palefire_hero_banners($paragraph, $variables);
    $variables['hero_blog'] = _palefire_hero_blog_banner($paragraph, $variables);
    // On the hero the map is a section of the page: its heading is an h2
    // (map.heading_tag). Its own render-cache entry.
    if (!empty($variables['landing_map'])) {
      $variables['landing_map']['#pf_hero'] = TRUE;
      $variables['landing_map']['#cache']['keys'][] = 'pf_hero';
    }
    if (!empty($variables['landing_map']) && !empty($variables['visit'])) {
      $variables['landing_map']['#pf_visit'] = $variables['visit'] + [
        'id' => $variables['landing']['input_id'] . '-visit',
        // Rooms and access, the key's index rule (map-key.html.twig).
        'index' => $variables['hero_index']['rooms'] ?? '',
      ];
      // The map's render cache: its own entry with the card, cleared when
      // the page's location fields change (the host node's tags).
      $variables['landing_map']['#cache']['keys'][] = 'pf_visit';
      $variables['landing_map']['#cache']['tags'] = Cache::mergeTags($variables['landing_map']['#cache']['tags'] ?? [], $variables['#cache']['tags'] ?? []);
      $variables['visit_in_map'] = TRUE;
    }
  }
}

/**
 * The Landing hero's banners, from its optional field, or [].
 *
 * field_hero_banners is added in the UI (Landing hero > Manage fields), like
 * the Quick Guide fields: an entity reference to Content (Tile and Modular
 * page), up to five values (five show on the 5-column grid, four on the
 * 4-column one). Each becomes a tall banner under the search
 * (includes/landing.html.twig), read through _palefire_node_card() as the
 * Tile showcase reads its tiles, so a banner looks and links as that tile
 * does there: title, url, label (its Category) and the portrait cover. A
 * node the visitor can't view is left out.
 */
function _palefire_hero_banners(ParagraphInterface $paragraph, array &$variables): array {
  if (!$paragraph->hasField('field_hero_banners')) {
    return [];
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $banners = [];
  foreach ($paragraph->get('field_hero_banners') as $item) {
    $node = $item->entity;
    $card = $node instanceof NodeInterface ? _palefire_node_card($node, $cache, 140) : NULL;
    if (!$card) {
      continue;
    }
    $banners[] = [
      'title' => $card['title'],
      'url' => $card['url'],
      'label' => $card['label'],
      'image' => $card['image_item'] ? _palefire_responsive_cover($card['image_item'], 'tile_showcase_portrait', $cache) : NULL,
    ];
    if (count($banners) === 5) {
      break;
    }
  }
  $cache->applyTo($variables);
  return $banners;
}

/**
 * The Landing hero's first banner: its newest blog post, or NULL.
 *
 * The newest Article in the paragraph's "Blog categories"
 * (field_landing_blog_category, _palefire_blog_posts()), as a banner before
 * the configured ones: title, url, date (and datetime), category, and its
 * Image (field_image) in the banners' portrait style, or NULL, when the
 * banner sets the date large instead (day, "Sep 2026"). Without the field,
 * or with no post, NULL.
 */
function _palefire_hero_blog_banner(ParagraphInterface $paragraph, array &$variables): ?array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $posts = _palefire_blog_posts($paragraph, 1, $cache);
  $post = $posts[0] ?? NULL;
  if ($post) {
    $post['image'] = $post['image_item'] ? _palefire_responsive_cover($post['image_item'], 'tile_showcase_portrait', $cache) : NULL;
    unset($post['image_item']);
  }
  $cache->applyTo($variables);
  return $post;
}

/**
 * The Landing hero's Quick Guide text, from its optional fields.
 *
 * Each field is added in the UI (Landing hero > Manage fields); a missing or
 * empty one leaves its key out, and includes/landing.html.twig prints the
 * built-in text instead:
 * - field_quick_guide_title (Text, plain): the heading and its TOC label.
 * - field_quick_guide_intro (Text, formatted, long): the line under it.
 * - field_quick_guide_link (Link): the full guide's URL; its link text, if
 *   any, replaces "Full guide".
 * - field_quick_guide_visit (Text, formatted, long): the "Before you
 *   visit" notes under the intro, as a list (an editor's bulleted list),
 *   replacing the built-in ones.
 *
 * Returns ['title', 'intro', 'visit', 'url', 'link_text'], each optional;
 * intro and visit are processed_text render arrays.
 */
function _palefire_quick_guide(ParagraphInterface $paragraph, array &$variables): array {
  $field = static fn (string $name): ?FieldItemListInterface => $paragraph->hasField($name) && !$paragraph->get($name)->isEmpty() ? $paragraph->get($name) : NULL;
  $quick = [];
  if ($title = $field('field_quick_guide_title')) {
    $quick['title'] = trim((string) $title->value);
  }
  if ($intro = $field('field_quick_guide_intro')) {
    $quick['intro'] = [
      '#type' => 'processed_text',
      '#text' => $intro->value,
      '#format' => $intro->format,
    ];
  }
  if ($visit = $field('field_quick_guide_visit')) {
    $quick['visit'] = [
      '#type' => 'processed_text',
      '#text' => $visit->value,
      '#format' => $visit->format,
    ];
  }
  if ($link = $field('field_quick_guide_link')?->first()) {
    $url = $link->getUrl()->toString(TRUE);
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheableDependency($url)
      ->applyTo($variables);
    $quick['url'] = $url->getGeneratedUrl();
    $quick['link_text'] = trim((string) $link->title);
  }
  return array_filter($quick);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-department.
 *
 * Landing department (scripts/palefire_landing_department_setup.php) is a
 * copy of bento_search with the same fields, plus the Landing hero's Tiles
 * (field_hero_tiles): the same variables, plus department and hero_tiles,
 * which includes/landing.html.twig reads. Its own input_id keeps the
 * search's and the Visit card's ids unique on the page.
 */
function palefire_preprocess_paragraph__landing_department(array &$variables): void {
  palefire_preprocess_paragraph__bento_search($variables);
  $variables['department'] = TRUE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if ($paragraph instanceof ParagraphInterface) {
    $variables['landing']['input_id'] = 'pf-department-' . $paragraph->id();
    $variables['hero_tiles'] = _palefire_hero_tiles($paragraph, $variables);
  }
}

/**
 * The newest published Articles in a paragraph's blog categories.
 *
 * The categories are its "Blog categories" field
 * (field_landing_blog_category, Article Category terms): the Landing hero's
 * and From the stacks'. An article matches when its own Article Category
 * (field_article_category) has any of them. Newest by Article Date, then by
 * creation. Without the field, with it empty, or without those Article
 * fields, this is []. The list's cache tag (node_list:article) refreshes
 * the posts when an article is published or changed.
 *
 * Each post: ['title', 'url', 'date', 'datetime', 'day', 'month',
 * 'category', 'excerpt', 'image_item']. category is the article's first
 * category among the paragraph's; day and month ("28", "Sep 2026") set the
 * date large; image_item is its Image (field_image) item, or NULL, for the
 * caller to build in its own style.
 */
function _palefire_blog_posts(ParagraphInterface $paragraph, int $limit, CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:article']);

  $terms = [];
  if ($paragraph->hasField('field_landing_blog_category')) {
    foreach ($paragraph->get('field_landing_blog_category')->referencedEntities() as $term) {
      $cache->addCacheableDependency($term);
      $terms[$term->id()] = $term;
    }
  }
  // Both fields are on Article (Manage fields); without them the query
  // would fail, so the posts just stay out.
  $storages = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
  if (!$terms || !isset($storages['field_article_category'], $storages['field_article_date'])) {
    return [];
  }

  $ids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'article')
    ->condition('status', 1)
    ->condition('field_article_category', array_keys($terms), 'IN')
    ->sort('field_article_date', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, $limit)
    ->execute();
  $repository = \Drupal::service('entity.repository');
  $formatter = \Drupal::service('date.formatter');
  $posts = [];
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($ids) as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }
    $node = $repository->getTranslationFromContext($node);
    $cache->addCacheableDependency($node);
    $url = $node->toUrl()->toString(TRUE);
    $cache->addCacheableDependency($url);

    // In the site's time zone (the field stores UTC).
    $timestamp = (int) $node->getCreatedTime();
    if ($node->hasField('field_article_date') && $node->get('field_article_date')->date) {
      $timestamp = $node->get('field_article_date')->date->getTimestamp();
    }

    // Excerpt: About Text, else the body's summary or text, as plain text.
    $excerpt = '';
    foreach ([['field_about_text', 'value'], ['body', 'summary'], ['body', 'value']] as [$field, $property]) {
      if ($excerpt === '' && $node->hasField($field) && !$node->get($field)->isEmpty()) {
        $excerpt = _palefire_plain_excerpt((string) $node->get($field)->first()->{$property}, 180);
      }
    }

    // The article's first category that the paragraph asks for.
    $term = reset($terms);
    foreach ($node->get('field_article_category') as $item) {
      if (isset($terms[$item->target_id])) {
        $term = $terms[$item->target_id];
        break;
      }
    }

    $posts[] = [
      'title' => $node->label(),
      'url' => $url->getGeneratedUrl(),
      'date' => $formatter->format($timestamp, 'custom', 'M j, Y'),
      'datetime' => $formatter->format($timestamp, 'custom', 'Y-m-d'),
      'category' => $repository->getTranslationFromContext($term)->label(),
      'excerpt' => $excerpt,
      'day' => $formatter->format($timestamp, 'custom', 'j'),
      'month' => $formatter->format($timestamp, 'custom', 'M Y'),
      'image_item' => $node->hasField('field_image') && !$node->get('field_image')->isEmpty() ? $node->get('field_image')->first() : NULL,
    ];
  }
  return $posts;
}

/**
 * The Landing hero's tiles from its Hero tile paragraphs, or [].
 *
 * field_hero_tiles (scripts/palefire_landing_hero_tiles_setup.php): up to
 * three Hero tiles, each a Modular page or a Tile (field_hero_tile_page,
 * read by _palefire_node_card()) with an optional label and line.
 * Empty, or without the field, the template keeps its placeholder tiles.
 * A tile whose page is missing or that the visitor can't view is left out.
 *
 * Each tile has the template's shape: label, title, meta (the line under
 * the title), more (the page's intro as plain text, shown when the tile
 * opens), url, cta, images (one render array, or none: hatched frame) and
 * frames. The image is the card's cover in the tiles' landscape style
 * (tile_showcase_landscape_lg, 1280 x 800), else the original file;
 * decorative and lazy.
 */
function _palefire_hero_tiles(ParagraphInterface $paragraph, array &$variables): array {
  if (!$paragraph->hasField('field_hero_tiles')) {
    return [];
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $tiles = [];
  foreach ($paragraph->get('field_hero_tiles')->referencedEntities() as $tile) {
    if (!$tile instanceof ParagraphInterface || !$tile->hasField('field_hero_tile_page')) {
      continue;
    }
    $cache->addCacheableDependency($tile);
    $page = $tile->get('field_hero_tile_page')->entity;
    $card = $page instanceof NodeInterface ? _palefire_node_card($page, $cache) : NULL;
    if (!$card) {
      continue;
    }
    $image = $card['image_item'] ? _palefire_image_build($card['image_item'], ['tile_showcase_landscape_lg'], $cache) : NULL;

    $tiles[] = [
      'label' => $tile->hasField('field_hero_tile_label') ? (string) $tile->get('field_hero_tile_label')->value : '',
      'title' => $card['title'],
      'meta' => $tile->hasField('field_hero_tile_when') ? (string) $tile->get('field_hero_tile_when')->value : '',
      'more' => $card['note'],
      'url' => $card['url'],
      'cta' => t('Explore'),
      'images' => $image ? [$image] : [],
      'frames' => 1,
    ];
  }
  $cache->applyTo($variables);
  return $tiles;
}

/**
 * A card's Category terms as one label (the hero banners, the tiles).
 *
 * Joined with " + " ("Dept + Medium"), except when one of them is
 * Exhibition: then a space, so it reads as a kind of exhibition ("Digital
 * Exhibition", "Physical Exhibition") rather than two things.
 *
 * @param string[] $labels
 *   The terms' labels, in field order.
 */
function _palefire_card_label(array $labels): string {
  $exhibition = (bool) array_filter($labels, static fn (string $label): bool => mb_strtolower(trim($label)) === 'exhibition');
  return implode($exhibition ? ' ' : ' + ', $labels);
}

/**
 * One Tile or Modular page as a card, or NULL when the visitor can't view it.
 *
 * Tile showcase (field_tiles) and the Landing hero's tiles
 * (field_hero_tile_page) may reference either type (each field's Reference
 * type, Manage fields), so both read their nodes through here and get the
 * same shape:
 * - title, url: the node's own, in the page's language.
 * - label: its Category terms (field_category) as one label
 *   (_palefire_card_label(): "Dept + Medium", "Digital Exhibition"), or ''.
 * - labels: the same terms, one string each ([] when none).
 * - note: plain text from its intro (field_intro), else the body's summary,
 *   else the body, cut at $max; '' when it has none.
 * - image_item: the cover's image item (_palefire_card_image_item()), or
 *   NULL. Each caller builds it in its own image style.
 */
function _palefire_node_card(NodeInterface $node, CacheableMetadata $cache, int $max = 200): ?array {
  $cache->addCacheableDependency($node);
  $access = $node->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  if (!$access->isAllowed()) {
    return NULL;
  }
  $repository = \Drupal::service('entity.repository');
  $node = $repository->getTranslationFromContext($node);
  $url = $node->toUrl()->toString(TRUE);
  $cache->addCacheableDependency($url);

  $labels = [];
  if ($node->hasField('field_category')) {
    foreach ($node->get('field_category') as $term_item) {
      $term = $term_item->entity;
      if (!$term) {
        continue;
      }
      $cache->addCacheableDependency($term);
      $term_access = $term->access('view', NULL, TRUE);
      $cache->addCacheableDependency($term_access);
      if ($term_access->isAllowed()) {
        $labels[] = $repository->getTranslationFromContext($term)->label();
      }
    }
  }

  $note = '';
  foreach ([['field_intro', 'value'], ['body', 'summary'], ['body', 'value']] as [$field, $property]) {
    if ($note === '' && $node->hasField($field) && !$node->get($field)->isEmpty()) {
      $note = _palefire_plain_excerpt((string) $node->get($field)->first()->{$property}, $max);
    }
  }

  return [
    'title' => $node->label(),
    'url' => $url->getGeneratedUrl(),
    'label' => _palefire_card_label($labels),
    'labels' => $labels,
    'note' => $note,
    'image_item' => _palefire_card_image_item($node, $cache),
  ];
}

/**
 * A page's outline for a card with no cover: the page drawn small, blurred.
 *
 * Up to four sections (field_scroll_section, then field_sections) that have
 * a title, each with up to three lines: its blocks' titles and the start of
 * their text (a guide section's field_guide_blocks), else the start of its
 * own body. Landings and untitled sections are skipped. Plain text only; the
 * card prints it aria-hidden, as a picture of the page.
 *
 * @return array
 *   A list of sections: heading (string) and lines (a list of
 *   ['text' => string, 'kind' => 'subhead'|'text']).
 */
function _palefire_page_outline(NodeInterface $node, CacheableMetadata $cache): array {
  $outline = [];
  foreach (PalefireHooks::SECTION_FIELDS as $field) {
    if (!$node->hasField($field)) {
      continue;
    }
    foreach ($node->get($field)->referencedEntities() as $section) {
      if (count($outline) === 4) {
        return $outline;
      }
      if (!$section instanceof ParagraphInterface || !$section->isPublished()
        || in_array($section->bundle(), PalefireHooks::LANDING_BUNDLES, TRUE)
        || !$section->hasField('field_section_title') || $section->get('field_section_title')->isEmpty()) {
        continue;
      }
      $cache->addCacheableDependency($section);
      $blocks = $section->hasField('field_guide_blocks') ? $section->get('field_guide_blocks')->referencedEntities() : [$section];
      $lines = [];
      foreach ($blocks as $block) {
        if (!$block instanceof ParagraphInterface || !$block->isPublished()) {
          continue;
        }
        $cache->addCacheableDependency($block);
        if ($block->hasField('field_block_title') && !$block->get('field_block_title')->isEmpty()) {
          $lines[] = ['text' => _palefire_plain_excerpt((string) $block->get('field_block_title')->value, 60), 'kind' => 'subhead'];
        }
        foreach (['field_block_intro', 'field_block_body', 'field_section_body'] as $text_field) {
          if ($block->hasField($text_field) && !$block->get($text_field)->isEmpty()) {
            $lines[] = ['text' => _palefire_plain_excerpt((string) $block->get($text_field)->value, 110), 'kind' => 'text'];
            break;
          }
        }
        if (count($lines) >= 3) {
          break;
        }
      }
      $outline[] = [
        'heading' => _palefire_plain_excerpt((string) $section->get('field_section_title')->value, 60),
        'lines' => array_slice(array_filter($lines, fn ($line) => $line['text'] !== ''), 0, 3),
      ];
    }
  }
  return $outline;
}

/**
 * A card's cover image item, or NULL.
 *
 * A Tile's Tile cover (field_tile_cover). Any other node (a Modular page):
 * its Image cover (field_image_cover, Media: Image), else an exhibition's
 * cover (field_exhibit_cover, Media: Image), else the background poster of
 * its first landing (_palefire_landing_poster_item()).
 */
function _palefire_card_image_item(NodeInterface $node, CacheableMetadata $cache): ?FieldItemInterface {
  if ($node->hasField('field_tile_cover')) {
    return $node->get('field_tile_cover')->isEmpty() ? NULL : $node->get('field_tile_cover')->first();
  }
  foreach (['field_image_cover', 'field_exhibit_cover'] as $field) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty()
      && ($image = _palefire_media_image_item($node->get($field)->first(), $cache))) {
      return $image;
    }
  }
  return _palefire_landing_poster_item($node, $cache);
}

/**
 * The background poster's image item of a page's first landing, or NULL.
 *
 * The first section (in field_scroll_section, then field_sections) that is
 * a landing (PalefireHooks::LANDING_BUNDLES) with a poster. field_bg_poster
 * may be a Media (image) reference or a plain image field.
 */
function _palefire_landing_poster_item(NodeInterface $page, CacheableMetadata $cache): ?FieldItemInterface {
  foreach (PalefireHooks::SECTION_FIELDS as $field) {
    if (!$page->hasField($field)) {
      continue;
    }
    foreach ($page->get($field)->referencedEntities() as $section) {
      if (!in_array($section->bundle(), PalefireHooks::LANDING_BUNDLES, TRUE)
        || !$section->hasField('field_bg_poster') || $section->get('field_bg_poster')->isEmpty()) {
        continue;
      }
      $cache->addCacheableDependency($section);
      return _palefire_media_image_item($section->get('field_bg_poster')->first(), $cache);
    }
  }
  return NULL;
}

/**
 * The image item behind a Media reference or a plain image field, or NULL.
 *
 * A Media item's source field holds the image; a plain image field item is
 * returned as it is.
 */
function _palefire_media_image_item(FieldItemInterface $item, CacheableMetadata $cache): ?FieldItemInterface {
  $target = $item->entity;
  if (!$target instanceof MediaInterface) {
    return $item;
  }
  $cache->addCacheableDependency($target);
  $source = $target->getSource()->getConfiguration()['source_field'] ?? NULL;
  if (!$source || !$target->hasField($source) || $target->get($source)->isEmpty()) {
    return NULL;
  }
  return $target->get($source)->first();
}

/**
 * Plain text from HTML, whitespace collapsed, cut at $max with an ellipsis.
 */
function _palefire_plain_excerpt(string $html, int $max = 180): string {
  $text = preg_replace('/\s+/u', ' ', trim(Html::decodeEntities(strip_tags($html))));
  return mb_strlen($text) > $max ? rtrim(mb_substr($text, 0, $max)) . '…' : $text;
}

/**
 * One image item as a decorative (alt="") lazy image with its size set.
 *
 * In the first of $styles that exists, else the original file.
 */
function _palefire_image_build(FieldItemInterface $image, array $styles, CacheableMetadata $cache): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $build = [
    '#uri' => $file->getFileUri(),
    '#width' => $image->width,
    '#height' => $image->height,
    '#alt' => '',
    '#attributes' => ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  foreach ($styles as $name) {
    if ($style = $storage->load($name)) {
      $cache->addCacheableDependency($style);
      return $build + ['#theme' => 'image_style', '#style_name' => $name];
    }
  }
  return $build + ['#theme' => 'image'];
}

/**
 * Adds the host Modular page's title, intro and Visit card to a landing search.
 *
 * Reads the optional node fields added by scripts/palefire_modular_setup.php
 * (field_intro, field_hours_location, field_location_name,
 * field_location_query, field_location_display). Sets:
 * - page_title: the node title when this landing is the first section (it
 *   then prints the page <h1>), or NULL.
 * - landing_intro: render array of field_intro, or NULL.
 * - visit: NULL, or ['name', 'lid', 'maps_url', 'embed_url', 'query',
 *   'parking_url'] for the Visit card (hours via js/visit-hours.js, the map
 *   loads on click).
 * A page with none of these fields filled in keeps today's landing.
 */
function _palefire_landing_visit(array &$variables, ParagraphInterface $paragraph): void {
  $variables['landing_intro'] = NULL;
  $variables['visit'] = NULL;

  // The landing may sit inside a section paragraph: walk up to the node.
  $host = $paragraph;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  if (!$host instanceof NodeInterface) {
    return;
  }
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $host->getCacheTags());

  // The page <h1>: printed by the landing (above the intro) only when it is
  // the Modular page's first section. Paragraph templates don't get a
  // `node` variable, which is why {{ node.label }} printed nothing.
  // PalefireHooks::preprocessPage() uses the same check, so page.html.twig
  // prints the <h1> itself on every other Modular page.
  if ($host->bundle() === PalefireHooks::MODULAR_BUNDLE && PalefireHooks::titleLandingUuid($host) === $paragraph->uuid()) {
    $variables['page_title'] = $host->label();
    // The TOC's "Home" and "Map" targets (PalefireHooks::heroTocIds()).
    $ids = PalefireHooks::heroTocIds($host);
    $variables['toc_home_id'] = $ids['home'] ?? NULL;
    $variables['toc_map_id'] = $ids['map'] ?? NULL;
    // The breadcrumb at the top of the lead panel (PalefireHooks::
    // crumbInLanding(); page.html.twig then leaves the head's out). Built by
    // the same service as the System Breadcrumb block, so the trail and its
    // template are the same.
    if (PalefireHooks::crumbInLanding($host)) {
      $variables['lead_breadcrumb'] = \Drupal::service('breadcrumb')->build(\Drupal::routeMatch())->toRenderable();
    }
  }

  $value = static function (string $name) use ($host): string {
    return ($host->hasField($name) && !$host->get($name)->isEmpty())
      ? trim((string) $host->get($name)->value)
      : '';
  };

  if ($host->hasField('field_intro') && !$host->get('field_intro')->isEmpty()) {
    $variables['landing_intro'] = $host->get('field_intro')->view(['label' => 'hidden']);
  }

  $lid = $value('field_hours_location');
  $name = $value('field_location_name');
  $query = $value('field_location_query');
  if ($lid === '' && $name === '' && $query === '') {
    return;
  }
  $embed = $value('field_location_display') === 'embed';
  // Visitor parking guides (scripts/palefire_guide_parking.php) by LibCal
  // location: the Visit card's Parking link and the Quick Guide's button.
  $parking = [
    '236' => '/v2/special/guides/parking-hill-memorial-library',
  ];
  $variables['visit'] = [
    'name' => $name,
    'lid' => preg_match('/^\d+$/', $lid) ? $lid : '',
    'query' => $query,
    'maps_url' => $query !== '' ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($query) : '',
    'embed_url' => ($embed && $query !== '') ? 'https://www.google.com/maps?q=' . rawurlencode($query) . '&output=embed' : '',
    'parking_url' => $parking[$lid] ?? '',
  ];
  $variables['#attached']['library'][] = 'palefire/visit';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--building-map.
 *
 * Builds `map` for the template: the building's drawing, and one entry per
 * published "Building spaces" room term (title, access, floor, link, tooltip).
 * A published Room override on this paragraph replaces that room's tooltip
 * text, access or link (only the fields it fills in).
 */
function palefire_preprocess_paragraph__building_map(array &$variables): void {
  $variables['map'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  $buildings = palefire_buildings();
  if (!$paragraph instanceof ParagraphInterface || !$buildings) {
    return;
  }
  $value = static fn (string $field) => $paragraph->hasField($field) ? $paragraph->get($field)->value : NULL;
  $key = $value('field_map_building') ?: array_key_first($buildings);
  $building = $buildings[$key] ?? NULL;
  if (!$building) {
    return;
  }

  // Any change to a Building spaces term re-renders the map.
  $cache = (new CacheableMetadata())->addCacheTags(['taxonomy_term_list:building_space']);
  $repository = \Drupal::service('entity.repository');
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $terms->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'building_space')
    ->condition('status', 1)
    ->condition('field_map_key', $key, 'STARTS_WITH')
    ->execute();
  $building_term = NULL;
  $rooms = [];
  foreach ($terms->loadMultiple($ids) as $term) {
    $term = $repository->getTranslationFromContext($term);
    $map_key = (string) $term->get('field_map_key')->value;
    if ($map_key === $key) {
      $building_term = $term;
    }
    elseif (str_starts_with($map_key, $key . '.')) {
      $rooms[substr($map_key, strlen($key) + 1)] = $term;
    }
  }

  $overrides = [];
  if ($paragraph->hasField('field_map_overrides')) {
    foreach ($paragraph->get('field_map_overrides') as $item) {
      $override = $item->entity;
      $room_key = $override instanceof ParagraphInterface && $override->isPublished() ? (string) $override->get('field_room_key')->value : '';
      if (str_starts_with($room_key, $key . '.')) {
        $overrides[substr($room_key, strlen($key) + 1)] = $override;
        $cache->addCacheableDependency($override);
      }
    }
  }

  // The override's field when it is filled in, otherwise the term's.
  $pick = static function (string $field, $term, ?ParagraphInterface $override, ?string $term_field = NULL): ?FieldItemListInterface {
    if ($override && $override->hasField($field) && !$override->get($field)->isEmpty()) {
      return $override->get($field);
    }
    $term_field = $term_field ?? $field;
    return $term->hasField($term_field) && !$term->get($term_field)->isEmpty() ? $term->get($term_field) : NULL;
  };
  $text = static fn (?FieldItemListInterface $items) => $items ? [
    '#type' => 'processed_text',
    '#text' => $items->value,
    '#format' => $items->format,
  ] : NULL;

  // The room's photo for the top of its tooltip: pf_map_room (960x240 WebP,
  // twice the tooltip's width). Rooms without one, or before the setup
  // script has made the style, get none.
  $photo_style = \Drupal::entityTypeManager()->getStorage('image_style')->load('pf_map_room');
  if ($photo_style) {
    $cache->addCacheableDependency($photo_style);
  }
  $photo = static function ($term) use ($photo_style, $cache): ?array {
    // An Image media item from the library, as the rest of Modular.
    $ref = $photo_style && $term->hasField('field_space_media') ? $term->get('field_space_media')->first() : NULL;
    $item = $ref ? _palefire_media_image_item($ref, $cache) : NULL;
    $file = $item?->entity;
    if (!$file instanceof FileInterface) {
      return NULL;
    }
    $cache->addCacheableDependency($file);
    $uri = $file->getFileUri();
    $dimensions = ['width' => (int) $item->width ?: NULL, 'height' => (int) $item->height ?: NULL];
    $photo_style->transformDimensions($dimensions, $uri);
    return [
      'src' => \Drupal::service('file_url_generator')->transformRelative($photo_style->buildUrl($uri)),
      'width' => (int) ($dimensions['width'] ?? 960),
      'height' => (int) ($dimensions['height'] ?? 240),
    ];
  };

  $uid = 'pf-map-' . $paragraph->id();
  $spaces = [];
  foreach ($building['spaces'] ?? [] as $space_key => $def) {
    $term = $rooms[$space_key] ?? NULL;
    if (!$term) {
      // Unpublished or missing: drawn as plain floor.
      continue;
    }
    $cache->addCacheableDependency($term);
    $override = $overrides[$space_key] ?? NULL;
    $access = $pick('field_space_access', $term, $override)?->value ?: ($def['access'] ?? 'walk_in');
    $link = $pick('field_space_link', $term, $override)?->first();
    $spaces[$space_key] = [
      'key' => $space_key,
      'title' => $term->label(),
      'access' => $access,
      'floor' => (int) ($def['floor'] ?? 1),
      'url' => $link ? $link->getUrl()->toString() : '',
      'cta' => $link ? ($link->title ?: ($access === 'appointment' ? t('Request an appointment') : t('Plan your visit'))) : '',
      'tip' => $uid . '-' . Html::cleanCssIdentifier($space_key) . '-tip',
      'body' => $text($pick('field_space_body', $term, $override, 'description')),
      // Optional words after the access line, e.g. "Now showing".
      'note' => $term->hasField('field_space_note') ? trim((string) $term->get('field_space_note')->value) : '',
      'photo' => $photo($term),
    ];
  }
  // Floor 1 before Floor 2; within a floor, the buildings.yml order.
  uasort($spaces, static fn (array $a, array $b): int => $a['floor'] <=> $b['floor']);

  if ($building_term) {
    $cache->addCacheableDependency($building_term);
  }
  // Summary: this paragraph's Intro (field_map_intro), under the heading or,
  // on the Hill hero, set into the drawing. Note: the building's own
  // description (its Building spaces term), at the top of the legend, for
  // who can walk in and what needs an appointment. Each is optional.
  $summary = $paragraph->hasField('field_map_intro') && !$paragraph->get('field_map_intro')->isEmpty()
    ? $paragraph->get('field_map_intro')
    : NULL;
  $note = $building_term && !$building_term->get('description')->isEmpty() ? $building_term->get('description') : NULL;

  // "You are here": only a drawn (published) room in this building.
  $here = (string) $value('field_map_here');
  $here = str_starts_with($here, $key . '.') ? substr($here, strlen($key) + 1) : '';
  if (!isset($spaces[$here])) {
    $here = '';
  }

  $cache_render = [];
  $cache->applyTo($cache_render);
  $variables['map'] = [
    'uid' => $uid,
    'key' => $key,
    'label' => $building['label'] ?? $key,
    'heading' => $value('field_map_heading') ?: ($building['heading'] ?? t('Visit @building', ['@building' => $building['label'] ?? $key])),
    'summary' => $text($summary),
    'note' => $text($note),
    'template' => $building['template'],
    'spaces' => $spaces,
    'here' => $here,
    'legend' => array_values((array) ($building['legend'] ?? [])),
    // Not rooms (the Lobby): numbered with them on phones, nothing more.
    'landmarks' => array_map(static fn (string $lkey, array $l): array => [
      'key' => $lkey,
      'title' => $l['label'] ?? $lkey,
      'floor' => (int) ($l['floor'] ?? 1),
    ], array_keys((array) ($building['landmarks'] ?? [])), array_values((array) ($building['landmarks'] ?? []))),
    'cache' => $cache_render,
    // The landing hero's Visit card, shown in the aside with the key
    // (palefire_preprocess_paragraph__landing_hero()), or NULL.
    'visit' => $variables['elements']['#pf_visit'] ?? NULL,
    // h2 on the landing hero (a section of the page), h3 elsewhere.
    'heading_tag' => empty($variables['elements']['#pf_hero']) ? 'h3' : 'h2',
  ];
}

/* ---------------------------------------------------------------------------
 * Guide pages (scripts/palefire_guide_setup.php)
 * ------------------------------------------------------------------------- */

/**
 * Proxy prefix for Resources with "Requires LSU login" ticked.
 */
const PALEFIRE_PROXY_PREFIX = 'https://libezp.lib.lsu.edu/login?url=';

/**
 * Resource type (field_resource_type) => Bootstrap Icons file in images/bi.
 */
const PALEFIRE_RESOURCE_ICONS = [
  'article' => 'file-earmark-text',
  'book' => 'book',
  'database' => 'database',
  'guide' => 'journal-bookmark',
  'standard' => 'card-checklist',
  'tool' => 'tools',
  'course' => 'easel',
  'video' => 'play-fill',
  'pdf' => 'file-earmark-pdf',
  'word' => 'file-earmark-word',
  'download' => 'download',
  'search' => 'search',
  'person' => 'person',
  'website' => 'globe2',
];

/**
 * Renders the Resources in $field that the visitor can see (guide_item).
 *
 * Unpublished or otherwise inaccessible Resources are left out; their cache
 * tags are kept, so publishing one shows it on every guide that lists it.
 */
function _palefire_guide_resources(ParagraphInterface $paragraph, string $field, array &$variables): array {
  $items = [];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  if ($paragraph->hasField($field)) {
    $builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    $repository = \Drupal::service('entity.repository');
    foreach ($paragraph->get($field) as $item) {
      $resource = $item->entity;
      if (!$resource instanceof NodeInterface) {
        continue;
      }
      $cache->addCacheableDependency($resource);
      $access = $resource->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access);
      if ($access->isAllowed()) {
        $items[] = $builder->view($repository->getTranslationFromContext($resource), 'guide_item');
      }
    }
  }
  $cache->applyTo($variables);
  return $items;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--resource-list.
 */
function palefire_preprocess_paragraph__resource_list(array &$variables): void {
  $variables['resources'] = _palefire_guide_resources($variables['paragraph'], 'field_resources', $variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--accordion-item.
 */
function palefire_preprocess_paragraph__accordion_item(array &$variables): void {
  $variables['resources'] = _palefire_guide_resources($variables['paragraph'], 'field_resources', $variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--guide-text.
 *
 * request_paths: TRUE when the text has a paragraph that is only
 * "[request-paths]". The marker is taken out of the text, and the template
 * draws the Special Collections request diagram (guide-request-paths.html.twig)
 * after it. A marker anywhere else in a sentence is left as typed.
 *
 * faqs: likewise for a paragraph that is only "[special-collections-faqs]":
 * every Special Collections FAQ, most asked first, in the order the
 * homepage's Ask Special Collections section uses (_palefire_ask_faqs()),
 * drawn after the text as the guides' accordion (guide-faqs.html.twig).
 *
 * transcription: TRUE when the text opens with a Heading 4 "Transcription"
 * (Audubon's manuscripts): a primary source, set apart from the curators'
 * text (_exhibition.scss .pf-transcription).
 */
function palefire_preprocess_paragraph__guide_text(array &$variables): void {
  $variables['request_paths'] = FALSE;
  $variables['faqs'] = [];
  $variables['transcription'] = (bool) preg_match('#^\s*<h4[^>]*>\s*Transcription\s*</h4>#i', (string) $variables['paragraph']->get('field_block_body')->value);
  if (empty($variables['content']['field_block_body'])) {
    return;
  }
  // Style "Sources" (exhibitions): each list item gets an id, #src-<surname>,
  // after the text format has run (it would strip ids typed in the text).
  if ($variables['paragraph']->get('field_text_style')->value === 'sources') {
    $variables['content']['field_block_body']['#post_render'][] = [ExhibitSources::class, 'addIds'];
  }
  // A link to a bird in Audubon's field guide becomes a ruled row with the
  // bird's names (ExhibitFieldGuide).
  $guide = FALSE;
  foreach (Element::children($variables['content']['field_block_body']) as $delta) {
    $guide = $guide || ExhibitFieldGuide::applies((string) ($variables['content']['field_block_body'][$delta]['#text'] ?? ''));
  }
  if ($guide) {
    $names = ExhibitFieldGuide::names($variables['paragraph']);
    $variables['content']['field_block_body']['#pf_fieldguide'] = $names;
    // The names come from the entry's caption: a new caption redraws the row.
    $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $names[2]);
    $variables['content']['field_block_body']['#post_render'][] = [ExhibitFieldGuide::class, 'rows'];
  }
  $marker = '#<p>\s*\[request-paths\]\s*</p>#i';
  $faqs_marker = '#<p>\s*\[special-collections-faqs\]\s*</p>#i';
  $faqs = FALSE;
  // Element::children() takes its argument by reference, so it gets the
  // variable itself, not an expression.
  foreach (Element::children($variables['content']['field_block_body']) as $delta) {
    $item = &$variables['content']['field_block_body'][$delta];
    if (isset($item['#text']) && preg_match($marker, (string) $item['#text'])) {
      $item['#text'] = preg_replace($marker, '', (string) $item['#text']);
      $variables['request_paths'] = TRUE;
    }
    if (isset($item['#text']) && preg_match($faqs_marker, (string) $item['#text'])) {
      $item['#text'] = preg_replace($faqs_marker, '', (string) $item['#text']);
      $faqs = TRUE;
    }
    unset($item);
  }
  if ($faqs) {
    $variables['faqs'] = _palefire_ask_faqs(NULL, $variables, NULL);
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--librarian-card.
 *
 * card: the referenced staff node in the guide_card view mode, or NULL when
 * it is missing or the visitor can't see it (the card is then left out).
 */
function palefire_preprocess_paragraph__librarian_card(array &$variables): void {
  $variables['card'] = NULL;
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_librarian')) {
    return;
  }
  $person = $paragraph->get('field_librarian')->entity;
  if (!$person instanceof NodeInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($person);
  $access = $person->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->applyTo($variables);
  if ($access->isAllowed()) {
    $person = \Drupal::service('entity.repository')->getTranslationFromContext($person);
    $variables['card'] = \Drupal::entityTypeManager()->getViewBuilder('node')->view($person, 'guide_card');
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view.
 *
 * The staff View (StaffDirectory::VIEW, scripts/palefire_staff_setup.php)
 * only provides the routes; its templates print what this reads from the
 * Staff nodes.
 * - directory (/v2/staff): people (StaffDirectory::row(), by family name),
 *   departments (label, slug, count, by label) and total.
 * - profile (/v2/staff/<slug>): person (StaffDirectory::profile()). A slug
 *   that names no published Staff node is a 404.
 */
function palefire_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  if ($view->id() !== StaffDirectory::VIEW) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheTags(['node_list:' . StaffDirectory::BUNDLE]);

  if ($view->current_display === 'profile') {
    $person = StaffDirectory::fromSlug((string) ($view->args[0] ?? ''), $cache);
    if (!$person) {
      throw new NotFoundHttpException();
    }
    $variables['person'] = StaffDirectory::profile($person, $cache);
    $cache->applyTo($variables);
    return;
  }

  $nids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', StaffDirectory::BUNDLE)
    ->condition('status', 1)
    ->execute();
  $people = [];
  $departments = [];
  $repository = \Drupal::service('entity.repository');
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids) as $node) {
    $row = StaffDirectory::row($repository->getTranslationFromContext($node), $cache);
    $people[StaffDirectory::sortKey($row['name']) . ' ' . $node->id()] = $row;
    foreach ($row['departments'] as $department) {
      $departments[$department['slug']] ??= ['label' => $department['label'], 'slug' => $department['slug'], 'count' => 0];
      $departments[$department['slug']]['count']++;
    }
  }
  ksort($people, SORT_NATURAL);
  uasort($departments, static fn (array $a, array $b): int => strnatcasecmp($a['label'], $b['label']));
  $variables['people'] = array_values($people);
  $variables['departments'] = array_values($departments);
  $variables['total'] = count($people);
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--staff-contacts.
 *
 * Who to ask (scripts/palefire_staff_setup.php): contacts, one per Contact
 * row (field_staff_contacts) whose person the visitor can see: topic, name,
 * url (their /v2/staff profile), title and email. The section's heading,
 * eyebrow, lede and link come from the scroll-section field template.
 */
function palefire_preprocess_paragraph__staff_contacts(array &$variables): void {
  $variables['contacts'] = [];
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_staff_contacts')) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  foreach ($paragraph->get('field_staff_contacts')->referencedEntities() as $contact) {
    $cache->addCacheableDependency($contact);
    $person = $contact->hasField('field_librarian') ? $contact->get('field_librarian')->entity : NULL;
    $topic = $contact->hasField('field_contact_topic') ? trim((string) $contact->get('field_contact_topic')->value) : '';
    if (!$contact->isPublished() || $topic === '' || !$person instanceof NodeInterface) {
      continue;
    }
    $cache->addCacheableDependency($person);
    $access = $person->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $row = StaffDirectory::row(\Drupal::service('entity.repository')->getTranslationFromContext($person), $cache);
    $variables['contacts'][] = ['topic' => $topic] + array_intersect_key($row, array_flip(['name', 'url', 'title', 'email']));
  }
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--tile-showcase.
 *
 * Tile showcase (scripts/palefire_tile_showcase_setup.php) lists Tile nodes
 * and Modular pages (field_tiles, read by _palefire_node_card()) in one of
 * three layouts (field_tile_layout):
 * - stagger: tall portrait cards in a row with an offset rhythm (the
 *   concept's How-to guides and Specializations). A swipeable row when the
 *   section is narrow.
 * - grid: landscape cards in three columns (the concept's Collections),
 *   stepping down to two and one.
 * - index: a numbered list with no pictures, one ruled row per item: its
 *   number, title, note and label (Collections & services on the Special
 *   Collections homepage). The "index" value is added to the Layout field's
 *   allowed values by hand (Manage fields); any other value is a stagger.
 * - masonry: tall cards in the hero banners' voice, with a Grid / List
 *   switch for the visitor (js/tile-views.js); named for its old Masonry
 *   view. Added by palefire_tile_showcase_gallery_setup.php.
 * - ledger: the index's rows unnumbered, grouped under their Category
 *   labels, beside the section's heading when wide (Partnerships on the
 *   Special Collections homepage). Added to the allowed values by hand, as
 *   index is.
 *
 * layout: 'stagger', 'grid', 'index', 'ledger', 'masonry', 'ask' or 'covers'.
 * tiles: one entry per item the visitor can see, in field order:
 * - title: the node's title.
 * - url: the node's own URL.
 * - label: its Category terms as one label (_palefire_card_label():
 *   "Dept + Medium", "Digital Exhibition"), or '' (the cards and the
 *   index's rows).
 * - labels: the same terms, one string each.
 * - note: its intro as plain text, or '' (shown by the index, and by the
 *   masonry's List view).
 * - image: the card's cover in the layout's responsive image style, or
 *   NULL (always NULL on the index, which shows none). Its alt is empty:
 *   the card's title already names the link, so the image would only
 *   repeat it (WCAG 1.1.1 decorative-in-context).
 * - outline: a card with no image (not on the index): the page's sections
 *   (_palefire_page_outline()), which the card draws as a blurred picture
 *   of the page in the reading swatch's colors. Guides rarely have covers.
 * groups (ledger only): the tiles by label, in the order each label first
 *   appears: label, tiles. Tiles with no label come last, under "More", or
 *   as one group with no label when none has one. Titles lose a leading
 *   "Special Collections".
 *
 * Layout "ask" (Ask Special Collections, scripts/palefire_ask_section.php)
 * is no card list: faqs (_palefire_ask_faqs()) and ask_form, the libanswers
 * module's question form (palefire_form_libanswers_ask_form_alter()), or
 * NULL without the module.
 *
 * Layout "covers" (Published from the Collections,
 * scripts/palefire_publications_setup.php) lists books, not nodes: books
 * (_palefire_publications()) from the section's Publications paragraphs.
 */
function palefire_preprocess_paragraph__tile_showcase(array &$variables): void {
  $variables['layout'] = 'stagger';
  $variables['tiles'] = [];
  $variables['groups'] = [];
  $variables['books'] = [];
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  $layout = $paragraph->hasField('field_tile_layout') ? $paragraph->get('field_tile_layout')->value : NULL;
  if (in_array($layout, ['grid', 'index', 'ledger', 'masonry', 'ask', 'covers'], TRUE)) {
    $variables['layout'] = $layout;
  }
  if ($variables['layout'] === 'ask') {
    $variables['faqs'] = _palefire_ask_faqs($paragraph, $variables);
    // The question form (the libanswers module: a Special Collections
    // ticket through the LibAnswers API, Honeypot against spam). Without
    // the module the section offers AskUs instead.
    $variables['ask_form'] = \Drupal::moduleHandler()->moduleExists('libanswers')
      ? \Drupal::formBuilder()->getForm('Drupal\libanswers\Form\AskForm', 2616, 'ask-special-collections')
      : NULL;
    return;
  }
  if ($variables['layout'] === 'covers') {
    $cache = CacheableMetadata::createFromRenderArray($variables);
    $variables['books'] = _palefire_publications($paragraph, $cache);
    $cache->applyTo($variables);
    return;
  }
  $rows = in_array($variables['layout'], ['index', 'ledger'], TRUE);
  if (!$paragraph->hasField('field_tiles')) {
    return;
  }

  $cache = CacheableMetadata::createFromRenderArray($variables);
  $style = $variables['layout'] === 'grid' ? 'tile_showcase_landscape' : 'tile_showcase_portrait';
  $covers = [];

  foreach ($paragraph->get('field_tiles') as $item) {
    $node = $item->entity;
    $card = $node instanceof NodeInterface ? _palefire_node_card($node, $cache, 140) : NULL;
    if (!$card) {
      continue;
    }
    $show_image = !$rows && $card['image_item'];
    $image = $show_image ? _palefire_responsive_cover($card['image_item'], $style, $cache) : NULL;
    $variables['tiles'][] = [
      'title' => $card['title'],
      'url' => $card['url'],
      'label' => $card['label'],
      'labels' => $card['labels'],
      'note' => $card['note'],
      'image' => $image,
      'outline' => !$rows && !$image ? _palefire_page_outline($node, $cache) : [],
    ];
    $covers[] = $show_image ? $card['image_item'] : NULL;
  }

  if ($variables['layout'] === 'ledger') {
    // Rows drop a leading "Special Collections" ("Research Grants"): the
    // section already sits on its homepage. The node titles keep it, for
    // their own pages and for search.
    $groups = [];
    foreach ($variables['tiles'] as $tile) {
      $tile['title'] = preg_replace('/^Special Collections\s+(?=\S)/iu', '', $tile['title']);
      $groups[$tile['label']][] = $tile;
    }
    $loose = $groups[''] ?? [];
    unset($groups['']);
    if ($loose) {
      $more = $groups ? (string) t('More') : '';
      $groups[$more] = array_merge($groups[$more] ?? [], $loose);
    }
    foreach ($groups as $label => $tiles) {
      $variables['groups'][] = ['label' => (string) $label, 'tiles' => $tiles];
    }
  }

  // The masonry Grid's lead card (one to four tiles, _tile-showcase.scss)
  // spans two to five columns: its cover is the landscape crop, sized for
  // that width (beside the sidebar from 1480px; a column below).
  $count = count($variables['tiles']);
  if ($variables['layout'] === 'masonry' && $count <= 4 && !empty($covers[0])) {
    $lead = [1 => 85, 2 => 50, 3 => 50, 4 => 34][$count];
    $variables['tiles'][0]['image'] = _palefire_lead_cover($covers[0], "(min-width: 1480px) {$lead}vw, (min-width: 768px) 34vw, 50vw", $cache) ?? $variables['tiles'][0]['image'];
  }
  $cache->applyTo($variables);
}

/**
 * The books for a Tile showcase in the Covers layout, in field order.
 *
 * From its Publications (field_tile_publications, Publication paragraphs:
 * scripts/palefire_publications_setup.php). Unpublished ones and ones with
 * no title are skipped. Each book:
 * - title: the title before its first colon ("Kingfish U"), as the cover
 *   and the card's heading show it; subtitle: the rest, or ''.
 * - author, imprint ("LSU Press, 2023"): plain text, or ''.
 * - url: its Link (the catalog record), or ''.
 * - image: its Cover (Media: Image) in publication_cover (480 wide, no
 *   crop), decorative and lazy (_palefire_image_build()), or NULL: the
 *   card then sets a jacket in type.
 * - depth: its thickness as a share of the cover's width, for the page
 *   edges (--pf-book-depth): from its Pages (field_pub_pages), about
 *   0.06mm a page plus 3mm of boards on a 6in (152mm) wide book,
 *   between 0.06 and 0.3; 300 pages when it has no count.
 */
function _palefire_publications(ParagraphInterface $paragraph, CacheableMetadata $cache): array {
  $books = [];
  if (!$paragraph->hasField('field_tile_publications')) {
    return $books;
  }
  $text = static fn (ParagraphInterface $book, string $field): string => ($book->hasField($field) && !$book->get($field)->isEmpty())
    ? trim((string) $book->get($field)->value)
    : '';
  foreach ($paragraph->get('field_tile_publications')->referencedEntities() as $book) {
    if (!$book instanceof ParagraphInterface) {
      continue;
    }
    $cache->addCacheableDependency($book);
    $full = $text($book, 'field_pub_title');
    if (!$book->isPublished() || $full === '') {
      continue;
    }
    [$title, $subtitle] = array_pad(preg_split('/\s*:\s+/u', $full, 2), 2, '');

    $url = '';
    if ($book->hasField('field_pub_link') && !$book->get('field_pub_link')->isEmpty()) {
      $link = $book->get('field_pub_link')->first()->getUrl();
      $generated = $link->toString(TRUE);
      $cache->addCacheableDependency($generated);
      $url = $generated->getGeneratedUrl();
    }

    $image = NULL;
    if ($book->hasField('field_pub_cover') && !$book->get('field_pub_cover')->isEmpty()
      && ($item = _palefire_media_image_item($book->get('field_pub_cover')->first(), $cache))) {
      $image = _palefire_image_build($item, ['publication_cover'], $cache);
    }

    $pages = ($book->hasField('field_pub_pages') && !$book->get('field_pub_pages')->isEmpty())
      ? (int) $book->get('field_pub_pages')->value
      : 300;

    $books[] = [
      'title' => $title,
      'subtitle' => $subtitle,
      'author' => $text($book, 'field_pub_author'),
      'imprint' => $text($book, 'field_pub_imprint'),
      'url' => $url,
      'image' => $image,
      'depth' => round(min(0.3, max(0.06, ($pages * 0.06 + 3) / 152)), 3),
    ];
  }
  return $books;
}

/**
 * The FAQs for an Ask Special Collections section (Tile showcase, "ask").
 *
 * The Tiles picked in the section's Tiles field, in that order; with none
 * picked, the published Tiles in the FAQ category whose Subcategory says
 * "Special Collections" (the old site's FAQ tiles), by search weight then
 * title, at most eight. "Says", not "is": some imported Subcategories
 * carry stray spaces, and an exact match (LIKE) misses them all. The section's link (the index rule's) points at
 * the rest on AskUs.
 *
 * With no paragraph and no limit (a guide's "[special-collections-faqs]"
 * marker, palefire_preprocess_paragraph__guide_text()): every one of those
 * FAQs, in the same order.
 *
 * Each FAQ:
 * - question: the tile's title.
 * - answer: its Formatted text or Linked text (filtered, as a render
 *   array), else its Long summary as plain text, else ''.
 * - byline: who answered ("Answered by" off the end of the text), or ''.
 * The tile's Link (the same answer on AskUs) isn't offered: it only sent
 * readers away to read the same words again.
 */
function _palefire_ask_faqs(?ParagraphInterface $paragraph, array &$variables, ?int $limit = 8): array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $nodes = [];
  if ($paragraph && $paragraph->hasField('field_tiles')) {
    foreach ($paragraph->get('field_tiles') as $item) {
      if ($item->entity instanceof NodeInterface) {
        $nodes[] = $item->entity;
      }
    }
  }
  if (!$nodes) {
    // A new or edited Tile can change the list.
    $cache->addCacheTags(['node_list:tile']);
    $types = \Drupal::entityTypeManager();
    $terms = $types->getStorage('taxonomy_term')->loadByProperties(['name' => 'FAQ']);
    if ($terms) {
      $query = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'tile')
        ->condition('status', NodeInterface::PUBLISHED)
        ->condition('field_category', array_keys($terms), 'IN')
        ->condition('field_subcategory', 'Special Collections', 'CONTAINS')
        ->sort('field_tile_search_weight', 'DESC')
        ->sort('title');
      if ($limit) {
        $query->range(0, $limit);
      }
      $ids = $query->execute();
      $nodes = $types->getStorage('node')->loadMultiple($ids);
    }
  }

  $faqs = [];
  foreach ($nodes as $node) {
    $node = \Drupal::service('entity.repository')->getTranslationFromContext($node);
    $access = $node->access('view', NULL, TRUE);
    $cache->addCacheableDependency($node)->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $answer = '';
    $byline = '';
    foreach (['field_formatted_text', 'field_tile_linked_text'] as $name) {
      if ($node->hasField($name) && trim(strip_tags((string) $node->get($name)->value)) !== '') {
        [$text, $byline] = _palefire_ask_answer_tidy((string) $node->get($name)->value);
        $answer = [
          '#type' => 'processed_text',
          '#text' => $text,
          '#format' => $node->get($name)->format,
          '#post_render' => [[AskAnswer::class, 'links']],
        ];
        break;
      }
    }
    if (!$answer && $node->hasField('field_tile_long_summary')) {
      $answer = trim((string) $node->get('field_tile_long_summary')->value);
    }
    $faqs[] = [
      'question' => $node->label(),
      'answer' => $answer,
      'byline' => $byline,
    ];
  }
  $cache->applyTo($variables);
  return $faqs;
}

/**
 * Tidies an FAQ answer imported from AskUs for reading.
 *
 * The import flattened AskUs's paragraphs into one line (two spaces where
 * a paragraph ended), sometimes pasted the answer in twice, wrote links
 * with their URL as their text and ended with "Answered by: Name". So:
 * - the trailing "Answered by" comes off and is returned as the byline;
 * - a block (between blank lines) whose words repeat an earlier one's goes;
 * - text with no block markup of its own is split into paragraphs where a
 *   sentence ends before two or more spaces;
 * Answers written with their own paragraphs keep them. The links are
 * tidied after the text format's filters (AskAnswer::links()), since most
 * are bare URLs until the URL filter links them.
 *
 * @return array
 *   The answer's HTML, then the byline's name ('' without one).
 */
function _palefire_ask_answer_tidy(string $html): array {
  $byline = '';
  if (preg_match('~\s*(?:<p>)?\s*Answered by:\s*([^<\n]+?)\s*(?:</p>)?\s*$~iu', $html, $match)) {
    $byline = trim(Html::decodeEntities($match[1]));
    $html = substr($html, 0, -strlen($match[0]));
  }

  $seen = [];
  $blocks = [];
  foreach (preg_split('~\R\s*\R~u', trim($html)) as $block) {
    $words = mb_strtolower(preg_replace('~\s+~u', ' ', trim(strip_tags($block))));
    if ($words === '' || isset($seen[$words])) {
      continue;
    }
    $seen[$words] = TRUE;
    $blocks[] = trim($block);
  }
  $html = implode("\n\n", $blocks);

  if (!preg_match('~<(?:p|br|ul|ol|h[1-6]|table|div|blockquote)\b~i', $html)) {
    $paragraphs = [];
    foreach ($blocks as $block) {
      foreach (preg_split('~(?<=[.!?:)])\s{2,}(?=\S)~u', $block) as $paragraph) {
        // One space between words, and none before a full stop after a link.
        $paragraph = preg_replace(['~\s+~u', '~\)\s+([.,;])~u'], [' ', ')$1'], trim($paragraph));
        $paragraphs[] = '<p>' . $paragraph . '</p>';
      }
    }
    $html = implode("\n", $paragraphs);
  }

  return [$html, $byline];
}

/**
 * Implements hook_form_FORM_ID_alter() for libanswers_ask_form.
 *
 * The libanswers module's question form in the Ask section's markup
 * (templates/form/libanswers-ask-form.html.twig writes the labels and error
 * lines, so the controls lose their form-element wrappers). Each control
 * takes the section's class, text fields a blank placeholder (filled ones
 * show by :placeholder-shown, _ask.scss), and the button is a <button>
 * with the arrow (input--submit--libanswers.html.twig).
 */
function palefire_form_libanswers_ask_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#attributes']['class'][] = 'pf-inquiry__form';
  // Named as the panel's heading above it.
  $form['#attributes']['aria-label'] = t('Send us a question');
  foreach (['val1', 'val2', 'pname', 'pemail', 'pquestion', 'pdetails'] as $name) {
    if (!isset($form[$name])) {
      continue;
    }
    $form[$name]['#theme_wrappers'] = [];
    $form[$name]['#attributes']['class'][] = 'pf-inquiry__control';
    if ($form[$name]['#type'] !== 'select') {
      $form[$name]['#attributes']['placeholder'] = ' ';
    }
  }
  if (isset($form['actions']['submit'])) {
    // A submit button is drawn by its wrapper (input__submit), not #theme:
    // replace the wrapper, or the <input> is drawn around the <button>.
    $form['actions']['submit']['#theme_wrappers'] = ['input__submit__libanswers'];
    $form['actions']['submit']['#attributes']['class'][] = 'pf-inquiry__submit';
  }
}

/**
 * Builds a tile's cover in the landscape crops for a lead card.
 *
 * One srcset of tile_showcase_landscape_sm/_md/_lg (640, 960 and 1280 wide,
 * 16:10) with the given sizes, decorative and lazy as the other covers.
 * NULL when none of the styles exist (the caller keeps its own cover).
 */
function _palefire_lead_cover(FieldItemInterface $image, string $sizes, CacheableMetadata $cache): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  $srcset = [];
  foreach (['sm' => 640, 'md' => 960, 'lg' => 1280] as $size => $width) {
    if ($style = $storage->load('tile_showcase_landscape_' . $size)) {
      $cache->addCacheableDependency($style);
      $srcset[] = ['uri' => $style->buildUrl($file->getFileUri()), 'width' => $width . 'w'];
    }
  }
  if (!$srcset) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  return [
    '#theme' => 'image',
    '#uri' => end($srcset)['uri'],
    '#srcset' => $srcset,
    '#sizes' => $sizes,
    '#width' => 1280,
    '#height' => 800,
    '#alt' => '',
    '#attributes' => ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for field templates.
 *
 * Scroll sections (field_scroll_section): a section whose paragraph has an
 * Eyebrow (field_tile_eyebrow, on the Tile showcase) opens with an index
 * rule, as the hero's do, and its Lede under the heading
 * (field--node--field-scroll-section--modular-page.html.twig). Adds
 * item.section.index: num ('04'), label (the eyebrow), lede (plain text,
 * or ''), and link (url, text, external, from field_tile_link) or NULL.
 *
 * Numbered by position, so a section moved in the editor renumbers itself:
 * the landing hero's rules count first (as many as it shows,
 * _palefire_hero_rules()), then each section with an Eyebrow, in order.
 * The link's text drops a trailing arrow typed by hand: the rule draws
 * its own.
 */
function palefire_preprocess_field(array &$variables): void {
  if (($variables['field_name'] ?? '') !== 'field_scroll_section' || empty($variables['items'])) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $count = 0;
  foreach ($variables['items'] as &$item) {
    $paragraph = $item['content']['#paragraph'] ?? NULL;
    if (!$paragraph instanceof ParagraphInterface) {
      continue;
    }
    if ($paragraph->bundle() === 'landing_hero') {
      $count += count(_palefire_hero_rules($paragraph));
      continue;
    }
    if (!is_array($item['section'] ?? NULL)
      || !$paragraph->hasField('field_tile_eyebrow') || $paragraph->get('field_tile_eyebrow')->isEmpty()) {
      continue;
    }
    $cache->addCacheableDependency($paragraph);
    $link = NULL;
    if ($paragraph->hasField('field_tile_link') && !$paragraph->get('field_tile_link')->isEmpty()) {
      $link_item = $paragraph->get('field_tile_link')->first();
      $url = $link_item->getUrl();
      $generated = $url->toString(TRUE);
      $cache->addCacheableDependency($generated);
      $text = trim(preg_replace('/[\s\x{2192}]+$/u', '', (string) $link_item->title));
      $link = [
        'url' => $generated->getGeneratedUrl(),
        'text' => $text !== '' ? $text : t('See all'),
        'external' => $url->isExternal(),
      ];
    }
    $lede = $paragraph->hasField('field_tile_lede') ? trim((string) $paragraph->get('field_tile_lede')->value) : '';
    $item['section']['index'] = [
      'num' => sprintf('%02d', ++$count),
      'label' => $paragraph->get('field_tile_eyebrow')->value,
      'lede' => $lede,
      'link' => $link,
    ];
  }
  unset($item);
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-stacks.
 *
 * From the stacks (scripts/palefire_landing_stacks_setup.php): one featured
 * item beside the next events and the newest blog posts.
 * - feature: the first Featured item (field_tiles, a Tile or a Modular
 *   page, read by _palefire_node_card()) the visitor can see, or NULL:
 *   title, url, label, note, and image (its cover in the portrait
 *   responsive style, decorative and lazy) or NULL.
 * - events: for js/upcoming.js, or NULL without a calendar: calendar and
 *   campus (field_stacks_calendar, field_stacks_campus; digits only),
 *   endpoint (the events carousel's feed) and calendar_url (LibCal's
 *   calendar for that campus, the carousel's own "full calendar" link).
 * - posts: the newest three articles in its Blog categories
 *   (_palefire_blog_posts()).
 */
function palefire_preprocess_paragraph__landing_stacks(array &$variables): void {
  $variables['feature'] = NULL;
  $variables['events'] = NULL;
  $variables['posts'] = [];
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);

  if ($paragraph->hasField('field_tiles')) {
    foreach ($paragraph->get('field_tiles') as $item) {
      $node = $item->entity;
      $card = $node instanceof NodeInterface ? _palefire_node_card($node, $cache, 220) : NULL;
      if (!$card) {
        continue;
      }
      $card['image'] = $card['image_item'] ? _palefire_responsive_cover($card['image_item'], 'tile_showcase_portrait', $cache) : NULL;
      unset($card['image_item']);
      $variables['feature'] = $card;
      break;
    }
  }

  $value = static fn (string $field): string => ($paragraph->hasField($field) && !$paragraph->get($field)->isEmpty())
    ? trim((string) $paragraph->get($field)->value)
    : '';
  $calendar = $value('field_stacks_calendar');
  $campus = $value('field_stacks_campus');
  if (preg_match('/^\d+$/', $calendar)) {
    $campus = preg_match('/^\d+$/', $campus) ? $campus : '';
    $variables['events'] = [
      'calendar' => $calendar,
      'campus' => $campus,
      'endpoint' => '/libcal-gantt/carousel-events',
      'calendar_url' => 'https://lsu.libcal.com/calendar/eventsandprogramming?cid=-1&t=m&d=0000-00-00&cal=-1&inc=0' . ($campus !== '' ? '&cm=' . $campus : ''),
    ];
    $variables['#attached']['library'][] = 'palefire/upcoming';
  }

  // Each post's picture for the stage (the section's large picture, which
  // shows the item under the pointer), in the feature's portrait style.
  foreach (_palefire_blog_posts($paragraph, 3, $cache) as $post) {
    $post['image'] = $post['image_item'] ? _palefire_responsive_cover($post['image_item'], 'tile_showcase_portrait', $cache) : NULL;
    unset($post['image_item']);
    $variables['posts'][] = $post;
  }
  $cache->applyTo($variables);
}

/**
 * A card's cover image as a decorative (alt="") lazy image.
 *
 * Uses the responsive image style when it exists, then its middle image
 * style ("<style>_md") on its own, then the original file, so the card never
 * breaks if the setup script hasn't run yet or Responsive Image is off.
 */
function _palefire_responsive_cover(FieldItemInterface $image, string $style, CacheableMetadata $cache): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $attributes = ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'];
  $build = [
    '#uri' => $file->getFileUri(),
    '#width' => $image->width,
    '#height' => $image->height,
    '#attributes' => $attributes,
  ];

  $types = \Drupal::entityTypeManager();
  if (\Drupal::moduleHandler()->moduleExists('responsive_image')
    && ($responsive = $types->getStorage('responsive_image_style')->load($style))) {
    $cache->addCacheableDependency($responsive);
    return $build + ['#theme' => 'responsive_image', '#responsive_image_style_id' => $style];
  }
  if ($image_style = $types->getStorage('image_style')->load($style . '_md')) {
    $cache->addCacheableDependency($image_style);
    return $build + ['#theme' => 'image_style', '#style_name' => $image_style->id(), '#alt' => ''];
  }
  return $build + ['#theme' => 'image', '#alt' => ''];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--guide-video.
 *
 * video: url (the video's page), embed (privacy-enhanced YouTube or Vimeo
 * player URL, '' for other providers), title, and the media item's local
 * thumbnail (thumb, thumb_width, thumb_height) when it has one.
 */
function palefire_preprocess_paragraph__guide_video(array &$variables): void {
  $variables['video'] = NULL;
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_video')) {
    return;
  }
  $media = $paragraph->get('field_video')->entity;
  if (!$media instanceof MediaInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($media);
  $access = $media->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->applyTo($variables);
  if (!$access->isAllowed()) {
    return;
  }

  $url = trim((string) $media->getSource()->getSourceFieldValue($media));
  if (!preg_match('#^https?://#i', $url)) {
    return;
  }
  $embed = '';
  if (preg_match('#(?:youtube\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/|live/)|youtu\.be/)([\w-]{11})#i', $url, $m)) {
    $embed = 'https://www.youtube-nocookie.com/embed/' . $m[1] . '?autoplay=1&rel=0';
  }
  elseif (preg_match('#vimeo\.com/(?:video/)?(\d+)#i', $url, $m)) {
    $embed = 'https://player.vimeo.com/video/' . $m[1] . '?autoplay=1&dnt=1';
  }

  $thumb = '';
  $width = $height = NULL;
  $file = $media->get('thumbnail')->entity ?? NULL;
  if ($file) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('large');
    $uri = $file->getFileUri();
    $thumb = $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri);
    $item = $media->get('thumbnail')->first();
    if ($item && $item->width && $item->height) {
      $width = (int) $item->width;
      $height = (int) $item->height;
      if ($style) {
        $dimensions = ['width' => $width, 'height' => $height];
        $style->transformDimensions($dimensions, $uri);
        [$width, $height] = [$dimensions['width'], $dimensions['height']];
      }
    }
  }

  $variables['video'] = [
    'url' => $url,
    'embed' => $embed,
    'title' => $media->label(),
    'thumb' => $thumb,
    'thumb_width' => $width,
    'thumb_height' => $height,
  ];
}

/* ---------------------------------------------------------------------------
 * Louisiana Newspapers guide (scripts/palefire_louisiana_newspapers_setup.php)
 * ------------------------------------------------------------------------- */

/**
 * Louisiana's 64 parishes: key => name, as the LibGuide spells them.
 *
 * The keys are parish_entry's field_parish values and the data-parish keys
 * of includes/louisiana-parishes.svg.twig.
 */
const PALEFIRE_LA_PARISHES = [
  'acadia' => 'Acadia',
  'allen' => 'Allen',
  'ascension' => 'Ascension',
  'assumption' => 'Assumption',
  'avoyelles' => 'Avoyelles',
  'beauregard' => 'Beauregard',
  'bienville' => 'Bienville',
  'bossier' => 'Bossier',
  'caddo' => 'Caddo',
  'calcasieu' => 'Calcasieu',
  'caldwell' => 'Caldwell',
  'cameron' => 'Cameron',
  'catahoula' => 'Catahoula',
  'claiborne' => 'Claiborne',
  'concordia' => 'Concordia',
  'de_soto' => 'De Soto',
  'east_baton_rouge' => 'East Baton Rouge',
  'east_carroll' => 'East Carroll',
  'east_feliciana' => 'East Feliciana',
  'evangeline' => 'Evangeline',
  'franklin' => 'Franklin',
  'grant' => 'Grant',
  'iberia' => 'Iberia',
  'iberville' => 'Iberville',
  'jackson' => 'Jackson',
  'jefferson' => 'Jefferson',
  'jefferson_davis' => 'Jefferson Davis',
  'lafayette' => 'Lafayette',
  'lafourche' => 'Lafourche',
  'la_salle' => 'La Salle',
  'lincoln' => 'Lincoln',
  'livingston' => 'Livingston',
  'madison' => 'Madison',
  'morehouse' => 'Morehouse',
  'natchitoches' => 'Natchitoches',
  'orleans' => 'Orleans',
  'ouachita' => 'Ouachita',
  'plaquemines' => 'Plaquemines',
  'pointe_coupee' => 'Pointe Coupee',
  'rapides' => 'Rapides',
  'red_river' => 'Red River',
  'richland' => 'Richland',
  'sabine' => 'Sabine',
  'st_bernard' => 'St. Bernard',
  'st_charles' => 'St. Charles',
  'st_helena' => 'St. Helena',
  'st_james' => 'St. James',
  'st_john_the_baptist' => 'St. John the Baptist',
  'st_landry' => 'St. Landry',
  'st_martin' => 'St. Martin',
  'st_mary' => 'St. Mary',
  'st_tammany' => 'St. Tammany',
  'tangipahoa' => 'Tangipahoa',
  'tensas' => 'Tensas',
  'terrebonne' => 'Terrebonne',
  'union' => 'Union',
  'vermilion' => 'Vermilion',
  'vernon' => 'Vernon',
  'washington' => 'Washington',
  'webster' => 'Webster',
  'west_baton_rouge' => 'West Baton Rouge',
  'west_carroll' => 'West Carroll',
  'west_feliciana' => 'West Feliciana',
  'winn' => 'Winn',
];

/**
 * The newspaper family trees, read live from the site's own records.
 *
 * The records behind lib.lsu.edu/louisiananewspapers: any published entity
 * whose bundle has field_louisiana_parish and field_record_url (title, tree
 * link, parish, field_louisiana_city). Found through the field map, so the
 * theme doesn't need to know the content type's machine name. Their list
 * cache tags go on $cache, so a new or changed record shows at once.
 *
 * Read with one database query, not by loading the records: loading all
 * 637 as entities on an uncached render ran the guide out of memory (a
 * blank 500, 2026-10-21). Anything unexpected (another storage, a renamed
 * table) is logged and gives no trees rather than a broken page.
 *
 * Returns rows sorted by title: title, url, parish (a PALEFIRE_LA_PARISHES
 * key, '' when the record's parish isn't one), city.
 */
function _palefire_newspaper_trees(CacheableMetadata $cache): array {
  $rows = &drupal_static(__FUNCTION__);
  $tags = &drupal_static(__FUNCTION__ . ':tags', []);
  if ($rows !== NULL) {
    $cache->addCacheTags($tags);
    return $rows;
  }
  $rows = [];
  try {
    $rows = _palefire_newspaper_trees_query($tags);
  }
  catch (\Throwable $e) {
    \Drupal::logger('palefire')->error('Louisiana Newspapers guide: could not read the family trees: @message', ['@message' => $e->getMessage()]);
  }
  usort($rows, static fn (array $a, array $b): int => strnatcasecmp($a['title'], $b['title']));
  $cache->addCacheTags($tags);
  return $rows;
}

/**
 * The family-tree rows, straight from the records' tables.
 *
 * For _palefire_newspaper_trees(). Adds each record type's list cache tags
 * to $tags.
 */
function _palefire_newspaper_trees_query(array &$tags): array {
  $rows = [];
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_manager = \Drupal::service('entity_field.manager');
  $database = \Drupal::database();
  // The records' keys shorten East/West ("e_baton_rouge"); compare them
  // without separators against the parish keys.
  $parishes = [];
  foreach (array_keys(PALEFIRE_LA_PARISHES) as $key) {
    $parishes[str_replace('_', '', $key)] = $key;
  }
  foreach ($field_manager->getFieldMap() as $entity_type_id => $fields) {
    if (!isset($fields['field_louisiana_parish'], $fields['field_record_url'])) {
      continue;
    }
    $bundles = array_values(array_intersect($fields['field_louisiana_parish']['bundles'], $fields['field_record_url']['bundles']));
    $type = $entity_type_manager->getDefinition($entity_type_id);
    $storage = $entity_type_manager->getStorage($entity_type_id);
    if (!$bundles || !$type->hasKey('label') || !$storage instanceof SqlEntityStorageInterface) {
      continue;
    }
    $tags = array_merge($tags, $type->getListCacheTags());
    $definitions = $field_manager->getFieldStorageDefinitions($entity_type_id);
    $mapping = $storage->getTableMapping();
    $table = $type->getDataTable() ?: $type->getBaseTable();
    $id = $type->getKey('id');

    $query = $database->select($table, 'e');
    $query->addField('e', $type->getKey('label'), 'title');
    if ($type->hasKey('bundle')) {
      $query->condition('e.' . $type->getKey('bundle'), $bundles, 'IN');
    }
    if ($type->hasKey('published')) {
      $query->condition('e.' . $type->getKey('published'), 1);
    }
    if ($type->getDataTable() && $type->hasKey('default_langcode')) {
      $query->condition('e.' . $type->getKey('default_langcode'), 1);
    }
    // One field value per record: delta 0 of the record's own language.
    $join = function (string $field, string $property, string $alias, bool $required) use ($query, $mapping, $definitions, $id, $type): ?string {
      $definition = $definitions[$field] ?? NULL;
      if (!$definition) {
        return NULL;
      }
      $on = "$alias.entity_id = e.$id AND $alias.deleted = 0 AND $alias.delta = 0";
      if ($type->hasKey('langcode')) {
        $on .= " AND $alias.langcode = e." . $type->getKey('langcode');
      }
      $required ? $query->join($mapping->getFieldTableName($field), $alias, $on) : $query->leftJoin($mapping->getFieldTableName($field), $alias, $on);
      return $query->addField($alias, $mapping->getFieldColumnName($definition, $property), $alias);
    };
    $link = ($definitions['field_record_url'] ?? NULL)?->getType() === 'link';
    $join('field_record_url', $link ? 'uri' : 'value', 'url', TRUE);
    $join('field_louisiana_parish', 'value', 'parish', TRUE);
    $city_column = $join('field_louisiana_city', 'value', 'city', FALSE);
    // A list field stores a key ("baton_rouge"); show its label.
    $cities = $city_column ? ($definitions['field_louisiana_city']->getSetting('allowed_values') ?: []) : [];

    foreach ($query->execute() as $record) {
      $url = trim((string) $record->url);
      if ($url === '') {
        continue;
      }
      if ($link) {
        try {
          $url = Url::fromUri($url)->toString();
        }
        catch (\Throwable $e) {
          $url = preg_replace('/^internal:/', '', $url);
        }
      }
      $parish = preg_replace(['/^e_/', '/^w_/'], ['east_', 'west_'], (string) $record->parish);
      $city = $city_column ? (string) $record->city : '';
      $rows[] = [
        'title' => (string) $record->title,
        'url' => $url,
        'parish' => $parishes[str_replace('_', '', $parish)] ?? '',
        'city' => is_scalar($cities[$city] ?? NULL) ? (string) $cities[$city] : $city,
      ];
    }
  }
  return $rows;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--parish-map.
 *
 * Builds `parishes` for the template: one entry per parish, in
 * PALEFIRE_LA_PARISHES order, with its name, its Parish item's three texts
 * (digital, websites, microfilm: processed_text render arrays or NULL), its
 * family trees (_palefire_newspaper_trees()), a count for each list and
 * `open`, the groups that start open (25 entries or fewer).
 */
function palefire_preprocess_paragraph__parish_map(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  // The family trees' icon, once, for each tree link to <use>.
  $variables['tree_icon'] = _palefire_fa_symbol('duotone', 'project-diagram', 'pf-icon-tree-map');
  $text = static fn (ParagraphInterface $entry, string $field): ?array => $entry->hasField($field) && trim(strip_tags((string) $entry->get($field)->value)) !== '' ? [
    '#type' => 'processed_text',
    '#text' => $entry->get($field)->value,
    '#format' => $entry->get($field)->format,
  ] : NULL;

  $entries = [];
  if ($paragraph->hasField('field_parish_entries')) {
    foreach ($paragraph->get('field_parish_entries') as $item) {
      $entry = $item->entity;
      if ($entry instanceof ParagraphInterface && $entry->isPublished()) {
        $cache->addCacheableDependency($entry);
        $entries[(string) $entry->get('field_parish')->value] = $entry;
      }
    }
  }
  $trees = [];
  foreach (_palefire_newspaper_trees($cache) as $row) {
    $trees[$row['parish']][] = $row;
  }

  $parishes = [];
  foreach (PALEFIRE_LA_PARISHES as $key => $name) {
    $entry = $entries[$key] ?? NULL;
    $parish = [
      'key' => $key,
      'name' => $name,
      'id' => 'parish-' . Html::cleanCssIdentifier($key),
      'trees' => $trees[$key] ?? [],
    ];
    foreach (['digital', 'websites', 'microfilm'] as $group) {
      $parish[$group] = $entry ? $text($entry, 'field_parish_' . $group) : NULL;
      $parish['count'][$group] = $parish[$group] ? substr_count(strtolower((string) $parish[$group]['#text']), '<li') : 0;
    }
    $parish['count']['trees'] = count($parish['trees']);
    $parish['open'] = array_keys(array_filter($parish['count'], static fn (int $n): bool => $n > 0 && $n <= 25));
    $parishes[$key] = $parish;
  }

  $cache->applyTo($variables);
  $variables['uid'] = 'pf-parishes-' . $paragraph->id();
  $variables['parishes'] = $parishes;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--family-trees.
 *
 * trees: every family tree (_palefire_newspaper_trees()), each with its
 * parish's name; parishes: key => name of the parishes that have one, for
 * the filter.
 */
function palefire_preprocess_paragraph__family_trees(array &$variables): void {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  // The family trees' icon, once, for each row to <use>.
  $variables['tree_icon'] = _palefire_fa_symbol('duotone', 'project-diagram', 'pf-icon-tree-list');
  $trees = [];
  $parishes = [];
  foreach (_palefire_newspaper_trees($cache) as $row) {
    $row['parish_name'] = PALEFIRE_LA_PARISHES[$row['parish']] ?? '';
    if ($row['parish'] !== '') {
      $parishes[$row['parish']] = $row['parish_name'];
    }
    $trees[] = $row;
  }
  $cache->applyTo($variables);
  $variables['uid'] = 'pf-trees-' . $variables['paragraph']->id();
  $variables['trees'] = $trees;
  $variables['parishes'] = array_intersect_key(PALEFIRE_LA_PARISHES, $parishes);
}

/**
 * Implements hook_preprocess_node().
 *
 * Resources in the guide_item view mode get `resource`: title, url, icon,
 * labels, citation, desc (node--resource--guide-item.html.twig).
 */
function palefire_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'resource' || ($variables['view_mode'] ?? '') !== 'guide_item') {
    return;
  }
  $value = fn (string $field): string => $node->hasField($field) && !$node->get($field)->isEmpty() ? trim((string) $node->get($field)->value) : '';

  $url = '';
  if ($node->hasField('field_resource_link') && !$node->get('field_resource_link')->isEmpty()) {
    $url = $node->get('field_resource_link')->first()->getUrl()->toString();
  }
  $labels = [];
  if ($node->hasField('field_resource_labels')) {
    foreach ($node->get('field_resource_labels') as $item) {
      if (trim((string) $item->value) !== '') {
        $labels[] = trim((string) $item->value);
      }
    }
  }
  $proxy = $node->hasField('field_resource_proxy') && (bool) $node->get('field_resource_proxy')->value;
  if ($proxy && $url !== '') {
    if (!str_starts_with($url, PALEFIRE_PROXY_PREFIX) && !str_contains((string) parse_url($url, PHP_URL_HOST), 'libezp.')) {
      $url = PALEFIRE_PROXY_PREFIX . $url;
    }
    array_unshift($labels, (string) t('LSU login'));
  }

  $type = $value('field_resource_type');
  $variables['resource'] = [
    'title' => $node->label(),
    'url' => $url ?: $node->toUrl()->toString(),
    'icon' => PALEFIRE_RESOURCE_ICONS[$type] ?? 'globe2',
    'labels' => array_slice(array_unique($labels), 0, 4),
    'citation' => $value('field_resource_citation'),
    'desc' => $value('field_resource_desc'),
  ];
}

/**
 * One image as plain values for an exhibition <img> (templates print it).
 *
 * The exhibit_640/_1280/_1920/_2560 styles (palefire_exhibit_setup.php) as
 * a srcset, so a 4K original is never sent: src is the 1280 version, full
 * (the lightbox) the largest. Styles that are missing are skipped; with
 * none, the original file. Width and height are always set (no layout
 * shift); alt comes from the image item.
 *
 * @param string $sizes
 *   The <img sizes> value.
 * @param bool $eager
 *   TRUE for the first image on screen (the exhibition's title page).
 *
 * @return array{src: string, srcset: string, sizes: string, width: ?int, height: ?int, alt: string, full: string, loading: string}|null
 */
function _palefire_exhibit_image(FieldItemInterface $image, string $sizes, CacheableMetadata $cache, bool $eager = FALSE): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $uri = $file->getFileUri();
  $width = $image->width ? (int) $image->width : NULL;
  $height = $image->height ? (int) $image->height : NULL;
  $original = \Drupal::service('file_url_generator')->generateString($uri);

  $candidates = [];
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  foreach ([640, 1280, 1920, 2560] as $step) {
    $style = $storage->load('exhibit_' . $step);
    if (!$style) {
      continue;
    }
    $cache->addCacheableDependency($style);
    $dimensions = ['width' => $width, 'height' => $height];
    $style->transformDimensions($dimensions, $uri);
    $w = (int) ($dimensions['width'] ?? $step);
    // An original narrower than the step gives the same image again.
    if ($candidates && $w <= array_key_last($candidates)) {
      continue;
    }
    $candidates[$w] = \Drupal::service('file_url_generator')->transformRelative($style->buildUrl($uri));
  }

  $srcset = implode(', ', array_map(fn ($w, $url) => "$url {$w}w", array_keys($candidates), $candidates));
  $src = $candidates ? ($candidates[array_keys($candidates)[min(1, count($candidates) - 1)]]) : $original;
  return [
    'src' => $src,
    'srcset' => $srcset,
    'sizes' => $sizes,
    'width' => $width,
    'height' => $height,
    'alt' => (string) ($image->alt ?? ''),
    'full' => $candidates ? end($candidates) : $original,
    'loading' => $eager ? 'eager' : 'lazy',
    'focus' => _palefire_focal_point($file, $width, $height, $cache),
  ];
}

/**
 * A Font Awesome Pro icon as an inline <symbol>, for <use href="#$id">.
 *
 * Read from the server's /libraries/fontawesome-pro (licensed, so never in
 * this repository). One copy per template, however many links use it,
 * instead of the whole SVG in each. The paths take the text color (the
 * <use> sets fill: currentColor); a duotone icon's lighter layer keeps its
 * 40%. NULL when the file isn't there: the templates then print no icon.
 */
function _palefire_fa_symbol(string $style, string $name, string $id): ?Markup {
  $file = DRUPAL_ROOT . '/libraries/fontawesome-pro/svgs/' . $style . '/' . $name . '.svg';
  $svg = is_readable($file) ? (string) file_get_contents($file) : '';
  if (!preg_match('#viewBox="([\d. ]+)"#', $svg, $box) || !preg_match_all('#<path [^>]*/>#', $svg, $paths)) {
    return NULL;
  }
  $paths = str_replace(['class="fa-secondary"', ' class="fa-primary"'], ['opacity=".4"', ''], implode('', $paths[0]));
  return Markup::create('<svg class="visually-hidden" aria-hidden="true" focusable="false"><symbol id="' . $id . '" viewBox="' . $box[1] . '">' . $paths . '</symbol></svg>');
}

/**
 * The image's focal point as an object-position ("62.5% 30%"), or ''.
 *
 * Set by editors on the Media image's edit form (Focal Point module), it
 * keeps that spot in view wherever a cropped cover shows the image, at any
 * screen shape: the templates set it as the <img>'s object-position rather
 * than using Focal Point's fixed-crop image styles. '' when the module is
 * off, the image has no point yet, or its size is unknown.
 */
function _palefire_focal_point(FileInterface $file, ?int $width, ?int $height, CacheableMetadata $cache): string {
  if (!$width || !$height || !\Drupal::moduleHandler()->moduleExists('focal_point')) {
    return '';
  }
  $type = \Drupal::config('focal_point.settings')->get('crop_type') ?: 'focal_point';
  $cache->addCacheTags(['config:focal_point.settings']);
  // getCropEntity() makes an unsaved crop when there is none: no point yet.
  $crop = \Drupal::service('focal_point.manager')->getCropEntity($file, $type);
  if (!$crop || $crop->isNew()) {
    return '';
  }
  $cache->addCacheableDependency($crop);
  $position = $crop->position();
  $x = max(0, min(100, round($position['x'] / $width * 100, 1)));
  $y = max(0, min(100, round($position['y'] / $height * 100, 1)));
  return $x . '% ' . $y . '%';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-page.
 *
 * lead: the gallery's lead image (decorative), or NULL.
 * focus: where a cropped lead stays in view (object-position keyword).
 * lead_x: the pan's horizontal position (Left / Right keep that side).
 * lead_whole: "Show whole image": uncropped and centred, not a band.
 * lead_mirror: "Mirror lead image": flipped left to right on the page
 * (.pf-exhibit-mirror), never in the lightbox.
 * lead_caption: field_exhibit_lead_caption rendered, or NULL. With one, the
 * lead is content (alt text, lightbox, caption); without, decorative.
 * Rendered here rather than through Manage display, so galleries made
 * before the field existed show it too.
 * opener: "cover" (default, with a lead), "full" (the pinned and panned
 * opening; the default without a lead) or "compact".
 * wall: the wall's tiles (_palefire_exhibit_wall()) when Display is "wall",
 * else NULL.
 * wall_lead, wall_lead_caption: the lead of a wall or a cover opening,
 * shown full screen and fixed, with the title, the entry links or a wall's
 * facts, and the opening text over its lower left (_exhibition.scss); lead
 * and lead_caption are then NULL.
 * entries, entries_more: the full and cover openings' links to the
 * gallery's entries, ['anchor', 'title'] each, the first six and the rest
 * (none on a wall).
 * dom_id: base for the caption's and the text's ids (the hero's
 * aria-labelledby and the opening's "Skip to the text" link).
 */
function palefire_preprocess_paragraph__exhibit_page(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $variables['lead'] = NULL;
  if ($paragraph->hasField('field_exhibit_lead') && !$paragraph->get('field_exhibit_lead')->isEmpty()) {
    $item = _palefire_media_image_item($paragraph->get('field_exhibit_lead')->first(), $cache);
    $variables['lead'] = $item ? _palefire_exhibit_image($item, '100vw', $cache) : NULL;
  }
  $focus = $paragraph->hasField('field_exhibit_lead_focus') ? (string) $paragraph->get('field_exhibit_lead_focus')->value : '';
  $variables['focus'] = in_array($focus, ['top', 'bottom', 'left', 'right'], TRUE) ? $focus : 'center';
  $variables['lead_x'] = ['left' => '0%', 'right' => '100%'][$variables['focus']] ?? '50%';
  // The image's focal point, when an editor has set one, is more precise
  // than "Keep in view when cropped" and takes its place.
  if (!empty($variables['lead']['focus'])) {
    $variables['focus'] = $variables['lead']['focus'];
    $variables['lead_x'] = explode(' ', $variables['focus'])[0];
  }
  $variables['lead_whole'] = $paragraph->hasField('field_exhibit_lead_whole') && (bool) $paragraph->get('field_exhibit_lead_whole')->value;
  $variables['lead_mirror'] = $paragraph->hasField('field_exhibit_lead_mirror') && (bool) $paragraph->get('field_exhibit_lead_mirror')->value;
  $variables['lead_caption'] = NULL;
  if ($variables['lead'] && $paragraph->hasField('field_exhibit_lead_caption') && trim(strip_tags((string) $paragraph->get('field_exhibit_lead_caption')->value)) !== '') {
    $variables['lead_caption'] = $paragraph->get('field_exhibit_lead_caption')->view(['label' => 'hidden', 'type' => 'text_default']);
  }
  // Opening: "cover" (stored as "full", also when empty, for galleries
  // made before the field), "full" (stored as "pan") or "compact" (the
  // band above, as before).
  $opener = $paragraph->hasField('field_exhibit_opener') ? (string) $paragraph->get('field_exhibit_opener')->value : '';
  $variables['opener'] = match ($opener) {
    'compact' => 'compact',
    'pan' => 'full',
    default => $variables['lead'] ? 'cover' : 'full',
  };
  if ($variables['lead'] && $variables['lead_whole'] && $variables['opener'] === 'compact') {
    // Centred at its own width, never wider than the column.
    $variables['lead']['sizes'] = '(min-width: 62rem) 60vw, 100vw';
  }

  // Display: "story" (default, also when empty) or "wall".
  $display = $paragraph->hasField('field_exhibit_display') ? (string) $paragraph->get('field_exhibit_display')->value : '';
  $variables['wall'] = $display === 'wall' ? _palefire_exhibit_wall($paragraph, $cache) : NULL;
  $variables['wall_lead'] = NULL;
  $variables['wall_lead_caption'] = NULL;
  if ($variables['wall'] || $variables['opener'] === 'cover') {
    // A wall, or a story with the cover opening, opens on its lead full
    // screen with its title and opening text over it (_exhibition.scss). A
    // wall ignores the Opening (kept in the field, for a return to
    // "story").
    $variables['wall_lead'] = $variables['lead'];
    $variables['wall_lead_caption'] = $variables['lead_caption'];
    if ($variables['wall_lead']) {
      $variables['wall_lead']['sizes'] = '100vw';
    }
    $variables['lead'] = NULL;
    $variables['lead_caption'] = NULL;
    $variables['opener'] = $variables['wall'] ? 'compact' : 'cover';
  }

  // The full and cover openings' "In this gallery" links: the gallery's
  // entries, in order, with the ids their headings get
  // (paragraph--exhibit-entry). The first six show; the rest sit behind
  // "Show more". A wall is its own index.
  $variables['entries'] = [];
  $variables['entries_more'] = [];
  if (in_array($variables['opener'], ['full', 'cover'], TRUE) && !$variables['wall'] && $paragraph->hasField('field_guide_blocks')) {
    foreach ($paragraph->get('field_guide_blocks')->referencedEntities() as $block) {
      if ($block->bundle() === 'exhibit_entry' && $block->isPublished()) {
        $variables['entries'][] = [
          'anchor' => _palefire_exhibit_entry_anchor($block),
          'title' => trim((string) $block->get('field_block_title')->value),
        ];
      }
    }
    $variables['entries_more'] = array_slice($variables['entries'], 6);
    $variables['entries'] = array_slice($variables['entries'], 0, 6);
  }
  $variables['dom_id'] = 'gallery-' . $paragraph->id();
  $cache->applyTo($variables);
}

/**
 * A wall gallery's tiles: one per published entry with an image.
 *
 * Each tile is the entry's first image, or its first two when they share an
 * image group (a drawing and its proof, compared in the object view). A
 * group of three or more is a manuscript's pages, turned in the object
 * view: its first two show (the second on hover), tagged "4 pages".
 *
 * @return array{tiles: array, sortable: bool, sheets: array}|null
 *   tiles: ['anchor', 'title', 'plate' (from "plate 40" in the caption, or
 *   NULL), 'tag' (the two figures' captions, "Drawing · Proof", or an
 *   audio clip's speaker, or "4 pages"), 'audio' (the entry has a clip),
 *   'pages' (a manuscript's page count, or 0), 'ratio',
 *   'images' (_palefire_exhibit_image() values)]. sortable: two or more
 *   tiles have a plate number. sheets: this page's sheet sizes, ['label',
 *   'h', 'w', 'current'] each, when this gallery has one. stats: the
 *   opening's facts ("22 entries" or "7 clips", "Plates 2–154", "11
 *   drawing–proof pairs", "Sheet 40 × 27 in").
 */
function _palefire_exhibit_wall(ParagraphInterface $page, CacheableMetadata $cache): ?array {
  if (!$page->hasField('field_guide_blocks')) {
    return NULL;
  }
  $sizes = '(min-width: 62rem) 24vw, (min-width: 36rem) 45vw, 90vw';
  $text = fn ($field) => trim(preg_replace('/\s+/', ' ', strip_tags((string) $field->value)));
  $tiles = [];
  foreach ($page->get('field_guide_blocks')->referencedEntities() as $entry) {
    if ($entry->bundle() !== 'exhibit_entry' || !$entry->isPublished()) {
      continue;
    }
    // The entry's first image block: a figure, or an image group's figures.
    // Its first audio clip's speaker (the credit before ", interviewed")
    // labels an oral history tile.
    $figures = [];
    $caption = '';
    $speaker = NULL;
    $pages = 0;
    foreach ($entry->get('field_guide_blocks')->referencedEntities() as $block) {
      if ($speaker === NULL && $block->bundle() === 'exhibit_audio' && $block->isPublished()) {
        $speaker = trim((string) preg_replace('/,?\s*interviewed\b.*$/i', '', (string) $block->get('field_audio_credit')->value));
      }
    }
    foreach ($entry->get('field_guide_blocks')->referencedEntities() as $block) {
      if ($block->bundle() === 'exhibit_figure' && !$block->get('field_figure_image')->isEmpty()) {
        $figures = [$block];
        $caption = $text($block->get('field_figure_caption'));
        break;
      }
      if ($block->bundle() === 'exhibit_gallery') {
        $figures = array_values(array_filter($block->get('field_gallery_items')->referencedEntities(), fn ($f) => !$f->get('field_figure_image')->isEmpty()));
        $pages = count($figures) > 2 ? count($figures) : 0;
        $figures = array_slice($figures, 0, 2);
        $caption = $text($block->get('field_figure_caption')) ?: ($figures ? $text($figures[0]->get('field_figure_caption')) : '');
        if ($figures) {
          break;
        }
      }
    }
    $images = [];
    foreach ($figures as $figure) {
      $item = _palefire_media_image_item($figure->get('field_figure_image')->first(), $cache);
      $image = $item ? _palefire_exhibit_image($item, $sizes, $cache) : NULL;
      if ($image) {
        $images[] = $image;
      }
    }
    if (!$images) {
      continue;
    }
    $tags = count($figures) === 2 ? array_filter(array_map(fn ($f) => $text($f->get('field_figure_caption')), $figures)) : [];
    $first = $images[0];
    $tiles[] = [
      'anchor' => _palefire_exhibit_entry_anchor($entry),
      'title' => trim((string) $entry->get('field_block_title')->value),
      'plate' => preg_match('/\bplate\s+(\d+)/i', $caption, $m) ? (int) $m[1] : NULL,
      'tag' => $pages ? (string) \Drupal::translation()->formatPlural($pages, '1 page', '@count pages') : (count($tags) === 2 ? implode(' · ', $tags) : (string) $speaker),
      'audio' => $speaker !== NULL,
      'pages' => $pages,
      'ratio' => $first['width'] && $first['height'] ? round($first['width'] / $first['height'], 4) : 1,
      'images' => $images,
    ];
  }
  if (!$tiles) {
    return NULL;
  }

  // "Actual size": every wall gallery's sheet on this page, to scale.
  $sheets = [];
  $own = $page->hasField('field_exhibit_sheet') ? (string) $page->get('field_exhibit_sheet')->value : '';
  $node = $page->getParentEntity();
  if (preg_match('/^\s*([\d.]+)\s*[×x]\s*([\d.]+)/u', $own) && $node && $node->hasField('field_scroll_section')) {
    $cache->addCacheableDependency($node);
    foreach ($node->get('field_scroll_section')->referencedEntities() as $sibling) {
      $size = $sibling->hasField('field_exhibit_sheet') ? (string) $sibling->get('field_exhibit_sheet')->value : '';
      if (preg_match('/^\s*([\d.]+)\s*[×x]\s*([\d.]+)/u', $size, $m)) {
        $sheets[] = [
          'label' => $sibling->hasField('field_section_title') ? trim((string) $sibling->get('field_section_title')->value) : '',
          'size' => trim($size),
          'h' => (float) $m[1],
          'w' => (float) $m[2],
          'current' => $sibling->id() === $page->id(),
        ];
      }
    }
  }

  // The opening's line of facts, in place of a story's entry links: how
  // many entries, the plate range, compared pairs, the sheet size.
  $plates = array_filter(array_column($tiles, 'plate'));
  $tags = array_filter(array_column(array_filter($tiles, fn ($tile) => !$tile['audio'] && !$tile['pages']), 'tag'));
  // A wall of oral history clips counts clips.
  $stats = [count(array_filter(array_column($tiles, 'audio'))) === count($tiles)
    ? (string) \Drupal::translation()->formatPlural(count($tiles), '1 clip', '@count clips')
    : (string) \Drupal::translation()->formatPlural(count($tiles), '1 entry', '@count entries')];
  if (count($plates) >= 2) {
    $stats[] = (string) t('Plates @first–@last', ['@first' => min($plates), '@last' => max($plates)]);
  }
  if ($tags && count(array_unique($tags)) === 1) {
    $stats[] = (string) t('@count @kind pairs', ['@count' => count($tags), '@kind' => mb_strtolower(str_replace(' · ', '–', reset($tags)))]);
  }
  if (preg_match('/^\s*[\d.]+\s*[×x]\s*[\d.]+/u', $own)) {
    $stats[] = (string) t('Sheet @size', ['@size' => trim($own)]);
  }

  return [
    'tiles' => $tiles,
    'sortable' => count($plates) >= 2,
    'sheets' => $sheets,
    'stats' => $stats,
  ];
}

/**
 * The id an exhibit_entry's heading gets: its Anchor field, else its
 * heading, as a class-safe string; entry-<id> when both are empty.
 */
function _palefire_exhibit_entry_anchor(ParagraphInterface $entry): string {
  $title = trim((string) ($entry->get('field_block_title')->value ?? ''));
  $anchor = $entry->hasField('field_section_anchor') ? trim((string) $entry->get('field_section_anchor')->value) : '';
  $anchor = Html::getClass($anchor !== '' ? $anchor : $title);
  return $anchor !== '' ? $anchor : 'entry-' . $entry->id();
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-entry.
 *
 * anchor: the heading's id, from the Anchor field or the heading, so text
 * on any gallery can link to #anchor (js/exhibition.js opens its gallery).
 */
function palefire_preprocess_paragraph__exhibit_entry(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['title'] = trim((string) ($paragraph->get('field_block_title')->value ?? ''));
  $variables['anchor'] = _palefire_exhibit_entry_anchor($paragraph);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-figure.
 *
 * image: values for the <img> (_palefire_exhibit_image()), or NULL when the
 * figure has no image yet (it then shows only to editors, as a reminder).
 * layout: side_start, side_end, center or wide. Inside an image group the
 * group lays the figures out and the layout is ignored.
 * align: "k rot tx ty" from field_figure_align (a drawing laid over the
 * proof after it in a wall's compare view), or ''.
 * link: ['url', 'external'] from field_figure_link (a book cover's catalog
 * record), or NULL. The image then links there instead of the lightbox;
 * inside an image group it is shown as a cover (2:3).
 */
function palefire_preprocess_paragraph__exhibit_figure(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $layout = (string) ($paragraph->get('field_figure_layout')->value ?? '');
  $layout = in_array($layout, ['side_start', 'side_end', 'center', 'wide'], TRUE) ? $layout : 'side_start';
  $in_group = $paragraph->getParentEntity() instanceof ParagraphInterface && $paragraph->getParentEntity()->bundle() === 'exhibit_gallery';
  $variables['link'] = NULL;
  if ($paragraph->hasField('field_figure_link') && !$paragraph->get('field_figure_link')->isEmpty()) {
    $url = $paragraph->get('field_figure_link')->first()->getUrl();
    $variables['link'] = [
      'url' => trim($url->toString()),
      'external' => $url->isExternal(),
    ];
  }
  $sizes = match (TRUE) {
    $in_group && $variables['link'] => '(min-width: 48rem) 12rem, 45vw',
    $in_group => '(min-width: 62rem) 30vw, (min-width: 36rem) 45vw, 100vw',
    $layout === 'wide' => '100vw',
    $layout === 'center' => '(min-width: 62rem) 48rem, 100vw',
    default => '(min-width: 48rem) 40vw, 100vw',
  };
  $variables['image'] = NULL;
  if (!$paragraph->get('field_figure_image')->isEmpty()) {
    $item = _palefire_media_image_item($paragraph->get('field_figure_image')->first(), $cache);
    $variables['image'] = $item ? _palefire_exhibit_image($item, $sizes, $cache) : NULL;
  }
  $variables['layout'] = $in_group ? 'group' : $layout;
  // "k rot tx ty": four numbers, else nothing.
  $align = $paragraph->hasField('field_figure_align') ? trim((string) $paragraph->get('field_figure_align')->value) : '';
  $variables['align'] = preg_match('/^-?[\d.]+(\s+-?[\d.]+){3}$/', $align) ? preg_replace('/\s+/', ' ', $align) : '';
  $access = $paragraph->access('update', NULL, TRUE);
  $variables['can_edit'] = $access->isAllowed();
  $cache->addCacheableDependency($access)->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-gallery.
 *
 * readings: TRUE when the group holds readings (exhibit_reading): it then
 * runs the gallery's full width and gets a Grid / List switch.
 * in_guide: TRUE when the group is a guide section's block, outside any
 * exhibition: it then brings its own lightbox (js/guide-gallery.js) and
 * the exhibition's colors, which exhibition.js and html[data-pf-mode]
 * give it on an exhibition.
 */
function palefire_preprocess_paragraph__exhibit_gallery(array &$variables): void {
  $parent = $variables['paragraph']->getParentEntity();
  $variables['in_guide'] = $parent instanceof ParagraphInterface && $parent->bundle() === 'guide_section';
  $variables['readings'] = FALSE;
  foreach ($variables['paragraph']->get('field_gallery_items')->referencedEntities() as $item) {
    if ($item->bundle() === 'exhibit_reading') {
      $variables['readings'] = TRUE;
      break;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-reading.
 *
 * kind: 'book' or 'article'. byline: the author as typed, for the cover;
 * author: the same ending in a full stop, for the citation. title: without
 * the quotes or full stop an editor may have typed (the template adds
 * them). A book's subtitle (after the first colon) is set smaller on the
 * cover, as a real cover sets it: title is then the part before it and
 * subtitle the rest, else ''. size: '' or 'longer' (over 90 characters), a
 * smaller title on the cover so it still fits; every other title is the
 * same size, so the covers match. source,
 * details: publisher or journal, and year or volume. link: ['url',
 * 'external'], or NULL. tone: 1–8 from the title, a book cover's color
 * (_exhibition.scss), the same wherever the book shows.
 */
function palefire_preprocess_paragraph__exhibit_reading(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $value = fn (string $name): string => $paragraph->hasField($name) ? trim((string) ($paragraph->get($name)->value ?? '')) : '';
  $author = $value('field_reading_author');
  $title = preg_replace('/^[\s“"‘]+|[\s”"’.]+$/u', '', $value('field_reading_title'));
  $kind = $value('field_reading_kind') === 'article' ? 'article' : 'book';
  $subtitle = '';
  if ($kind === 'book' && preg_match('/^(.+?):\s+(.+)$/u', $title, $parts)) {
    [, $title, $subtitle] = $parts;
  }
  $length = mb_strlen($title);
  $variables['kind'] = $kind;
  $variables['byline'] = $author;
  $variables['author'] = $author === '' || preg_match('/[.?!]$/u', $author) ? $author : $author . '.';
  $variables['title'] = $title;
  $variables['subtitle'] = $subtitle;
  $variables['size'] = $length > 90 ? 'longer' : '';
  // The template ends the imprint with a full stop.
  $variables['source'] = rtrim($value('field_reading_source'), '. ');
  $variables['details'] = rtrim($value('field_reading_details'), '. ');
  $variables['tone'] = crc32(mb_strtolower($title)) % 8 + 1;
  $variables['link'] = NULL;
  if ($paragraph->hasField('field_figure_link') && !$paragraph->get('field_figure_link')->isEmpty()) {
    $url = $paragraph->get('field_figure_link')->first()->getUrl();
    $variables['link'] = [
      'url' => trim($url->toString()),
      'external' => $url->isExternal(),
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-audio.
 *
 * audio: ['url', 'type', 'timings'] of the file, or NULL. timings: the URL
 * of a WebVTT file of the same name beside it, or NULL.
 * entry_heading_id: inside an entry, the entry heading's id. The clip is
 * labelled by that heading instead of repeating its title as another <h3>.
 */
function palefire_preprocess_paragraph__exhibit_audio(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $parent = $paragraph->getParentEntity();
  $variables['entry_heading_id'] = $parent instanceof ParagraphInterface && $parent->bundle() === 'exhibit_entry'
    ? _palefire_exhibit_entry_anchor($parent)
    : NULL;
  $file = $paragraph->get('field_audio_file')->entity;
  // A WebVTT file beside the clip under the same name (01-helen-bradley.vtt)
  // times its transcript phrase by phrase (js/exhibition.js lights the
  // phrase being heard). Uploaded by hand, so a drush cr shows a new one.
  $timings = $file ? preg_replace('/\.[^.\/]+$/', '.vtt', $file->getFileUri()) : NULL;
  $variables['audio'] = $file ? [
    'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
    'type' => $file->getMimeType(),
    'timings' => $timings && file_exists($timings) ? \Drupal::service('file_url_generator')->generateString($timings) : NULL,
  ] : NULL;
  $variables['transcript_id'] = 'pf-audio-transcript-' . $paragraph->id();
}
