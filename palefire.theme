/**
 * The newspaper family trees, read live from the site's own records.
 *
 * The records behind lib.lsu.edu/louisiananewspapers: any published entity
 * whose bundle has field_louisiana_parish and field_record_url (title, tree
 * link, parish, field_louisiana_city). Found through the field map, so the
 * theme doesn't need to know the content type's machine name. Their list
 * cache tags go on $cache, so a new or changed record shows at once.
 *
 * Read with one database query, not by loading the records: loading all
 * 637 as entities on an uncached render ran the guide out of memory (a
 * blank 500, 2026-10-21). Anything unexpected (another storage, a renamed
 * table) is logged and gives no trees rather than a broken page.
 *
 * Returns rows sorted by title: title, url, parish (a PALEFIRE_LA_PARISHES
 * key, '' when the record's parish isn't one), city.
 */
function _palefire_newspaper_trees(CacheableMetadata $cache): array {
  $rows = &drupal_static(__FUNCTION__);
  $tags = &drupal_static(__FUNCTION__ . ':tags', []);
  if ($rows !== NULL) {
    $cache->addCacheTags($tags);
    return $rows;
  }
  $rows = [];
  try {
    $rows = _palefire_newspaper_trees_query($tags);
  }
  catch (\Throwable $e) {
    \Drupal::logger('palefire')->error('Louisiana Newspapers guide: could not read the family trees: @message', ['@message' => $e->getMessage()]);
  }
  usort($rows, static fn (array $a, array $b): int => strnatcasecmp($a['title'], $b['title']));
  $cache->addCacheTags($tags);
  return $rows;
}

/**
 * The family-tree rows, straight from the records' tables.
 *
 * For _palefire_newspaper_trees(). Adds each record type's list cache tags
 * to $tags.
 */
function _palefire_newspaper_trees_query(array &$tags): array {
  $rows = [];
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_manager = \Drupal::service('entity_field.manager');
  $database = \Drupal::database();
  // The records' keys shorten East/West ("e_baton_rouge"); compare them
  // without separators against the parish keys.
  $parishes = [];
  foreach (array_keys(PALEFIRE_LA_PARISHES) as $key) {
    $parishes[str_replace('_', '', $key)] = $key;
  }
  foreach ($field_manager->getFieldMap() as $entity_type_id => $fields) {
    if (!isset($fields['field_louisiana_parish'], $fields['field_record_url'])) {
      continue;
    }
    $bundles = array_values(array_intersect($fields['field_louisiana_parish']['bundles'], $fields['field_record_url']['bundles']));
    $type = $entity_type_manager->getDefinition($entity_type_id);
    $storage = $entity_type_manager->getStorage($entity_type_id);
    if (!$bundles || !$type->hasKey('label') || !$storage instanceof SqlEntityStorageInterface) {
      continue;
    }
    $tags = array_merge($tags, $type->getListCacheTags());
    $definitions = $field_manager->getFieldStorageDefinitions($entity_type_id);
    $mapping = $storage->getTableMapping();
    $table = $type->getDataTable() ?: $type->getBaseTable();
    $id = $type->getKey('id');

    $query = $database->select($table, 'e');
    $query->addField('e', $type->getKey('label'), 'title');
    if ($type->hasKey('bundle')) {
      $query->condition('e.' . $type->getKey('bundle'), $bundles, 'IN');
    }
    if ($type->hasKey('published')) {
      $query->condition('e.' . $type->getKey('published'), 1);
    }
    if ($type->getDataTable() && $type->hasKey('default_langcode')) {
      $query->condition('e.' . $type->getKey('default_langcode'), 1);
    }
    // One field value per record: delta 0 of the record's own language.
    $join = function (string $field, string $property, string $alias, bool $required) use ($query, $mapping, $definitions, $id, $type): ?string {
      $definition = $definitions[$field] ?? NULL;
      if (!$definition) {
        return NULL;
      }
      $on = "$alias.entity_id = e.$id AND $alias.deleted = 0 AND $alias.delta = 0";
      if ($type->hasKey('langcode')) {
        $on .= " AND $alias.langcode = e." . $type->getKey('langcode');
      }
      $required ? $query->join($mapping->getFieldTableName($field), $alias, $on) : $query->leftJoin($mapping->getFieldTableName($field), $alias, $on);
      return $query->addField($alias, $mapping->getFieldColumnName($definition, $property), $alias);
    };
    $link = ($definitions['field_record_url'] ?? NULL)?->getType() === 'link';
    $join('field_record_url', $link ? 'uri' : 'value', 'url', TRUE);
    $join('field_louisiana_parish', 'value', 'parish', TRUE);
    $city_column = $join('field_louisiana_city', 'value', 'city', FALSE);
    // A list field stores a key ("baton_rouge"); show its label.
    $cities = $city_column ? ($definitions['field_louisiana_city']->getSetting('allowed_values') ?: []) : [];

    foreach ($query->execute() as $record) {
      $url = trim((string) $record->url);
      if ($url === '') {
        continue;
      }
      if ($link) {
        try {
          $url = Url::fromUri($url)->toString();
        }
        catch (\Throwable $e) {
          $url = preg_replace('/^internal:/', '', $url);
        }
      }
      $parish = preg_replace(['/^e_/', '/^w_/'], ['east_', 'west_'], (string) $record->parish);
      $city = $city_column ? (string) $record->city : '';
      $rows[] = [
        'title' => (string) $record->title,
        'url' => $url,
        'parish' => $parishes[str_replace('_', '', $parish)] ?? '',
        'city' => is_scalar($cities[$city] ?? NULL) ? (string) $cities[$city] : $city,
      ];
    }
  }
  return $rows;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--parish-map.
 *
 * Builds `parishes` for the template: one entry per parish, in
 * PALEFIRE_LA_PARISHES order, with its name, its Parish item's three texts
 * (digital, websites, microfilm: processed_text render arrays or NULL), its
 * family trees (_palefire_newspaper_trees()), a count for each list and
 * `open`, the groups that start open (25 entries or fewer).
 */
function palefire_preprocess_paragraph__parish_map(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  // The family trees' icon, once, for each tree link to <use>.
  $variables['tree_icon'] = _palefire_fa_symbol('duotone', 'project-diagram', 'pf-icon-tree-map');
  $text = static fn (ParagraphInterface $entry, string $field): ?array => $entry->hasField($field) && trim(strip_tags((string) $entry->get($field)->value)) !== '' ? [
    '#type' => 'processed_text',
    '#text' => $entry->get($field)->value,
    '#format' => $entry->get($field)->format,
  ] : NULL;

  $entries = [];
  if ($paragraph->hasField('field_parish_entries')) {
    foreach ($paragraph->get('field_parish_entries') as $item) {
      $entry = $item->entity;
      if ($entry instanceof ParagraphInterface && $entry->isPublished()) {
        $cache->addCacheableDependency($entry);
        $entries[(string) $entry->get('field_parish')->value] = $entry;
      }
    }
  }
  $trees = [];
  foreach (_palefire_newspaper_trees($cache) as $row) {
    $trees[$row['parish']][] = $row;
  }

  $parishes = [];
  foreach (PALEFIRE_LA_PARISHES as $key => $name) {
    $entry = $entries[$key] ?? NULL;
    $parish = [
      'key' => $key,
      'name' => $name,
      'id' => 'parish-' . Html::cleanCssIdentifier($key),
      'trees' => $trees[$key] ?? [],
    ];
    foreach (['digital', 'websites', 'microfilm'] as $group) {
      $parish[$group] = $entry ? $text($entry, 'field_parish_' . $group) : NULL;
      $parish['count'][$group] = $parish[$group] ? substr_count(strtolower((string) $parish[$group]['#text']), '<li') : 0;
    }
    $parish['count']['trees'] = count($parish['trees']);
    $parish['open'] = array_keys(array_filter($parish['count'], static fn (int $n): bool => $n > 0 && $n <= 25));
    $parishes[$key] = $parish;
  }

  $cache->applyTo($variables);
  $variables['uid'] = 'pf-parishes-' . $paragraph->id();
  $variables['parishes'] = $parishes;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--family-trees.
 *
 * trees: every family tree (_palefire_newspaper_trees()), each with its
 * parish's name; parishes: key => name of the parishes that have one, for
 * the filter.
 */
function palefire_preprocess_paragraph__family_trees(array &$variables): void {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  // The family trees' icon, once, for each row to <use>.
  $variables['tree_icon'] = _palefire_fa_symbol('duotone', 'project-diagram', 'pf-icon-tree-list');
  $trees = [];
  $parishes = [];
  foreach (_palefire_newspaper_trees($cache) as $row) {
    $row['parish_name'] = PALEFIRE_LA_PARISHES[$row['parish']] ?? '';
    if ($row['parish'] !== '') {
      $parishes[$row['parish']] = $row['parish_name'];
    }
    $trees[] = $row;
  }
  $cache->applyTo($variables);
  $variables['uid'] = 'pf-trees-' . $variables['paragraph']->id();
  $variables['trees'] = $trees;
  $variables['parishes'] = array_intersect_key(PALEFIRE_LA_PARISHES, $parishes);
}

/**
 * Implements hook_preprocess_node().
 *
 * Resources in the guide_item view mode get `resource`: title, url, icon,
 * labels, citation, desc (node--resource--guide-item.html.twig).
 */
function palefire_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'resource' || ($variables['view_mode'] ?? '') !== 'guide_item') {
    return;
  }
  $value = fn (string $field): string => $node->hasField($field) && !$node->get($field)->isEmpty() ? trim((string) $node->get($field)->value) : '';

  $url = '';
  if ($node->hasField('field_resource_link') && !$node->get('field_resource_link')->isEmpty()) {
    $url = $node->get('field_resource_link')->first()->getUrl()->toString();
  }
  $labels = [];
  if ($node->hasField('field_resource_labels')) {
    foreach ($node->get('field_resource_labels') as $item) {
      if (trim((string) $item->value) !== '') {
        $labels[] = trim((string) $item->value);
      }
    }
  }
  $proxy = $node->hasField('field_resource_proxy') && (bool) $node->get('field_resource_proxy')->value;
  if ($proxy && $url !== '') {
    if (!str_starts_with($url, PALEFIRE_PROXY_PREFIX) && !str_contains((string) parse_url($url, PHP_URL_HOST), 'libezp.')) {
      $url = PALEFIRE_PROXY_PREFIX . $url;
    }
    array_unshift($labels, (string) t('LSU login'));
  }

  $type = $value('field_resource_type');
  $variables['resource'] = [
    'title' => $node->label(),
    'url' => $url ?: $node->toUrl()->toString(),
    'icon' => PALEFIRE_RESOURCE_ICONS[$type] ?? 'globe2',
    'labels' => array_slice(array_unique($labels), 0, 4),
    'citation' => $value('field_resource_citation'),
    'desc' => $value('field_resource_desc'),
  ];
}

/**
 * One image as plain values for an exhibition <img> (templates print it).
 *
 * The exhibit_640/_1280/_1920/_2560 styles (palefire_exhibit_setup.php) as
 * a srcset, so a 4K original is never sent: src is the 1280 version, full
 * (the lightbox) the largest. Styles that are missing are skipped; with
 * none, the original file. Width and height are always set (no layout
 * shift); alt comes from the image item.
 *
 * @param string $sizes
 *   The <img sizes> value.
 * @param bool $eager
 *   TRUE for the first image on screen (the exhibition's title page).
 *
 * @return array{src: string, srcset: string, sizes: string, width: ?int, height: ?int, alt: string, full: string, loading: string}|null
 */
function _palefire_exhibit_image(FieldItemInterface $image, string $sizes, CacheableMetadata $cache, bool $eager = FALSE): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $uri = $file->getFileUri();
  $width = $image->width ? (int) $image->width : NULL;
  $height = $image->height ? (int) $image->height : NULL;
  $original = \Drupal::service('file_url_generator')->generateString($uri);

  $candidates = [];
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  foreach ([640, 1280, 1920, 2560] as $step) {
    $style = $storage->load('exhibit_' . $step);
    if (!$style) {
      continue;
    }
    $cache->addCacheableDependency($style);
    $dimensions = ['width' => $width, 'height' => $height];
    $style->transformDimensions($dimensions, $uri);
    $w = (int) ($dimensions['width'] ?? $step);
    // An original narrower than the step gives the same image again.
    if ($candidates && $w <= array_key_last($candidates)) {
      continue;
    }
    $candidates[$w] = \Drupal::service('file_url_generator')->transformRelative($style->buildUrl($uri));
  }

  $srcset = implode(', ', array_map(fn ($w, $url) => "$url {$w}w", array_keys($candidates), $candidates));
  $src = $candidates ? ($candidates[array_keys($candidates)[min(1, count($candidates) - 1)]]) : $original;
  return [
    'src' => $src,
    'srcset' => $srcset,
    'sizes' => $sizes,
    'width' => $width,
    'height' => $height,
    'alt' => (string) ($image->alt ?? ''),
    'full' => $candidates ? end($candidates) : $original,
    'loading' => $eager ? 'eager' : 'lazy',
    'focus' => _palefire_focal_point($file, $width, $height, $cache),
  ];
}

/**
 * A Font Awesome Pro icon as an inline <symbol>, for <use href="#$id">.
 *
 * Read from the server's /libraries/fontawesome-pro (licensed, so never in
 * this repository). One copy per template, however many links use it,
 * instead of the whole SVG in each. The paths take the text colour (the
 * <use> sets fill: currentColor); a duotone icon's lighter layer keeps its
 * 40%. NULL when the file isn't there: the templates then print no icon.
 */
function _palefire_fa_symbol(string $style, string $name, string $id): ?Markup {
  $file = DRUPAL_ROOT . '/libraries/fontawesome-pro/svgs/' . $style . '/' . $name . '.svg';
  $svg = is_readable($file) ? (string) file_get_contents($file) : '';
  if (!preg_match('#viewBox="([\d. ]+)"#', $svg, $box) || !preg_match_all('#<path [^>]*/>#', $svg, $paths)) {
    return NULL;
  }
  $paths = str_replace(['class="fa-secondary"', ' class="fa-primary"'], ['opacity=".4"', ''], implode('', $paths[0]));
  return Markup::create('<svg class="visually-hidden" aria-hidden="true" focusable="false"><symbol id="' . $id . '" viewBox="' . $box[1] . '">' . $paths . '</symbol></svg>');
}

/**
 * The image's focal point as an object-position ("62.5% 30%"), or ''.
 *
 * Set by editors on the Media image's edit form (Focal Point module), it
 * keeps that spot in view wherever a cropped cover shows the image, at any
 * screen shape: the templates set it as the <img>'s object-position rather
 * than using Focal Point's fixed-crop image styles. '' when the module is
 * off, the image has no point yet, or its size is unknown.
 */
function _palefire_focal_point(FileInterface $file, ?int $width, ?int $height, CacheableMetadata $cache): string {
  if (!$width || !$height || !\Drupal::moduleHandler()->moduleExists('focal_point')) {
    return '';
  }
  $type = \Drupal::config('focal_point.settings')->get('crop_type') ?: 'focal_point';
  $cache->addCacheTags(['config:focal_point.settings']);
  // getCropEntity() makes an unsaved crop when there is none: no point yet.
  $crop = \Drupal::service('focal_point.manager')->getCropEntity($file, $type);
  if (!$crop || $crop->isNew()) {
    return '';
  }
  $cache->addCacheableDependency($crop);
  $position = $crop->position();
  $x = max(0, min(100, round($position['x'] / $width * 100, 1)));
  $y = max(0, min(100, round($position['y'] / $height * 100, 1)));
  return $x . '% ' . $y . '%';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-page.
 *
 * lead: the gallery's lead image (decorative), or NULL.
 * focus: where a cropped lead stays in view (object-position keyword).
 * lead_x: the pan's horizontal position (Left / Right keep that side).
 * lead_whole: "Show whole image": uncropped and centred, not a band.
 * lead_caption: field_exhibit_lead_caption rendered, or NULL. With one, the
 * lead is content (alt text, lightbox, caption); without, decorative.
 * Rendered here rather than through Manage display, so galleries made
 * before the field existed show it too.
 * opener: "cover" (default, with a lead), "full" (the pinned and panned
 * opening; the default without a lead) or "compact".
 * wall: the wall's tiles (_palefire_exhibit_wall()) when Display is "wall",
 * else NULL.
 * wall_lead, wall_lead_caption: the lead of a wall or a cover opening,
 * shown full screen and fixed, with the title, the entry links or a wall's
 * facts, and the opening text over its lower left (_exhibition.scss); lead
 * and lead_caption are then NULL.
 * entries, entries_more: the full and cover openings' links to the
 * gallery's entries, ['anchor', 'title'] each, the first six and the rest
 * (none on a wall).
 * dom_id: base for the caption's and the text's ids (the hero's
 * aria-labelledby and the opening's "Skip to the text" link).
 */
function palefire_preprocess_paragraph__exhibit_page(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $variables['lead'] = NULL;
  if ($paragraph->hasField('field_exhibit_lead') && !$paragraph->get('field_exhibit_lead')->isEmpty()) {
    $item = _palefire_media_image_item($paragraph->get('field_exhibit_lead')->first(), $cache);
    $variables['lead'] = $item ? _palefire_exhibit_image($item, '100vw', $cache) : NULL;
  }
  $focus = $paragraph->hasField('field_exhibit_lead_focus') ? (string) $paragraph->get('field_exhibit_lead_focus')->value : '';
  $variables['focus'] = in_array($focus, ['top', 'bottom', 'left', 'right'], TRUE) ? $focus : 'center';
  $variables['lead_x'] = ['left' => '0%', 'right' => '100%'][$variables['focus']] ?? '50%';
  // The image's focal point, when an editor has set one, is more precise
  // than "Keep in view when cropped" and takes its place.
  if (!empty($variables['lead']['focus'])) {
    $variables['focus'] = $variables['lead']['focus'];
    $variables['lead_x'] = explode(' ', $variables['focus'])[0];
  }
  $variables['lead_whole'] = $paragraph->hasField('field_exhibit_lead_whole') && (bool) $paragraph->get('field_exhibit_lead_whole')->value;
  $variables['lead_caption'] = NULL;
  if ($variables['lead'] && $paragraph->hasField('field_exhibit_lead_caption') && trim(strip_tags((string) $paragraph->get('field_exhibit_lead_caption')->value)) !== '') {
    $variables['lead_caption'] = $paragraph->get('field_exhibit_lead_caption')->view(['label' => 'hidden', 'type' => 'text_default']);
  }
  // Opening: "cover" (stored as "full", also when empty, for galleries
  // made before the field), "full" (stored as "pan") or "compact" (the
  // band above, as before).
  $opener = $paragraph->hasField('field_exhibit_opener') ? (string) $paragraph->get('field_exhibit_opener')->value : '';
  $variables['opener'] = match ($opener) {
    'compact' => 'compact',
    'pan' => 'full',
    default => $variables['lead'] ? 'cover' : 'full',
  };
  if ($variables['lead'] && $variables['lead_whole'] && $variables['opener'] === 'compact') {
    // Centred at its own width, never wider than the column.
    $variables['lead']['sizes'] = '(min-width: 62rem) 60vw, 100vw';
  }

  // Display: "story" (default, also when empty) or "wall".
  $display = $paragraph->hasField('field_exhibit_display') ? (string) $paragraph->get('field_exhibit_display')->value : '';
  $variables['wall'] = $display === 'wall' ? _palefire_exhibit_wall($paragraph, $cache) : NULL;
  $variables['wall_lead'] = NULL;
  $variables['wall_lead_caption'] = NULL;
  if ($variables['wall'] || $variables['opener'] === 'cover') {
    // A wall, or a story with the cover opening, opens on its lead full
    // screen with its title and opening text over it (_exhibition.scss). A
    // wall ignores the Opening (kept in the field, for a return to
    // "story").
    $variables['wall_lead'] = $variables['lead'];
    $variables['wall_lead_caption'] = $variables['lead_caption'];
    if ($variables['wall_lead']) {
      $variables['wall_lead']['sizes'] = '100vw';
    }
    $variables['lead'] = NULL;
    $variables['lead_caption'] = NULL;
    $variables['opener'] = $variables['wall'] ? 'compact' : 'cover';
  }

  // The full and cover openings' "In this gallery" links: the gallery's
  // entries, in order, with the ids their headings get
  // (paragraph--exhibit-entry). The first six show; the rest sit behind
  // "Show more". A wall is its own index.
  $variables['entries'] = [];
  $variables['entries_more'] = [];
  if (in_array($variables['opener'], ['full', 'cover'], TRUE) && !$variables['wall'] && $paragraph->hasField('field_guide_blocks')) {
    foreach ($paragraph->get('field_guide_blocks')->referencedEntities() as $block) {
      if ($block->bundle() === 'exhibit_entry' && $block->isPublished()) {
        $variables['entries'][] = [
          'anchor' => _palefire_exhibit_entry_anchor($block),
          'title' => trim((string) $block->get('field_block_title')->value),
        ];
      }
    }
    $variables['entries_more'] = array_slice($variables['entries'], 6);
    $variables['entries'] = array_slice($variables['entries'], 0, 6);
  }
  $variables['dom_id'] = 'gallery-' . $paragraph->id();
  $cache->applyTo($variables);
}

/**
 * A wall gallery's tiles: one per published entry with an image.
 *
 * Each tile is the entry's first image, or its first two when they share an
 * image group (a drawing and its proof, compared in the object view).
 *
 * @return array{tiles: array, sortable: bool, sheets: array}|null
 *   tiles: ['anchor', 'title', 'plate' (from "plate 40" in the caption, or
 *   NULL), 'tag' (the two figures' captions, "Drawing · Proof"), 'ratio',
 *   'images' (_palefire_exhibit_image() values)]. sortable: two or more
 *   tiles have a plate number. sheets: this page's sheet sizes, ['label',
 *   'h', 'w', 'current'] each, when this gallery has one. stats: the
 *   opening's facts ("22 entries", "Plates 2–154", "11 drawing–proof
 *   pairs", "Sheet 40 × 27 in").
 */
function _palefire_exhibit_wall(ParagraphInterface $page, CacheableMetadata $cache): ?array {
  if (!$page->hasField('field_guide_blocks')) {
    return NULL;
  }
  $sizes = '(min-width: 62rem) 24vw, (min-width: 36rem) 45vw, 90vw';
  $text = fn ($field) => trim(preg_replace('/\s+/', ' ', strip_tags((string) $field->value)));
  $tiles = [];
  foreach ($page->get('field_guide_blocks')->referencedEntities() as $entry) {
    if ($entry->bundle() !== 'exhibit_entry' || !$entry->isPublished()) {
      continue;
    }
    // The entry's first image block: a figure, or an image group's figures.
    $figures = [];
    $caption = '';
    foreach ($entry->get('field_guide_blocks')->referencedEntities() as $block) {
      if ($block->bundle() === 'exhibit_figure' && !$block->get('field_figure_image')->isEmpty()) {
        $figures = [$block];
        $caption = $text($block->get('field_figure_caption'));
        break;
      }
      if ($block->bundle() === 'exhibit_gallery') {
        $figures = array_slice(array_values(array_filter($block->get('field_gallery_items')->referencedEntities(), fn ($f) => !$f->get('field_figure_image')->isEmpty())), 0, 2);
        $caption = $text($block->get('field_figure_caption')) ?: ($figures ? $text($figures[0]->get('field_figure_caption')) : '');
        if ($figures) {
          break;
        }
      }
    }
    $images = [];
    foreach ($figures as $figure) {
      $item = _palefire_media_image_item($figure->get('field_figure_image')->first(), $cache);
      $image = $item ? _palefire_exhibit_image($item, $sizes, $cache) : NULL;
      if ($image) {
        $images[] = $image;
      }
    }
    if (!$images) {
      continue;
    }
    $tags = count($figures) === 2 ? array_filter(array_map(fn ($f) => $text($f->get('field_figure_caption')), $figures)) : [];
    $first = $images[0];
    $tiles[] = [
      'anchor' => _palefire_exhibit_entry_anchor($entry),
      'title' => trim((string) $entry->get('field_block_title')->value),
      'plate' => preg_match('/\bplate\s+(\d+)/i', $caption, $m) ? (int) $m[1] : NULL,
      'tag' => count($tags) === 2 ? implode(' · ', $tags) : '',
      'ratio' => $first['width'] && $first['height'] ? round($first['width'] / $first['height'], 4) : 1,
      'images' => $images,
    ];
  }
  if (!$tiles) {
    return NULL;
  }

  // "Actual size": every wall gallery's sheet on this page, to scale.
  $sheets = [];
  $own = $page->hasField('field_exhibit_sheet') ? (string) $page->get('field_exhibit_sheet')->value : '';
  $node = $page->getParentEntity();
  if (preg_match('/^\s*([\d.]+)\s*[×x]\s*([\d.]+)/u', $own) && $node && $node->hasField('field_scroll_section')) {
    $cache->addCacheableDependency($node);
    foreach ($node->get('field_scroll_section')->referencedEntities() as $sibling) {
      $size = $sibling->hasField('field_exhibit_sheet') ? (string) $sibling->get('field_exhibit_sheet')->value : '';
      if (preg_match('/^\s*([\d.]+)\s*[×x]\s*([\d.]+)/u', $size, $m)) {
        $sheets[] = [
          'label' => $sibling->hasField('field_section_title') ? trim((string) $sibling->get('field_section_title')->value) : '',
          'size' => trim($size),
          'h' => (float) $m[1],
          'w' => (float) $m[2],
          'current' => $sibling->id() === $page->id(),
        ];
      }
    }
  }

  // The opening's line of facts, in place of a story's entry links: how
  // many entries, the plate range, compared pairs, the sheet size.
  $plates = array_filter(array_column($tiles, 'plate'));
  $tags = array_filter(array_column($tiles, 'tag'));
  $stats = [(string) \Drupal::translation()->formatPlural(count($tiles), '1 entry', '@count entries')];
  if (count($plates) >= 2) {
    $stats[] = (string) t('Plates @first–@last', ['@first' => min($plates), '@last' => max($plates)]);
  }
  if ($tags && count(array_unique($tags)) === 1) {
    $stats[] = (string) t('@count @kind pairs', ['@count' => count($tags), '@kind' => mb_strtolower(str_replace(' · ', '–', reset($tags)))]);
  }
  if (preg_match('/^\s*[\d.]+\s*[×x]\s*[\d.]+/u', $own)) {
    $stats[] = (string) t('Sheet @size', ['@size' => trim($own)]);
  }

  return [
    'tiles' => $tiles,
    'sortable' => count($plates) >= 2,
    'sheets' => $sheets,
    'stats' => $stats,
  ];
}

/**
 * The id an exhibit_entry's heading gets: its Anchor field, else its
 * heading, as a class-safe string; entry-<id> when both are empty.
 */
function _palefire_exhibit_entry_anchor(ParagraphInterface $entry): string {
  $title = trim((string) ($entry->get('field_block_title')->value ?? ''));
  $anchor = $entry->hasField('field_section_anchor') ? trim((string) $entry->get('field_section_anchor')->value) : '';
  $anchor = Html::getClass($anchor !== '' ? $anchor : $title);
  return $anchor !== '' ? $anchor : 'entry-' . $entry->id();
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-entry.
 *
 * anchor: the heading's id, from the Anchor field or the heading, so text
 * on any gallery can link to #anchor (js/exhibition.js opens its gallery).
 */
function palefire_preprocess_paragraph__exhibit_entry(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['title'] = trim((string) ($paragraph->get('field_block_title')->value ?? ''));
  $variables['anchor'] = _palefire_exhibit_entry_anchor($paragraph);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-figure.
 *
 * image: values for the <img> (_palefire_exhibit_image()), or NULL when the
 * figure has no image yet (it then shows only to editors, as a reminder).
 * layout: side_start, side_end, center or wide. Inside an image group the
 * group lays the figures out and the layout is ignored.
 * align: "k rot tx ty" from field_figure_align (a drawing laid over the
 * proof after it in a wall's compare view), or ''.
 */
function palefire_preprocess_paragraph__exhibit_figure(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $layout = (string) ($paragraph->get('field_figure_layout')->value ?? '');
  $layout = in_array($layout, ['side_start', 'side_end', 'center', 'wide'], TRUE) ? $layout : 'side_start';
  $in_group = $paragraph->getParentEntity() instanceof ParagraphInterface && $paragraph->getParentEntity()->bundle() === 'exhibit_gallery';
  $sizes = match (TRUE) {
    $in_group => '(min-width: 62rem) 30vw, (min-width: 36rem) 45vw, 100vw',
    $layout === 'wide' => '100vw',
    $layout === 'center' => '(min-width: 62rem) 48rem, 100vw',
    default => '(min-width: 48rem) 40vw, 100vw',
  };
  $variables['image'] = NULL;
  if (!$paragraph->get('field_figure_image')->isEmpty()) {
    $item = _palefire_media_image_item($paragraph->get('field_figure_image')->first(), $cache);
    $variables['image'] = $item ? _palefire_exhibit_image($item, $sizes, $cache) : NULL;
  }
  $variables['layout'] = $in_group ? 'group' : $layout;
  // "k rot tx ty": four numbers, else nothing.
  $align = $paragraph->hasField('field_figure_align') ? trim((string) $paragraph->get('field_figure_align')->value) : '';
  $variables['align'] = preg_match('/^-?[\d.]+(\s+-?[\d.]+){3}$/', $align) ? preg_replace('/\s+/', ' ', $align) : '';
  $access = $paragraph->access('update', NULL, TRUE);
  $variables['can_edit'] = $access->isAllowed();
  $cache->addCacheableDependency($access)->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--exhibit-audio.
 *
 * audio: ['url', 'type'] of the file, or NULL.
 */
function palefire_preprocess_paragraph__exhibit_audio(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $file = $paragraph->get('field_audio_file')->entity;
  $variables['audio'] = $file ? [
    'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
    'type' => $file->getMimeType(),
  ] : NULL;
  $variables['transcript_id'] = 'pf-audio-transcript-' . $paragraph->id();
}
