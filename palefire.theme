/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Adds the current page title so the breadcrumb template can show it
 * as the final, non-linked item.
 */
function palefire_preprocess_breadcrumb(array &$variables) {
  $route_match = \Drupal::routeMatch();
  $title = NULL;

  // Node pages: use the node's title.
  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface) {
    $title = $node->label();
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $node->getCacheTags()
    );
    // An exhibition: its title opens a list of the exhibitions in its
    // family (PalefireHooks::exhibitFamily()), to switch between them.
    if ($node->hasField('field_modular_type') && $node->get('field_modular_type')->value === 'exhibition') {
      $cache = CacheableMetadata::createFromRenderArray($variables);
      $family = PalefireHooks::exhibitFamily($node, $cache);
      $cache->applyTo($variables);
      if (count($family['items']) > 1) {
        $variables['exhibit_family'] = array_map(static fn (array $item): array => [
          'title' => $item['title'],
          'url' => $item['url'],
          'current' => $item['current'],
        ], $family['items']);
        $variables['exhibit_family_label'] = $family['parent']['title'];
      }
    }
  }
  // Staff profiles (a View page): the person's name, not the View's title.
  elseif (StaffDirectory::isRoute('profile')) {
    $cache = CacheableMetadata::createFromRenderArray($variables);
    $title = StaffDirectory::current($cache)?->label();
    $cache->applyTo($variables);
  }
  // Other pages (Views, taxonomy terms, etc.): use the route's title.
  elseif ($route = $route_match->getRouteObject()) {
    $resolved = \Drupal::service('title_resolver')
      ->getTitle(\Drupal::request(), $route);

    if (is_array($resolved)) {
      $resolved = \Drupal::service('renderer')->renderPlain($resolved);
    }
    if ($resolved) {
      $title = strip_tags((string) $resolved);
    }
  }

  if ($title) {
    $variables['current_page_title'] = $title;
  }

  // Cache the breadcrumb separately for each page.
  $variables['#cache']['contexts'][] = 'url.path';
}
/**
 * Implements hook_page_attachments_alter().
 *
 * Adds noindex to every page under /concept, and to Resource nodes' own
 * pages: a Resource exists to be listed on guides, and its node page would
 * be a thin duplicate in search results.
 */
function palefire_page_attachments_alter(array &$attachments) {
  $path = \Drupal::request()->getPathInfo();

  // On pages with the mobile dock (Special Collections), let the page run
  // under the iPhone's home indicator and notch, so the dock can pad itself
  // with env(safe-area-inset-*) (_dock.scss).
  if (PalefireHooks::isSpecialPage(PalefireHooks::pageAlias()) && !empty($attachments['#attached']['html_head'])) {
    foreach ($attachments['#attached']['html_head'] as &$item) {
      if (($item[1] ?? '') === 'viewport') {
        $item[0]['#attributes']['content'] = 'width=device-width, initial-scale=1.0, viewport-fit=cover';
      }
    }
    unset($item);
  }
  _palefire_page_description($attachments);

  $node = \Drupal::routeMatch()->getParameter('node');
  $is_resource = $node instanceof NodeInterface && $node->bundle() === 'resource';

  // Newsletter review pages (scripts/palefire_newsletter_review.php): a draft
  // that changes by the minute, for the people asked to read it. Never kept
  // whole by the anonymous page cache (NewsletterReview::MAX_AGE governs the
  // draft), never indexed. Under /v2/internal since 2026-11-13; the old
  // /v2/special/internal address still matches.
  $is_review = (bool) preg_match('#^/v2/(?:special/)?internal/newsletter-review(/|$)#i', $path);
  if ($is_review) {
    \Drupal::service('page_cache_kill_switch')->trigger();
  }
  // The newsletter archive compares the latest issue, a draft until it is
  // sent, with the one before: kept out of the anonymous page cache too, or
  // visitors saw the draft as it was when the page was first cached (until
  // drush cr). Its parts are still render cached (five minutes for the
  // comparison, a day for the archive).
  if (preg_match('#^/v2/newsletters/?$#i', $path)) {
    \Drupal::service('page_cache_kill_switch')->trigger();
  }

  // The public relations timeline (scripts/palefire_pr_timeline.php):
  // published so anyone with the link can leave a note, never indexed. Its
  // approved notes redraw it through the page cache's tags.
  $is_timeline = (bool) preg_match('#^/v2/(?:special/)?internal/pr-timeline(/|$)#i', $path);
  // Review mode (any /v2 page with ?review) and its hub: for reviewers, never
  // indexed. Both are page cached by address, and redrawn through the
  // Webform's tags when a note or a thumb comes in.
  $is_page_review = (class_exists(PageReview::class) && PageReview::applies())
    || preg_match('#^/v2/internal/page-review(/|$)#i', $path);

  if (!$is_resource && !$is_review && !$is_timeline && !$is_page_review && !preg_match('#^/concept(/|$)#i', $path)) {
    return;
  }

  $found = FALSE;

  // Overwrite Metatag's robots tag if it already added one.
  if (!empty($attachments['#attached']['html_head'])) {
    foreach ($attachments['#attached']['html_head'] as &$item) {
      if (($item[1] ?? '') === 'robots') {
        $item[0]['#attributes']['content'] = 'noindex, nofollow';
        $found = TRUE;
      }
    }
    unset($item);
  }

  // Otherwise, add one.
  if (!$found) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex, nofollow'],
      ],
      'robots',
    ];
  }
}

/**
 * The page's description (meta description and og:description) from the
 * lede it shows: the page's Intro (field_intro), else its Body (the
 * summary, else the text), else a location page's room description (the
 * line under its title). Plain text, cut at a word to about 160
 * characters. Left alone when Metatag already gives one.
 */
function _palefire_page_description(array &$attachments): void {
  $node = PalefireHooks::pageNode();
  if (!$node) {
    return;
  }
  foreach ($attachments['#attached']['html_head'] ?? [] as $item) {
    if (($item[1] ?? '') === 'description') {
      return;
    }
  }
  $cache = CacheableMetadata::createFromRenderArray($attachments)->addCacheableDependency($node);
  $text = '';
  if ($node->hasField('field_intro') && !$node->get('field_intro')->isEmpty()) {
    $text = (string) $node->get('field_intro')->value;
  }
  elseif ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $text = (string) ($node->get('body')->summary ?: $node->get('body')->value);
  }
  else {
    foreach (PalefireHooks::SECTION_FIELDS as $field) {
      foreach ($node->hasField($field) ? $node->get($field)->referencedEntities() : [] as $section) {
        $room = $section instanceof ParagraphInterface && $section->bundle() === 'location_space' ? _palefire_location_room($section) : NULL;
        if ($room) {
          $cache->addCacheableDependency($room);
          $text = (string) $room->get('description')->value;
          break 2;
        }
      }
    }
  }
  $text = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($text), ENT_QUOTES | ENT_HTML5)));
  if ($text !== '') {
    $text = Unicode::truncate($text, 160, TRUE, TRUE);
    $attachments['#attached']['html_head'][] = [['#tag' => 'meta', '#attributes' => ['name' => 'description', 'content' => $text]], 'description'];
    $attachments['#attached']['html_head'][] = [['#tag' => 'meta', '#attributes' => ['property' => 'og:description', 'content' => $text]], 'og_description'];
  }
  $cache->applyTo($attachments);
}

/**
 * Implements hook_theme_suggestions_page_alter().
 *
 * The 404 preview page (PalefireHooks::NOT_FOUND_PREVIEW) uses the 404
 * page's template, page--404.html.twig, as a real 404 does.
 */
function palefire_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (PalefireHooks::pageAlias() === PalefireHooks::NOT_FOUND_PREVIEW) {
    $suggestions = array_values(array_diff($suggestions, ['page__4xx', 'page__404']));
    $suggestions[] = 'page__4xx';
    $suggestions[] = 'page__404';
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Cache busting. Drupal adds a library's version to its CSS and JS URLs
 * (?v=1.0.0) and to the names of its aggregates, so with fixed versions in
 * palefire.libraries.yml a changed file kept its old URL and browsers or a
 * CDN served the old copy. Each library's version is now a short hash of
 * the contents of its files: change a file and its library gets a new URL;
 * the others keep theirs, so their caches stay warm.
 *
 * Library info is cached, so files are only hashed when caches are rebuilt
 * (drush cr, part of every deploy). External files are skipped.
 *
 * Drupal calls this with the definitions as written in the .libraries.yml
 * (files keyed by path, CSS grouped by category such as "theme"), and
 * copies the library version onto each file afterwards. The first version
 * of this hook expected the processed form (a "data" key per file), found
 * nothing and changed nothing; palefire_library_files() reads both forms.
 */
function palefire_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'palefire') {
    return;
  }
  $theme_path = \Drupal::service('extension.list.theme')->getPath('palefire');
  foreach ($libraries as &$library) {
    $files = [];
    foreach (['css', 'js'] as $type) {
      if (!empty($library[$type]) && is_array($library[$type])) {
        palefire_library_files($library[$type], $theme_path, $files);
      }
    }
    $hashes = [];
    foreach (array_unique($files) as $file) {
      if (is_file($file)) {
        $hashes[] = hash_file('xxh3', $file);
      }
    }
    if (!$hashes) {
      continue;
    }
    $version = substr(hash('xxh3', implode('.', $hashes)), 0, 10);
    $library['version'] = $version;
    // Processed form: each file carries its own copy of the version.
    foreach (['css', 'js'] as $type) {
      if (!empty($library[$type]) && is_array($library[$type]) && array_is_list($library[$type])) {
        foreach ($library[$type] as &$asset) {
          if (is_array($asset) && isset($asset['data'])) {
            $asset['version'] = $version;
          }
        }
        unset($asset);
      }
    }
  }
  unset($library);
}

/**
 * Collects the local file paths of a library's CSS or JS definitions.
 *
 * @param array $assets
 *   The library's "css" or "js" array, as written in the .libraries.yml
 *   (path => options, CSS nested under categories) or processed (a list of
 *   arrays with a "data" path).
 * @param string $theme_path
 *   The theme's path, which relative file paths are relative to.
 * @param string[] $files
 *   Absolute file paths, added to.
 */
function palefire_library_files(array $assets, string $theme_path, array &$files): void {
  foreach ($assets as $key => $value) {
    // Processed: ['data' => 'themes/custom/palefire/css/style.css', ...].
    if (is_array($value) && isset($value['data']) && is_string($value['data'])) {
      if (($value['type'] ?? 'file') === 'file') {
        $files[] = DRUPAL_ROOT . '/' . ltrim($value['data'], '/');
      }
      continue;
    }
    if (!is_string($key) || !is_array($value)) {
      continue;
    }
    // As written: 'css/style.css' => [options], or '/libraries/…' from the
    // Drupal root.
    if (preg_match('/\.(css|js)$/i', $key)) {
      if (($value['type'] ?? 'file') === 'external' || preg_match('#^(//|[a-z][a-z0-9+.-]*:)#i', $key)) {
        continue;
      }
      $files[] = str_starts_with($key, '/') ? DRUPAL_ROOT . $key : DRUPAL_ROOT . '/' . $theme_path . '/' . $key;
    }
    // A CSS category (theme, component, base, layout, state).
    else {
      palefire_library_files($value, $theme_path, $files);
    }
  }
}

/**
 * Building floor maps from maps/buildings.yml, keyed by building.
 *
 * Each entry: label, heading, template (Twig include of the drawing), intro,
 * legend (icons to explain, e.g. [elevator]) and spaces (space key => label,
 * floor, access, tooltip). See that file.
 */
function palefire_buildings(): array {
  $buildings = &drupal_static(__FUNCTION__);
  if (!isset($buildings)) {
    $file = DRUPAL_ROOT . '/' . \Drupal::service('extension.list.theme')->getPath('palefire') . '/maps/buildings.yml';
    $buildings = is_readable($file) ? (Yaml::decode(file_get_contents($file)) ?: []) : [];
  }
  return $buildings;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--bento-search.
 *
 * Renders the landing's building map (field_bento_map) as landing_map. Built
 * here from the referenced paragraph, so it doesn't depend on the landing's
 * view display listing the field.
 *
 * map_only: TRUE when the optional field_bento_hide_lead (Boolean, added in
 * the UI) is checked and there is a map to show. The template then leaves
 * out the lead panel (title, intro, search) and the map leads the landing. A
 * landing without a map ignores it, so it can never render empty.
 *
 * landing: the search settings (identifier, input_id, placeholder). The
 * palefire_modular module still hands them over as bento, so they are
 * copied across; anything already in landing wins.
 */
function palefire_preprocess_paragraph__bento_search(array &$variables): void {
  $variables['landing'] = ($variables['landing'] ?? []) + ($variables['bento'] ?? []);
  $variables['landing_map'] = NULL;
  $variables['page_title'] = NULL;
  $variables['toc_home_id'] = NULL;
  $variables['toc_map_id'] = NULL;
  $variables['toc_start_id'] = NULL;
  $variables['toc_hours_id'] = NULL;
  $variables['lead_breadcrumb'] = NULL;
  $variables['map_only'] = FALSE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  // A landing without the map field still gets its intro, Visit card and
  // page title (this used to return early and skip them).
  $map = $paragraph->hasField('field_bento_map') ? $paragraph->get('field_bento_map')->entity : NULL;
  if ($map instanceof ParagraphInterface && $map->isPublished()) {
    $map = \Drupal::service('entity.repository')->getTranslationFromContext($map);
    $variables['landing_map'] = \Drupal::entityTypeManager()->getViewBuilder('paragraph')->view($map, 'default');
  }
  $variables['map_only'] = $variables['landing_map'] !== NULL
    && $paragraph->hasField('field_bento_hide_lead')
    && (bool) $paragraph->get('field_bento_hide_lead')->value;
  _palefire_landing_visit($variables, $paragraph);
}

/**
 * The landing hero's index rules, in the order it shows them: guide (Start
 * your research, the Quick Start in the lead panel), rooms (Rooms and access,
 * over the map and its key) and hours (Hours and directions, over the Visit
 * strip). Read from the same facts the templates use: the lead shows unless
 * the map leads alone, and only with the page title or an intro (show_lead,
 * includes/landing.html.twig); the map when it is published; the Visit strip
 * when the host page has a location (_palefire_landing_visit()), but not on a
 * unit’s homepage, whose Find us banner and hours under the title say where
 * and when. The hero
 * numbers its rules from this (_palefire_hero_index()), and
 * palefire_preprocess_field() counts on from those numbers, so no number is
 * typed by hand and they always agree.
 *
 * @return string[]
 *   Rule keys: 'guide', 'series' (Oral History only), 'rooms', 'hours',
 *   those the hero shows.
 */
function _palefire_hero_rules(ParagraphInterface $paragraph): array {
  $map = $paragraph->hasField('field_bento_map') ? $paragraph->get('field_bento_map')->entity : NULL;
  $has_map = $map instanceof ParagraphInterface && $map->isPublished();
  $map_only = $has_map && $paragraph->hasField('field_bento_hide_lead') && (bool) $paragraph->get('field_bento_hide_lead')->value;

  $host = $paragraph;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  $filled = static fn (string $name): bool => $host instanceof NodeInterface
    && $host->hasField($name) && trim((string) ($host->get($name)->value ?? '')) !== '';
  $title = $host instanceof NodeInterface
    && $host->bundle() === PalefireHooks::MODULAR_BUNDLE
    && PalefireHooks::titleLandingUuid($host) === $paragraph->uuid();
  $intro = $host instanceof NodeInterface && $host->hasField('field_intro') && !$host->get('field_intro')->isEmpty();
  $visit = $filled('field_hours_location') || $filled('field_location_name') || $filled('field_location_query');

  $rules = [];
  if (!$map_only && ($title || $intro)) {
    $rules[] = 'guide';
    // Oral History's homepage (its map's Here room): Browse by series, after
    // the Quick Start, when Combined Search (palefire_search) is there to
    // list them (_palefire_oral_history_series()).
    $here = $has_map && $map->hasField('field_map_here') ? (string) $map->get('field_map_here')->value : '';
    if (str_ends_with($here, '.oral_history') && \Drupal::hasService('palefire_search.local')) {
      $rules[] = 'series';
    }
  }
  // A unit's homepage (its map marks a room Here) shows the map as its Find
  // us banner only, with no Rooms and access or Hours and directions section.
  $unit = $has_map && $map->hasField('field_map_here') && trim((string) $map->get('field_map_here')->value) !== '';
  if ($has_map && !$unit) {
    $rules[] = 'rooms';
  }
  if ($visit && !$unit) {
    $rules[] = 'hours';
  }
  return $rules;
}

/**
 * The landing hero's index numbers, by rule key (_palefire_hero_rules()).
 *
 * Each is a section of its own, in the order the hero shows them.
 *
 * @return string[]
 *   Rule key => number ('01').
 */
function _palefire_hero_index(ParagraphInterface $paragraph): array {
  $index = [];
  foreach (_palefire_hero_rules($paragraph) as $i => $rule) {
    $index[$rule] = sprintf('%02d', $i + 1);
  }
  return $index;
}

/**
 * The page's Section tabs that the landing hero draws in its Quick Start.
 *
 * The first published Section tabs section on the hero's page, when the
 * hero shows its Quick Start (the guide rule, _palefire_hero_rules()) and a
 * Tab draws the request paths (_palefire_tab_has_paths()). The hero draws
 * the tabs under its rule 01, that Tab's panel holding the whole Quick
 * Start, and palefire_preprocess_field() leaves the section out
 * of the page, so it shows once and takes no number of its own. NULL when
 * there is none.
 */
function _palefire_hero_tabs(ParagraphInterface $hero): ?ParagraphInterface {
  if (!in_array('guide', _palefire_hero_rules($hero), TRUE)) {
    return NULL;
  }
  $host = $hero;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  if (!$host instanceof NodeInterface || !$host->hasField('field_scroll_section')) {
    return NULL;
  }
  foreach ($host->get('field_scroll_section')->referencedEntities() as $section) {
    if ($section->bundle() !== 'section_tabs' || !$section->isPublished() || !$section->hasField('field_tabs')) {
      continue;
    }
    foreach ($section->get('field_tabs')->referencedEntities() as $tab) {
      if ($tab->isPublished() && _palefire_tab_has_paths($tab)) {
        return $section;
      }
    }
  }
  return NULL;
}

/**
 * Whether a Tab's blocks draw the request paths.
 *
 * TRUE when one of its published Guide texts has a paragraph that is only
 * "[request-paths]" (palefire_preprocess_paragraph__guide_text()): the
 * Special Collections homepage's Research tab.
 */
function _palefire_tab_has_paths(ParagraphInterface $tab): bool {
  foreach ($tab->hasField('field_guide_blocks') ? $tab->get('field_guide_blocks')->referencedEntities() : [] as $block) {
    if ($block->bundle() === 'guide_text' && $block->isPublished() && $block->hasField('field_block_body')
      && preg_match('#<p>\s*\[request-paths\]\s*</p>#i', (string) $block->get('field_block_body')->value)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-hero.
 *
 * Landing hero (scripts/palefire_landing_hero_setup.php) is the landing
 * section without the search form, and it shares the bento_search fields:
 * the same variables, plus hero, which includes/landing.html.twig reads.
 * input_id only keeps the Visit card's ids unique on the page.
 *
 * With both a map and a Visit strip, the map's key is an index across the
 * map's full width (#pf_key_indexed, read as map.key_indexed), the rooms and
 * the drawing one section; hero_rooms is its count, for the section's rule.
 * The strip follows as a section of its own (includes/landing.html.twig).
 */
function palefire_preprocess_paragraph__landing_hero(array &$variables): void {
  palefire_preprocess_paragraph__bento_search($variables);
  $variables['hero'] = TRUE;
  $variables['hero_rooms'] = 0;
  $paragraph = $variables['paragraph'] ?? NULL;
  if ($paragraph instanceof ParagraphInterface) {
    $variables['landing']['input_id'] = 'pf-hero-' . $paragraph->id();
    // The cover's warm light from the film's edge (_landing-features.scss,
    // --pf-cover-glow): on unless the hero's Spotlight box is unticked
    // (field_hero_spotlight, scripts/palefire_hero_spotlight_setup.php).
    $variables['hero_spotlight'] = !$paragraph->hasField('field_hero_spotlight')
      || $paragraph->get('field_hero_spotlight')->isEmpty()
      || (bool) $paragraph->get('field_hero_spotlight')->value;
    $variables['hero_index'] = _palefire_hero_index($paragraph);
    $variables['hero_tiles'] = _palefire_hero_tiles($paragraph, $variables);
    $variables['quick_guide'] = _palefire_quick_guide($paragraph, $variables);
    // The page's Section tabs over the Quick Start (_palefire_hero_tabs()):
    // tabs and tabs_label as the paragraph's template gets them; the tab
    // with the request paths shows the Quick Start. The page's tag redraws
    // the hero when its sections change.
    $variables['quick_tabs'] = NULL;
    if ($tabs = _palefire_hero_tabs($paragraph)) {
      $tab_variables = ['paragraph' => $tabs];
      palefire_preprocess_paragraph__section_tabs($tab_variables);
      CacheableMetadata::createFromRenderArray($tab_variables)->applyTo($variables);
      $variables['quick_tabs'] = [
        'tabs' => $tab_variables['tabs'],
        'label' => $tab_variables['tabs_label'],
        'photos' => _palefire_tab_photos($tab_variables['tabs'], $variables),
        'facts' => _palefire_tab_facts($tab_variables['tabs'], $variables),
      ];
    }
    $host = $paragraph;
    for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
      $host = $host->getParentEntity();
    }
    if ($host instanceof NodeInterface) {
      CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($host)->applyTo($variables);
    }
    $variables['hero_banners'] = _palefire_hero_banners($paragraph, $variables);
    $variables['hero_blog'] = _palefire_hero_blog_banner($paragraph, $variables);
    $variables += _palefire_hero_map_banner($paragraph, $variables);
    // A unit's homepage (Oral History): the map draws the Find us banner
    // only, with no Rooms and access section of its own; the banner links
    // to the room's page.
    if ($variables['hero_unit'] !== '') {
      $variables['landing_map'] = NULL;
    }
    // Where the film plays (field_hero_video, palefire_hero_video_filter.php):
    // '' beside, in the column; 'faded', 'mono' or 'none' in the main
    // column. Until the field exists, Oral History keeps its faded film.
    $variables['hero_video'] = $paragraph->hasField('field_hero_video')
      ? (string) $paragraph->get('field_hero_video')->value
      : (($variables['hero_unit'] ?? '') === 'oral_history' ? 'faded' : '');
    if (!in_array($variables['hero_video'], ['faded', 'mono', 'none'], TRUE)) {
      $variables['hero_video'] = '';
    }
    // Oral History: the Podcast banner is the newest episode, with Play.
    if (($variables['hero_unit'] ?? '') === 'oral_history') {
      PodcastFeed::heroBanner($variables);
    }
    $variables['oral_history_series'] = isset($variables['hero_index']['series']) ? _palefire_oral_history_series($variables) : [];
    // Contents in the column (field_hero_toc,
    // scripts/palefire_hero_toc_setup.php): the page's sections in place of
    // the Highlights. Until the field exists, Oral History has them.
    $variables['hero_toc'] = $paragraph->hasField('field_hero_toc')
      ? (bool) $paragraph->get('field_hero_toc')->value
      : ($variables['hero_unit'] ?? '') === 'oral_history';
    $variables['hero_toc_sections'] = $variables['hero_toc'] ? _palefire_hero_toc($paragraph, $variables) : [];
    // On the hero the map is a section of the page: its heading is an h2
    // (map.heading_tag). Its own render-cache entry.
    if (!empty($variables['landing_map'])) {
      $variables['landing_map']['#pf_hero'] = TRUE;
      $variables['landing_map']['#cache']['keys'][] = 'pf_hero';
    }
    if (!empty($variables['landing_map']) && !empty($variables['visit'])) {
      $variables['landing_map']['#pf_key_indexed'] = TRUE;
      // The map's render cache: its own entry with the indexed key.
      $variables['landing_map']['#cache']['keys'][] = 'pf_key_indexed';
      // The rooms' count at the end of the section's rule. Any change to a
      // room term redraws it, as it does the map.
      $map = $paragraph->get('field_bento_map')->entity;
      $building = $map->hasField('field_map_building') ? $map->get('field_map_building')->value : NULL;
      $built = _palefire_building_map($building ?: (string) array_key_first(palefire_buildings()), '', $map);
      $variables['hero_rooms'] = count($built['spaces'] ?? []);
      $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], ['taxonomy_term_list:building_space']);
    }
  }
}

/**
 * The Landing hero banners' sizes value.
 *
 * On the stage a picture fills the column's third to the window's height, so
 * the portrait crop is wider than the column: the 648w file up to 1440 from
 * 64rem, and on a portrait tablet (from 44rem) most of the window's width.
 * Under 44rem the lead fills the film's box, across the phone, and the other
 * pictures don't load.
 */
const PALEFIRE_HERO_BANNER_SIZES = '(min-width: 64rem) 46vw, (min-width: 44rem) 90vw, 100vw';

/**
 * A hero banner's picture as a URL, for the title's letters, or ''.
 *
 * The file the column shows from 44rem (the portrait cover's md), so the
 * letters (_landing-features.scss, pf-title-feature) cost no second download.
 */
function _palefire_hero_banner_still($image, CacheableMetadata $cache): string {
  $file = $image?->entity;
  $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('tile_showcase_portrait_md');
  if (!$file instanceof FileInterface || !$style) {
    return '';
  }
  $cache->addCacheableDependency($file);
  $cache->addCacheableDependency($style);
  return \Drupal::service('file_url_generator')->transformRelative($style->buildUrl($file->getFileUri()));
}

/**
 * The Landing hero's banners, from its optional field, or [].
 *
 * field_hero_banners is added in the UI (Landing hero > Manage fields), like
 * the Quick Guide fields: an entity reference to Content (Tile and Modular
 * page), up to five values (five show on the 5-column grid, four on the
 * 4-column one). Each becomes a tall banner under the search
 * (includes/landing.html.twig), read through _palefire_node_card() as the
 * Tile showcase reads its tiles, so a banner looks and links as that tile
 * does there: title, url, label (its Category) and the portrait cover. A
 * node the visitor can't view is left out.
 */
function _palefire_hero_banners(ParagraphInterface $paragraph, array &$variables): array {
  if (!$paragraph->hasField('field_hero_banners')) {
    return [];
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $banners = [];
  foreach ($paragraph->get('field_hero_banners') as $item) {
    $node = $item->entity;
    $card = $node instanceof NodeInterface ? _palefire_node_card($node, $cache, 140) : NULL;
    if (!$card) {
      continue;
    }
    $banners[] = [
      'title' => $card['title'],
      'url' => $card['url'],
      'label' => $card['label'],
      'image' => $card['image_item'] ? _palefire_responsive_cover($card['image_item'], 'tile_showcase_portrait', $cache, PALEFIRE_HERO_BANNER_SIZES) : NULL,
      'still' => _palefire_hero_banner_still($card['image_item'] ?? NULL, $cache),
      'object' => _palefire_cover_object_label($node),
    ];
    if (count($banners) === 5) {
      break;
    }
  }
  $cache->applyTo($variables);
  return $banners;
}

/**
 * The page's sections after the Landing hero, for its column's contents.
 *
 * With Contents in the column ticked (hero_toc), the column lists the
 * hero's own sections (includes/landing.html.twig, from hero_index) and
 * then these: each section the TOC lists, numbered as
 * palefire_preprocess_field() numbers its rule, so the column's numbers are
 * the page's. Keys: num ('' for a section with no rule), label (its
 * Eyebrow, the podcast's "The podcast"), title, url ('#' . its anchor),
 * episode (the podcast's: the newest episode's banner, from
 * PodcastFeed::heroBanner(), for its picture and Play).
 */
function _palefire_hero_toc(ParagraphInterface $hero, array &$variables): array {
  $host = $hero;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  if (!$host instanceof NodeInterface || !$host->hasField('field_scroll_section')) {
    return [];
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $anchors = PalefireHooks::sectionData($host);
  $drawn = _palefire_hero_tabs($hero)?->id();
  $episode = NULL;
  foreach ($variables['hero_banners'] ?? [] as $banner) {
    if (!empty($banner['episode'])) {
      $episode = $banner;
      break;
    }
  }
  $count = 0;
  $after = FALSE;
  $rows = [];
  foreach ($host->get('field_scroll_section')->referencedEntities() as $section) {
    if (!$section instanceof ParagraphInterface || !$section->isPublished()) {
      continue;
    }
    if ($section->bundle() === 'landing_hero') {
      $count += count(_palefire_hero_index($section));
      $after = $after || $section->uuid() === $hero->uuid();
      continue;
    }
    if ($section->id() === $drawn) {
      continue;
    }
    $cache->addCacheableDependency($section);
    $num = '';
    $label = '';
    $podcast = FALSE;
    if ($section->hasField('field_tile_eyebrow') && !$section->get('field_tile_eyebrow')->isEmpty()) {
      $num = sprintf('%02d', ++$count);
      $label = (string) $section->get('field_tile_eyebrow')->value;
    }
    elseif (PodcastFeed::isSection($section)) {
      $num = sprintf('%02d', ++$count);
      $label = (string) t('The podcast');
      $podcast = TRUE;
    }
    elseif (_palefire_location_index($section, $cache)) {
      $num = sprintf('%02d', ++$count);
    }
    $data = $anchors[$section->uuid()] ?? NULL;
    if (!$after || !$data || !$data['toc']) {
      continue;
    }
    $rows[] = [
      'num' => $num,
      'label' => $label,
      'title' => $data['label'],
      'url' => '#' . $data['anchor'],
      'episode' => $podcast ? $episode : NULL,
    ];
  }
  $cache->applyTo($variables);
  return $rows;
}

/**
 * The Landing hero's unit and map banner, from its map's Here room.
 *
 * A hero whose Building map marks a room "here" (field_map_here, e.g.
 * hill_memorial.oral_history) is the homepage of the unit in that room
 * (/v2/oralhistory, scripts/palefire_oral_history_page.php):
 * - hero_unit: the room's key ('oral_history'), or ''. In
 *   includes/landing.html.twig it picks that unit's search, buttons and
 *   Quick Start; '' keeps Special Collections'.
 * - hero_map_banner: the first of the banners, before the configured ones,
 *   or NULL. Its picture is the building's drawing with the room lit
 *   (static: no controls in it), so the column rests on where the unit is.
 *   It links down to Hours and directions, else to the room's location page
 *   (url), the unit's homepage having no Rooms and access section
 *   (palefire_preprocess_paragraph__landing_hero(), _palefire_hero_rules()). Keys: template, spaces (every room, none a
 *   link), lit, title, floor, building, anchor, url.
 *
 * @return array
 *   ['hero_unit' => string, 'hero_map_banner' => ?array].
 */
function _palefire_hero_map_banner(ParagraphInterface $paragraph, array &$variables): array {
  $none = ['hero_unit' => '', 'hero_map_banner' => NULL];
  $map = $paragraph->hasField('field_bento_map') ? $paragraph->get('field_bento_map')->entity : NULL;
  if (!$map instanceof ParagraphInterface || !$map->isPublished() || !$map->hasField('field_map_here')) {
    return $none;
  }
  $here = trim((string) $map->get('field_map_here')->value);
  if ($here === '') {
    return $none;
  }
  $building = ($map->hasField('field_map_building') ? $map->get('field_map_building')->value : NULL) ?: (string) array_key_first(palefire_buildings());
  $built = _palefire_building_map($building, $here, $map);
  if (!$built) {
    return $none;
  }
  CacheableMetadata::createFromRenderArray($variables)
    ->merge(CacheableMetadata::createFromRenderArray($built['cache']))
    ->applyTo($variables);
  if ($built['here'] === '') {
    return $none;
  }
  $room = $built['spaces'][$built['here']];
  return [
    'hero_unit' => $built['here'],
    'hero_map_banner' => [
      'template' => $built['template'],
      // Every room, as on a location page, none a link (the banner is one).
      'spaces' => array_map(static fn (array $space): array => ['url' => ''] + $space, $built['spaces']),
      'lit' => $built['here'],
      'title' => $room['title'],
      'floor' => $room['floor'],
      'building' => $built['label'],
      'anchor' => $built['uid'] . '-heading',
      // The room's own page, for a homepage with no Hours and directions.
      'url' => (string) ($room['url'] ?? ''),
    ],
  ];
}

/**
 * The oral history series for Oral History's homepage, A to Z.
 *
 * From Combined Search itself (palefire_search's LocalSearch::seriesCounts()
 * with no words: its series list, OralHistorySeries, and how many indexed
 * interviews each has), so a series' count is what its link lists. A series
 * with none yet is left out. Each links to Combined Search browsing that
 * series (no words, oral_histories:series:<name>). The index's list tag
 * redraws it when records change.
 *
 * Each row also has its short description and its fuller one: an editor's,
 * from the series' term in the Oral history series vocabulary
 * (_palefire_oral_history_series_terms()), else the theme's own
 * (_palefire_oral_history_series_descriptions(),
 * _palefire_oral_history_series_details()); and the radius its tape
 * pack is wound to on its card's reel (includes/series-reel.html.twig): the
 * pack's area grows with the count, from the hub (50) to full (136) for the
 * largest series.
 *
 * @return array
 *   [name, count, url, description, details, pack] rows, or [] without
 *   the module.
 */
function _palefire_oral_history_series(array &$variables): array {
  if (!\Drupal::hasService('palefire_search.local')) {
    return [];
  }
  try {
    $counts = \Drupal::service('palefire_search.local')->seriesCounts('oral_histories', '');
  }
  catch (\Throwable $e) {
    \Drupal::logger('palefire')->error('Oral history series could not be listed: @message', ['@message' => $e->getMessage()]);
    return [];
  }
  // The terms' list tag redraws it when an editor saves a series' term.
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], ['search_api_list:bento_search', 'taxonomy_term_list']);
  $rows = [];
  $terms = _palefire_oral_history_series_terms();
  $descriptions = array_merge(_palefire_oral_history_series_descriptions(), array_filter(array_map(static fn (array $term): string => $term['description'], $terms)));
  $details = array_merge(_palefire_oral_history_series_details(), array_filter(array_map(static fn (array $term): string => $term['details'], $terms)));
  $max = max(1, ...array_map('intval', array_values($counts) ?: [1]));
  foreach ($counts as $name => $count) {
    if ($count > 0) {
      $rows[] = [
        'name' => (string) $name,
        'count' => (int) $count,
        'description' => $descriptions[strtr((string) $name, ["'" => '’'])] ?? '',
        'details' => $details[strtr((string) $name, ["'" => '’'])] ?? '',
        'pack' => round(sqrt(2500 + (18496 - 2500) * min(1, $count / $max)), 1),
        'url' => '/v2/search?' . http_build_query([
          'mode' => 'special',
          'source' => ['oral_histories'],
          'refine' => ['oral_histories:series:' . $name],
        ], '', '&', PHP_QUERY_RFC3986),
      ];
    }
  }
  return $rows;
}

/**
 * The editors' descriptions of the oral history series, by name.
 *
 * Each series may have a term in the Oral history series vocabulary
 * (oral_history_series, set up by hand in Drupal; its terms are seeded by
 * scripts/palefire_oral_history_series_terms.php), named as the series is.
 * Its Short summary (field_short_summary) is the series' short description
 * and its Description the fuller one, as plain text. An empty field, an
 * unpublished term or no term leaves the theme's own. Without the vocabulary
 * or the field, nothing is read and the theme's own stand.
 *
 * @return array
 *   ['description' => string, 'details' => string] by series name, with
 *   straight apostrophes as ’ (as the theme's own are keyed).
 */
function _palefire_oral_history_series_terms(): array {
  $plain = static fn (?string $text): string => trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags((string) $text), ENT_QUOTES | ENT_HTML5, 'UTF-8')) ?? '');
  $out = [];
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    if (!\Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary')->load('oral_history_series')) {
      return [];
    }
    foreach ($storage->loadByProperties(['vid' => 'oral_history_series', 'status' => 1]) as $term) {
      $name = strtr(trim((string) $term->label()), ["'" => '’']);
      if ($name === '') {
        continue;
      }
      $out[$name] = [
        'description' => $term->hasField('field_short_summary') ? $plain($term->get('field_short_summary')->value) : '',
        'details' => $plain($term->get('description')->value),
      ];
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('palefire')->error('Oral history series terms could not be read: @message', ['@message' => $e->getMessage()]);
    return [];
  }
  return $out;
}

/**
 * Short descriptions of the oral history series, by name.
 *
 * From the Williams Center's former series page (the line under each
 * series' name), with straight apostrophes as ’ (names are matched that
 * way). The eleven series added since the old page have lines written in
 * November 2026 from their abstracts, the exhibitions' text and partners'
 * pages. A series with none simply has no description in the deck's
 * caption (Oral History's homepage, js/series-deck.js).
 *
 * @return string[]
 *   Description by series name.
 */
function _palefire_oral_history_series_descriptions(): array {
  return [
    '272 Slaves: Discovering Louisiana and Georgetown’s Past' => 'Descendants of the 272 people Georgetown sold in 1838, interviewed by LSU students.',
    'Acadian Handicraft Project' => 'Recollections from women involved with the Acadian Handicraft Project (1942–1962) supported by the General Education Board to sustain French language and culture in Louisiana.',
    'Adrienne LaCour - Four Corners Series' => 'Focuses on land use patterns and community history in the predominately African American community of Four Corners, located near New Iberia, Louisiana.',
    'Americans in Vietnam' => 'Interviews with American servicemen and Vietnamese civilians living in America around the time the Vietnam War was ending in the mid-1970s.',
    'Baton Rouge Blues' => 'Focusing on Baton Rouge-area blues musicians and the history of blues music in the city.',
    'Baton Rouge History and Culture' => 'Documenting the culture and history of the city of Baton Rouge, Louisiana.',
    'Baton Rouge Insurance Industry' => 'Interviews with insurance industry leaders in Baton Rouge.',
    'Baton Rouge’s LGBTQ Community: Then and Now' => 'Narratives from LGBTQ individuals in Baton Rouge, Louisiana.',
    'Bayou Lafourche Oral History Project' => 'Dr. Mike Pasquier conducted these interviews to better understand the role of religion in the life of residents along Louisiana’s Bayou Lafourche.',
    'British Voices from South Asia' => 'Experiences of Britons who lived and worked in pre-independence India, focusing on the contact of cultures and cultural identity.',
    'Brusly Centennial Oral History Project' => 'Focusing on the history of the town of Brusly in West Baton Rouge Parish, Louisiana.',
    'Civil Rights Series' => 'Documenting the Civil Rights Movement in Baton Rouge and surrounding parishes.',
    'Gillis Long Series' => 'Interviews with friends and critics of Democratic Congressman Gillis Long.',
    'History of Louisiana Cooperative Extension Services' => 'Documenting the impact of Cooperative Extension Services on the state of Louisiana.',
    'Hurricane Betsy Survivor Stories' => 'Residents of New Orleans’ Lower Ninth Ward recall how they survived Hurricane Betsy in 1965 and the aftermath of the storm.',
    'The Jazz and Heritage Festival and Foundation Class Project: 2014' => 'Performers, artists, vendors and crew of Jazz Fest, interviewed by LSU students.',
    'LGBT+ Archives Project of Louisiana' => 'LGBT+ activists and media makers, recorded with the LGBT+ Archives Project of Louisiana.',
    'Louisiana Sea Grant Coastal Change Oral Histories Project' => 'South Louisiana high school students interviewed members of their communities about the effects of coastal change.',
    'Louisiana State Medical Society' => 'Leaders of the Louisiana State Medical Society on their careers and the profession.',
    'McKinley High School Oral History Project' => 'McKinley High school students, with assistance from faculty and students from LSU’s College of Education, conducted interviews on African American experiences in Baton Rouge.',
    'Michael Mulhern Centenarians Series' => 'Centenarians recall life under slavery and service in the Spanish American War.',
    'Military Series' => 'Documenting Louisiana’s military tradition, primarily focusing on World War II.',
    'Mossville History Project' => 'Residents of Mossville, a historic African American community in Calcasieu Parish.',
    'New Orleans New Wave Carnival Krewes' => 'Members of New Orleans’ newer, do-it-yourself carnival krewes on making Mardi Gras.',
    'Our Lady of the Lake, "Under Pressure: A Louisiana Hospital’s COVID-19 Experience"' => 'Staff of Our Lady of the Lake in Baton Rouge on caring for patients through COVID-19.',
    'Perique Tobacco' => 'Documenting the cultivation and processing of Perique tobacco, one of Louisiana’s most unique agricultural products.',
    'Political Series' => 'Focusing on Louisiana’s rich political history.',
    'Robert Ray Cox Series' => 'Chronicles the restoration and landscaping of the gardens of the Shadows on the Teche, a historic home in New Iberia, Louisiana.',
    'Sicilian-Italian Oral History Project' => 'Louisianians of Sicilian descent on immigrant families, farming and community life.',
    'Sue Hebert Series' => 'Documenting the local history of Plaquemine, Bayou Sorrel and Bayou Chene, in the Atchafalaya Basin area of Louisiana.',
    'University History' => 'Interviews with faculty, staff, and alumni conducted by LSU Recording Services and Williams Center staff, volunteers, and graduate students.',
    'Various Topics' => 'Biographical and local history interviews on multiple topics.',
    'Voices in the Storm: Hurricane Katrina Survivors in Pointe Coupee Parish' => 'People who lived through Hurricane Katrina, interviewed in Pointe Coupee Parish in 2007.',
    'Volunteers of America' => 'Focusing on the history of the Baton Rouge chapter of the Volunteers of America.',
    'West Baton Rouge Parish Remembrance' => 'The history, experiences, and contributions of African Americans in West Baton Rouge Parish, Louisiana.',
    'WJBO Radio Interviews' => 'Recordings of interviews broadcast on WJBO’s radio program "Topic Today" in the 1970s.',
    'Women in Louisiana’s Environmental Movement' => 'Women who led Louisiana’s grassroots environmental movement, and those who worked beside them.',
    'Women in Politics' => 'Women in Louisiana politics on their paths to office and public life.',
    'Women’s Council of Greater Baton Rouge' => 'Focuses on prominent Baton Rouge-area women and women’s rights activism.',
  ];
}

/**
 * Fuller descriptions of the oral history series, by name.
 *
 * The Description in each series' details on the Williams Center's former
 * series page, with straight apostrophes and quotes made curly and two
 * slips mended (affected, to document). A series' card is described by
 * this (else its short line); the deck's caption shows it when it fits in
 * six lines, else the short line (js/series-deck.js). Civil Rights' there
 * repeats Brusly's, and Robert Ray Cox's is its short line, so they have
 * none here. The eleven series added since have ones written with their
 * short lines.
 *
 * @return string[]
 *   Description by series name.
 */
function _palefire_oral_history_series_details(): array {
  return [
    '272 Slaves: Discovering Louisiana and Georgetown’s Past' => 'Recorded in 2017 and 2018 by students in an LSU Honors College course taught by Williams Center director Jennifer A. Cramer, these interviews are with descendants of the 272 enslaved people Georgetown’s Jesuits sold to Louisiana plantations in 1838, members of the Maringouin community, and Georgetown faculty.',
    'Acadian Handicraft Project' => 'The Acadian Handicraft Project existed from 1942 until 1962, growing out of an earlier effort by the General Education Board to support French language and culture in Louisiana. In 1942, Louisiana State University’s General Extension Program picked up the project. Louise Olivier (d. 1962), served as the Extension Program’s field representative and purchased crafts, mostly textiles, from Acadian women and marketed them throughout the state. Interviewers Pam Rabalais of LSU’s School of Human Ecology and Yvonne Olivier conducted these interviews with women who participated in the project for the Southeastern Crafts Revival at the University of South Carolina’s McKissick Museum. Tapes and transcripts are also housed at the McKissick Museum.',
    'Adrienne LaCour - Four Corners Series' => 'Interviews for this series were conducted by Adrienne LaCour as part of the research for her MA thesis in landscape architecture at LSU. Interviews focused on the experience of both blacks and whites on sugarcane farms at Four Corners, an unincorporated community south of Franklin, Louisiana, and near New Iberia, Louisiana. LaCour was interested in land use patterns and community history in the predominately African-American community of Four Corners.The topics of the interviews include life of workers on plantations, recollections of grandparents who were slaves, growing and processing of sugar cane, foods grown for self-subsistence, and horse and buggy transportation. Interviewees discuss South Coast and other plantations of the Four Corners area, plantation stores and debt peonage, recreational activities including gambling and baseball, Sunday visiting, and dancing. Other topics include the impact of World War Two, various religious beliefs, burial and birth traditions, and natural remedies for childhood illnesses.',
    'Americans in Vietnam' => 'LSU Professor Beatrice Spade and students conducted these interviews with American servicemen and a few Vietnamese civilians living in America. The interviewees discuss their experiences in Vietnam and their attitudes toward American involvement in Southeast Asia. In addition, the soldiers, representing a variety of ranks and all branches of the military, discuss their military training and contact with the Vietnamese people and their culture, and the civilians relate their background and the experience of immigrating to the United States.',
    'Baton Rouge Blues' => 'This project focuses on the careers of Baton Rouge-area blues musicians and the history of blues music in the city of Baton Rouge. Interviewees discuss prominent blues musicians, local and national blues music venues, the blues scene in other U.S. and some international cities, record labels, recording contracts and record sales, musical training and mentorship, touring, and radio broadcasts among other topics.',
    'Baton Rouge History and Culture' => 'Interviews in this series focus on topics relating to the city of Baton Rouge, Louisiana.',
    'Baton Rouge Insurance Industry' => 'Interviews conducted by R. Robert Rackley with leaders in the Baton Rouge insurance industry. Interviewees include the first woman to sell insurance in the city, Chartered Life Underwriters, and a previous director of the LSU Institute of Insurance Marketing.',
    'Baton Rouge’s LGBTQ Community: Then and Now' => 'Conducted by students in Elaine Maccio’s class, Social Work with Lesbian, Gay, Bisexual, and Transgender People, these interviews focus on the LGBTQ community in Baton Rouge, Louisiana, from the 1950s to the 2000s. Interviewees describe what it was like to identify as gay at a time when negative stereotypes were pervasive, and discuss the changes they’ve witnessed as LGBTQ causes have become more mainstream. Interviewees share personal experiences of marriages and relationships, coming out, and recount their involvement and activism in the LGBTQ and Baton Rouge communities whether social, political, religious, or related to HIV/AIDS causes.',
    'Bayou Lafourche Oral History Project' => 'Dr. Mike Pasquier partnered with the Williams Center on this project, and also with LSU’s Coastal Sustainability Studio, and Communication across the Curriculum (CxC) program. Pasquier’s goal is to use these interviews to garner a better understanding of how the culture of south Louisiana is being affected by wetland loss. Interviewees from Lockport, Thibodaux, Cut Off, and other towns discuss growing up in Golden Meadow, the role of religion and local churches, careers in sugar cane farming, paper milling, and the oil and gas business, fishing and hunting, the changing landscape of the bayou, local plantations, and many other topics.',
    'British Voices from South Asia' => 'Folklorists de Caro and Jordan interviewed Britons who lived and worked in pre-independence India as colonial administrators, civil servants, missionaries, soldiers, forestry officials, and engineers. Many interviews focus on daily life in India and the contact of cultures and cultural identity.',
    'Brusly Centennial Oral History Project' => 'Interviews focus on the history of the town of Brusly, located in West Baton Rouge Parish, Louisiana. The interview project was done in conjunction with the Brusly Centennial Committee for the celebration of the town’s centennial in 2001.',
    'Gillis Long Series' => 'Dr. Gary Huey conducted these interviews with friends and critics of Democratic Congressman Gillis Long (U.S. House of Representatives, 1963-65 and 1973-85) for a biography of Long.',
    'History of Louisiana Cooperative Extension Services' => 'This project is a collaboration between LSU Libraries, the LSU AgCenter, and the LSU College of Agriculture. In celebration of the centennial of the Smith-Lever Act, this oral history project documents the impact of Cooperative Extension Services on the state of Louisiana. The Smith-Lever Act, passed in 1914, helped finance outreach endeavors through Land-Grant Universities, allowing for Cooperative Extension Services across the nation to present research-based information to the public. This series on Louisiana Cooperative Extension Services includes personal stories told by LCES professionals. Topics include experiences in 4-H clubs, LCES’ impact on recovery after natural disasters, livestock shows, the role of research, the impact of mechanization on farming, and more. Many interviewees discuss their upbringing and early education as it relates to their later experience with LCES.',
    'Hurricane Betsy Survivor Stories' => 'Nilima Mwendo conducted these interviews in 2003 with residents of New Orleans’ Lower Ninth Ward who survived Hurricane Betsy when it made landfall on September 9, 1965. Interviews focus on the Lower Ninth Ward neighborhood from the 1930s and 40s, when the area was only partially developed and rural, to the early 2000s. Interviewees discuss their experiences during the hurricane, the evacuation of the neighborhood, disaster relief from the state and federal government and Red Cross, and the hardships they and other residents encountered in the months and years they spent rebuilding their homes and lives after they returned to the neighborhood. Interviewees describe the neighborhood before Betsy and discuss changes in the community after the storm. Several interviewees also discuss social activism and advocacy for the neighborhood in the 1960s and 70s.',
    'The Jazz and Heritage Festival and Foundation Class Project: 2014' => 'Recorded in 2014 by students in an LSU anthropology class with Helen Regis, these interviews are with people who make the New Orleans Jazz & Heritage Festival: musicians, poster and craft artists, food vendors, a Mardi Gras Indian queen, a WWOZ program director and the crews who build the site.',
    'LGBT+ Archives Project of Louisiana' => 'Recorded in 2019 by members of the LGBT+ Archives Project of Louisiana, trained with the Williams Center’s help, these interviews document gay and lesbian life and activism in Louisiana in the 1980s and 1990s, with a founding member of the Louisiana Lesbian and Gay Political Action Caucus and a videographer of the community.',
    'Louisiana Sea Grant Coastal Change Oral Histories Project' => 'Louisiana’s coast is washing away at an alarming rate, and as the land disappears, residents are affected economically and culturally. In 2012, Louisiana Sea Grant partnered with the Williams Center and implemented an oral history project in which high school students in South Louisiana recorded information on coastal change and explored the implications of this change on their communities. One primary goal of the project, beyond creating primary resources documenting this phenomenon, was to increase environmental literacy among students who live in communities at risk and to engage them in a stewardship project that would help them interact with community elders through the use of oral history. Interviewees in this series discuss climate change, eroding coastlines and wetlands, sea level rise, saltwater intrusion, dredging, channelization, dwindling biodiversity, coastal restoration projects, the BP oil spill, pollution, the U.S. Army Corps of Engineers, FEMA, and Hurricanes Andrew, Audrey, Ike, Isaac, Katrina and Rita. Many also discuss the sugarcane industry, hunting, fishing and trapping, their families and childhoods, and the culture of their local communities.',
    'Louisiana State Medical Society' => 'Begun by longtime member Trenton James to carry the society’s written history forward, these interviews (2014–2019) are with past presidents and leaders of the Louisiana State Medical Society, among them two presidents of the American Medical Association, a dean of LSU Medical School and a congressman.',
    'McKinley High School Oral History Project' => 'McKinley High School students, with the assistance of faculty and students from LSU’s College of Education, conducted interviews focusing on the African American experience in Baton Rouge, Louisiana. In 1995, students began interviewing community members on the history of McKinley High School, established in 1926 as the first high school for African American students in Baton Rouge. The interviews continued in subsequent years, focusing on African American businesses during the period of segregation, the history and role of African American churches, the Baton Rouge Bus Boycott, and African American social organizations.',
    'Michael Mulhern Centenarians Series' => 'Michael Mulhern, an LSU graduate student specializing in Civil War History, conducted these interviews with centenarians. His first interview, with former slave Sylvester Magee, led him information on other former slaves, Polly Mason and Sarah Baker. He also interviewed Spanish-American War Veteran, Joseph Favret. Mulhern donated his interviews to the Williams Center in the 1990s.',
    'Military Series' => 'This ongoing interview series documents Louisiana’s military tradition and focuses primarily on World War II. Veterans of the Korean, Vietnam, and Gulf Wars are also interviewed.',
    'Mossville History Project' => 'Recorded in 2015 and 2016 with the Imperial Calcasieu Museum to preserve the history of Mossville, a historic African American community in Calcasieu Parish, as industrial expansion and property buyouts emptied it. Residents remember family, church, school and work in the nearby plants.',
    'New Orleans New Wave Carnival Krewes' => 'Interviews by anthropologist Martha Radice (2017–2019) with founders, captains, artists and members of New Orleans’ “new wave” carnival krewes, among them Krewe du Vieux, Muses and ’tit Rəx, and with carnival historian Henri Schindler, on satire, costume, float making and community.',
    'Our Lady of the Lake, "Under Pressure: A Louisiana Hospital’s COVID-19 Experience"' => 'Recorded in 2024 with Our Lady of the Lake and LSU’s Manship School of Mass Communication, these interviews are with the Baton Rouge hospital’s leaders, physicians, nurses, pharmacists and researchers on meeting the COVID-19 pandemic from 2020 to 2022, and caring for patients and one another.',
    'Perique Tobacco' => 'Persephone Hintlian conducted these interviews to document the cultivation and processing of Perique tobacco, one of Louisiana’s most unique agricultural products. In the past, Perique tobacco has been one of St. James Parish’s most important cash crops. The Percy Martin family of the Grand Point area ensured the survival of the crop. In 1999, Percy Martin almost left the Perique production industry but entered in a partnership with Christopher Brown and Matthew Nichols, both of New Orleans. Martin then continued to plant and process Perique tobacco.',
    'Political Series' => 'This series focuses on Louisiana’s rich political history. Topics include the civil rights movement, the Tidelands case, stump speaking, Louisiana’s oil industry, and the administrations of governors from Huey Long through John McKeithen.',
    'Sicilian-Italian Oral History Project' => 'Interviews by Michael Agnello (2017–2018) with first- and second-generation Sicilian and Italian Americans, many from Tangipahoa Parish and Baton Rouge, on families who came through New Orleans around 1900, cane and strawberry farming, family groceries, faith, food and keeping Sicilian ways.',
    'Sue Hebert Series' => 'This series documents the local history of the Atchafalaya Basin area, including Plaquemine, Bayou Sorrel, and Bayou Chene. Interviewees discuss lumbering, ginning moss, the Plaquemine Locks, harvesting sugarcane, and social life and customs of the area in the early twentieth century.',
    'University History' => 'Interviews with faculty, staff, and alumni conducted by Williams Center staff, LSU Recording Services, volunteers, and graduate students, focusing on the history of Louisiana State University. Various topics are covered and since interviews are often life narratives, multiple topics arise, including major historic events outside of the scope of LSU history, including, for example, the 1927 Flood, the Great Depression, Governor Huey Long, military history, and civil rights.',
    'Various Topics' => 'These primarily biographical and regional history interviews were conducted by LSU faculty and students, by Williams Center staff under contract for interviewees’ families, or were donated to the Williams Center. In addition to family history and genealogy, topics covered include: the Association for Women Historians, Lansdowne Plantation in Natchez, Mississippi, the New Llano Cooperative Colony near Leesville, Louisiana, Williams Plantation, architecture, landscape architecture, hurricanes, Mardi Gras celebrations, Louisiana fisheries, the sugarcane industry, Native American and African American artists, New Orleans history and music, and topics of international interest such as the Mexican Revolution and Nazi propaganda films.',
    'Voices in the Storm: Hurricane Katrina Survivors in Pointe Coupee Parish' => 'Recorded in Pointe Coupee Parish in 2007, these interviews are with people who lived through Hurricane Katrina, among them evacuees from New Orleans, St. Bernard and Plaquemines Parishes, a nurse who helped evacuate a flooded hospital, teachers and the longtime Orleans Parish coroner.',
    'Volunteers of America' => 'Interviews for this series were conducted by students enrolled in two service learning English composition classes at LSU taught by Wade and Susann Dorman. Wanting the service aspect of their course to be based on writing, the Dormans decided to help the Baton Rouge Chapter of Volunteers of America (VOA) write a history of their organization. Involved in all aspects of the project, their students did background research, conducted, transcribed and indexed the interviews with key figures, and wrote “Giving Shelter,” a history of the Baton Rouge Chapter of VOA.',
    'West Baton Rouge Parish Remembrance' => 'Interviews focusing on the history, experiences, and contributions of the African American community in West Baton Rouge Parish, Louisiana. This project was funded through a grant to the West Baton Rouge Parish Library in Port Allen, Louisiana, from the West Baton Rouge Museum.',
    'WJBO Radio Interviews' => 'Recordings of interviews broadcast on WJBO’s radio program “Topic Today.” On the program, Jim Harris talked to state and local politicians, economists, and LSU administrators. Topics discussed include improvements to Baton Rouge, elections, federal subsidies to cities, white flight, the energy crisis, inflation, Louisiana’s economic status, and trends in higher education.',
    'Women in Louisiana’s Environmental Movement' => 'Begun in 1999 by activist Peggy Frankland with the Williams Center, these interviews record leaders of Louisiana’s grassroots environmental movement, most of them women, on fighting pollution and hazardous waste from the 1970s on. They are the basis of her book Women Pioneers of the Louisiana Environmental Movement.',
    'Women in Politics' => 'Part of the Louisiana Women in Politics Oral History Project, led since 2022 by LSU’s Reilly Center for Media & Public Affairs with partner universities, these interviews are with state legislators, a Baton Rouge mayor-president, a commissioner of elections and other women in Louisiana public life.',
    'Women’s Council of Greater Baton Rouge' => 'The Women’s Council of Greater Baton Rouge, a nonprofit organization committed to connecting, promoting, and empowering women, conducted these interviews in preparation for a video presentation of Baton Rouge area women who have made history. Interviewees include a female attorney, a state legislator, and women’s rights activists.',
  ];
}

/**
 * A page's object label for its cover picture, or NULL.
 *
 * The values includes/object-label.html.twig takes, from the optional
 * field_exhibit_cover_* fields (scripts/palefire_exhibit_cover_label.php):
 * maker, title, date, medium, and url (the record link, https only). With
 * no title there is no label. The caller's cache metadata already
 * depends on the node.
 */
function _palefire_cover_object_label(NodeInterface $node): ?array {
  $node = \Drupal::service('entity.repository')->getTranslationFromContext($node);
  $label = [];
  foreach (['maker', 'title', 'date', 'medium', 'url'] as $key) {
    $field = 'field_exhibit_cover_' . $key;
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      $label[$key] = trim((string) $node->get($field)->value);
    }
  }
  if (isset($label['url']) && !preg_match('#^https://[^\s"<>]+$#', $label['url'])) {
    unset($label['url']);
  }
  return isset($label['title']) ? $label : NULL;
}

/**
 * The Landing hero's last banner: its newest blog post, or NULL.
 *
 * The newest Article in the paragraph's "Blog categories"
 * (field_landing_blog_category, _palefire_blog_posts()), as a banner after
 * the configured ones: title, url, date (and datetime), category, and its
 * Image (field_image) in the banners' portrait style, or NULL, when the
 * banner sets the date large instead (day, "Sep 2026"). Without the field,
 * or with no post, NULL.
 */
function _palefire_hero_blog_banner(ParagraphInterface $paragraph, array &$variables): ?array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $posts = _palefire_blog_posts($paragraph, 1, $cache);
  $post = $posts[0] ?? NULL;
  if ($post) {
    $post['image'] = $post['image_item'] ? _palefire_responsive_cover($post['image_item'], 'tile_showcase_portrait', $cache, PALEFIRE_HERO_BANNER_SIZES) : NULL;
    $post['still'] = _palefire_hero_banner_still($post['image_item'], $cache);
    unset($post['image_item']);
  }
  $cache->applyTo($variables);
  return $post;
}

/**
 * The Landing hero's Quick Guide text, from its optional fields.
 *
 * Each field is added in the UI (Landing hero > Manage fields); a missing or
 * empty one leaves its key out, and includes/landing.html.twig prints the
 * built-in text instead:
 * - field_quick_guide_title (Text, plain): the heading and its TOC label.
 * - field_quick_guide_intro (Text, formatted, long): the line under it.
 * - field_quick_guide_link (Link): the full guide's URL; its link text, if
 *   any, replaces "Full guide".
 * - field_quick_guide_visit (Text, formatted, long): the "Before you
 *   visit" notes under the intro, as a list (an editor's bulleted list),
 *   replacing the built-in ones.
 *
 * Returns ['title', 'intro', 'visit', 'url', 'link_text'], each optional;
 * intro and visit are processed_text render arrays.
 */
function _palefire_quick_guide(ParagraphInterface $paragraph, array &$variables): array {
  $field = static fn (string $name): ?FieldItemListInterface => $paragraph->hasField($name) && !$paragraph->get($name)->isEmpty() ? $paragraph->get($name) : NULL;
  $quick = [];
  if ($title = $field('field_quick_guide_title')) {
    $quick['title'] = trim((string) $title->value);
  }
  if ($intro = $field('field_quick_guide_intro')) {
    $quick['intro'] = [
      '#type' => 'processed_text',
      '#text' => $intro->value,
      '#format' => $intro->format,
    ];
  }
  if ($visit = $field('field_quick_guide_visit')) {
    $quick['visit'] = [
      '#type' => 'processed_text',
      '#text' => $visit->value,
      '#format' => $visit->format,
    ];
  }
  if ($link = $field('field_quick_guide_link')?->first()) {
    $url = $link->getUrl()->toString(TRUE);
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheableDependency($url)
      ->applyTo($variables);
    $quick['url'] = $url->getGeneratedUrl();
    $quick['link_text'] = trim((string) $link->title);
  }
  return array_filter($quick);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-department.
 *
 * Landing department (scripts/palefire_landing_department_setup.php) is a
 * copy of bento_search with the same fields, plus the Landing hero's Tiles
 * (field_hero_tiles): the same variables, plus department and hero_tiles,
 * which includes/landing.html.twig reads. Its own input_id keeps the
 * search's and the Visit card's ids unique on the page.
 */
function palefire_preprocess_paragraph__landing_department(array &$variables): void {
  palefire_preprocess_paragraph__bento_search($variables);
  $variables['department'] = TRUE;
  $paragraph = $variables['paragraph'] ?? NULL;
  if ($paragraph instanceof ParagraphInterface) {
    $variables['landing']['input_id'] = 'pf-department-' . $paragraph->id();
    $variables['hero_tiles'] = _palefire_hero_tiles($paragraph, $variables);
  }
}

/**
 * The newest published Articles in a paragraph's blog categories.
 *
 * The categories are its "Blog categories" field
 * (field_landing_blog_category, Article Category terms): the Landing hero's
 * and From the stacks'. An article matches when its own Article Category
 * (field_article_category) has any of them. Newest by Article Date, then by
 * creation. Without the field, with it empty, or without those Article
 * fields, this is []. The list's cache tag (node_list:article) refreshes
 * the posts when an article is published or changed.
 *
 * Each post: ['title', 'url', 'date', 'datetime', 'day', 'month',
 * 'category', 'excerpt', 'image_item']. category is the article's first
 * category among the paragraph's; day and month ("28", "Sep 2026") set the
 * date large; image_item is its Image (field_image) item, or NULL, for the
 * caller to build in its own style.
 */
function _palefire_blog_posts(ParagraphInterface $paragraph, int $limit, CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:article']);

  $terms = [];
  if ($paragraph->hasField('field_landing_blog_category')) {
    foreach ($paragraph->get('field_landing_blog_category')->referencedEntities() as $term) {
      $cache->addCacheableDependency($term);
      $terms[$term->id()] = $term;
    }
  }
  // Both fields are on Article (Manage fields); without them the query
  // would fail, so the posts just stay out.
  $storages = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
  if (!$terms || !isset($storages['field_article_category'], $storages['field_article_date'])) {
    return [];
  }

  $ids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'article')
    ->condition('status', 1)
    ->condition('field_article_category', array_keys($terms), 'IN')
    ->sort('field_article_date', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, $limit)
    ->execute();
  $repository = \Drupal::service('entity.repository');
  $formatter = \Drupal::service('date.formatter');
  $posts = [];
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($ids) as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }
    $node = $repository->getTranslationFromContext($node);
    $cache->addCacheableDependency($node);
    $url = $node->toUrl()->toString(TRUE);
    $cache->addCacheableDependency($url);

    // In the site's time zone (the field stores UTC).
    $timestamp = (int) $node->getCreatedTime();
    if ($node->hasField('field_article_date') && $node->get('field_article_date')->date) {
      $timestamp = $node->get('field_article_date')->date->getTimestamp();
    }

    // Excerpt: About Text, else the body's summary or text, as plain text.
    $excerpt = '';
    foreach ([['field_about_text', 'value'], ['body', 'summary'], ['body', 'value']] as [$field, $property]) {
      if ($excerpt === '' && $node->hasField($field) && !$node->get($field)->isEmpty()) {
        $excerpt = _palefire_plain_excerpt((string) $node->get($field)->first()->{$property}, 180);
      }
    }

    // The article's first category that the paragraph asks for.
    $term = reset($terms);
    foreach ($node->get('field_article_category') as $item) {
      if (isset($terms[$item->target_id])) {
        $term = $terms[$item->target_id];
        break;
      }
    }

    $posts[] = [
      'title' => $node->label(),
      'url' => $url->getGeneratedUrl(),
      'date' => $formatter->format($timestamp, 'custom', 'M j, Y'),
      'datetime' => $formatter->format($timestamp, 'custom', 'Y-m-d'),
      'category' => $repository->getTranslationFromContext($term)->label(),
      'excerpt' => $excerpt,
      'day' => $formatter->format($timestamp, 'custom', 'j'),
      'month' => $formatter->format($timestamp, 'custom', 'M Y'),
      'image_item' => $node->hasField('field_image') && !$node->get('field_image')->isEmpty() ? $node->get('field_image')->first() : NULL,
    ];
  }
  return $posts;
}

/**
 * The Landing hero's tiles from its Hero tile paragraphs, or [].
 *
 * field_hero_tiles (scripts/palefire_landing_hero_tiles_setup.php): up to
 * three Hero tiles, each a Modular page or a Tile (field_hero_tile_page,
 * read by _palefire_node_card()) with an optional label and line.
 * Empty, or without the field, the template keeps its placeholder tiles.
 * A tile whose page is missing or that the visitor can't view is left out.
 *
 * Each tile has the template's shape: label, title, meta (the line under
 * the title), more (the page's intro as plain text, shown when the tile
 * opens), url, cta, images (one render array, or none: hatched frame) and
 * frames. The image is the card's cover in the tiles' landscape style
 * (tile_showcase_landscape_lg, 1280 x 800), else the original file;
 * decorative and lazy.
 */
function _palefire_hero_tiles(ParagraphInterface $paragraph, array &$variables): array {
  if (!$paragraph->hasField('field_hero_tiles')) {
    return [];
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $tiles = [];
  foreach ($paragraph->get('field_hero_tiles')->referencedEntities() as $tile) {
    if (!$tile instanceof ParagraphInterface || !$tile->hasField('field_hero_tile_page')) {
      continue;
    }
    $cache->addCacheableDependency($tile);
    $page = $tile->get('field_hero_tile_page')->entity;
    $card = $page instanceof NodeInterface ? _palefire_node_card($page, $cache) : NULL;
    if (!$card) {
      continue;
    }
    $image = $card['image_item'] ? _palefire_image_build($card['image_item'], ['tile_showcase_landscape_lg'], $cache) : NULL;

    $tiles[] = [
      'label' => $tile->hasField('field_hero_tile_label') ? (string) $tile->get('field_hero_tile_label')->value : '',
      'title' => $card['title'],
      'meta' => $tile->hasField('field_hero_tile_when') ? (string) $tile->get('field_hero_tile_when')->value : '',
      'more' => $card['note'],
      'url' => $card['url'],
      'cta' => t('Explore'),
      'images' => $image ? [$image] : [],
      'frames' => 1,
    ];
  }
  $cache->applyTo($variables);
  return $tiles;
}

/**
 * A card's Category terms as one label (the hero banners, the tiles).
 *
 * Joined with " + " ("Dept + Medium"), except when one of them is
 * Exhibition: then a space, so it reads as a kind of exhibition ("Digital
 * Exhibition", "Physical Exhibition") rather than two things.
 *
 * @param string[] $labels
 *   The terms' labels, in field order.
 */
function _palefire_card_label(array $labels): string {
  $exhibition = (bool) array_filter($labels, static fn (string $label): bool => mb_strtolower(trim($label)) === 'exhibition');
  return implode($exhibition ? ' ' : ' + ', $labels);
}

/**
 * One Tile or Modular page as a card, or NULL when the visitor can't view it.
 *
 * Tile showcase (field_tiles) and the Landing hero's tiles
 * (field_hero_tile_page) may reference either type (each field's Reference
 * type, Manage fields), so both read their nodes through here and get the
 * same shape:
 * - title, url: the node's own, in the page's language.
 * - label: its Category terms (field_category) as one label
 *   (_palefire_card_label(): "Dept + Medium", "Digital Exhibition"), or ''.
 * - labels: the same terms, one string each ([] when none).
 * - note: plain text from its intro (field_intro), else the body's summary,
 *   else the body, cut at $max; '' when it has none.
 * - image_item: the cover's image item (_palefire_card_image_item()), or
 *   NULL. Each caller builds it in its own image style.
 */
function _palefire_node_card(NodeInterface $node, CacheableMetadata $cache, int $max = 200): ?array {
  $cache->addCacheableDependency($node);
  $access = $node->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  if (!$access->isAllowed()) {
    return NULL;
  }
  $repository = \Drupal::service('entity.repository');
  $node = $repository->getTranslationFromContext($node);
  $url = $node->toUrl()->toString(TRUE);
  $cache->addCacheableDependency($url);

  $labels = [];
  if ($node->hasField('field_category')) {
    foreach ($node->get('field_category') as $term_item) {
      $term = $term_item->entity;
      if (!$term) {
        continue;
      }
      $cache->addCacheableDependency($term);
      $term_access = $term->access('view', NULL, TRUE);
      $cache->addCacheableDependency($term_access);
      if ($term_access->isAllowed()) {
        $labels[] = $repository->getTranslationFromContext($term)->label();
      }
    }
  }

  $note = '';
  foreach ([['field_intro', 'value'], ['body', 'summary'], ['body', 'value']] as [$field, $property]) {
    if ($note === '' && $node->hasField($field) && !$node->get($field)->isEmpty()) {
      $note = _palefire_plain_excerpt((string) $node->get($field)->first()->{$property}, $max);
    }
  }

  return [
    'title' => $node->label(),
    'url' => $url->getGeneratedUrl(),
    'label' => _palefire_card_label($labels),
    'labels' => $labels,
    'note' => $note,
    'image_item' => _palefire_card_image_item($node, $cache),
  ];
}

/**
 * A page's outline for a card with no cover: the page drawn small, blurred.
 *
 * Up to four sections (field_scroll_section, then field_sections) that have
 * a title, each with up to three lines: its blocks' titles and the start of
 * their text (a guide section's field_guide_blocks), else the start of its
 * own body. Landings and untitled sections are skipped. Plain text only; the
 * card prints it aria-hidden, as a picture of the page.
 *
 * @return array
 *   A list of sections: heading (string) and lines (a list of
 *   ['text' => string, 'kind' => 'subhead'|'text']).
 */
function _palefire_page_outline(NodeInterface $node, CacheableMetadata $cache): array {
  $outline = [];
  foreach (PalefireHooks::SECTION_FIELDS as $field) {
    if (!$node->hasField($field)) {
      continue;
    }
    foreach ($node->get($field)->referencedEntities() as $section) {
      if (count($outline) === 4) {
        return $outline;
      }
      if (!$section instanceof ParagraphInterface || !$section->isPublished()
        || in_array($section->bundle(), PalefireHooks::LANDING_BUNDLES, TRUE)
        || !$section->hasField('field_section_title') || $section->get('field_section_title')->isEmpty()) {
        continue;
      }
      $cache->addCacheableDependency($section);
      $blocks = $section->hasField('field_guide_blocks') ? $section->get('field_guide_blocks')->referencedEntities() : [$section];
      $lines = [];
      foreach ($blocks as $block) {
        if (!$block instanceof ParagraphInterface || !$block->isPublished()) {
          continue;
        }
        $cache->addCacheableDependency($block);
        if ($block->hasField('field_block_title') && !$block->get('field_block_title')->isEmpty()) {
          $lines[] = ['text' => _palefire_plain_excerpt((string) $block->get('field_block_title')->value, 60), 'kind' => 'subhead'];
        }
        foreach (['field_block_intro', 'field_block_body', 'field_section_body'] as $text_field) {
          if ($block->hasField($text_field) && !$block->get($text_field)->isEmpty()) {
            $lines[] = ['text' => _palefire_plain_excerpt((string) $block->get($text_field)->value, 110), 'kind' => 'text'];
            break;
          }
        }
        if (count($lines) >= 3) {
          break;
        }
      }
      $outline[] = [
        'heading' => _palefire_plain_excerpt((string) $section->get('field_section_title')->value, 60),
        'lines' => array_slice(array_filter($lines, fn ($line) => $line['text'] !== ''), 0, 3),
      ];
    }
  }
  return $outline;
}

/**
 * Whether a node is an oral history exhibition: its address is under
 * /v2/oralhistory/exhibitions/ (scripts/palefire_oral_history_exhibit_paths.php).
 */
function _palefire_is_oral_history_exhibition(NodeInterface $node): bool {
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  return str_starts_with($alias, '/v2/oralhistory/exhibitions/');
}

/**
 * A card's cover image item, or NULL.
 *
 * A Tile's Tile cover (field_tile_cover). Any other node (a Modular page):
 * its Image cover (field_image_cover, Media: Image), else an exhibition's
 * cover (field_exhibit_cover, Media: Image), else the background poster of
 * its first landing (_palefire_landing_poster_item()).
 */
function _palefire_card_image_item(NodeInterface $node, CacheableMetadata $cache): ?FieldItemInterface {
  if ($node->hasField('field_tile_cover')) {
    return $node->get('field_tile_cover')->isEmpty() ? NULL : $node->get('field_tile_cover')->first();
  }
  foreach (['field_image_cover', 'field_exhibit_cover'] as $field) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty()
      && ($image = _palefire_media_image_item($node->get($field)->first(), $cache))) {
      return $image;
    }
  }
  return _palefire_landing_poster_item($node, $cache);
}

/**
 * The background poster's image item of a page's first landing, or NULL.
 *
 * The first section (in field_scroll_section, then field_sections) that is
 * a landing (PalefireHooks::LANDING_BUNDLES) with a poster. field_bg_poster
 * may be a Media (image) reference or a plain image field.
 */
function _palefire_landing_poster_item(NodeInterface $page, CacheableMetadata $cache): ?FieldItemInterface {
  foreach (PalefireHooks::SECTION_FIELDS as $field) {
    if (!$page->hasField($field)) {
      continue;
    }
    foreach ($page->get($field)->referencedEntities() as $section) {
      if (!in_array($section->bundle(), PalefireHooks::LANDING_BUNDLES, TRUE)
        || !$section->hasField('field_bg_poster') || $section->get('field_bg_poster')->isEmpty()) {
        continue;
      }
      $cache->addCacheableDependency($section);
      return _palefire_media_image_item($section->get('field_bg_poster')->first(), $cache);
    }
  }
  return NULL;
}

/**
 * The image item behind a Media reference or a plain image field, or NULL.
 *
 * A Media item's source field holds the image; a plain image field item is
 * returned as it is.
 */
function _palefire_media_image_item(FieldItemInterface $item, CacheableMetadata $cache): ?FieldItemInterface {
  $target = $item->entity;
  if (!$target instanceof MediaInterface) {
    return $item;
  }
  $cache->addCacheableDependency($target);
  $source = $target->getSource()->getConfiguration()['source_field'] ?? NULL;
  if (!$source || !$target->hasField($source) || $target->get($source)->isEmpty()) {
    return NULL;
  }
  return $target->get($source)->first();
}

/**
 * Plain text from HTML, whitespace collapsed, cut at $max with an ellipsis.
 */
function _palefire_plain_excerpt(string $html, int $max = 180): string {
  $text = preg_replace('/\s+/u', ' ', trim(Html::decodeEntities(strip_tags($html))));
  return mb_strlen($text) > $max ? rtrim(mb_substr($text, 0, $max)) . '…' : $text;
}

/**
 * One image item as a decorative (alt="") lazy image with its size set.
 *
 * In the first of $styles that exists, else the original file.
 */
function _palefire_image_build(FieldItemInterface $image, array $styles, CacheableMetadata $cache): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $build = [
    '#uri' => $file->getFileUri(),
    '#width' => $image->width,
    '#height' => $image->height,
    '#alt' => '',
    '#attributes' => ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  foreach ($styles as $name) {
    if ($style = $storage->load($name)) {
      $cache->addCacheableDependency($style);
      return $build + ['#theme' => 'image_style', '#style_name' => $name];
    }
  }
  return $build + ['#theme' => 'image'];
}

/**
 * Adds the host Modular page's title, intro and Visit card to a landing search.
 *
 * Reads the optional node fields added by scripts/palefire_modular_setup.php
 * (field_intro, field_hours_location, field_location_name,
 * field_location_query, field_location_display). Sets:
 * - page_title: the node title when this landing is the first section (it
 *   then prints the page <h1>), or NULL.
 * - landing_intro: render array of field_intro, or NULL.
 * - visit: NULL, or ['name', 'lid', 'maps_url', 'embed_url', 'query',
 *   'parking_url'] for the Visit card (hours via js/visit-hours.js, the map
 *   loads on click).
 * A page with none of these fields filled in keeps today's landing.
 */
function _palefire_landing_visit(array &$variables, ParagraphInterface $paragraph): void {
  $variables['landing_intro'] = NULL;
  $variables['visit'] = NULL;

  // The landing may sit inside a section paragraph: walk up to the node.
  $host = $paragraph;
  for ($i = 0; $i < 5 && $host instanceof ParagraphInterface; $i++) {
    $host = $host->getParentEntity();
  }
  if (!$host instanceof NodeInterface) {
    return;
  }
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $host->getCacheTags());

  // The page <h1>: printed by the landing (above the intro) only when it is
  // the Modular page's first section. Paragraph templates don't get a
  // `node` variable, which is why {{ node.label }} printed nothing.
  // PalefireHooks::preprocessPage() uses the same check, so page.html.twig
  // prints the <h1> itself on every other Modular page.
  if ($host->bundle() === PalefireHooks::MODULAR_BUNDLE && PalefireHooks::titleLandingUuid($host) === $paragraph->uuid()) {
    $variables['page_title'] = $host->label();
    // The TOC's "Home", "Map" and "Hours" targets (PalefireHooks::heroTocIds()).
    $ids = PalefireHooks::heroTocIds($host);
    $variables['toc_home_id'] = $ids['home'] ?? NULL;
    $variables['toc_start_id'] = $ids['start'] ?? NULL;
    $variables['toc_map_id'] = $ids['map'] ?? NULL;
    $variables['toc_hours_id'] = $ids['hours'] ?? NULL;
    // The breadcrumb at the top of the lead panel (PalefireHooks::
    // crumbInLanding(); page.html.twig then leaves the head's out). Built by
    // the same service as the System Breadcrumb block, so the trail and its
    // template are the same.
    if (PalefireHooks::crumbInLanding($host)) {
      $variables['lead_breadcrumb'] = \Drupal::service('breadcrumb')->build(\Drupal::routeMatch())->toRenderable();
    }
  }

  $value = static function (string $name) use ($host): string {
    return ($host->hasField($name) && !$host->get($name)->isEmpty())
      ? trim((string) $host->get($name)->value)
      : '';
  };

  if ($host->hasField('field_intro') && !$host->get('field_intro')->isEmpty()) {
    $variables['landing_intro'] = $host->get('field_intro')->view(['label' => 'hidden']);
  }

  $lid = $value('field_hours_location');
  $name = $value('field_location_name');
  $query = $value('field_location_query');
  if ($lid === '' && $name === '' && $query === '') {
    return;
  }
  $embed = $value('field_location_display') === 'embed';
  // Visitor parking guides (scripts/palefire_guide_parking.php) by LibCal
  // location: the Visit card's link and the Quick Guide's button. Each by
  // its first alias, which a rename keeps (palefire_guide_hill_rename.php):
  // the link goes out as the guide's current alias.
  $parking = [
    '236' => '/v2/special/guides/parking-hill-memorial-library',
  ];
  $parking_url = '';
  if (isset($parking[$lid])) {
    $url = Url::fromUserInput($parking[$lid])->toString(TRUE);
    CacheableMetadata::createFromObject($url)->merge(CacheableMetadata::createFromRenderArray($variables))->applyTo($variables);
    $parking_url = $url->getGeneratedUrl();
  }
  $variables['visit'] = [
    'name' => $name,
    'lid' => preg_match('/^\d+$/', $lid) ? $lid : '',
    'query' => $query,
    'maps_url' => $query !== '' ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($query) : '',
    'embed_url' => ($embed && $query !== '') ? 'https://www.google.com/maps?q=' . rawurlencode($query) . '&output=embed' : '',
    'parking_url' => $parking_url,
  ];
  $variables['#attached']['library'][] = 'palefire/visit';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--building-map.
 *
 * Builds `map` for the template: the building's drawing, and one entry per
 * published "Building spaces" room term (title, access, floor, link, tooltip).
 * A published Room override on this paragraph replaces that room's tooltip
 * text, access or link (only the fields it fills in).
 */
function palefire_preprocess_paragraph__building_map(array &$variables): void {
  $variables['map'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  $buildings = palefire_buildings();
  if (!$paragraph instanceof ParagraphInterface || !$buildings) {
    return;
  }
  $value = static fn (string $field) => $paragraph->hasField($field) ? $paragraph->get($field)->value : NULL;
  $map = _palefire_building_map($value('field_map_building') ?: array_key_first($buildings), (string) $value('field_map_here'), $paragraph);
  if (!$map) {
    return;
  }
  $variables['map'] = $map + [
    // The landing hero's key, an index across the map (map-key.html.twig,
    // palefire_preprocess_paragraph__landing_hero()).
    'key_indexed' => !empty($variables['elements']['#pf_key_indexed']),
    // h2 on the landing hero (a section of the page), h3 elsewhere.
    'heading_tag' => empty($variables['elements']['#pf_hero']) ? 'h3' : 'h2',
  ];
}

/**
 * The building map's `map` variable (paragraph--building-map.html.twig).
 *
 * @param string $key
 *   The building (maps/buildings.yml).
 * @param string $here
 *   building.space of the room to mark "here", or ''.
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   The paragraph the map belongs to: its id makes the element ids, and on
 *   a Building map its Heading, Intro and Room overrides are used.
 *
 * @return array|null
 *   NULL when the building isn't in buildings.yml.
 */
function _palefire_building_map(string $key, string $here, ParagraphInterface $paragraph): ?array {
  $building = palefire_buildings()[$key] ?? NULL;
  if (!$building) {
    return NULL;
  }
  $value = static fn (string $field) => $paragraph->hasField($field) ? $paragraph->get($field)->value : NULL;

  // Any change to a Building spaces term re-renders the map.
  $cache = (new CacheableMetadata())->addCacheTags(['taxonomy_term_list:building_space']);
  $repository = \Drupal::service('entity.repository');
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $terms->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'building_space')
    ->condition('status', 1)
    ->condition('field_map_key', $key, 'STARTS_WITH')
    ->execute();
  $building_term = NULL;
  $rooms = [];
  foreach ($terms->loadMultiple($ids) as $term) {
    $term = $repository->getTranslationFromContext($term);
    $map_key = (string) $term->get('field_map_key')->value;
    if ($map_key === $key) {
      $building_term = $term;
    }
    elseif (str_starts_with($map_key, $key . '.')) {
      $rooms[substr($map_key, strlen($key) + 1)] = $term;
    }
  }

  $overrides = [];
  if ($paragraph->hasField('field_map_overrides')) {
    foreach ($paragraph->get('field_map_overrides') as $item) {
      $override = $item->entity;
      $room_key = $override instanceof ParagraphInterface && $override->isPublished() ? (string) $override->get('field_room_key')->value : '';
      if (str_starts_with($room_key, $key . '.')) {
        $overrides[substr($room_key, strlen($key) + 1)] = $override;
        $cache->addCacheableDependency($override);
      }
    }
  }

  // The override's field when it is filled in, otherwise the term's.
  $pick = static function (string $field, $term, ?ParagraphInterface $override, ?string $term_field = NULL): ?FieldItemListInterface {
    if ($override && $override->hasField($field) && !$override->get($field)->isEmpty()) {
      return $override->get($field);
    }
    $term_field = $term_field ?? $field;
    return $term->hasField($term_field) && !$term->get($term_field)->isEmpty() ? $term->get($term_field) : NULL;
  };
  $text = static fn (?FieldItemListInterface $items) => $items ? [
    '#type' => 'processed_text',
    '#text' => $items->value,
    '#format' => $items->format,
  ] : NULL;

  // The room's photo behind the map while the room is lit (building-map.js,
  // landing only): a URL in pf_location_backdrop (1920px wide WebP, the
  // style the room's own page sets behind its top), fetched only when the
  // room is lit. Rooms without one, or without the style, get ''.
  $photo_style = \Drupal::entityTypeManager()->getStorage('image_style')->load('pf_location_backdrop');
  if ($photo_style) {
    $cache->addCacheableDependency($photo_style);
  }
  $photo = static function ($term) use ($photo_style, $cache): string {
    // An Image media item from the library, as the rest of Modular.
    $ref = $photo_style && $term->hasField('field_space_media') ? $term->get('field_space_media')->first() : NULL;
    $item = $ref ? _palefire_media_image_item($ref, $cache) : NULL;
    $file = $item?->entity;
    if (!$file instanceof FileInterface) {
      return '';
    }
    $cache->addCacheableDependency($file);
    return \Drupal::service('file_url_generator')->transformRelative($photo_style->buildUrl($file->getFileUri()));
  };

  $uid = 'pf-map-' . $paragraph->id();
  $spaces = [];
  foreach ($building['spaces'] ?? [] as $space_key => $def) {
    $term = $rooms[$space_key] ?? NULL;
    if (!$term) {
      // Unpublished or missing: drawn as plain floor.
      continue;
    }
    $cache->addCacheableDependency($term);
    $override = $overrides[$space_key] ?? NULL;
    $access = _palefire_space_access((string) ($pick('field_space_access', $term, $override)?->value ?: ($def['access'] ?? 'walk_in')));
    $link = $pick('field_space_link', $term, $override)?->first();
    $spaces[$space_key] = [
      'key' => $space_key,
      'title' => $term->label(),
      'access' => $access['key'],
      'access_label' => $access['label'],
      'hatch' => $access['hatch'],
      'floor' => (int) ($def['floor'] ?? 1),
      'url' => $link ? $link->getUrl()->toString() : '',
      'cta' => $link ? ($link->title ?: $access['cta']) : '',
      'tip' => $uid . '-' . Html::cleanCssIdentifier($space_key) . '-tip',
      'body' => $text($pick('field_space_body', $term, $override, 'description')),
      // Optional words after the access line, e.g. "Now showing".
      'note' => $term->hasField('field_space_note') ? trim((string) $term->get('field_space_note')->value) : '',
      'photo' => $photo($term),
    ];
  }
  // Floor 1 before Floor 2; within a floor, the buildings.yml order.
  uasort($spaces, static fn (array $a, array $b): int => $a['floor'] <=> $b['floor']);

  if ($building_term) {
    $cache->addCacheableDependency($building_term);
  }
  // Summary: this paragraph's Intro (field_map_intro), under the heading or,
  // on the Hill hero, set into the drawing. Note: the building's own
  // description (its Building spaces term), at the top of the legend, for
  // who can walk in and what needs an appointment. Each is optional.
  $summary = $paragraph->hasField('field_map_intro') && !$paragraph->get('field_map_intro')->isEmpty()
    ? $paragraph->get('field_map_intro')
    : NULL;
  $note = $building_term && !$building_term->get('description')->isEmpty() ? $building_term->get('description') : NULL;

  // "You are here": only a drawn (published) room in this building.
  $here = str_starts_with($here, $key . '.') ? substr($here, strlen($key) + 1) : '';
  if (!isset($spaces[$here])) {
    $here = '';
  }

  $cache_render = [];
  $cache->applyTo($cache_render);
  return [
    'uid' => $uid,
    'key' => $key,
    'label' => $building['label'] ?? $key,
    'heading' => $value('field_map_heading') ?: ($building['heading'] ?? t('Visit @building', ['@building' => $building['label'] ?? $key])),
    'summary' => $text($summary),
    'note' => $text($note),
    'template' => $building['template'],
    'spaces' => $spaces,
    'here' => $here,
    'legend' => array_values((array) ($building['legend'] ?? [])),
    // Not rooms (the Lobby): numbered with them on phones, nothing more.
    'landmarks' => array_map(static fn (string $lkey, array $l): array => [
      'key' => $lkey,
      'title' => $l['label'] ?? $lkey,
      'floor' => (int) ($l['floor'] ?? 1),
    ], array_keys((array) ($building['landmarks'] ?? [])), array_values((array) ($building['landmarks'] ?? []))),
    'cache' => $cache_render,
  ];
}

/* ---------------------------------------------------------------------------
 * Location pages (scripts/palefire_location_setup.php)
 *
 * A room's policies, sound level and capacity live on its Building spaces
 * term (policies are Space policies terms), so every page that shows the
 * room reads the same words.
 * ------------------------------------------------------------------------- */

/**
 * Sound levels (field_space_sound) => their step on the three-step meter.
 */
const PALEFIRE_SPACE_SOUND = ['quiet' => 1, 'conversation' => 2, 'collaborative' => 3];

/**
 * Access (field_space_access) => its words, mark (space-icon.html.twig) and
 * the default button words (a room's link with no text of its own). The
 * buttons stay short for the phone dock (js/dock.js takes page words up to
 * 24 characters), and Reserve matches the booking section's name.
 *
 * Booked rooms (book online, room rental) and class rooms share the map's
 * lighter hatch: _palefire_space_access() gives each its hatch. A class
 * room (the McIlhenny Room) isn't booked by the public: faculty plan a
 * class with Special Collections (scripts/palefire_space_access_class.php).
 */
function _palefire_space_access_kinds(): array {
  return [
    'walk_in' => ['label' => (string) t('Walk in'), 'icon' => 'walk', 'cta' => (string) t('Plan your visit')],
    'appointment' => ['label' => (string) t('Book online'), 'icon' => 'calendar', 'cta' => (string) t('Book a time')],
    'class' => ['label' => (string) t('For classes'), 'icon' => 'group', 'cta' => (string) t('Plan a class')],
    'rental' => ['label' => (string) t('Event rental'), 'icon' => 'receipt', 'cta' => (string) t('Request a date')],
  ];
}

/**
 * A room's access: key, label, icon and hatch (walk-in | appointment).
 */
function _palefire_space_access(string $key): array {
  $kinds = _palefire_space_access_kinds();
  $key = isset($kinds[$key]) ? $key : 'walk_in';
  return ['key' => $key, 'hatch' => $key === 'walk_in' ? 'walk-in' : 'appointment'] + $kinds[$key];
}

/**
 * A short count as words and a number: "100" => about (TRUE) and 100, so the
 * template shows "~100" and screen readers hear "about 100"; anything else
 * (e.g. "2 to 6 people") stays as written.
 */
function _palefire_space_about(string $value): array {
  return preg_match('/^~?\s*([\d,]+)$/', $value, $m)
    ? ['about' => TRUE, 'value' => number_format((int) str_replace(',', '', $m[1]))]
    : ['about' => FALSE, 'value' => $value];
}

/**
 * The room a location section is about.
 *
 * Its own Room (field_location_space), else the Room of the page's Location
 * section, so House rules and Booking need no Room of their own. NULL when
 * there is none, or it is unpublished.
 */
function _palefire_location_room(ParagraphInterface $paragraph): ?TermInterface {
  $term = $paragraph->hasField('field_location_space') ? $paragraph->get('field_location_space')->entity : NULL;
  $host = $term ? NULL : $paragraph->getParentEntity();
  if ($host instanceof NodeInterface) {
    foreach (PalefireHooks::SECTION_FIELDS as $field) {
      if (!$host->hasField($field)) {
        continue;
      }
      foreach ($host->get($field)->referencedEntities() as $section) {
        if ($section->bundle() === 'location_space' && $section->hasField('field_location_space')) {
          $term = $section->get('field_location_space')->entity;
          break 2;
        }
      }
    }
  }
  if (!$term instanceof TermInterface || !$term->isPublished() || !$term->access('view')) {
    return NULL;
  }
  return \Drupal::service('entity.repository')->getTranslationFromContext($term);
}

/**
 * What the location templates show about a room.
 *
 * @return array
 *   title, key (building.space), building_key, building (name), floor (int
 *   or NULL), access (walk_in | appointment | rental) and access_kind (key,
 *   label, icon, hatch), sound, sound_level (0-3), capacity and area (each
 *   about, value: _palefire_space_about(); area in square feet), body (the
 *   room's description, rendered), link (url, title or NULL), policies:
 *   label, detail, state (allowed | required | not_allowed), icon, in the
 *   room's order, details (field_space_details, "Label: value" lines: label,
 *   value) and contact (field_space_contact, a Staff page: name, url,
 *   title, email, phone, phone_href; or NULL).
 */
function _palefire_location_data(TermInterface $room, CacheableMetadata $cache): array {
  $cache->addCacheableDependency($room);
  $string = static fn (string $field): string => $room->hasField($field) ? trim((string) $room->get($field)->value) : '';
  $key = $string('field_map_key');
  [$building_key, $space_key] = explode('.', $key, 2) + ['', ''];
  $building = palefire_buildings()[$building_key] ?? [];
  $def = $building['spaces'][$space_key] ?? [];

  // The building's name: buildings.yml, else the room's parent term.
  $building_label = (string) ($building['label'] ?? '');
  if ($building_label === '') {
    $parents = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadParents($room->id());
    $parent = reset($parents);
    $building_label = $parent ? $parent->label() : '';
  }

  $policies = [];
  if ($room->hasField('field_space_policies')) {
    $repository = \Drupal::service('entity.repository');
    foreach ($room->get('field_space_policies')->referencedEntities() as $policy) {
      if (!$policy instanceof TermInterface || !$policy->isPublished() || !$policy->access('view')) {
        continue;
      }
      $policy = $repository->getTranslationFromContext($policy);
      $cache->addCacheableDependency($policy);
      $state = $policy->hasField('field_policy_state') ? (string) $policy->get('field_policy_state')->value : '';
      $policies[] = [
        'label' => $policy->label(),
        'detail' => trim(strip_tags((string) $policy->getDescription())),
        'state' => in_array($state, ['allowed', 'required', 'not_allowed'], TRUE) ? $state : 'allowed',
        'icon' => $policy->hasField('field_policy_icon') ? (string) $policy->get('field_policy_icon')->value : '',
        'key' => $policy->hasField('field_policy_key') ? (string) $policy->get('field_policy_key')->value : '',
      ];
    }
  }

  $link = $room->hasField('field_space_link') ? $room->get('field_space_link')->first() : NULL;
  $sound = $string('field_space_sound');
  $access = _palefire_space_access($string('field_space_access') ?: ($def['access'] ?? 'walk_in'));
  $capacity = $string('field_space_capacity');
  $area = (int) $string('field_space_area');
  $description = $room->get('description');
  $details = [];
  foreach ($room->hasField('field_space_details') ? $room->get('field_space_details') : [] as $line) {
    [$label, $value] = array_map('trim', explode(':', (string) $line->value, 2)) + ['', ''];
    if ($label !== '' && $value !== '') {
      $details[] = ['label' => $label, 'value' => $value];
    }
  }
  $contact = NULL;
  $person = $room->hasField('field_space_contact') ? $room->get('field_space_contact')->entity : NULL;
  if ($person instanceof NodeInterface && $person->isPublished() && $person->access('view')) {
    $row = StaffDirectory::row(\Drupal::service('entity.repository')->getTranslationFromContext($person), $cache);
    $contact = array_intersect_key($row, array_flip(['name', 'url', 'title', 'email', 'phone', 'phone_href']));
  }
  return [
    'title' => $room->label(),
    'key' => $key,
    'building_key' => $building_key,
    'building' => $building_label,
    'floor' => isset($def['floor']) ? (int) $def['floor'] : NULL,
    'access' => $access['key'],
    'access_kind' => $access,
    'sound' => $sound,
    'sound_level' => PALEFIRE_SPACE_SOUND[$sound] ?? 0,
    'capacity' => $capacity === '' ? NULL : _palefire_space_about($capacity),
    'area' => $area > 0 ? _palefire_space_about((string) $area) : NULL,
    'body' => $description->isEmpty() ? NULL : [
      '#type' => 'processed_text',
      '#text' => $description->value,
      '#format' => $description->format,
    ],
    'link' => $link ? ['url' => $link->getUrl()->toString(), 'title' => $link->title ?: $access['cta']] : NULL,
    'policies' => $policies,
    'details' => $details,
    'contact' => $contact,
    'entrance' => _palefire_space_entrance($room, $cache),
  ];
}

/**
 * Space policies the Access fact and the button already say (field_policy_key).
 */
const PALEFIRE_ACCESS_POLICY_KEYS = ['reservation', 'by_appointment', 'walk_up', 'walk_in'];

/**
 * Need to know, at the top of a room's page: what someone has to do or
 * accept before coming, in words. The room's Required policies in its
 * order, less those the facts row already says (its access, the notice),
 * and "Fees apply" for an Event rental whose price the facts don't give,
 * three at most. Everything else is in House rules. A room with no such
 * requirement (Quiet Study) lists its Not allowed policies instead, three
 * at most, so its top still says what to know before coming. House rules
 * keeps those too (palefire_preprocess_paragraph__location_rules() drops
 * only the Required ones shown here), so it is never left empty.
 *
 * Every room reads the same way: a few requirements here, the full rules
 * in its House rules section. Only a walk-in room whose page has no House
 * rules section (rules_section FALSE, set by the caller) lists all its
 * policies but its access here instead, under "House rules", so none is
 * lost.
 *
 * Call after setting $location['price'] (_palefire_location_price()) and
 * $location['rules_section'].
 *
 * @return array
 *   Each: label, detail ('' for none), icon (includes/space-icon), state.
 */
function _palefire_location_need_to_know(array $location): array {
  $all = ($location['access'] ?? '') === 'walk_in' && empty($location['rules_section']);
  $items = [];
  foreach ($location['policies'] ?? [] as $policy) {
    if (in_array($policy['key'] ?? '', PALEFIRE_ACCESS_POLICY_KEYS, TRUE)) {
      continue;
    }
    if ($all || ($policy['state'] === 'required' && _palefire_policy_notice($policy) === '')) {
      $items[] = ['label' => $policy['label'], 'detail' => $policy['detail'], 'icon' => $policy['icon'], 'state' => $policy['state']];
    }
  }
  if ($all) {
    return $items;
  }
  if (!$items) {
    foreach ($location['policies'] ?? [] as $policy) {
      if ($policy['state'] === 'not_allowed' && !in_array($policy['key'] ?? '', PALEFIRE_ACCESS_POLICY_KEYS, TRUE)) {
        $items[] = ['label' => $policy['label'], 'detail' => $policy['detail'], 'icon' => $policy['icon'], 'state' => $policy['state']];
      }
    }
  }
  $fee = ($location['access'] ?? '') === 'rental' && ($location['price'] ?? '') === '' ? [['label' => (string) t('Fees apply'), 'detail' => '', 'icon' => 'receipt', 'state' => 'required']] : [];
  return [...array_slice($items, 0, 3 - count($fee)), ...$fee];
}

/**
 * The facts row's Notice: how far ahead to ask, from a Required policy
 * named "… notice" ("Two weeks' notice" gives "Two weeks"). '' for none.
 */
function _palefire_location_notice(array $location): string {
  foreach ($location['policies'] ?? [] as $policy) {
    if (($notice = _palefire_policy_notice($policy)) !== '') {
      return $notice;
    }
  }
  return '';
}

/**
 * A policy's notice ("Two weeks" from a Required "Two weeks' notice"), or ''.
 */
function _palefire_policy_notice(array $policy): string {
  return $policy['state'] === 'required' && preg_match('/^(.+?)[\'\x{2019}]?\s+notice$/iu', trim($policy['label']), $match) ? $match[1] : '';
}

/**
 * The facts row's Price, from the booking text's fees ("Two hours
 * (minimum): $100", "A full day: $250"): the lowest, as "From $100" when
 * there are others. '' when the text names no price, so a free room shows
 * no Price at all.
 */
function _palefire_location_price(ParagraphInterface $paragraph): string {
  if (!$paragraph->hasField('field_booking_body') || $paragraph->get('field_booking_body')->isEmpty()) {
    return '';
  }
  $text = html_entity_decode(strip_tags((string) $paragraph->get('field_booking_body')->value), ENT_QUOTES | ENT_HTML5);
  if (!preg_match_all('/\$\s?(\d{1,3}(?:,\d{3})+|\d+)/', $text, $matches)) {
    return '';
  }
  $amounts = array_unique(array_map(static fn (string $n): int => (int) str_replace(',', '', $n), $matches[1]));
  $lowest = '$' . number_format(min($amounts));
  return count($amounts) > 1 ? (string) t('From @price', ['@price' => $lowest]) : $lowest;
}

/**
 * A room's link, unless it is the page $paragraph is on. The room's Link
 * is where the building map sends people (often the room's own page); as
 * the page's button it would go nowhere, so the Booking link is used.
 */
function _palefire_location_not_here(?array $link, ParagraphInterface $paragraph): ?array {
  $host = $paragraph->getParentEntity();
  if (!$link || !$host instanceof NodeInterface || $host->isNew()) {
    return $link;
  }
  $path = static fn (string $url): string => rtrim((string) parse_url($url, PHP_URL_PATH), '/');
  $here = [$path($host->toUrl()->toString()), $path($host->toUrl('canonical', ['path_processing' => FALSE])->toString())];
  return in_array($path($link['url']), $here, TRUE) && !parse_url($link['url'], PHP_URL_FRAGMENT) ? NULL : $link;
}

/**
 * Where the step-free way in is (field_space_entrance,
 * palefire_location_entrance.php): the room's own words, else its
 * building's (the room's parent term). '' when neither says.
 */
function _palefire_space_entrance(TermInterface $room, CacheableMetadata $cache): string {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ([$room, ...array_values($storage->loadParents($room->id()))] as $term) {
    if (!$term->hasField('field_space_entrance')) {
      continue;
    }
    $cache->addCacheableDependency($term);
    $text = trim((string) $term->get('field_space_entrance')->value);
    if ($text !== '') {
      return $text;
    }
  }
  return '';
}

/**
 * A room's house rules: groups (allowed, required, not_allowed => policies;
 * empty ones left out), sound and sound_level.
 */
function _palefire_location_rules(array $location, string $uid): array {
  $groups = ['allowed' => [], 'required' => [], 'not_allowed' => []];
  foreach ($location['policies'] as $policy) {
    $groups[$policy['state']][] = $policy;
  }
  return [
    'uid' => $uid,
    'groups' => array_filter($groups),
    'sound' => $location['sound'],
    'sound_level' => $location['sound_level'],
  ];
}

/**
 * Booking from a section's Text and Booking link (field_booking_*): body
 * (rendered or NULL), link (url, title or NULL), capacity, and needs (the
 * room's Required policies).
 */
function _palefire_location_booking(ParagraphInterface $paragraph, ?array $location, string $uid): array {
  $body = $paragraph->hasField('field_booking_body') ? $paragraph->get('field_booking_body') : NULL;
  $link = $paragraph->hasField('field_booking_link') ? $paragraph->get('field_booking_link')->first() : NULL;
  return [
    'uid' => $uid,
    'body' => $body && !$body->isEmpty() ? [
      '#type' => 'processed_text',
      '#text' => $body->value,
      '#format' => $body->format,
    ] : NULL,
    'parts' => $body && !$body->isEmpty() ? _palefire_location_booking_parts((string) $body->value, (string) $body->format) : NULL,
    'link' => $link ? ['url' => $link->getUrl()->toString(), 'title' => $link->title ?: ($location['access_kind']['cta'] ?? (string) t('Reserve'))] : NULL,
    'capacity' => $location['capacity'] ?? NULL,
    'needs' => array_values(array_filter($location['policies'] ?? [], static fn (array $p): bool => $p['state'] === 'required')),
  ];
}

/**
 * The booking text in parts, split at its subheads (h3), for Reserve's
 * layout: the text before the first subhead (intro), the part whose list
 * is numbered (steps: How to book), and the others (groups: Service
 * charges, Equipment, Layouts) to sit side by side. Each part is filtered
 * on its own in the field's format, so editors keep writing one text.
 * NULL when the text has no subheads (the template prints it whole).
 */
function _palefire_location_booking_parts(string $html, string $format): ?array {
  $dom = Html::load($html);
  $body = $dom->getElementsByTagName('body')->item(0);
  if (!$body) {
    return NULL;
  }
  $intro = '';
  $groups = [];
  $current = NULL;
  foreach (iterator_to_array($body->childNodes) as $node) {
    $tag = $node instanceof \DOMElement ? strtolower($node->tagName) : '';
    if ($tag === 'h3') {
      if ($current) {
        $groups[] = $current;
      }
      $current = ['title' => trim($node->textContent), 'html' => '', 'steps' => FALSE];
      continue;
    }
    $chunk = (string) $dom->saveHTML($node);
    if ($current === NULL) {
      $intro .= $chunk;
      continue;
    }
    $current['html'] .= $chunk;
    $current['steps'] = $current['steps'] || $tag === 'ol';
  }
  if ($current) {
    $groups[] = $current;
  }
  if (!$groups) {
    return NULL;
  }
  $text = static fn (string $value): ?array => trim(strip_tags($value, '<img>')) === '' ? NULL : [
    '#type' => 'processed_text',
    '#text' => $value,
    '#format' => $format,
  ];
  $parts = ['intro' => $text($intro), 'steps' => NULL, 'groups' => []];
  foreach ($groups as $group) {
    $part = ['title' => $group['title'], 'body' => $text($group['html'])];
    if ($group['steps'] && !$parts['steps']) {
      $part['items'] = _palefire_steps_items($group['html'], $format);
      $parts['steps'] = $part;
    }
    else {
      $parts['groups'][] = $part;
    }
  }
  return $parts;
}

/**
 * A numbered list's steps for includes/steps.html.twig (pf-steps), when
 * each item opens with a bold name: <li><strong>Send the form</strong> At
 * least two weeks ahead</li>. Each step is its name in two parts, broken
 * at the middle word ("Send" / "the form"; the pattern sets it on two
 * lines from md), and the rest as its note, filtered in the text's format.
 * A numbered list inside an item is its sub-steps, read the same way; each
 * may open with "[icon:name]", a Font Awesome Pro duotone file name
 * (calendar-check), for its mark. Text around the list comes back as rest.
 * NULL when a step has no bold name (the text then prints as written).
 */
function _palefire_steps_items(string $html, string $format): ?array {
  $dom = Html::load($html);
  $list = $dom->getElementsByTagName('ol')->item(0);
  if (!$list) {
    return NULL;
  }
  $text = static fn (string $value): ?array => trim(strip_tags($value)) === '' ? NULL : [
    '#type' => 'processed_text',
    '#text' => $value,
    '#format' => $format,
  ];
  $steps = [];
  foreach (_palefire_steps_split($list) as $item) {
    if ($item['lead'] === '') {
      return NULL;
    }
    $words = explode(' ', $item['lead']);
    $split = max(1, intdiv(count($words), 2));
    $stops = [];
    foreach ($item['list'] ? _palefire_steps_split($item['list']) : [] as $stop) {
      $label = $stop['lead'];
      $note = $stop['note'];
      // "[icon:name]" before the bold label (or before the words, with
      // none). The name is checked, as it becomes part of a file path.
      $icon = NULL;
      if (preg_match('/^\s*\[icon:([a-z0-9-]+)\]\s*/', $stop['before'], $m)) {
        $icon = $m[1];
      }
      elseif ($label === '' && preg_match('/^\s*\[icon:([a-z0-9-]+)\]\s*/', $note, $m)) {
        $icon = $m[1];
        $note = substr($note, strlen($m[0]));
      }
      // No bold label: the sub-step's words are its label.
      if ($label === '') {
        $label = trim(preg_replace('/\s+/u', ' ', strip_tags($note)));
        $note = '';
      }
      $stops[] = ['label' => $label, 'note' => $text($note), 'icon' => $icon];
    }
    $steps[] = [
      'name' => [implode(' ', array_slice($words, 0, $split)), implode(' ', array_slice($words, $split))],
      'note' => $text($item['note']),
      'stops' => $stops,
    ];
  }
  if (!$steps) {
    return NULL;
  }
  $list->parentNode->removeChild($list);
  $rest = Html::serialize($dom);
  return [
    'steps' => $steps,
    'rest' => trim(strip_tags($rest, '<img>')) === '' ? NULL : [
      '#type' => 'processed_text',
      '#text' => $rest,
      '#format' => $format,
    ],
  ];
}

/**
 * A list's items for _palefire_steps_items(), each in parts: before (the
 * text before its bold lead, as text), lead (the bold text, or ''), note
 * (the HTML after it) and list (a numbered list inside it, or NULL). With
 * no bold lead, all its HTML but the inner list is the note.
 */
function _palefire_steps_split(\DOMElement $list): array {
  $items = [];
  foreach (iterator_to_array($list->childNodes) as $li) {
    if (!$li instanceof \DOMElement || strtolower($li->tagName) !== 'li') {
      continue;
    }
    $item = ['before' => '', 'lead' => '', 'note' => '', 'list' => NULL];
    $nodes = iterator_to_array($li->childNodes);
    // The lead: the first element, if bold, with only text before it.
    $lead = NULL;
    foreach ($nodes as $node) {
      if ($node instanceof \DOMElement) {
        $lead = in_array(strtolower($node->tagName), ['strong', 'b'], TRUE) ? $node : NULL;
        break;
      }
    }
    $after = $lead === NULL;
    foreach ($nodes as $node) {
      if ($node === $lead) {
        $item['lead'] = trim(preg_replace('/\s+/u', ' ', $node->textContent));
        $after = TRUE;
      }
      elseif ($node instanceof \DOMElement && strtolower($node->tagName) === 'ol' && !$item['list']) {
        $item['list'] = $node;
      }
      elseif ($after) {
        $item['note'] .= $node->ownerDocument->saveHTML($node);
      }
      else {
        $item['before'] .= $node->textContent;
      }
    }
    // A colon or dash an editor put after the lead goes with it.
    $item['note'] = trim(preg_replace('/^[\s:\x{2013}\x{2014}-]+/u', '', $item['note']));
    $items[] = $item;
  }
  return $items;
}

/**
 * A location photo's caption from its media name: '' for a name that is
 * still the uploaded file's name ("screadingroom-1.jpg"), which Drupal
 * gives a media item until an editor names it.
 */
function _palefire_location_caption(string $name): string {
  $name = trim($name);
  return preg_match('/\.(jpe?g|png|webp|gif|tiff?|heic|avif)$/i', $name) ? '' : $name;
}

/**
 * The room's photos (field_location_photos, palefire_location_photos.php).
 *
 * Each Image media item in pf_location_photo (4:5 WebP), or the original
 * before the script has made the style: src, width, height, its alt text,
 * full (the original, for the viewer) with full_width and full_height,
 * and its media name as the caption (none while the name is still a file
 * name, _palefire_location_caption()). Media items without a file are
 * left out.
 */
function _palefire_location_photos(ParagraphInterface $paragraph, CacheableMetadata $cache): array {
  if (!$paragraph->hasField('field_location_photos')) {
    return [];
  }
  $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('pf_location_photo');
  if ($style) {
    $cache->addCacheableDependency($style);
  }
  $urls = \Drupal::service('file_url_generator');
  $photos = [];
  foreach ($paragraph->get('field_location_photos') as $ref) {
    $item = _palefire_media_image_item($ref, $cache);
    $file = $item?->entity;
    if (!$file instanceof FileInterface) {
      continue;
    }
    $cache->addCacheableDependency($file);
    $uri = $file->getFileUri();
    $dimensions = ['width' => (int) $item->width ?: NULL, 'height' => (int) $item->height ?: NULL];
    if ($style) {
      $style->transformDimensions($dimensions, $uri);
    }
    $photos[] = [
      'src' => $urls->transformRelative($style ? $style->buildUrl($uri) : $urls->generateString($uri)),
      'width' => (int) ($dimensions['width'] ?? 800),
      'height' => (int) ($dimensions['height'] ?? 1000),
      'alt' => (string) $item->alt,
      // The original, for the full-screen viewer (js/guide-gallery.js).
      'full' => $urls->generateString($uri),
      'full_width' => (int) $item->width ?: NULL,
      'full_height' => (int) $item->height ?: NULL,
      'caption' => _palefire_location_caption($ref->entity ? (string) $ref->entity->label() : ''),
    ];
  }
  return $photos;
}

/**
 * The photo behind a location page's top: a URL, or ''.
 *
 * The room term's own photo (field_space_media, the one the map's tooltip
 * crops to a band), whole, in pf_location_backdrop (1920px wide WebP);
 * without that style or photo, the first of the page's photos.
 */
function _palefire_location_backdrop(TermInterface $room, array $photos, CacheableMetadata $cache): string {
  $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('pf_location_backdrop');
  $ref = $style && $room->hasField('field_space_media') ? $room->get('field_space_media')->first() : NULL;
  $item = $ref ? _palefire_media_image_item($ref, $cache) : NULL;
  $file = $item?->entity;
  if ($file instanceof FileInterface) {
    $cache->addCacheableDependency($style);
    $cache->addCacheableDependency($file);
    return \Drupal::service('file_url_generator')->transformRelative($style->buildUrl($file->getFileUri()));
  }
  return $photos[0]['src'] ?? '';
}

/**
 * The room each of the hero's tabs is about, by tab id.
 *
 * A tab whose id is listed below shows that room's photo and facts in its
 * panel (_palefire_tab_photos(), _palefire_tab_facts()). To give another tab
 * a room, add its id and the room's map key (building.space). Published
 * rooms only; a room added or edited later redraws the hero.
 *
 * @return \Drupal\taxonomy\TermInterface[]
 *   Rooms by tab id.
 */
function _palefire_tab_rooms(array $tabs, CacheableMetadata $cache): array {
  $rooms = [
    'study' => 'hill_memorial.quiet_study',
  ];
  $wanted = array_intersect_key($rooms, array_flip(array_column($tabs, 'id')));
  if (!$wanted) {
    return [];
  }
  $cache->addCacheTags(['taxonomy_term_list:building_space']);
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('vid', 'building_space')
    ->condition('field_map_key', array_values($wanted), 'IN')
    ->condition('status', 1)
    ->execute();
  $by_key = [];
  foreach ($storage->loadMultiple($ids) as $room) {
    $by_key[(string) $room->get('field_map_key')->value] = $room;
  }
  $found = [];
  foreach ($wanted as $tab_id => $key) {
    $room = $by_key[$key] ?? NULL;
    if ($room instanceof TermInterface) {
      $cache->addCacheableDependency($room);
      $found[$tab_id] = $room;
    }
  }
  return $found;
}

/**
 * A detail still waiting on its value: "xx" in it ("Outlets: xx").
 */
function _palefire_is_placeholder(string $value): bool {
  return (bool) preg_match('/\bxx\b/i', $value);
}

/**
 * Room facts for the hero's tabs, by tab id: facts and specs.
 *
 * From the tab's room term (_palefire_tab_rooms(), the same data as the
 * room's own page, _palefire_location_data()), so the tab and the page
 * never disagree:
 * - facts: term and text, a row of columns under the photo: the room's
 *   allowed and required policies, its sound, then what isn't allowed, each
 *   policy with its description.
 * - specs: label and value, a ruled line under them: seats (Capacity), then
 *   the room's details lines (Wi-Fi: eduroam), in its order.
 * A value with "xx" in it is a placeholder and is left out. A tab without
 * a room, or a room with none of these, gets nothing, so the tab's own
 * text is all it shows.
 */
function _palefire_tab_facts(array $tabs, array &$variables): array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $sounds = [
    'quiet' => [t('Quiet.'), t('Keep conversations and calls outside.')],
    'conversation' => [t('Conversation.'), t('Talk at a low voice.')],
    'collaborative' => [t('Collaborative.'), t('Group work and talking are welcome.')],
  ];
  $all = [];
  foreach (_palefire_tab_rooms($tabs, $cache) as $tab_id => $room) {
    $data = _palefire_location_data($room, $cache);
    $policy = static fn (array $p): array => [
      'term' => rtrim($p['label'], '.') . '.',
      'text' => _palefire_is_placeholder($p['detail']) ? '' : $p['detail'],
    ];
    $facts = [];
    foreach ($data['policies'] as $p) {
      if ($p['state'] !== 'not_allowed') {
        $facts[] = $policy($p);
      }
    }
    if (isset($sounds[$data['sound']])) {
      $facts[] = ['term' => $sounds[$data['sound']][0], 'text' => $sounds[$data['sound']][1]];
    }
    foreach ($data['policies'] as $p) {
      if ($p['state'] === 'not_allowed') {
        $facts[] = $policy($p);
      }
    }
    $specs = [];
    $capacity = $data['capacity'];
    if ($capacity && !_palefire_is_placeholder($capacity['value'])) {
      $specs[] = [
        'label' => t('Seats'),
        'value' => $capacity['about'] ? t('About @n', ['@n' => $capacity['value']]) : $capacity['value'],
      ];
    }
    foreach ($data['details'] as $detail) {
      if (!_palefire_is_placeholder($detail['value'])) {
        $specs[] = $detail;
      }
    }
    if ($facts || $specs) {
      $all[$tab_id] = ['facts' => $facts, 'specs' => $specs];
    }
  }
  $cache->applyTo($variables);
  return $all;
}

/**
 * Room photos for the hero's tabs: by tab id, src, width, height and alt.
 *
 * A tab with a room (_palefire_tab_rooms()) shows that room's photo in its
 * panel, a framed print over the tab's blocks (includes/section-tabs.html.twig,
 * _section-tabs.scss): the room term's photo (field_space_media) in
 * pf_location_backdrop, the one behind the room's own page. A tab without a
 * room, or a room without a photo, keeps its blocks alone.
 */
function _palefire_tab_photos(array $tabs, array &$variables): array {
  $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('pf_location_backdrop');
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $rooms = $style ? _palefire_tab_rooms($tabs, $cache) : [];
  if (!$rooms) {
    $cache->applyTo($variables);
    return [];
  }
  $cache->addCacheableDependency($style);
  $photos = [];
  foreach ($rooms as $tab_id => $room) {
    if (!$room->hasField('field_space_media')) {
      continue;
    }
    $ref = $room->get('field_space_media')->first();
    $item = $ref ? _palefire_media_image_item($ref, $cache) : NULL;
    $file = $item?->entity;
    if (!$file instanceof FileInterface) {
      continue;
    }
    $cache->addCacheableDependency($file);
    $uri = $file->getFileUri();
    $dimensions = ['width' => (int) $item->width ?: NULL, 'height' => (int) $item->height ?: NULL];
    $style->transformDimensions($dimensions, $uri);
    $photos[$tab_id] = [
      'src' => \Drupal::service('file_url_generator')->transformRelative($style->buildUrl($uri)),
      'width' => (int) ($dimensions['width'] ?? 1920),
      'height' => (int) ($dimensions['height'] ?? 1440),
      'alt' => (string) $item->alt,
    ];
  }
  $cache->applyTo($variables);
  return $photos;
}

/**
 * The first section of a bundle on the same page as a paragraph, or NULL.
 *
 * Location pages are one section per part (Location, Location: photos,
 * hours and directions, house rules, booking): the parts read each other
 * through this, so the room's photo can sit behind the top and a fact is
 * said once.
 */
function _palefire_location_sibling(ParagraphInterface $paragraph, string $bundle): ?ParagraphInterface {
  $host = $paragraph->getParentEntity();
  if (!$host instanceof NodeInterface) {
    return NULL;
  }
  foreach (PalefireHooks::SECTION_FIELDS as $field) {
    if (!$host->hasField($field)) {
      continue;
    }
    foreach ($host->get($field)->referencedEntities() as $section) {
      if ($section instanceof ParagraphInterface && $section->bundle() === $bundle && (!method_exists($section, 'isPublished') || $section->isPublished())) {
        return $section;
      }
    }
  }
  return NULL;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--location-space.
 *
 * `location` (_palefire_location_data(), plus `map`: the building map with
 * the room marked, or NULL for a building without a drawing; `backdrop`,
 * the photo behind the top) and `visit` (the page's hours, for today's
 * line under the title). The page's other parts are sections of their own
 * (Location: photos, hours and directions, house rules, booking). With no
 * Room link of its own, the button at the top is this section's Booking
 * link. The facts row adds Notice (_palefire_location_notice()), Price
 * (_palefire_location_price(), from the Booking part's text) and the
 * room's details (field_space_details) but those named as a photo is.
 */
function palefire_preprocess_paragraph__location_space(array &$variables): void {
  $variables['location'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  _palefire_landing_visit($variables, $paragraph);
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $room = _palefire_location_room($paragraph);
  if ($room) {
    $location = _palefire_location_data($room, $cache);
    $map = $location['building_key'] !== '' ? _palefire_building_map($location['building_key'], $location['key'], $paragraph) : NULL;
    if ($map) {
      $map['heading'] = t('Find the @room', ['@room' => $location['title']]);
      $map['heading_tag'] = 'h2';
      $map['visit'] = NULL;
      // The drawing alone: the room is lit on it and named beside it.
      $map['no_key'] = TRUE;
    }
    $location['map'] = $map;
    $location['uid'] = 'pf-location-' . $paragraph->id();
    // A button at the top only for a room people book online. A room
    // people ask for (Event rental, For classes) has its form in Booking,
    // after the rules, so nobody sends it before reading them; a walk-in
    // room (Reading Room, Quiet Study) needs no booking to use.
    $asked = in_array($location['access'], ['rental', 'class'], TRUE);
    $location['link'] = $location['access'] !== 'appointment'
      ? NULL
      : _palefire_location_not_here($location['link'], $paragraph) ?? _palefire_location_booking($paragraph, NULL, '')['link'];
    // Its person to ask, once, further down (_palefire_location_contact_part()).
    if (!_palefire_location_contact_part($paragraph, $location, 'location_space')) {
      $location['contact'] = NULL;
    }
    $location['request'] = $asked ? _palefire_location_request($paragraph, $location) : NULL;
    $location['notice'] = _palefire_location_notice($location);
    $location['price'] = _palefire_location_price(_palefire_location_sibling($paragraph, 'location_booking') ?? $paragraph);
    $location['rules_section'] = (bool) _palefire_location_sibling($paragraph, 'location_rules');
    $location['need_to_know'] = _palefire_location_need_to_know($location);
    $photos = _palefire_location_sibling($paragraph, 'location_photos');
    $photo_list = $photos ? _palefire_location_photos($photos, $cache) : [];
    // A detail named as a photo is ("Lecture: xx seats") goes under that
    // photo (palefire_preprocess_paragraph__location_photos()), not here.
    $captions = array_map('mb_strtolower', array_column($photo_list, 'caption'));
    $location['details'] = array_values(array_filter($location['details'], static fn (array $d): bool => !in_array(mb_strtolower($d['label']), $captions, TRUE)));
    $cache->addCacheTags($paragraph->getParentEntity()?->getCacheTags() ?? []);
    // The backdrop's fallback: the first of the page's photos.
    $location['backdrop'] = _palefire_location_backdrop($room, array_slice($photo_list, 0, 1), $cache);
    // Its Photo filter (palefire_location_photo_filter.php): 'mono' or
    // 'none'; '' for Faded, the default, and pages made before the field.
    $filter = $paragraph->hasField('field_location_photo_filter') ? (string) $paragraph->get('field_location_photo_filter')->value : '';
    $location['photo_filter'] = in_array($filter, ['mono', 'none'], TRUE) ? $filter : '';
    $variables['location'] = $location;
  }
  $cache->applyTo($variables);
}

/**
 * Whether a room's person to ask ("Questions? …") shows in a part.
 *
 * A room people book online or walk into shows them at the top, beside the
 * button, and in Booking. A room people ask for (Event rental, For
 * classes) shows them once, further down: under House rules, else in
 * Booking, else at the top when the page has neither.
 *
 * @param string $bundle
 *   The part asking: location_space, location_rules or location_booking.
 */
function _palefire_location_contact_part(ParagraphInterface $paragraph, array $location, string $bundle): bool {
  if (!in_array($location['access'] ?? '', ['rental', 'class'], TRUE)) {
    return $bundle !== 'location_rules';
  }
  foreach (['location_rules', 'location_booking', 'location_space'] as $part) {
    if ($part === $bundle || $paragraph->bundle() === $part || _palefire_location_sibling($paragraph, $part)) {
      return $part === $bundle;
    }
  }
  return FALSE;
}

/**
 * The line under the title for a room people ask for, in place of hours.
 *
 * A room people ask for (Event rental, For classes) isn't open to walk
 * into, so today's hours under its title would mislead. In their place, in
 * the same slot and at the same height: "By request" and the room's ask
 * (Request a date, Plan a class), a link down to the part that carries the
 * request: Booking (the form), else House rules (the person to ask,
 * _palefire_location_contact_part()); no link when the page has neither.
 *
 * @return array{label: string, link: ?array{url: string, title: string}}
 */
function _palefire_location_request(ParagraphInterface $paragraph, array $location): array {
  $link = NULL;
  $host = $paragraph->getParentEntity();
  $part = _palefire_location_sibling($paragraph, 'location_booking')
    ?? (!empty($location['contact']) ? NULL : _palefire_location_sibling($paragraph, 'location_rules'));
  if ($part && $host instanceof NodeInterface) {
    $anchor = PalefireHooks::sectionData($host)[$part->uuid()]['anchor'] ?? '';
    if ($anchor !== '') {
      // The part's <h2> (tabindex -1), so the jump lands focus on it.
      $link = [
        'url' => '#' . $anchor . '-title',
        'title' => $location['access_kind']['cta'] ?? (string) t('How to ask'),
      ];
    }
  }
  return ['label' => (string) t('By request'), 'link' => $link];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--location-rules.
 *
 * `rules` (_palefire_location_rules()), or NULL without a room.
 */
function palefire_preprocess_paragraph__location_rules(array &$variables): void {
  $variables['rules'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  $room = $paragraph instanceof ParagraphInterface ? _palefire_location_room($paragraph) : NULL;
  if (!$room) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $location = _palefire_location_data($room, $cache);
  $variables['rules'] = _palefire_location_rules($location, 'pf-rules-' . $paragraph->id());
  // Beside a Location section, its ledger already gives the sound level,
  // access and notice, and Need to know its other requirements: the
  // groups keep the rest (After hours, Alcohol permit).
  if (_palefire_location_sibling($paragraph, 'location_space')) {
    $variables['rules']['sound_level'] = 0;
    $location['price'] = _palefire_location_price(_palefire_location_sibling($paragraph, 'location_booking') ?? $paragraph);
    $location['rules_section'] = TRUE;
    // Only the Required items: a Not allowed rule Need to know shows for a
    // room with no requirements stays here too.
    $shown = array_column(array_filter(_palefire_location_need_to_know($location), static fn (array $item): bool => $item['state'] === 'required'), 'label');
    foreach ($variables['rules']['groups'] as $state => $policies) {
      $variables['rules']['groups'][$state] = array_values(array_filter($policies, static fn (array $p): bool => !in_array($p['label'], $shown, TRUE)
        && !in_array($p['key'] ?? '', PALEFIRE_ACCESS_POLICY_KEYS, TRUE)
        && _palefire_policy_notice($p) === ''));
    }
    $variables['rules']['groups'] = array_filter($variables['rules']['groups']);
  }
  // The person to ask, under the rules, for a room people ask for.
  $variables['rules']['contact'] = _palefire_location_contact_part($paragraph, $location, 'location_rules') ? ($location['contact'] ?? NULL) : NULL;
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--location-booking.
 *
 * `booking` (_palefire_location_booking()).
 */
function palefire_preprocess_paragraph__location_booking(array &$variables): void {
  $variables['booking'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $room = _palefire_location_room($paragraph);
  $location = $room ? _palefire_location_data($room, $cache) : NULL;
  $variables['booking'] = _palefire_location_booking($paragraph, $location, 'pf-booking-' . $paragraph->id());
  // Beside a Location section: its ledger gives the capacity and House
  // rules the required policies. The button under the steps is this
  // section's link, else the top's (the index rule has no link of its own:
  // _palefire_location_index()).
  $space = _palefire_location_sibling($paragraph, 'location_space');
  if ($space) {
    $variables['booking']['capacity'] = NULL;
    $variables['booking']['needs'] = [];
    $variables['booking']['link'] ??= _palefire_location_not_here($location['link'] ?? NULL, $paragraph) ?? _palefire_location_booking($space, NULL, '')['link'];
  }
  $variables['booking']['contact'] = $location && _palefire_location_contact_part($paragraph, $location, 'location_booking') ? ($location['contact'] ?? NULL) : NULL;
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--location-photos.
 *
 * `photos` (_palefire_location_photos()): the room's photos, three across.
 */
function palefire_preprocess_paragraph__location_photos(array &$variables): void {
  $variables['photos'] = [];
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $variables['photos'] = _palefire_location_photos($paragraph, $cache);
  // The room's details named as a photo is ("Lecture: xx seats"), as a
  // second line under it.
  $room = _palefire_location_room($paragraph);
  $notes = [];
  foreach ($room ? _palefire_location_data($room, $cache)['details'] : [] as $detail) {
    $notes[mb_strtolower($detail['label'])] = $detail['value'];
  }
  foreach ($variables['photos'] as &$photo) {
    $photo['note'] = $notes[mb_strtolower($photo['caption'])] ?? '';
  }
  unset($photo);
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--location-visit.
 *
 * `visit` (_palefire_landing_visit(): the page's LibCal location, Google
 * Maps query and parking guide) and `uid`, for the id the hours line at the
 * top jumps to.
 */
function palefire_preprocess_paragraph__location_visit(array &$variables): void {
  $variables['uid'] = NULL;
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    $variables['visit'] = NULL;
    return;
  }
  _palefire_landing_visit($variables, $paragraph);
  $space = _palefire_location_sibling($paragraph, 'location_space');
  $variables['uid'] = 'pf-location-' . ($space ? $space->id() : $paragraph->id());
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $room = _palefire_location_room($paragraph);
  $variables['entrance'] = $room ? _palefire_space_entrance($room, $cache) : '';
  $cache->applyTo($variables);
}

/* ---------------------------------------------------------------------------
 * Guide pages (scripts/palefire_guide_setup.php)
 * ------------------------------------------------------------------------- */

/**
 * Proxy prefix for Resources with "Requires LSU login" ticked.
 */
const PALEFIRE_PROXY_PREFIX = 'https://libezp.lib.lsu.edu/login?url=';

/**
 * Resource type (field_resource_type) => Bootstrap Icons file in images/bi.
 */
const PALEFIRE_RESOURCE_ICONS = [
  'article' => 'file-earmark-text',
  'book' => 'book',
  'database' => 'database',
  'guide' => 'journal-bookmark',
  'standard' => 'card-checklist',
  'tool' => 'tools',
  'course' => 'easel',
  'video' => 'play-fill',
  'pdf' => 'file-earmark-pdf',
  'word' => 'file-earmark-word',
  'download' => 'download',
  'search' => 'search',
  'person' => 'person',
  'website' => 'globe2',
];

/**
 * Renders the Resources in $field that the visitor can see (guide_item).
 *
 * Unpublished or otherwise inaccessible Resources are left out; their cache
 * tags are kept, so publishing one shows it on every guide that lists it.
 */
function _palefire_guide_resources(ParagraphInterface $paragraph, string $field, array &$variables): array {
  $items = [];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  if ($paragraph->hasField($field)) {
    $builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    $repository = \Drupal::service('entity.repository');
    foreach ($paragraph->get($field) as $item) {
      $resource = $item->entity;
      if (!$resource instanceof NodeInterface) {
        continue;
      }
      $cache->addCacheableDependency($resource);
      $access = $resource->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access);
      if ($access->isAllowed()) {
        $items[] = $builder->view($repository->getTranslationFromContext($resource), 'guide_item');
      }
    }
  }
  $cache->applyTo($variables);
  return $items;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--resource-list.
 *
 * guides: when every Resource the visitor can see links to a Modular page
 * on this site (Related guides, palefire_guide_related.php), those pages as
 * cards, the Special Collections homepage's (tile-showcase): title, url,
 * label, image or outline. Else [], and the list shows as usual.
 */
function palefire_preprocess_paragraph__resource_list(array &$variables): void {
  $variables['resources'] = _palefire_guide_resources($variables['paragraph'], 'field_resources', $variables);
  $variables['guides'] = $variables['resources'] ? _palefire_guide_cards($variables['paragraph'], $variables) : [];
}

/**
 * The Modular pages a Resource list links to, as cards, or [].
 *
 * [] as soon as one visible Resource links anywhere else, so a list is
 * either all cards or all rows. A Resource or page the visitor can't see is
 * left out, as in _palefire_guide_resources().
 */
function _palefire_guide_cards(ParagraphInterface $paragraph, array &$variables): array {
  if (!$paragraph->hasField('field_resources')) {
    return [];
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $cards = [];
  foreach ($paragraph->get('field_resources') as $item) {
    $resource = $item->entity;
    if (!$resource instanceof NodeInterface) {
      continue;
    }
    $access = $resource->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $url = $resource->hasField('field_resource_link') && !$resource->get('field_resource_link')->isEmpty()
      ? $resource->get('field_resource_link')->first()->getUrl() : NULL;
    // entity:node/N, or an internal path or alias (the path validator
    // resolves it to the node's route).
    $nid = $url && $url->isRouted() && $url->getRouteName() === 'entity.node.canonical'
      ? ($url->getRouteParameters()['node'] ?? NULL) : NULL;
    $node = $nid ? \Drupal::entityTypeManager()->getStorage('node')->load($nid) : NULL;
    if (!$node instanceof NodeInterface || $node->bundle() !== PalefireHooks::MODULAR_BUNDLE) {
      return [];
    }
    $card = _palefire_node_card($node, $cache, 140);
    if (!$card) {
      continue;
    }
    $image = $card['image_item'] ? _palefire_responsive_cover($card['image_item'], 'tile_showcase_portrait', $cache) : NULL;
    $cards[] = [
      'title' => $card['title'],
      'url' => $card['url'],
      'label' => $card['label'],
      'note' => $card['note'],
      'image' => $image,
      'outline' => $image ? [] : _palefire_page_outline($node, $cache),
    ];
  }
  $cache->applyTo($variables);
  return $cards;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--accordion-item.
 */
function palefire_preprocess_paragraph__accordion_item(array &$variables): void {
  $variables['resources'] = _palefire_guide_resources($variables['paragraph'], 'field_resources', $variables);
}

/**
 * Style guide plates, in catalogue order (includes/styleguide-plate.html.twig).
 *
 * Add new ones at the end, so existing plates keep their numbers.
 */
const PALEFIRE_STYLEGUIDE_PLATES = ['overview', 'colors', 'type', 'grid', 'spacing', 'lines', 'motion', 'buttons', 'steps', 'labels'];

/**
 * Implements hook_preprocess_HOOK() for paragraph--guide-text.
 *
 * request_paths: TRUE when the text has a paragraph that is only
 * "[request-paths]". The marker is taken out of the text, and the template
 * draws the Special Collections request diagram (guide-request-paths.html.twig)
 * after it. A marker anywhere else in a sentence is left as typed.
 *
 * faqs: likewise for a paragraph that is only "[special-collections-faqs]":
 * every Special Collections FAQ, most asked first, in the order the
 * homepage's Ask Special Collections section uses (_palefire_ask_faqs()),
 * drawn after the text as the guides' accordion (guide-faqs.html.twig).
 *
 * ask_href: where the paths' "Reach out" goes: the question form
 * (#ask-question) when the text is in a Section tab beside an Ask showcase
 * tab (the Special Collections homepage), else empty (AskUs).
 *
 * transcription: TRUE when the text opens with a Heading 4 "Transcription"
 * (Audubon's manuscripts): a primary source, set apart from the curators'
 * text (_exhibition.scss .pf-transcription).
 *
 * plates: style guide plates, from paragraphs that are only
 * "[styleguide:<plate>]" (PALEFIRE_STYLEGUIDE_PLATES), in order, drawn
 * after the text (includes/styleguide-plate.html.twig). A plate's number is
 * its place in that list, like a catalogue number, so it never depends on
 * which blocks were rendered from cache. docs/styleguide.md.
 *
 * analytics: a paragraph that is only "[analytics:report]" draws the staff
 * analytics report after the text (includes/analytics-report.html.twig,
 * Drupal\palefire\AnalyticsReport), "[analytics:feedback]" the Combined
 * Search feedback (includes/analytics-feedback.html.twig): part, allowed,
 * and the figures (report or feedback) for visitors who may see them. NULL
 * without a marker.
 *
 * research: a paragraph that is only "[research:<part>]" draws that part of
 * the LSU research figures from OpenAlex after the text
 * (includes/research-figures.html.twig, Drupal\palefire\ResearchFigures):
 * part and data. Public. NULL without a marker.
 *
 * newsletter: a paragraph that is only
 * "[newsletter-review:<account>/<activity id>]" draws that Constant Contact
 * draft for review, with Comment buttons and the feedback form
 * (includes/newsletter-review.html.twig, Drupal\palefire\NewsletterReview).
 * Kept five minutes, so reviewers read the draft as it is now. NULL without
 * a marker.
 *
 * newsletter_archive, newsletter_compare: a paragraph that is only
 * "[newsletter-archive]" turns the block's links to Constant Contact
 * previews into a gallery of past issues (includes/newsletter-archive.html.twig);
 * "[newsletter-compare]" draws its first two linked issues under a
 * before/after slider (includes/newsletter-compare.html.twig). The links
 * leave the text. NULL without a marker.
 *
 * page_review_hub: a paragraph that is only "[page-review-hub]" turns the
 * first list of links after it into the review mode hub: each page's thumbs
 * and approved notes, with a link into review mode, then any other page that
 * has some (includes/page-review-hub.html.twig, Drupal\palefire\PageReview).
 * NULL without a marker.
 *
 * pr_timeline: a paragraph that is only "[pr-timeline]" turns the first list
 * after it in the block into a timeline anyone can leave notes on, with the
 * notes staff approved (includes/pr-timeline.html.twig,
 * Drupal\palefire\PrTimeline). The list leaves the text. NULL without a
 * marker.
 */
function palefire_preprocess_paragraph__guide_text(array &$variables): void {
  $variables['request_paths'] = FALSE;
  $variables['faqs'] = [];
  $variables['plates'] = [];
  $variables['analytics'] = NULL;
  $variables['research'] = NULL;
  $variables['podcast'] = NULL;
  $variables['newsletter'] = NULL;
  $variables['newsletter_archive'] = NULL;
  $variables['newsletter_compare'] = NULL;
  $variables['pr_timeline'] = NULL;
  $variables['page_review_hub'] = NULL;
  $variables['transcription'] = (bool) preg_match('#^\s*<h4[^>]*>\s*Transcription\s*</h4>#i', (string) $variables['paragraph']->get('field_block_body')->value);
  if (empty($variables['content']['field_block_body'])) {
    return;
  }
  // Style "Sources" (exhibitions): each list item gets an id, #src-<surname>,
  // after the text format has run (it would strip ids typed in the text).
  if ($variables['paragraph']->get('field_text_style')->value === 'sources') {
    $variables['content']['field_block_body']['#post_render'][] = [ExhibitSources::class, 'addIds'];
  }
  // Glossary terms open a definition card where they first appear
  // (GlossaryTerms, scripts/palefire_glossary_setup.php). Not in a list of
  // sources or a transcription, whose words are a document's own.
  elseif (!$variables['transcription'] && GlossaryTerms::available()) {
    $variables['content']['field_block_body']['#post_render'][] = [GlossaryTerms::class, 'mark'];
    $variables['content']['field_block_body']['#attached']['library'][] = 'palefire/glossary';
    $variables['content']['field_block_body']['#cache']['tags'] = Cache::mergeTags($variables['content']['field_block_body']['#cache']['tags'] ?? [], GlossaryTerms::cacheTags());
  }
  // A link to a bird in Audubon's field guide becomes a ruled row with the
  // bird's names (ExhibitFieldGuide).
  $guide = FALSE;
  foreach (Element::children($variables['content']['field_block_body']) as $delta) {
    $guide = $guide || ExhibitFieldGuide::applies((string) ($variables['content']['field_block_body'][$delta]['#text'] ?? ''));
  }
  if ($guide) {
    $names = ExhibitFieldGuide::names($variables['paragraph']);
    $variables['content']['field_block_body']['#pf_fieldguide'] = $names;
    // The names come from the entry's caption: a new caption redraws the row.
    $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $names[2]);
    $variables['content']['field_block_body']['#post_render'][] = [ExhibitFieldGuide::class, 'rows'];
  }
  $marker = '#<p>\s*\[request-paths\]\s*</p>#i';
  $faqs_marker = '#<p>\s*\[special-collections-faqs\]\s*</p>#i';
  $faqs = FALSE;
  $analytics_marker = '#<p>\s*\[analytics:(report|feedback)\]\s*</p>#i';
  $analytics = NULL;
  $research_marker = '#<p>\s*\[research:(' . implode('|', ResearchFigures::PARTS) . ')\]\s*</p>#i';
  $research = NULL;
  $newsletter = NULL;
  // Guarded, so this file never needs src/NewsletterReview.php to be deployed
  // with it.
  $newsletter_ready = class_exists(NewsletterReview::class);
  $newsletter_issues = [];
  $newsletter_parts = [];
  // Element::children() takes its argument by reference, so it gets the
  // variable itself, not an expression.
  foreach (Element::children($variables['content']['field_block_body']) as $delta) {
    $item = &$variables['content']['field_block_body'][$delta];
    if (isset($item['#text']) && preg_match($marker, (string) $item['#text'])) {
      $item['#text'] = preg_replace($marker, '', (string) $item['#text']);
      $variables['request_paths'] = TRUE;
    }
    if (isset($item['#text']) && preg_match($faqs_marker, (string) $item['#text'])) {
      $item['#text'] = preg_replace($faqs_marker, '', (string) $item['#text']);
      $faqs = TRUE;
    }
    if (isset($item['#text']) && preg_match($analytics_marker, (string) $item['#text'], $analytics_match)) {
      $item['#text'] = preg_replace($analytics_marker, '', (string) $item['#text']);
      $analytics = strtolower($analytics_match[1]);
    }
    if (isset($item['#text']) && preg_match($research_marker, (string) $item['#text'], $research_match)) {
      $item['#text'] = preg_replace($research_marker, '', (string) $item['#text']);
      $research = strtolower($research_match[1]);
    }
    // "[podcast]": Oral History's podcast episodes follow (PodcastFeed).
    if (isset($item['#text']) && preg_match(PodcastFeed::MARKER, (string) $item['#text'])) {
      $item['#text'] = preg_replace(PodcastFeed::MARKER, '', (string) $item['#text']);
      $variables['podcast'] = PodcastFeed::view() ?? ['profile' => PodcastFeed::PROFILE];
      CacheableMetadata::createFromRenderArray($variables)
        ->addCacheTags([PodcastFeed::CACHE_TAG])
        ->applyTo($variables);
    }
    if ($newsletter_ready && isset($item['#text']) && preg_match(NewsletterReview::MARKER, (string) $item['#text'], $newsletter_match)) {
      $item['#text'] = preg_replace(NewsletterReview::MARKER, '', (string) $item['#text']);
      $newsletter = [$newsletter_match[1], $newsletter_match[2]];
    }
    foreach ($newsletter_ready ? ['archive' => NewsletterReview::ARCHIVE_MARKER, 'compare' => NewsletterReview::COMPARE_MARKER] : [] as $part => $part_marker) {
      if (isset($item['#text']) && preg_match($part_marker, (string) $item['#text'])) {
        $item['#text'] = preg_replace($part_marker, '', (string) $item['#text']);
        $newsletter_parts[$part] = TRUE;
      }
    }
    if (class_exists(PrTimeline::class) && isset($item['#text']) && preg_match(PrTimeline::MARKER, (string) $item['#text'])) {
      $pr_text = preg_replace(PrTimeline::MARKER, '<!--pf-pr-timeline-->', (string) $item['#text'], 1);
      // Only a list after the marker is the timeline.
      [$before, $after] = explode('<!--pf-pr-timeline-->', $pr_text, 2);
      [$pr_items, $after] = PrTimeline::items($after, (string) ($item['#format'] ?? ''));
      $item['#text'] = preg_replace(PrTimeline::MARKER, '', $before . $after);
      $variables['pr_timeline'] = $pr_items;
    }
    if (class_exists(PageReview::class) && isset($item['#text']) && preg_match(PageReview::HUB_MARKER, (string) $item['#text'])) {
      // Only a list after the marker is the hub's.
      [$before, $after] = explode('<!--pf-page-review-->', preg_replace(PageReview::HUB_MARKER, '<!--pf-page-review-->', (string) $item['#text'], 1), 2);
      [$hub_pages, $after] = PageReview::links($after);
      $item['#text'] = $before . $after;
      $variables['page_review_hub'] = $hub_pages;
    }
    if ($newsletter_parts && isset($item['#text'])) {
      [$found, $item['#text']] = NewsletterReview::issues((string) $item['#text']);
      $newsletter_issues = array_merge($newsletter_issues, $found);
    }
    if (isset($item['#text']) && str_contains((string) $item['#text'], '[styleguide:')) {
      $item['#text'] = preg_replace_callback('#<p>\s*\[styleguide:([a-z]+)\]\s*</p>#i', function (array $m) use (&$variables): string {
        $number = array_search(strtolower($m[1]), PALEFIRE_STYLEGUIDE_PLATES, TRUE);
        if ($number === FALSE) {
          return $m[0];
        }
        $variables['plates'][] = ['plate' => PALEFIRE_STYLEGUIDE_PLATES[$number], 'number' => sprintf('%02d', $number + 1)];
        return '';
      }, (string) $item['#text']);
    }
    unset($item);
  }
  if ($faqs) {
    $variables['faqs'] = _palefire_ask_faqs(NULL, $variables, NULL);
  }
  // Staff only, even if the page is published by mistake: search terms are
  // people's own words.
  if ($analytics) {
    $allowed = \Drupal::currentUser()->hasPermission(AnalyticsReport::PERMISSION);
    $variables['analytics'] = [
      'part' => $analytics,
      'allowed' => $allowed,
      'report' => $allowed && $analytics === 'report' ? AnalyticsReport::view() : NULL,
      'feedback' => $allowed && $analytics === 'feedback' ? AnalyticsReport::feedback() : NULL,
    ];
    $cache = CacheableMetadata::createFromRenderArray($variables)
      ->addCacheTags([AnalyticsReport::CACHE_TAG])
      ->addCacheContexts(['user.permissions']);
    // Feedback is read as it arrives; an hour's limit moves its 28 days on.
    if ($analytics === 'feedback') {
      $cache->addCacheTags(['webform_submission_list'])->setCacheMaxAge(3600);
    }
    $cache->applyTo($variables);
  }
  // Redrawn when the nightly pull saves (ResearchFigures::save()).
  if ($research) {
    $variables['research'] = ['part' => $research, 'data' => ResearchFigures::view($research)];
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheTags([ResearchFigures::CACHE_TAG])
      ->applyTo($variables);
  }
  // The draft changes while it is reviewed: redrawn every five minutes. The
  // anonymous page cache ignores max-age, so palefire_page_attachments_alter()
  // keeps these pages out of it.
  if ($newsletter) {
    $variables['newsletter'] = NewsletterReview::view(...$newsletter);
    // Below the draft and its form, the past issues to hold it against: the
    // newsletters page's own list, so there is one list to keep.
    $past = NewsletterReview::pastIssues();
    if ($past['issues'] && empty($newsletter_parts['archive'])) {
      $variables['newsletter_archive'] = NewsletterReview::archive($past['issues']) + ['heading' => t('Past issues'), 'plain' => TRUE];
    }
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheTags($past['tags'])
      ->addCacheTags(NewsletterReview::cacheTags())
      // Staff who can edit notes get a Reply button under each one.
      ->addCacheContexts(['url.query_args:' . NewsletterReview::READ, 'user.permissions'])
      ->setCacheMaxAge(NewsletterReview::MAX_AGE)
      ->applyTo($variables);
  }
  // Approved notes show as soon as they're approved: the Webform's
  // submissions list tag clears the paragraph (and the page cache).
  if ($variables['pr_timeline'] !== NULL) {
    $variables['pr_timeline'] = PrTimeline::view($variables['pr_timeline']);
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheTags(PrTimeline::cacheTags())
      ->applyTo($variables);
  }
  // Notes and thumbs show as they come in and are approved, as on the
  // timeline.
  if ($variables['page_review_hub'] !== NULL) {
    $variables['page_review_hub'] = PageReview::hub($variables['page_review_hub']);
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheTags(PageReview::cacheTags())
      ->applyTo($variables);
  }
  // Sent issues are kept a day; a comparison, which is often of a draft,
  // five minutes.
  if ($newsletter_parts) {
    $variables['newsletter_archive'] = isset($newsletter_parts['archive']) ? NewsletterReview::archive($newsletter_issues) : NULL;
    $variables['newsletter_compare'] = isset($newsletter_parts['compare']) ? NewsletterReview::compare($newsletter_issues) : NULL;
    CacheableMetadata::createFromRenderArray($variables)
      ->addCacheTags([NewsletterReview::cacheTag()])
      ->addCacheContexts(['url.query_args:' . NewsletterReview::READ])
      ->setCacheMaxAge(isset($newsletter_parts['compare']) ? NewsletterReview::MAX_AGE : NewsletterReview::SENT_MAX_AGE)
      ->applyTo($variables);
  }
  $variables['ask_href'] = '';
  $tab = $variables['request_paths'] ? $variables['paragraph']->getParentEntity() : NULL;
  $tabs = $tab instanceof ParagraphInterface && $tab->bundle() === 'section_tab' ? $tab->getParentEntity() : NULL;
  if ($tabs instanceof ParagraphInterface && $tabs->hasField('field_tabs')) {
    foreach ($tabs->get('field_tabs')->referencedEntities() as $sibling) {
      foreach ($sibling->hasField('field_guide_blocks') ? $sibling->get('field_guide_blocks')->referencedEntities() : [] as $block) {
        if ($block->bundle() === 'tile_showcase' && $block->hasField('field_tile_layout') && $block->get('field_tile_layout')->value === 'ask') {
          $variables['ask_href'] = '#ask-question';
        }
      }
    }
    CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($tabs)->applyTo($variables);
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--librarian-card.
 *
 * card: the referenced staff node in the guide_card view mode, or NULL when
 * it is missing or the visitor can't see it (the card is then left out).
 */
function palefire_preprocess_paragraph__librarian_card(array &$variables): void {
  $variables['card'] = NULL;
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_librarian')) {
    return;
  }
  $person = $paragraph->get('field_librarian')->entity;
  if (!$person instanceof NodeInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($person);
  $access = $person->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->applyTo($variables);
  if ($access->isAllowed()) {
    $person = \Drupal::service('entity.repository')->getTranslationFromContext($person);
    $variables['card'] = \Drupal::entityTypeManager()->getViewBuilder('node')->view($person, 'guide_card');
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view.
 *
 * The staff View (StaffDirectory::VIEW, scripts/palefire_staff_setup.php)
 * only provides the routes; its templates print what this reads from the
 * Staff nodes.
 * - directory (/v2/staff): people (StaffDirectory::row(), by family name),
 *   departments (label, slug, count, by label) and total.
 * - profile (/v2/staff/<slug>): person (StaffDirectory::profile()). A slug
 *   that names no published Staff node is a 404.
 */
function palefire_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  if ($view->id() !== StaffDirectory::VIEW) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheTags(['node_list:' . StaffDirectory::BUNDLE]);

  if ($view->current_display === 'profile') {
    $person = StaffDirectory::fromSlug((string) ($view->args[0] ?? ''), $cache);
    if (!$person) {
      throw new NotFoundHttpException();
    }
    $variables['person'] = StaffDirectory::profile($person, $cache);
    $cache->applyTo($variables);
    return;
  }

  $nids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', StaffDirectory::BUNDLE)
    ->condition('status', 1)
    ->execute();
  $people = [];
  $departments = [];
  $repository = \Drupal::service('entity.repository');
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids) as $node) {
    $row = StaffDirectory::row($repository->getTranslationFromContext($node), $cache);
    $people[StaffDirectory::sortKey($row['name']) . ' ' . $node->id()] = $row;
    foreach ($row['departments'] as $department) {
      $departments[$department['slug']] ??= ['label' => $department['label'], 'slug' => $department['slug'], 'count' => 0];
      $departments[$department['slug']]['count']++;
    }
  }
  ksort($people, SORT_NATURAL);
  uasort($departments, static fn (array $a, array $b): int => strnatcasecmp($a['label'], $b['label']));
  $variables['people'] = array_values($people);
  $variables['departments'] = array_values($departments);
  $variables['total'] = count($people);
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--section-tabs.
 *
 * Section tabs (scripts/palefire_section_tabs_setup.php): tabs, one per
 * published Tab (field_tabs), in order:
 * - id: the panel's id and link (#visit): the Tab's Link name
 *   (field_tab_anchor) or its label, made an HTML id, unique in the section.
 * - label: Label (field_tab_label).
 * - icon: Icon (field_tab_icon), a Font Awesome 5 name ("landmark", or
 *   "duotone/landmark"; solid when no style is given), as the SVG's path
 *   under libraries/fontawesome-pro/svgs/ for the template to inline. A
 *   name with anything but lowercase letters, digits and hyphens is left
 *   out.
 * - content: the Tab's blocks (field_guide_blocks), rendered.
 * - quick: the Tab draws the request paths (_palefire_tab_has_paths()); in
 *   the landing hero its panel shows the whole Quick Start.
 * tabs_label names the tablist: the section's title, else "Sections".
 */
function palefire_preprocess_paragraph__section_tabs(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  $variables['tabs'] = [];
  if (!$paragraph instanceof ParagraphInterface || !$paragraph->hasField('field_tabs')) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $title = $paragraph->hasField('field_section_title') ? trim((string) $paragraph->get('field_section_title')->value) : '';
  $variables['tabs_label'] = $title !== '' ? $title : t('Sections');
  $value = static fn (ParagraphInterface $tab, string $name): string => $tab->hasField($name) ? trim((string) $tab->get($name)->value) : '';
  $used = [];
  foreach ($paragraph->get('field_tabs') as $item) {
    $tab = $item->entity;
    if (!$tab instanceof ParagraphInterface) {
      continue;
    }
    $cache->addCacheableDependency($tab);
    if (!$tab->isPublished()) {
      continue;
    }
    $label = $value($tab, 'field_tab_label');
    if ($label === '') {
      continue;
    }
    $base = Html::getId($value($tab, 'field_tab_anchor') ?: $label);
    $id = $base;
    for ($n = 2; isset($used[$id]); $n++) {
      $id = $base . '-' . $n;
    }
    $used[$id] = TRUE;
    $icon = strtolower($value($tab, 'field_tab_icon'));
    if (preg_match('/^(?:(solid|regular|light|thin|duotone)\/)?([a-z0-9]+(?:-[a-z0-9]+)*)$/', $icon, $m)) {
      $icon = ($m[1] ?: 'solid') . '/' . $m[2];
    }
    else {
      $icon = '';
    }
    $variables['tabs'][] = [
      'id' => $id,
      'label' => $label,
      'icon' => $icon,
      'content' => $tab->hasField('field_guide_blocks') ? $tab->get('field_guide_blocks')->view(['label' => 'hidden']) : [],
      'quick' => _palefire_tab_has_paths($tab),
    ];
  }
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--staff-contacts.
 *
 * Who to ask (scripts/palefire_staff_setup.php): contacts, one per Contact
 * row (field_staff_contacts) whose person the visitor can see: topic, name,
 * url (their /v2/staff profile), title and email. The section's heading,
 * eyebrow, lede and link come from the scroll-section field template.
 */
function palefire_preprocess_paragraph__staff_contacts(array &$variables): void {
  $variables['contacts'] = [];
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_staff_contacts')) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  foreach ($paragraph->get('field_staff_contacts')->referencedEntities() as $contact) {
    $cache->addCacheableDependency($contact);
    $person = $contact->hasField('field_librarian') ? $contact->get('field_librarian')->entity : NULL;
    $topic = $contact->hasField('field_contact_topic') ? trim((string) $contact->get('field_contact_topic')->value) : '';
    if (!$contact->isPublished() || $topic === '' || !$person instanceof NodeInterface) {
      continue;
    }
    $cache->addCacheableDependency($person);
    $access = $person->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $row = StaffDirectory::row(\Drupal::service('entity.repository')->getTranslationFromContext($person), $cache);
    $variables['contacts'][] = ['topic' => $topic] + array_intersect_key($row, array_flip(['name', 'url', 'title', 'email']));
  }
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--tile-showcase.
 *
 * Tile showcase (scripts/palefire_tile_showcase_setup.php) lists Tile nodes
 * and Modular pages (field_tiles, read by _palefire_node_card()) in one of
 * three layouts (field_tile_layout):
 * - stagger: tall portrait cards in a row with an offset rhythm (the
 *   concept's How-to guides and Specializations). A swipeable row when the
 *   section is narrow.
 * - grid: landscape cards in three columns (the concept's Collections),
 *   stepping down to two and one.
 * - index: a numbered list with no pictures, one ruled row per item: its
 *   number, title, note and label (Collections & services on the Special
 *   Collections homepage). The "index" value is added to the Layout field's
 *   allowed values by hand (Manage fields); any other value is a stagger.
 * - masonry: tall cards in the hero banners' voice, with a Grid / List
 *   switch for the visitor (js/tile-views.js); named for its old Masonry
 *   view. Added by palefire_tile_showcase_gallery_setup.php.
 * - ledger: the index's rows unnumbered, grouped under their Category
 *   labels, beside the section's heading when wide (Partnerships on the
 *   Special Collections homepage). Added to the allowed values by hand, as
 *   index is.
 *
 * layout: 'stagger', 'grid', 'index', 'ledger', 'masonry', 'ask' or 'covers'.
 * tiles: one entry per item the visitor can see, in field order:
 * - title: the node's title.
 * - url: the node's own URL.
 * - label: its Category terms as one label (_palefire_card_label():
 *   "Dept + Medium", "Digital Exhibition"), or '' (the cards and the
 *   index's rows).
 * - labels: the same terms, one string each.
 * - note: its intro as plain text, or '' (shown by the index, and by the
 *   masonry's List view).
 * - image: the card's cover in the layout's responsive image style, or
 *   NULL (always NULL on the index, which shows none). Its alt is empty:
 *   the card's title already names the link, so the image would only
 *   repeat it (WCAG 1.1.1 decorative-in-context).
 * - outline: a card with no image (not on the index): the page's sections
 *   (_palefire_page_outline()), which the card draws as a blurred picture
 *   of the page in the reading swatch's colors. Guides rarely have covers.
 * groups (ledger only): the tiles by label, in the order each label first
 *   appears: label, tiles. Tiles with no label come last, under "More", or
 *   as one group with no label when none has one. Titles lose a leading
 *   "Special Collections".
 *
 * Layout "ask" (Ask Special Collections, scripts/palefire_ask_section.php)
 * is no card list: faqs (_palefire_ask_faqs()) and ask_form, the libanswers
 * module's question form (palefire_form_libanswers_ask_form_alter()), or
 * NULL without the module.
 *
 * Layout "covers" (Published from the Collections,
 * scripts/palefire_publications_setup.php) lists books, not nodes: books
 * (_palefire_publications()) from the section's Publications paragraphs.
 */
function palefire_preprocess_paragraph__tile_showcase(array &$variables): void {
  $variables['layout'] = 'stagger';
  $variables['tiles'] = [];
  $variables['groups'] = [];
  $variables['books'] = [];
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  $layout = $paragraph->hasField('field_tile_layout') ? $paragraph->get('field_tile_layout')->value : NULL;
  if (in_array($layout, ['grid', 'index', 'ledger', 'masonry', 'ask', 'covers'], TRUE)) {
    $variables['layout'] = $layout;
  }
  if ($variables['layout'] === 'ask') {
    // On Oral History's homepage the section is the Williams Center's: its
    // FAQs (Subcategory "Oral History", else Special Collections'), its
    // wording (ask-special.html.twig, ask_unit) and the form mailed to the
    // person its Who to ask names (_palefire_ask_mail_to()), not a ticket.
    $host = _palefire_paragraph_host_node($paragraph);
    $alias = $host ? \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $host->id()) : '';
    $variables['ask_unit'] = preg_match('#^/v2/oralhistory(/|$)#', $alias) ? 'oral_history' : '';
    $oral_history = $variables['ask_unit'] === 'oral_history';
    $variables['faqs'] = _palefire_ask_faqs($paragraph, $variables, 8, $oral_history ? 'Oral History' : 'Special Collections');
    // The question form (the libanswers module: a Special Collections
    // ticket through the LibAnswers API, or an email to one Staff member,
    // Honeypot against spam). Without the module the section offers AskUs
    // instead.
    $variables['ask_form'] = NULL;
    if (\Drupal::moduleHandler()->moduleExists('libanswers')) {
      $form_class = 'Drupal\libanswers\Form\AskForm';
      $mail_to = $oral_history && $host ? _palefire_ask_mail_to($host) : 0;
      // A module from before its email mode takes no Staff node: then the
      // queue, as on Special Collections.
      if ($mail_to && (new \ReflectionMethod($form_class, 'buildForm'))->getNumberOfParameters() < 5) {
        $mail_to = 0;
      }
      $variables['ask_form'] = $mail_to
        ? \Drupal::formBuilder()->getForm($form_class, 0, 'ask-oral-history', $mail_to)
        : \Drupal::formBuilder()->getForm($form_class, 2616, 'ask-special-collections');
    }
    return;
  }
  if ($variables['layout'] === 'covers') {
    $cache = CacheableMetadata::createFromRenderArray($variables);
    $variables['books'] = _palefire_publications($paragraph, $cache);
    $cache->applyTo($variables);
    return;
  }
  $rows = in_array($variables['layout'], ['index', 'ledger'], TRUE);
  if (!$paragraph->hasField('field_tiles')) {
    return;
  }

  $cache = CacheableMetadata::createFromRenderArray($variables);
  $style = $variables['layout'] === 'grid' ? 'tile_showcase_landscape' : 'tile_showcase_portrait';
  $covers = [];
  $covers_all = [];
  $objects_all = [];

  foreach ($paragraph->get('field_tiles') as $item) {
    $node = $item->entity;
    $card = $node instanceof NodeInterface ? _palefire_node_card($node, $cache, 140) : NULL;
    if (!$card) {
      continue;
    }
    $show_image = !$rows && $card['image_item'];
    // Every cover fills its card, an oral history exhibition's wide still
    // too (cut to the card's 3:4 from its middle, as any other picture);
    // none is shown whole on the card's ground any more (2026-11-18).
    $oral_history = _palefire_is_oral_history_exhibition($node);
    $whole = FALSE;
    $image = $show_image ? _palefire_responsive_cover($card['image_item'], $style, $cache) : NULL;
    $variables['tiles'][] = [
      'whole' => $whole,
      'oral_history' => $oral_history,
      'title' => $card['title'],
      'url' => $card['url'],
      'label' => $card['label'],
      'labels' => $card['labels'],
      'note' => $card['note'],
      'image' => $image,
      'outline' => !$rows && !$image ? _palefire_page_outline($node, $cache) : [],
    ];
    $covers[] = $show_image ? $card['image_item'] : NULL;
    $covers_all[] = $card['image_item'];
    $objects_all[] = $variables['layout'] === 'ledger' ? _palefire_cover_object_label($node) : NULL;
  }

  if ($variables['layout'] === 'ledger') {
    // Each row's cover behind the whole section while the row is hovered or
    // focused (js/ledger-photo.js): a URL in pf_location_backdrop (1920px
    // WebP, as the map's room photos), fetched only on hover. Rows without
    // a cover, or without the style, get ''. object: the cover's object
    // label (_palefire_cover_object_label()), shown as its citation at the
    // foot of the left column while it shows, or NULL.
    $photo_style = \Drupal::entityTypeManager()->getStorage('image_style')->load('pf_location_backdrop');
    if ($photo_style) {
      $cache->addCacheableDependency($photo_style);
    }
    $variables['backdrops'] = FALSE;
    foreach ($variables['tiles'] as $i => $tile) {
      $file = $photo_style ? $covers_all[$i]?->entity : NULL;
      $backdrop = '';
      if ($file instanceof FileInterface) {
        $cache->addCacheableDependency($file);
        $backdrop = \Drupal::service('file_url_generator')->transformRelative($photo_style->buildUrl($file->getFileUri()));
        $variables['backdrops'] = TRUE;
      }
      $variables['tiles'][$i]['backdrop'] = $backdrop;
      $variables['tiles'][$i]['object'] = $backdrop ? $objects_all[$i] : NULL;
    }

    // Rows drop a leading "Special Collections" ("Research Grants"): the
    // section already sits on its homepage. The node titles keep it, for
    // their own pages and for search.
    $groups = [];
    foreach ($variables['tiles'] as $tile) {
      $tile['title'] = preg_replace('/^Special Collections\s+(?=\S)/iu', '', $tile['title']);
      $groups[$tile['label']][] = $tile;
    }
    $loose = $groups[''] ?? [];
    unset($groups['']);
    if ($loose) {
      $more = $groups ? (string) t('More') : '';
      $groups[$more] = array_merge($groups[$more] ?? [], $loose);
    }
    foreach ($groups as $label => $tiles) {
      $variables['groups'][] = ['label' => (string) $label, 'tiles' => $tiles];
    }
  }

  // A gallery listing (.pf-tiles--whole): in the Grid every picture 16:9,
  // the title and label under it on the page, no scrim: only a showcase
  // whose every card is a whole wide cover, so a mixed showcase (Oral
  // History's exhibitions included) keeps the masonry cards. Wide covers
  // stay whole (letterboxed); the other cards' pictures are the landscape
  // crop (1280 x 800, from the whole file, not the 3:4 one), cut to 16:9.
  $tiles = $variables['tiles'] ?? [];
  $variables['whole_covers'] = $tiles && !array_filter($tiles, static fn (array $tile): bool => empty($tile['whole']));
  if ($variables['whole_covers']) {
    foreach ($variables['tiles'] as $i => $tile) {
      if (!$tile['whole'] && !empty($covers[$i])) {
        $variables['tiles'][$i]['image'] = _palefire_image_build($covers[$i], ['tile_showcase_landscape_lg'], $cache) ?? $tile['image'];
      }
    }
  }
  // The masonry Grid's lead card (one to four tiles, _tile-showcase.scss)
  // spans two to five columns: its cover is the landscape crop, sized for
  // that width (beside the sidebar from 1480px; a column below).
  $count = count($variables['tiles']);
  if ($variables['layout'] === 'masonry' && $count <= 4 && !empty($covers[0]) && !$variables['whole_covers']) {
    $lead = [1 => 85, 2 => 50, 3 => 50, 4 => 34][$count];
    $variables['tiles'][0]['image'] = _palefire_lead_cover($covers[0], "(min-width: 1480px) {$lead}vw, (min-width: 768px) 34vw, 50vw", $cache) ?? $variables['tiles'][0]['image'];
  }
  $cache->applyTo($variables);
}

/**
 * The books for a Tile showcase in the Covers layout, in field order.
 *
 * From its Publications (field_tile_publications, Publication paragraphs:
 * scripts/palefire_publications_setup.php). Unpublished ones and ones with
 * no title are skipped. Each book:
 * - title: the title before its first colon ("Kingfish U"), as the cover
 *   and the card's heading show it; subtitle: the rest, or ''.
 * - author, imprint ("LSU Press, 2023"): plain text, or ''.
 * - url: its Link (the catalog record), or ''.
 * - image: its Cover (Media: Image) in publication_cover (480 wide, no
 *   crop), decorative and lazy (_palefire_image_build()), or NULL: the
 *   card then sets a jacket in type.
 * - depth: its thickness as a share of the cover's width, for the page
 *   edges (--pf-book-depth): from its Pages (field_pub_pages), about
 *   0.06mm a page plus 3mm of boards on a 6in (152mm) wide book,
 *   between 0.06 and 0.3; 300 pages when it has no count.
 */
function _palefire_publications(ParagraphInterface $paragraph, CacheableMetadata $cache): array {
  $books = [];
  if (!$paragraph->hasField('field_tile_publications')) {
    return $books;
  }
  $text = static fn (ParagraphInterface $book, string $field): string => ($book->hasField($field) && !$book->get($field)->isEmpty())
    ? trim((string) $book->get($field)->value)
    : '';
  foreach ($paragraph->get('field_tile_publications')->referencedEntities() as $book) {
    if (!$book instanceof ParagraphInterface) {
      continue;
    }
    $cache->addCacheableDependency($book);
    $full = $text($book, 'field_pub_title');
    if (!$book->isPublished() || $full === '') {
      continue;
    }
    [$title, $subtitle] = array_pad(preg_split('/\s*:\s+/u', $full, 2), 2, '');

    $url = '';
    if ($book->hasField('field_pub_link') && !$book->get('field_pub_link')->isEmpty()) {
      $link = $book->get('field_pub_link')->first()->getUrl();
      $generated = $link->toString(TRUE);
      $cache->addCacheableDependency($generated);
      $url = $generated->getGeneratedUrl();
    }

    $image = NULL;
    if ($book->hasField('field_pub_cover') && !$book->get('field_pub_cover')->isEmpty()
      && ($item = _palefire_media_image_item($book->get('field_pub_cover')->first(), $cache))) {
      $image = _palefire_image_build($item, ['publication_cover'], $cache);
    }

    $pages = ($book->hasField('field_pub_pages') && !$book->get('field_pub_pages')->isEmpty())
      ? (int) $book->get('field_pub_pages')->value
      : 300;

    $books[] = [
      'title' => $title,
      'subtitle' => $subtitle,
      'author' => $text($book, 'field_pub_author'),
      'imprint' => $text($book, 'field_pub_imprint'),
      'url' => $url,
      'image' => $image,
      'depth' => round(min(0.3, max(0.06, ($pages * 0.06 + 3) / 152)), 3),
    ];
  }
  return $books;
}

/**
 * The node a paragraph is on, through any paragraphs it is nested in.
 *
 * A Section tab's block sits in the tab, the tab in the Section tabs, and
 * those on the page. NULL when it isn't on a node (a library item, say).
 */
function _palefire_paragraph_host_node(ParagraphInterface $paragraph): ?NodeInterface {
  $entity = $paragraph;
  for ($depth = 0; $depth < 6 && $entity instanceof ParagraphInterface; $depth++) {
    $entity = $entity->getParentEntity();
  }
  return $entity instanceof NodeInterface ? $entity : NULL;
}

/**
 * Whom a unit homepage's Ask form mails: a published Staff node's ID, or 0.
 *
 * The first person in the page's Who to ask (a Staff contacts section,
 * field_librarian), so the page names who answers and the form reaches
 * them. The address is read from their Staff page when a question is sent
 * (the libanswers module), never put in the page.
 */
function _palefire_ask_mail_to(NodeInterface $node): int {
  if (!$node->hasField('field_scroll_section')) {
    return 0;
  }
  foreach ($node->get('field_scroll_section')->referencedEntities() as $section) {
    if ($section->bundle() !== 'staff_contacts' || !$section->hasField('field_staff_contacts')) {
      continue;
    }
    foreach ($section->get('field_staff_contacts')->referencedEntities() as $contact) {
      $person = $contact->hasField('field_librarian') ? $contact->get('field_librarian')->entity : NULL;
      if ($person instanceof NodeInterface && $person->bundle() === 'staff' && $person->isPublished()) {
        return (int) $person->id();
      }
    }
  }
  return 0;
}

/**
 * The FAQs for an Ask Special Collections section (Tile showcase, "ask").
 *
 * The Tiles picked in the section's Tiles field, in that order; with none
 * picked, the published Tiles in the FAQ category whose Subcategory says
 * "Special Collections" (the old site's FAQ tiles), by search weight then
 * title, at most eight. "Says", not "is": some imported Subcategories
 * carry stray spaces, and an exact match (LIKE) misses them all. The section's link (the index rule's) points at
 * the rest on AskUs.
 *
 * With no paragraph and no limit (a guide's "[special-collections-faqs]"
 * marker, palefire_preprocess_paragraph__guide_text()): every one of those
 * FAQs, in the same order.
 *
 * $subcategory picks another unit's FAQ tiles ("Oral History" on its
 * homepage); with none, Special Collections' stand in.
 *
 * Each FAQ:
 * - question: the tile's title.
 * - answer: its Formatted text or Linked text (filtered, as a render
 *   array), else its Long summary as plain text, else ''.
 * - byline: who answered ("Answered by" off the end of the text), or ''.
 * The tile's Link (the same answer on AskUs) isn't offered: it only sent
 * readers away to read the same words again.
 */
function _palefire_ask_faqs(?ParagraphInterface $paragraph, array &$variables, ?int $limit = 8, string $subcategory = 'Special Collections'): array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $nodes = [];
  if ($paragraph && $paragraph->hasField('field_tiles')) {
    foreach ($paragraph->get('field_tiles') as $item) {
      if ($item->entity instanceof NodeInterface) {
        $nodes[] = $item->entity;
      }
    }
  }
  if (!$nodes) {
    // A new or edited Tile can change the list.
    $cache->addCacheTags(['node_list:tile']);
    $types = \Drupal::entityTypeManager();
    $terms = $types->getStorage('taxonomy_term')->loadByProperties(['name' => 'FAQ']);
    $ids = [];
    foreach ($terms ? array_unique([$subcategory, 'Special Collections']) : [] as $name) {
      $query = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'tile')
        ->condition('status', NodeInterface::PUBLISHED)
        ->condition('field_category', array_keys($terms), 'IN')
        ->condition('field_subcategory', $name, 'CONTAINS')
        ->sort('field_tile_search_weight', 'DESC')
        ->sort('title');
      if ($limit) {
        $query->range(0, $limit);
      }
      $ids = $query->execute();
      if ($ids) {
        break;
      }
    }
    $nodes = $ids ? $types->getStorage('node')->loadMultiple($ids) : [];
  }

  $faqs = [];
  foreach ($nodes as $node) {
    $node = \Drupal::service('entity.repository')->getTranslationFromContext($node);
    $access = $node->access('view', NULL, TRUE);
    $cache->addCacheableDependency($node)->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $answer = '';
    $byline = '';
    foreach (['field_formatted_text', 'field_tile_linked_text'] as $name) {
      if ($node->hasField($name) && trim(strip_tags((string) $node->get($name)->value)) !== '') {
        [$text, $byline] = _palefire_ask_answer_tidy((string) $node->get($name)->value);
        $answer = [
          '#type' => 'processed_text',
          '#text' => $text,
          '#format' => $node->get($name)->format,
          '#post_render' => [[AskAnswer::class, 'links']],
        ];
        break;
      }
    }
    if (!$answer && $node->hasField('field_tile_long_summary')) {
      $answer = trim((string) $node->get('field_tile_long_summary')->value);
    }
    $faqs[] = [
      'question' => $node->label(),
      'answer' => $answer,
      'byline' => $byline,
    ];
  }
  $cache->applyTo($variables);
  return $faqs;
}

/**
 * Tidies an FAQ answer imported from AskUs for reading.
 *
 * The import flattened AskUs's paragraphs into one line (two spaces where
 * a paragraph ended), sometimes pasted the answer in twice, wrote links
 * with their URL as their text and ended with "Answered by: Name". So:
 * - the trailing "Answered by" comes off and is returned as the byline;
 * - a block (between blank lines) whose words repeat an earlier one's goes;
 * - text with no block markup of its own is split into paragraphs where a
 *   sentence ends before two or more spaces;
 * Answers written with their own paragraphs keep them. The links are
 * tidied after the text format's filters (AskAnswer::links()), since most
 * are bare URLs until the URL filter links them.
 *
 * @return array
 *   The answer's HTML, then the byline's name ('' without one).
 */
function _palefire_ask_answer_tidy(string $html): array {
  $byline = '';
  if (preg_match('~\s*(?:<p>)?\s*Answered by:\s*([^<\n]+?)\s*(?:</p>)?\s*$~iu', $html, $match)) {
    $byline = trim(Html::decodeEntities($match[1]));
    $html = substr($html, 0, -strlen($match[0]));
  }

  $seen = [];
  $blocks = [];
  foreach (preg_split('~\R\s*\R~u', trim($html)) as $block) {
    $words = mb_strtolower(preg_replace('~\s+~u', ' ', trim(strip_tags($block))));
    if ($words === '' || isset($seen[$words])) {
      continue;
    }
    $seen[$words] = TRUE;
    $blocks[] = trim($block);
  }
  $html = implode("\n\n", $blocks);

  if (!preg_match('~<(?:p|br|ul|ol|h[1-6]|table|div|blockquote)\b~i', $html)) {
    $paragraphs = [];
    foreach ($blocks as $block) {
      foreach (preg_split('~(?<=[.!?:)])\s{2,}(?=\S)~u', $block) as $paragraph) {
        // One space between words, and none before a full stop after a link.
        $paragraph = preg_replace(['~\s+~u', '~\)\s+([.,;])~u'], [' ', ')$1'], trim($paragraph));
        $paragraphs[] = '<p>' . $paragraph . '</p>';
      }
    }
    $html = implode("\n", $paragraphs);
  }

  return [$html, $byline];
}

/**
 * Implements hook_form_FORM_ID_alter() for libanswers_ask_form.
 *
 * The libanswers module's question form in the Ask section's markup
 * (templates/form/libanswers-ask-form.html.twig writes the labels and error
 * lines, so the controls lose their form-element wrappers). Each control
 * takes the section's class, text fields a blank placeholder (filled ones
 * show by :placeholder-shown, _ask.scss), and the button is a <button>
 * with the arrow (input--submit--libanswers.html.twig).
 */
function palefire_form_libanswers_ask_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#attributes']['class'][] = 'pf-inquiry__form';
  // Named as the panel's heading above it.
  $form['#attributes']['aria-label'] = t('Send us a question');
  // Who answers each queue, for the slip's last row and js/ask-form.js's
  // thank-you, and where to ask instead if sending fails.
  $desks = [
    237 => [t('Library staff'), t('the Main Library'), 'https://askus.lib.lsu.edu/'],
    2616 => [t('Special Collections staff'), t('Special Collections'), 'https://askus.lib.lsu.edu/special'],
  ];
  $queue = (int) ($form['#libanswers_queue'] ?? $form_state->get('libanswers_queue') ?? 2616);
  [$staff, $desk, $askus] = $desks[$queue] ?? $desks[2616];
  // Mailed to one person (Oral History's homepage, _palefire_ask_mail_to()).
  if (!empty($form['#libanswers_mail'])) {
    [$staff, $desk, $askus] = [t('Williams Center staff'), t('the Williams Center'), 'https://askus.lib.lsu.edu/search/?t=0&g=12395'];
  }
  $form['#pf_staff'] = $staff;
  $form['#attributes']['data-pf-ask-to'] = (string) $desk;
  $form['#attributes']['data-pf-askus'] = $askus;
  // The queue's own fields (the module lists them; before it did, only
  // Special Collections' two menus), then the shared ones.
  $fields = $form['#libanswers_fields'] ?? ['val1', 'val2'];
  $form['#libanswers_fields'] = $fields;
  foreach (array_merge($fields, ['pname', 'pemail', 'pquestion', 'pdetails']) as $name) {
    if (!isset($form[$name])) {
      continue;
    }
    $form[$name]['#theme_wrappers'] = [];
    $form[$name]['#attributes']['class'][] = 'pf-inquiry__control';
    if ($form[$name]['#type'] !== 'select') {
      $form[$name]['#attributes']['placeholder'] = ' ';
    }
    // A follow-up starts switched off, so it isn't sent until
    // js/ask-form.js shows it (the template hides its cell).
    if (isset($form['#libanswers_when'][$name])) {
      $form[$name]['#attributes']['disabled'] = 'disabled';
    }
  }
  if (isset($form['actions']['submit'])) {
    // A submit button is drawn by its wrapper (input__submit), not #theme:
    // replace the wrapper, or the <input> is drawn around the <button>.
    $form['actions']['submit']['#theme_wrappers'] = ['input__submit__libanswers'];
    $form['actions']['submit']['#attributes']['class'][] = 'pf-inquiry__submit';
  }
}

/**
 * Builds a tile's cover in the landscape crops for a lead card.
 *
 * One srcset of tile_showcase_landscape_sm/_md/_lg (640, 960 and 1280 wide,
 * 16:10) with the given sizes, decorative and lazy as the other covers.
 * NULL when none of the styles exist (the caller keeps its own cover).
 */
function _palefire_lead_cover(FieldItemInterface $image, string $sizes, CacheableMetadata $cache): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  $srcset = [];
  foreach (['sm' => 640, 'md' => 960, 'lg' => 1280] as $size => $width) {
    if ($style = $storage->load('tile_showcase_landscape_' . $size)) {
      $cache->addCacheableDependency($style);
      $srcset[] = ['uri' => $style->buildUrl($file->getFileUri()), 'width' => $width . 'w'];
    }
  }
  if (!$srcset) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  return [
    '#theme' => 'image',
    '#uri' => end($srcset)['uri'],
    '#srcset' => $srcset,
    '#sizes' => $sizes,
    '#width' => 1280,
    '#height' => 800,
    '#alt' => '',
    '#attributes' => ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for field templates.
 *
 * Scroll sections (field_scroll_section): a section whose paragraph has an
 * Eyebrow (field_tile_eyebrow, on the Tile showcase) opens with an index
 * rule, as the hero's do, and its Lede under the heading
 * (field--node--field-scroll-section--modular-page.html.twig). Adds
 * item.section.index: num ('04'), label (the eyebrow), lede (plain text,
 * or ''), and link (url, text, external, from field_tile_link) or NULL.
 *
 * Numbered by position, so a section moved in the editor renumbers itself:
 * the landing hero's sections count first (as many as it numbers,
 * _palefire_hero_index()), then each section with an Eyebrow, in order.
 * The link's text drops a trailing arrow typed by hand: the rule draws
 * its own. A Section tabs section the hero's Quick Start draws
 * (_palefire_hero_tabs()) is left out, and takes no number.
 */
function palefire_preprocess_field(array &$variables): void {
  if (($variables['field_name'] ?? '') !== 'field_scroll_section' || empty($variables['items'])) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $count = 0;
  $hide = [];
  // Sections the hero draws itself, wherever they sit on the page.
  $drawn = [];
  foreach ($variables['items'] as $item) {
    $paragraph = $item['content']['#paragraph'] ?? NULL;
    if ($paragraph instanceof ParagraphInterface && $paragraph->bundle() === 'landing_hero' && ($tabs = _palefire_hero_tabs($paragraph))) {
      $drawn[] = $tabs->id();
    }
  }
  foreach ($variables['items'] as $key => &$item) {
    $paragraph = $item['content']['#paragraph'] ?? NULL;
    if (!$paragraph instanceof ParagraphInterface) {
      continue;
    }
    if ($paragraph->bundle() === 'landing_hero') {
      $count += count(_palefire_hero_index($paragraph));
      continue;
    }
    // Its Quick Start draws the page's Section tabs: not again here.
    if (in_array($paragraph->id(), $drawn, TRUE)) {
      $hide[] = $key;
      continue;
    }
    if (!is_array($item['section'] ?? NULL)) {
      continue;
    }
    if (!$paragraph->hasField('field_tile_eyebrow') || $paragraph->get('field_tile_eyebrow')->isEmpty()) {
      // The podcast's section (a Guide section, no Eyebrow field): its rule
      // in code, with the way to every episode at its end, a Lede, and the
      // cassette mark in its head (includes/cassette-mark.html.twig).
      if (PodcastFeed::isSection($paragraph)) {
        $cache->addCacheableDependency($paragraph);
        $item['section']['index'] = [
          'num' => sprintf('%02d', ++$count),
          'label' => t('The podcast'),
          'lede' => t('Short episodes from the T. Harry Williams Center for Oral History, drawn from more than 6,000 hours of interviews: Louisiana’s hidden stories, told by the people who lived them.'),
          'mark' => 'cassette',
          'link' => ['url' => PodcastFeed::PROFILE, 'text' => t('All episodes'), 'external' => TRUE, 'hidden' => (string) t(' (on SoundCloud, opens in a new tab)')],
        ];
        continue;
      }
      // A location page's parts carry theirs in code (no Eyebrow field), and
      // set their heading beside the content (aside) rather than over it.
      $location = _palefire_location_index($paragraph, $cache);
      if ($location) {
        // Numbered on every room's page, so the pages read alike.
        $item['section']['index'] = ['num' => sprintf('%02d', ++$count), 'aside' => TRUE] + $location;
        // A part saved without a Section title still gets its heading (the
        // section is aria-labelledby it, and the TOC lists it).
        if (trim((string) ($item['section']['label'] ?? '')) === '') {
          $item['section']['label'] = $location['heading'];
        }
      }
      continue;
    }
    $cache->addCacheableDependency($paragraph);
    $link = NULL;
    if ($paragraph->hasField('field_tile_link') && !$paragraph->get('field_tile_link')->isEmpty()) {
      $link_item = $paragraph->get('field_tile_link')->first();
      $url = $link_item->getUrl();
      $generated = $url->toString(TRUE);
      $cache->addCacheableDependency($generated);
      $text = trim(preg_replace('/[\s\x{2192}]+$/u', '', (string) $link_item->title));
      $link = [
        'url' => $generated->getGeneratedUrl(),
        'text' => $text !== '' ? $text : t('See all'),
        'external' => $url->isExternal(),
      ];
    }
    $lede = $paragraph->hasField('field_tile_lede') ? trim((string) $paragraph->get('field_tile_lede')->value) : '';
    $item['section']['index'] = [
      'num' => sprintf('%02d', ++$count),
      'label' => $paragraph->get('field_tile_eyebrow')->value,
      'lede' => $lede,
      'link' => $link,
    ];
  }
  unset($item);
  foreach ($hide as $key) {
    unset($variables['items'][$key]);
  }
  $cache->applyTo($variables);
}

/**
 * The index rule of a location page's part, or NULL for any other section.
 *
 * Location: photos, hours and directions, house rules and booking open on
 * an index rule as /v2/special's sections do, but with only the number:
 * the section's heading, big and sticky in the left column, names it, so a
 * label in the rule would say it twice. Then a lede naming the room, and on
 * Hours and directions a link at the rule's end (Directions). Written here
 * rather than in Eyebrow and Lede fields, so every room's page reads the
 * same. heading is the section's title when its Section title is empty.
 *
 * Every room's parts are numbered, walk-in or not, and every room has its
 * House rules part (the top keeps only a few requirements,
 * _palefire_location_need_to_know()).
 *
 * @return array{heading: string, lede: string, link: ?array, walk_in: bool}|null
 */
function _palefire_location_index(ParagraphInterface $paragraph, CacheableMetadata $cache): ?array {
  $bundle = $paragraph->bundle();
  if (!in_array($bundle, ['location_photos', 'location_visit', 'location_rules', 'location_booking'], TRUE)) {
    return NULL;
  }
  $cache->addCacheableDependency($paragraph);
  $room = _palefire_location_room($paragraph) ?? (($space = _palefire_location_sibling($paragraph, 'location_space')) ? _palefire_location_room($space) : NULL);
  $location = $room ? _palefire_location_data($room, $cache) : NULL;
  $name = $location['title'] ?? (string) t('the room');
  $host = $paragraph->getParentEntity();
  $access = $location['access'] ?? 'walk_in';
  $walk_in = $access === 'walk_in';
  switch ($bundle) {
    case 'location_photos':
      return ['heading' => (string) t('The room'), 'walk_in' => $walk_in, 'lede' => (string) t('See the @room before you come.', ['@room' => $name]), 'link' => NULL];

    case 'location_visit':
      $query = $host instanceof NodeInterface && $host->hasField('field_location_query') ? trim((string) $host->get('field_location_query')->value) : '';
      $floor = $location['floor'] ?? NULL;
      $building = $location['building'] ?? '';
      // A booked or class room isn't open whenever the building is.
      $where = $floor
        ? (string) t('On Floor @n of @building', ['@n' => $floor, '@building' => $building])
        : (string) t('In @building', ['@building' => $building]);
      $ledes = [
        'walk_in' => (string) t('@where, open whenever the building is.', ['@where' => $where]),
        'class' => (string) t('@where, for scheduled classes.', ['@where' => $where]),
      ];
      return [
        'heading' => (string) t('Hours and directions'),
        'walk_in' => $walk_in,
        'lede' => $ledes[$access] ?? (string) t('@where, by booking.', ['@where' => $where]),
        'link' => $query !== '' ? [
          'url' => 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($query),
          'text' => (string) t('Directions'),
          'external' => TRUE,
          'hidden' => (string) t(' (opens in a new tab)'),
        ] : NULL,
      ];

    case 'location_rules':
      // "What to arrange first" only when a policy is Required (a walk-in
      // room may have none).
      $required = in_array('required', array_column($location['policies'] ?? [], 'state'), TRUE);
      return [
        'heading' => (string) t('House rules'),
        'walk_in' => $walk_in,
        'lede' => $required
          ? (string) t('What the @room allows, and what to arrange first.', ['@room' => $name])
          : (string) t('What the @room allows, and what it doesn’t.', ['@room' => $name]),
        'link' => NULL,
      ];

    default:
      // No link in the rule: the section's own button, under the steps, is
      // the way to the form (palefire_preprocess_paragraph__location_booking()).
      return [
        'heading' => (string) t('Book the @room', ['@room' => $name]),
        'walk_in' => $walk_in,
        'lede' => (string) t('How to request the @room, and what comes with it.', ['@room' => $name]),
        'link' => NULL,
      ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--landing-stacks.
 *
 * From the stacks (scripts/palefire_landing_stacks_setup.php): one featured
 * item beside the next events and the newest blog posts.
 * - feature: the first Featured item (field_tiles, a Tile or a Modular
 *   page, read by _palefire_node_card()) the visitor can see, or NULL:
 *   title, url, label, note, and image (its cover in the portrait
 *   responsive style, decorative and lazy) or NULL.
 * - events: for js/upcoming.js, or NULL without a calendar: calendar and
 *   campus (field_stacks_calendar, field_stacks_campus; digits only),
 *   endpoint (the events carousel's feed) and calendar_url (LibCal's
 *   calendar for that campus, the carousel's own "full calendar" link).
 * - posts: the newest three articles in its Blog categories
 *   (_palefire_blog_posts()).
 */
function palefire_preprocess_paragraph__landing_stacks(array &$variables): void {
  $variables['feature'] = NULL;
  $variables['events'] = NULL;
  $variables['posts'] = [];
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);

  if ($paragraph->hasField('field_tiles')) {
    foreach ($paragraph->get('field_tiles') as $item) {
      $node = $item->entity;
      $card = $node instanceof NodeInterface ? _palefire_node_card($node, $cache, 220) : NULL;
      if (!$card) {
        continue;
      }
      $card['image'] = $card['image_item'] ? _palefire_responsive_cover($card['image_item'], 'tile_showcase_portrait', $cache) : NULL;
      unset($card['image_item']);
      $variables['feature'] = $card;
      break;
    }
  }

  $value = static fn (string $field): string => ($paragraph->hasField($field) && !$paragraph->get($field)->isEmpty())
    ? trim((string) $paragraph->get($field)->value)
    : '';
  $calendar = $value('field_stacks_calendar');
  $campus = $value('field_stacks_campus');
  if (preg_match('/^\d+$/', $calendar)) {
    $campus = preg_match('/^\d+$/', $campus) ? $campus : '';
    $variables['events'] = [
      'calendar' => $calendar,
      'campus' => $campus,
      'endpoint' => '/libcal-gantt/carousel-events',
      'calendar_url' => 'https://lsu.libcal.com/calendar/eventsandprogramming?cid=-1&t=m&d=0000-00-00&cal=-1&inc=0' . ($campus !== '' ? '&cm=' . $campus : ''),
    ];
    $variables['#attached']['library'][] = 'palefire/upcoming';
  }

  // Each post's picture for the stage (the section's large picture, which
  // shows the item under the pointer), in the feature's portrait style.
  foreach (_palefire_blog_posts($paragraph, 3, $cache) as $post) {
    $post['image'] = $post['image_item'] ? _palefire_responsive_cover($post['image_item'], 'tile_showcase_portrait', $cache) : NULL;
    unset($post['image_item']);
    $variables['posts'][] = $post;
  }
  $cache->applyTo($variables);
}

/**
 * A card's cover image as a decorative (alt="") lazy image.
 *
 * Uses the responsive image style when it exists, then its middle image
 * style ("<style>_md") on its own, then the original file, so the card never
 * breaks if the setup script hasn't run yet or Responsive Image is off.
 * $sizes replaces the responsive style's own sizes value, for a picture shown
 * at another size than the style's other users
 * (palefire_preprocess_responsive_image()).
 */
function _palefire_responsive_cover(FieldItemInterface $image, string $style, CacheableMetadata $cache, ?string $sizes = NULL): ?array {
  $file = $image->entity;
  if (!$file) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  $attributes = ['alt' => '', 'loading' => 'lazy', 'decoding' => 'async'];
  $build = [
    '#uri' => $file->getFileUri(),
    '#width' => $image->width,
    '#height' => $image->height,
    '#attributes' => $attributes,
  ];

  $types = \Drupal::entityTypeManager();
  if (\Drupal::moduleHandler()->moduleExists('responsive_image')
    && ($responsive = $types->getStorage('responsive_image_style')->load($style))) {
    $cache->addCacheableDependency($responsive);
    if ($sizes) {
      $build['#attributes']['data-pf-sizes'] = $sizes;
    }
    return $build + ['#theme' => 'responsive_image', '#responsive_image_style_id' => $style];
  }
  if ($image_style = $types->getStorage('image_style')->load($style . '_md')) {
    $cache->addCacheableDependency($image_style);
    return $build + ['#theme' => 'image_style', '#style_name' => $image_style->id(), '#alt' => ''];
  }
  return $build + ['#theme' => 'image', '#alt' => ''];
}

/**
 * Implements hook_preprocess_HOOK() for responsive_image.
 *
 * Core has by now put the style's sizes on the image; a cover that asks for
 * its own (_palefire_responsive_cover()) gets those instead.
 */
function palefire_preprocess_responsive_image(array &$variables): void {
  $sizes = $variables['attributes']['data-pf-sizes'] ?? NULL;
  if (!$sizes) {
    return;
  }
  unset($variables['attributes']['data-pf-sizes'], $variables['img_element']['#attributes']['data-pf-sizes']);
  $variables['attributes']['sizes'] = $sizes;
  if (!empty($variables['output_image_tag'])) {
    $variables['img_element']['#attributes']['sizes'] = $sizes;
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--guide-video.
 *
 * video: url (the video's page), embed (privacy-enhanced YouTube or Vimeo
 * player URL, '' for other providers), title, and the media item's local
 * thumbnail (thumb, thumb_width, thumb_height) when it has one.
 */
function palefire_preprocess_paragraph__guide_video(array &$variables): void {
  $variables['video'] = NULL;
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_video')) {
    return;
  }
  $media = $paragraph->get('field_video')->entity;
  if (!$media instanceof MediaInterface) {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($media);
  $access = $media->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->applyTo($variables);
  if (!$access->isAllowed()) {
    return;
  }

  $url = trim((string) $media->getSource()->getSourceFieldValue($media));
  if (!preg_match('#^https?://#i', $url)) {
    return;
  }
  $embed = '';
  if (preg_match('#(?:youtube\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/|live/)|youtu\.be/)([\w-]{11})#i', $url, $m)) {
    $embed = 'https://www.youtube-nocookie.com/embed/' . $m[1] . '?autoplay=1&rel=0';
  }
  elseif (preg_match('#vimeo\.com/(?:video/)?(\d+)#i', $url, $m)) {
    $embed = 'https://player.vimeo.com/video/' . $m[1] . '?autoplay=1&dnt=1';
  }

  $thumb = '';
  $width = $height = NULL;
  $file = $media->get('thumbnail')->entity ?? NULL;
  if ($file) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('large');
    $uri = $file->getFileUri();
    $thumb = $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri);
    $item = $media->get('thumbnail')->first();
    if ($item && $item->width && $item->height) {
      $width = (int) $item->width;
      $height = (int) $item->height;
      if ($style) {
        $dimensions = ['width' => $width, 'height' => $height];
        $style->transformDimensions($dimensions, $uri);
        [$width, $height] = [$dimensions['width'], $dimensions['height']];
      }
    }
  }

  $variables['video'] = [
    'url' => $url,
    'embed' => $embed,
    'title' => $media->label(),
    'thumb' => $thumb,
    'thumb_width' => $width,
    'thumb_height' => $height,
  ];
}

/* ---------------------------------------------------------------------------
 * Louisiana Newspapers guide (scripts/palefire_louisiana_newspapers_setup.php)
 * ------------------------------------------------------------------------- */

/**
